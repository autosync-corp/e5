# Stripe API Keys
# Get your keys from: https://dashboard.stripe.com/test/apikeys

# Public key (used in the browser)
PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key_here

# Secret key (used on the server - NEVER expose this to the browser)
STRIPE_SECRET_KEY=your_secret_key_here

# Go High Level Webhook
GHL_WEBHOOK_URL=your_webhook_url_here

# Affirm API Keys (Sandbox)
# Get your keys from: https://sandbox.affirm.com/dashboard/
PUBLIC_AFFIRM_PUBLIC_KEY=your_affirm_public_key_here
AFFIRM_PRIVATE_KEY=your_affirm_private_key_here
AFFIRM_API_URL=https://sandbox.affirm.com/api/v1/transactions
AFFIRM_JS_URL=https://cdn1-sandbox.affirm.com/js/v2/affirm.js

# AutoSync API Key
# IMPORTANT: This should be used server-side only via API proxy
# Never expose this directly in client-side code
AUTOSYNC_API_KEY=efive

# Security Settings
# Set to 'production' to enable HSTS and other production-only security features
NODE_ENV=development
