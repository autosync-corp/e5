{
  "buildCommand": "npm run build",
  "framework": "astro",
  "regions": ["iad1"],
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/galleries",
      "schedule": "15 6 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/(login|dashboard)/?$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal"
    },
    {
      "src": "^/logout/?$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/logout"
    },
    {
      "src": "^/(slides|links|blog|galleries|performance|sales)/?$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/$1"
    },
    {
      "src": "^/galleries/([^/]+)/?$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/galleries/$1"
    },
    {
      "src": "^/blog/([^/]+)/?$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/blog/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/robots.txt"
    },
    {
      "src": "^/api/portal/(.*)$",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "dest": "/portal/api/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/robots.txt"
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal"
    },
    {
      "source": "/dashboard",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal"
    },
    {
      "source": "/logout",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/logout"
    },
    {
      "source": "/:section(slides|links|blog|galleries|performance|sales)",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/:section"
    },
    {
      "source": "/galleries/:id",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/galleries/:id"
    },
    {
      "source": "/blog/:slug",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/blog/:slug"
    },
    {
      "source": "/api/portal/:path*",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/portal/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "missing": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/home-slides",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/site-nav",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/sitemap-blog.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/sitemap-galleries.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/gallery-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "/login",
      "statusCode": 302
    },
    {
      "source": "/:path((?!login$|logout$|dashboard$|slides$|links$|blog(?:/.*)?$|galleries(?:/.*)?$|performance$|sales$|robots\\.txt$|_astro(?:/.*)?$|assets(?:/.*)?$|js(?:/.*)?$|favicon[^/]*$|portal(?:/.*)?$|api/portal(?:/.*)?$).*)",
      "has": [{ "type": "host", "value": "portal.e5wheels.com" }],
      "destination": "https://www.e5wheels.com/:path",
      "statusCode": 302
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "e5wheels.com" }],
      "destination": "https://www.e5wheels.com/:path*",
      "permanent": true
    },
    {
      "source": "/portal",
      "has": [{ "type": "host", "value": "www.e5wheels.com" }],
      "destination": "https://portal.e5wheels.com/login",
      "permanent": true
    },
    {
      "source": "/portal/:path*",
      "has": [{ "type": "host", "value": "www.e5wheels.com" }],
      "destination": "https://portal.e5wheels.com/:path*",
      "permanent": true
    },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "s" }],
      "destination": "/shop",
      "permanent": true
    },
