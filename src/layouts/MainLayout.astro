---
import Navbar from '@/core/components/Navbar.vue';
import Footer from '@/core/components/Footer.vue';
import LiveChat from '@/core/components/LiveChat.vue';
import { Redis } from '@upstash/redis';
import '@/assets/main.css';
import '@/assets/fonts/fonts.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  noindex?: boolean;
}

const {
  title = 'E5 Wheels - Exclusively Engineered for Corvettes',
  description,
  canonical,
  ogImage = 'https://e5wheels.com/assets/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Build full URL for OG tags
const siteUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const currentUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Load tracking settings from Redis
let tracking: any = {};
try {
  const redis = new Redis({
    url: import.meta.env.KV_REST_API_URL,
    token: import.meta.env.KV_REST_API_TOKEN,
  });
  const raw = await redis.get('e5:tracking');
  tracking = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : {};
} catch {
  // Fall back to env vars if Redis unavailable
  tracking = {};
}

const gaId = tracking.gaId || import.meta.env.GA_ID || 'G-7XTP4KDPC1';
const gtmId = tracking.gtmId || '';
const fbPixelId = tracking.fbPixelId || '';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    {gtmId && <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />}

    <!-- Google Analytics -->
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
    {gaId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`} />}

    <!-- Facebook Pixel -->
    {fbPixelId && <script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${fbPixelId}');fbq('track','PageView');`} />}
    {fbPixelId && <noscript set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${fbPixelId}&ev=PageView&noscript=1"/>`} />}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800;900&family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="E5 Wheels" />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <slot name="head" />

    <!-- Organization + LocalBusiness JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "E5 Wheels",
      "url": "https://e5wheels.com",
      "logo": "https://e5wheels.com/assets/images/e5-wheels-logo-white.webp",
      "description": "Forged and flow-formed wheels exclusively engineered for Corvette C5, C6, C7, and C8. Precision fitment, hub-centric design, made in the USA.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3500 NW 77 CT",
        "addressLocality": "Doral",
        "addressRegion": "FL",
        "postalCode": "33122",
        "addressCountry": "US"
      },
      "telephone": "+13059647429",
      "email": "SALES@E5WHEELS.COM",
      "sameAs": [
        "https://www.instagram.com/e5wheels/",
        "https://www.facebook.com/e5wheels/",
        "https://www.youtube.com/@E5Wheels",
        "https://www.tiktok.com/@e5wheels"
      ]
    })}></script>
  </head>
  <body>
    {gtmId && <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />}
    <Navbar client:load transition:persist/>
    <div style="min-height: 100dvh">
      <main class="mt-107">
        <slot />
      </main>
    </div>
    <Footer client:visible transition:persist/>
    <LiveChat client:load />
  </body>
</html>

<style is:global>
body {
  margin: auto;
  padding: 0;
  width: 100dvw;
  min-width: 100dvw;
  max-width: 1920px;
  min-height: 100dvh;
  overflow-x: hidden;
}
</style>
