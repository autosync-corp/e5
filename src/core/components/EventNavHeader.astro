---
---

<header class="rsvp-header">
  <button class="rsvp-hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <a href="/events/upcoming" class="rsvp-nav-link rsvp-nav-dark">Upcoming</a>
  <a href="/events" class="rsvp-nav-link rsvp-nav-dark">Calendar</a>
  <a href="https://www.e5wheels.com" aria-label="E5 Wheels home" class="rsvp-header-logo-link">
    <img src="/assets/images/e5-logo-black-rsvp.webp" alt="E5 Wheels" class="rsvp-header-logo" />
  </a>
  <a href="https://www.e5wheels.com" class="rsvp-nav-link"><span class="rsvp-nav-dark">To</span> <span class="rsvp-nav-red">E5Wheels.com</span></a>
  <a href="https://www.e5wheels.com/shop" class="rsvp-nav-link"><span class="rsvp-nav-dark">To</span> <span class="rsvp-nav-red">E5 Shop</span></a>
</header>

<nav class="rsvp-mobile-menu" id="mobileMenu">
  <a href="/events/upcoming">Upcoming</a>
  <a href="/events">Calendar</a>
  <a href="https://www.e5wheels.com"><span class="rsvp-nav-dark">To</span> <span class="rsvp-nav-red">E5Wheels.com</span></a>
  <a href="https://www.e5wheels.com/shop"><span class="rsvp-nav-dark">To</span> <span class="rsvp-nav-red">E5 Shop</span></a>
</nav>

<style>
  .rsvp-header {
    background: #fff;
    height: 80px;
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    justify-items: center;
    border-bottom: 2px solid #d31d25;
  }
  .rsvp-nav-link {
    font-size: 16px;
    letter-spacing: 4px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .rsvp-nav-dark { color: #000; }
  .rsvp-nav-dark:hover { color: #d31d25; }
  .rsvp-nav-red { color: #d31d25; }
  .rsvp-nav-red:hover { color: #000; }
  .rsvp-header-logo { height: auto; max-height: 40px; width: auto; display: block; }
  .rsvp-header-logo-link { grid-column: 3; }

  .rsvp-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 22px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .rsvp-hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #000;
  }

  .rsvp-mobile-menu {
    display: none;
    flex-direction: column;
    background: #fff;
    border-bottom: 2px solid #d31d25;
    position: absolute;
    top: 56px;
    left: 0;
    right: 0;
    z-index: 40;
  }
  .rsvp-mobile-menu.open { display: flex; }
  .rsvp-mobile-menu a {
    padding: 16px 24px;
    border-bottom: 1px solid #eee;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
  }
  .rsvp-mobile-menu a.rsvp-nav-red { color: #d31d25; }
  .rsvp-mobile-menu a:last-child { border-bottom: none; }

  @media (max-width: 768px) {
    .rsvp-header {
      height: 56px;
      grid-template-columns: 44px 1fr 44px;
    }
    .rsvp-header .rsvp-nav-link { display: none; }
    .rsvp-header-logo-link { grid-column: 2; }
    .rsvp-header-logo { max-height: 24px; }
    .rsvp-hamburger { display: flex; grid-column: 1; }
  }
</style>

<script>
  // @ts-nocheck
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburgerBtn.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('open');
    hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
