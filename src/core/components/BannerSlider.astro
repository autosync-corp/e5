---
import CtaLink from '@/core/components/CtaLink.astro';
import { bannerPicture, gt03LaydownPicture } from '@/core/utils/responsiveSrc';
import { E5_LOGO_WHITE_NAV, E5_LOGO_WHITE_NAV_SRCSET } from '@/core/constants/App.ts';
import {
  DEFAULT_HOMEPAGE_SLIDES,
  slidesFingerprint,
} from '@/core/portal/slides.ts';

const FILM_VIDEO_ID = '2zk8Sdi3Yh8';
const slidesSeedFp = slidesFingerprint(DEFAULT_HOMEPAGE_SLIDES);

const vizFrames = [
  { stem: 'viz-01', caption: 'Torch Red · Daytona Gloss Black', alt: 'C8 Stingray Torch Red with Daytona Gloss Black wheels in the E5 Immersive Gallery' },
  { stem: 'viz-02', caption: 'Arctic White · Sebring Titanium', alt: 'C8 Stingray Arctic White with Sebring Titanium wheels in the E5 Immersive Gallery' },
  { stem: 'viz-03', caption: 'Rapid Blue · Speedway Chrome', alt: 'C8 Stingray Rapid Blue with Speedway Chrome wheels in the E5 Immersive Gallery' },
  { stem: 'viz-04', caption: 'Black · Daytona Bronze Brushed Tint', alt: 'C8 Stingray Black with Daytona Bronze Brushed Tint wheels in the E5 Immersive Gallery' },
];

const gt03Laydown = gt03LaydownPicture();
const LAZY_PIXEL =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

// Seed copy lives in src/core/portal/slides.ts (Redis e5:portal:slides).
// Poster vehicle: 2018-c7-grand-sport-black-with-e5-daytona-bronze-brushed-tint-wheels
// Poster-print grade: scripts/generate-banner-poster.py
const slides = DEFAULT_HOMEPAGE_SLIDES;
---

<section
  id="e5-banner"
  class="e5-banner"
  aria-roledescription="carousel"
  aria-label="Featured promotions"
  tabindex="0"
  data-slides-fp={slidesSeedFp}
  data-slides-api="/api/home-slides"
>
  <div class="e5-banner-viewport">
    <div class="e5-banner-track">
      {slides.map((slide, index) => {
        const pic = bannerPicture(slide.stem);
        const eager = index === 0;
        const isFilm = slide.layout === 'film';
        const isViz = slide.layout === 'viz';
        const isLaydown = slide.layout === 'laydown';
        return (
          <div
            class:list={['e5-banner-slide', isLaydown && 'is-split', isFilm && 'is-poster']}
            data-slide={index}
            data-slide-id={slide.id}
            data-layout={slide.layout}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            {isViz ? (
              <div class="e5-banner-viz" data-viz-cycle>
                {vizFrames.map((frame, fi) => {
                  const framePic = bannerPicture(frame.stem);
                  const frameEager = eager && fi === 0;
                  return (
                    <picture
                      class:list={['e5-banner-viz-frame', fi === 0 && 'is-active']}
                      data-viz-frame={fi}
                      data-combo={frame.caption}
                    >
                      {framePic.avif && (
                        <source
                          type="image/avif"
                          srcset={frameEager ? framePic.avif : undefined}
                          data-srcset={frameEager ? undefined : framePic.avif}
                          sizes={framePic.sizes}
                        />
                      )}
                      {framePic.webp && (
                        <source
                          type="image/webp"
                          srcset={frameEager ? framePic.webp : undefined}
                          data-srcset={frameEager ? undefined : framePic.webp}
                          sizes={framePic.sizes}
                        />
                      )}
                      <img
                        src={frameEager ? framePic.src : LAZY_PIXEL}
                        data-src={frameEager ? undefined : framePic.src}
                        alt={frame.alt}
                        width="1280"
                        height="720"
                        decoding="async"
                        fetchpriority={frameEager ? 'high' : 'low'}
                        loading={frameEager ? 'eager' : 'lazy'}
                      />
                    </picture>
                  );
                })}
              </div>
            ) : (
              <picture class="e5-banner-picture">
                {pic.avif && (
                  <source
                    type="image/avif"
                    srcset={eager ? pic.avif : undefined}
                    data-srcset={eager ? undefined : pic.avif}
                    sizes={pic.sizes}
                  />
                )}
                {pic.webp && (
                  <source
                    type="image/webp"
                    srcset={eager ? pic.webp : undefined}
                    data-srcset={eager ? undefined : pic.webp}
                    sizes={pic.sizes}
                  />
                )}
                <img
                  src={eager ? pic.src : LAZY_PIXEL}
                  data-src={eager ? undefined : pic.src}
                  alt={slide.alt}
                  width="1280"
                  height="720"
                  decoding="async"
                  fetchpriority={eager ? 'high' : 'low'}
                  loading={eager ? 'eager' : 'lazy'}
                />
              </picture>
            )}
            <img class="e5-banner-override" data-banner-override hidden alt="" width="1280" height="720" decoding="async" />
            {isLaydown && gt03Laydown && (
              <div class="e5-banner-laydown">
                <picture>
                  {gt03Laydown.avif && (
                    <source
                      type="image/avif"
                      srcset={eager ? gt03Laydown.avif : undefined}
                      data-srcset={eager ? undefined : gt03Laydown.avif}
                      sizes={gt03Laydown.sizes}
                    />
                  )}
                  {gt03Laydown.webp && (
                    <source
                      type="image/webp"
                      srcset={eager ? gt03Laydown.webp : undefined}
                      data-srcset={eager ? undefined : gt03Laydown.webp}
                      sizes={gt03Laydown.sizes}
                    />
                  )}
                  <img
                    src={eager ? gt03Laydown.src : LAZY_PIXEL}
                    data-src={eager ? undefined : gt03Laydown.src}
                    alt="GT.03 Brushed Aluminum wheel, product laydown"
                    width="1500"
                    height="1500"
                    decoding="async"
                    fetchpriority="low"
                    loading="lazy"
                  />
                </picture>
              </div>
            )}
            <div class="e5-banner-overlay"></div>
            {isFilm && (
              <svg
                class="e5-poster-grid"
                viewBox="0 0 100 36"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <linearGradient id="e5-poster-grid-stroke" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#ff2e88" stop-opacity="0.85"></stop>
                    <stop offset="1" stop-color="#00e5d4" stop-opacity="0.12"></stop>
                  </linearGradient>
                </defs>
                <line x1="0" y1="5.5" x2="100" y2="5.5" stroke="#ff2e88" stroke-width="0.22"></line>
                <line x1="50" y1="5.5" x2="0" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.18"></line>
                <line x1="50" y1="5.5" x2="12" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="25" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="37" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="63" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="75" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="88" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.16"></line>
                <line x1="50" y1="5.5" x2="100" y2="36" stroke="url(#e5-poster-grid-stroke)" stroke-width="0.18"></line>
                <line x1="0" y1="12" x2="100" y2="12" stroke="#00e5d4" stroke-opacity="0.35" stroke-width="0.12"></line>
                <line x1="0" y1="20" x2="100" y2="20" stroke="#00e5d4" stroke-opacity="0.28" stroke-width="0.12"></line>
                <line x1="0" y1="28.5" x2="100" y2="28.5" stroke="#00e5d4" stroke-opacity="0.2" stroke-width="0.12"></line>
              </svg>
            )}
            <div class="e5-banner-copy">
              <div class:list={['e5-banner-copy-inner', isLaydown && 'is-card']}>
                <p class="e5-banner-kicker" data-field="kicker" hidden={!slide.kicker}>{slide.kicker}</p>
                {isFilm && (
                  <img
                    class="e5-poster-logo"
                    src={E5_LOGO_WHITE_NAV}
                    srcset={E5_LOGO_WHITE_NAV_SRCSET}
                    sizes="(max-width: 767px) 120px, 220px"
                    alt="E5 Wheels"
                    width="560"
                    height="48"
                    decoding="async"
                    loading="lazy"
                  />
                )}
                {isFilm && <span class="e5-poster-rule" aria-hidden="true"></span>}
                <h2 class="e5-banner-title">
                  <span data-field="title">{slide.title}</span>
                  <span data-field="subtitle-wrap" hidden={!slide.subtitle}>
                    <br />
                    <span class="e5-poster-sub" data-field="subtitle">{slide.subtitle}</span>
                  </span>
                </h2>
                <p class="e5-banner-code" data-field="code" aria-label={`Promo code ${slide.code}`} hidden={!slide.code}>
                  {slide.code}
                </p>
                <p class:list={['e5-banner-body', slide.emphasize && 'is-emphasis']} data-field="body" hidden={!slide.body}>
                  <span data-field="body-text">{slide.body}</span>
                  {isFilm && (
                    <>
                      {' '}
                      <span class="e5-poster-script" data-field="script" hidden={!slide.script}>{slide.script}</span>
                    </>
                  )}
                </p>
                <p class="e5-poster-credits" data-field="credits" hidden={!slide.credits}>{slide.credits}</p>
                <div class="e5-banner-cta">
                  {isFilm ? (
                    <button
                      type="button"
                      class="e5-poster-cta"
                      data-film-open
                      data-field="cta"
                      data-gtm-event="home_banner"
                      data-gtm-label={slide.gtm}
                    >
                      {slide.cta}
                    </button>
                  ) : (
                    <CtaLink
                      primary
                      href={slide.href}
                      data-gtm-event="home_banner"
                      data-gtm-label={slide.gtm}
                    >
                      {slide.cta}
                    </CtaLink>
                  )}
                </div>
                {isViz && (
                  <p class="e5-banner-combo" data-viz-caption>
                    {vizFrames[0].caption}
                  </p>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <button type="button" class="e5-banner-arrow e5-banner-arrow--prev" data-prev aria-label="Previous slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M11.5 3.5 6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="e5-banner-arrow e5-banner-arrow--next" data-next aria-label="Next slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M6.5 3.5 12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="e5-banner-dots" role="group" aria-label="Choose slide">
    {slides.map((slide, index) => (
      <button
        type="button"
        class:list={['e5-banner-dot', index === 0 && 'is-active']}
        data-dot={index}
        aria-label={`Go to slide ${index + 1}: ${slide.title}`}
        aria-current={index === 0 ? 'true' : 'false'}
      />
    ))}
  </div>
  <p class="sr-only" data-live aria-live="polite">Slide 1 of {slides.length}</p>
</section>

<div
  id="e5-film-modal"
  class="e5-film-modal"
  hidden
  data-film-modal
  data-film-id={FILM_VIDEO_ID}
  role="dialog"
  aria-modal="true"
  aria-labelledby="e5-film-title"
>
  <button type="button" class="e5-film-backdrop" data-film-close aria-label="Close film"></button>
  <div class="e5-film-dialog">
    <p id="e5-film-title" class="sr-only">E5 Wheels film</p>
    <button type="button" class="e5-film-x" data-film-close aria-label="Close film">
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="e5-film-frame" data-film-frame></div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('e5-banner');
    if (!root) return;
    var track = root.querySelector('.e5-banner-track');
    var dotsHost = root.querySelector('.e5-banner-dots');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var live = root.querySelector('[data-live]');
    if (!track) return;
    var slides = [];
    var dots = [];
    var n = 0;
    var i = 0;
    var timer = null;
    var paused = false;
    var filmOpen = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var vizRoot = root.querySelector('[data-viz-cycle]');
    var vizFrames = vizRoot ? vizRoot.querySelectorAll('[data-viz-frame]') : [];
    var vizCaption = root.querySelector('[data-viz-caption]');
    var vizTimer = null;
    var vizI = 0;
    var vizLoaded = false;
    var vizHoldMs = 3000;

    function querySlides() {
      slides = root.querySelectorAll('.e5-banner-track [data-slide]');
      dots = dotsHost ? dotsHost.querySelectorAll('[data-dot]') : [];
      n = slides.length;
    }

    function currentHasViz() {
      return !!(slides[i] && slides[i].querySelector('[data-viz-cycle]') && !slides[i].classList.contains('is-static-image'));
    }

    function hydrateLazyMedia(scope) {
      if (!scope) return;
      var sources = scope.querySelectorAll('source[data-srcset]');
      for (var s = 0; s < sources.length; s++) {
        if (!sources[s].getAttribute('srcset')) {
          sources[s].setAttribute('srcset', sources[s].getAttribute('data-srcset'));
        }
      }
      var imgs = scope.querySelectorAll('img[data-src]');
      for (var m = 0; m < imgs.length; m++) {
        imgs[m].setAttribute('src', imgs[m].getAttribute('data-src'));
        imgs[m].removeAttribute('data-src');
      }
    }

    function loadViz() {
      if (vizLoaded || !vizFrames.length) return;
      vizLoaded = true;
      hydrateLazyMedia(vizRoot);
    }

    function paintViz() {
      for (var f = 0; f < vizFrames.length; f++) {
        vizFrames[f].classList.toggle('is-active', f === vizI);
      }
      if (vizCaption && vizFrames[vizI]) {
        vizCaption.textContent = vizFrames[vizI].getAttribute('data-combo') || '';
      }
    }

    function stopViz() {
      if (vizTimer) {
        clearInterval(vizTimer);
        vizTimer = null;
      }
    }

    function startViz() {
      if (reduce || !currentHasViz() || !vizFrames.length) return;
      loadViz();
      if (vizTimer) return;
      vizTimer = setInterval(function () {
        vizI = (vizI + 1) % vizFrames.length;
        paintViz();
      }, vizHoldMs);
    }

    function paint(idx) {
      querySlides();
      if (!n) return;
      i = ((idx % n) + n) % n;
      track.style.transform = 'translate3d(' + (-i * 100) + '%,0,0)';
      for (var s = 0; s < n; s++) {
        var hidden = s !== i;
        slides[s].setAttribute('aria-hidden', hidden ? 'true' : 'false');
        slides[s].setAttribute('data-slide', String(s));
        if (hidden) slides[s].setAttribute('inert', '');
        else slides[s].removeAttribute('inert');
        if (dots[s]) {
          dots[s].setAttribute('aria-current', s === i ? 'true' : 'false');
          dots[s].classList.toggle('is-active', s === i);
        }
      }
      if (live) live.textContent = 'Slide ' + (i + 1) + ' of ' + n;
      hydrateLazyMedia(slides[i]);
      if (currentHasViz()) startViz();
      else stopViz();
    }

    function go(idx, fromUser) {
      paint(idx);
      if (fromUser && !paused) restart();
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      if (reduce || paused || filmOpen) return;
      stop();
      timer = setInterval(function () { go(i + 1, false); }, 6000);
      startViz();
    }

    function restart() {
      stop();
      start();
    }

    function pause() {
      paused = true;
      stop();
    }

    function resume() {
      if (filmOpen) return;
      paused = false;
      start();
    }

    prev.addEventListener('click', function () { go(i - 1, true); });
    next.addEventListener('click', function () { go(i + 1, true); });
    if (dotsHost) {
      dotsHost.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-dot]');
        if (!btn) return;
        go(Number(btn.getAttribute('data-dot')), true);
      });
    }

    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', function (e) {
      if (!root.contains(e.relatedTarget)) resume();
    });
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1, true); }
    });

    var startX = 0;
    var dx = 0;
    var swiping = false;
    root.addEventListener('pointerdown', function (e) {
      if (e.target.closest('a, button')) return;
      swiping = true;
      startX = e.clientX;
      dx = 0;
    });
    root.addEventListener('pointermove', function (e) {
      if (!swiping) return;
      dx = e.clientX - startX;
    });
    function endSwipe() {
      if (!swiping) return;
      swiping = false;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1), true);
    }
    root.addEventListener('pointerup', endSwipe);
    root.addEventListener('pointercancel', endSwipe);

    var modal = document.getElementById('e5-film-modal');
    var filmFrame = modal ? modal.querySelector('[data-film-frame]') : null;
    var filmId = modal ? modal.getAttribute('data-film-id') || '' : '';
    var lastFocus = null;

    function openFilm() {
      if (!modal || !filmFrame || !filmId) return;
      lastFocus = document.activeElement;
      filmOpen = true;
      pause();
      if (!filmFrame.querySelector('iframe')) {
        var iframe = document.createElement('iframe');
        iframe.setAttribute(
          'src',
          'https://www.youtube-nocookie.com/embed/' + filmId + '?rel=0&modestbranding=1'
        );
        iframe.setAttribute('title', 'E5 Wheels film');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute(
          'allow',
          'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
        );
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        filmFrame.appendChild(iframe);
      }
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('.e5-film-x');
      if (closeBtn) closeBtn.focus();
    }

    function closeFilm() {
      if (!modal || !filmOpen) return;
      filmOpen = false;
      modal.hidden = true;
      if (filmFrame) filmFrame.innerHTML = '';
      document.documentElement.style.overflow = '';
      if (!root.matches(':hover') && !root.contains(document.activeElement)) {
        resume();
      }
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-film-open]')) {
        e.preventDefault();
        openFilm();
      }
    });
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target && e.target.closest('[data-film-close]')) closeFilm();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && filmOpen) {
        e.preventDefault();
        closeFilm();
      }
    });

    function setField(el, name, text) {
      var node = el.querySelector('[data-field="' + name + '"]');
      if (!node) return;
      if (name === 'subtitle-wrap') {
        node.hidden = !text;
        return;
      }
      node.hidden = !text;
      if (name !== 'body') node.textContent = text || '';
    }

    function applyOverride(el, url, alt) {
      var override = el.querySelector('[data-banner-override]');
      if (!override) return;
      if (!url) {
        el.classList.remove('is-static-image');
        override.hidden = true;
        override.removeAttribute('src');
        return;
      }
      el.classList.add('is-static-image');
      override.hidden = false;
      override.src = url;
      override.alt = alt || '';
    }

    function rebuildDots(items) {
      if (!dotsHost) return;
      dotsHost.innerHTML = '';
      for (var d = 0; d < items.length; d++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'e5-banner-dot' + (d === 0 ? ' is-active' : '');
        btn.setAttribute('data-dot', String(d));
        btn.setAttribute('aria-label', 'Go to slide ' + (d + 1) + ': ' + (items[d].title || ''));
        btn.setAttribute('aria-current', d === 0 ? 'true' : 'false');
        dotsHost.appendChild(btn);
      }
    }

    function fillSlide(el, slide) {
      setField(el, 'kicker', slide.kicker);
      setField(el, 'title', slide.title);
      setField(el, 'subtitle', slide.subtitle);
      setField(el, 'subtitle-wrap', slide.subtitle);
      setField(el, 'code', slide.code);
      var bodyText = el.querySelector('[data-field="body-text"]');
      var body = el.querySelector('[data-field="body"]');
      if (bodyText) bodyText.textContent = slide.body || '';
      if (body) body.hidden = !slide.body;
      setField(el, 'script', slide.script);
      setField(el, 'credits', slide.credits);
      var cta = el.querySelector('[data-field="cta"]') || el.querySelector('.e5-banner-cta a');
      if (cta) cta.textContent = slide.cta || '';
      var link = el.querySelector('.e5-banner-cta a');
      if (link && slide.href) link.setAttribute('href', slide.href);
      var img = el.querySelector('.e5-banner-picture img');
      if (img && slide.alt) img.setAttribute('alt', slide.alt);
      applyOverride(el, slide.imageUrl || '', slide.alt || '');
    }

    function applyLiveSlides(payload) {
      if (!payload || !payload.slides || !payload.slides.length) return false;
      if (payload.fingerprint && payload.fingerprint === root.getAttribute('data-slides-fp')) return false;
      var incoming = payload.slides;
      var byId = {};
      var existing = root.querySelectorAll('.e5-banner-track [data-slide]');
      for (var e = 0; e < existing.length; e++) {
        byId[existing[e].getAttribute('data-slide-id')] = existing[e];
      }
      var proto = null;
      for (var p = 0; p < existing.length; p++) {
        if (existing[p].getAttribute('data-layout') === 'promo') {
          proto = existing[p];
          break;
        }
