---
import CtaLink from '@/core/components/CtaLink.astro';
import { bannerPicture, filmCarPicture, gt03LaydownPicture } from '@/core/utils/responsiveSrc';
import {
  SHOP_ROUTE,
  INTERACTIVE_GALLERY_ROUTE,
  WHEELS_GT_03_ROUTE,
} from '@/core/constants/Routes.ts';

const FILM_VIDEO_ID = '2zk8Sdi3Yh8';

const vizFrames = [
  { stem: 'viz-01', caption: 'Torch Red · Daytona Gloss Black', alt: 'C8 Stingray Torch Red with Daytona Gloss Black wheels in the E5 Immersive Gallery' },
  { stem: 'viz-02', caption: 'Arctic White · Sebring Titanium', alt: 'C8 Stingray Arctic White with Sebring Titanium wheels in the E5 Immersive Gallery' },
  { stem: 'viz-03', caption: 'Rapid Blue · Speedway Chrome', alt: 'C8 Stingray Rapid Blue with Speedway Chrome wheels in the E5 Immersive Gallery' },
  { stem: 'viz-04', caption: 'Black · Daytona Bronze Brushed Tint', alt: 'C8 Stingray Black with Daytona Bronze Brushed Tint wheels in the E5 Immersive Gallery' },
];

const gt03Laydown = gt03LaydownPicture();
const filmCar = filmCarPicture();

const slides = [
  {
    stem: 'bf-sale' as const,
    // Real gallery photo: 2025 C8 Stingray Blue on Sebring Gloss Black
    // (public/assets/images/gallery/corvette/2025-c8-stingray-blue-sebring-gloss-black/0.webp)
    alt: 'Blue C8 Corvette Stingray fitted with E5 Sebring Gloss Black wheels',
    kicker: 'LIMITED TIME',
    title: 'BLACK FRIDAY SALE',
    code: '15%OFF@E5',
    body: 'Use this code at checkout for 15% off complete E5 wheel sets.',
    cta: 'SHOP WHEELS',
    href: SHOP_ROUTE,
    gtm: 'Black Friday Shop Wheels',
    viz: false,
    laydown: false,
    film: false,
    subtitle: '',
    credits: '',
  },
  {
    stem: 'viz-01' as const,
    viz: true,
    alt: vizFrames[0].alt,
    kicker: 'NOW LIVE',
    title: 'E5 IMMERSIVE GALLERY',
    code: '',
    body: 'See E5 wheels on your Corvette — the new Immersive Gallery is live.',
    cta: 'OPEN GALLERY',
    href: INTERACTIVE_GALLERY_ROUTE,
    gtm: 'Open Immersive Gallery',
    laydown: false,
    film: false,
    subtitle: '',
    credits: '',
  },
  {
    stem: 'gt03-black' as const,
    // Real GT.03 on a black C8 Z06: gallery 2025-c8-z06-black/1.webp
    // Part numbers E5GT032010E25520AB / E5GT032113E20520AB.
    // Laydown is Dave's transparent GT.03 Brushed Aluminum product shot (scripts/assets/gt03-laydown.png).
    laydown: true,
    alt: 'Black C8 Corvette Z06 fitted with in-stock E5 GT.03 wheels',
    kicker: 'GT FORGED',
    title: 'GT.03',
    code: '',
    body: 'IN-STOCK & READY-2-SHIP',
    emphasize: true,
    cta: 'EXPLORE GT.03',
    href: WHEELS_GT_03_ROUTE,
    gtm: 'Explore GT.03',
    film: false,
    subtitle: '',
    credits: '',
  },
  {
    stem: 'film-poster' as const,
    // Real gallery vehicle, isolated (not generated, wheels unaltered):
    // public/assets/images/gallery/corvette/2018-c7-grand-sport-black-with-e5-daytona-bronze-brushed-tint-wheels/1.webp
    // Cutout variants: public/assets/images/banner/film-car-*.webp
    film: true,
    alt: 'Black C7 Corvette Grand Sport fitted with E5 Daytona Bronze Brushed Tint wheels',
    kicker: '',
    title: 'E5 Wheels',
    subtitle: 'FORGED ON BLACKTOP',
    code: '',
    body: '',
    credits: 'E5 WHEELS presents  ·  a Corvette motion picture',
    cta: 'WATCH THE FILM',
    href: '',
    gtm: 'Watch the Film',
    viz: false,
    laydown: false,
  },
];
---

<section
  id="e5-banner"
  class="e5-banner"
  aria-roledescription="carousel"
  aria-label="Featured promotions"
  tabindex="0"
>
  <div class="e5-banner-viewport">
    <div class="e5-banner-track">
      {slides.map((slide, index) => {
        const pic = slide.film ? filmCar : bannerPicture(slide.stem);
        const eager = index === 0;
        if (slide.film) {
          return (
            <div
              class="e5-banner-slide is-poster"
              data-slide={index}
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${slides.length}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
              inert={index === 0 ? undefined : true}
            >
              <div class="e5-poster-stage" aria-hidden="true">
                <div class="e5-poster-sun"></div>
                <div class="e5-poster-ground"></div>
              </div>
              <picture class="e5-poster-car">
                {pic.avif && <source type="image/avif" srcset={pic.avif} sizes={pic.sizes} />}
                {pic.webp && <source type="image/webp" srcset={pic.webp} sizes={pic.sizes} />}
                <img
                  src={pic.src}
                  alt={slide.alt}
                  width="860"
                  height="312"
                  decoding="async"
                  fetchpriority="low"
                  loading="lazy"
                />
              </picture>
              <div class="e5-poster-masthead">
                <svg class="e5-poster-bolts" viewBox="0 0 1000 240" aria-hidden="true" focusable="false">
                  <g transform="translate(70,8) rotate(-22)">
                    <path fill="#fff" d="M42 10 H128 L100 58 H168 L58 178 L92 96 H42 Z" />
                  </g>
                  <g transform="translate(930,8) rotate(22) scale(-1,1)">
                    <path fill="#fff" d="M42 10 H128 L100 58 H168 L58 178 L92 96 H42 Z" />
                  </g>
                </svg>
                <h2 class="e5-banner-title e5-poster-title">
                  <span class="e5-poster-script">{slide.title}</span>
                  {slide.subtitle && <span class="e5-poster-banner">{slide.subtitle}</span>}
                </h2>
              </div>
              {slide.credits && <p class="e5-poster-credits">{slide.credits}</p>}
              <div class="e5-poster-cta-wrap">
                <button
                  type="button"
                  class="e5-poster-cta"
                  data-film-open
                  data-gtm-event="home_banner"
                  data-gtm-label={slide.gtm}
                >
                  {slide.cta}
                </button>
              </div>
            </div>
          );
        }
        return (
          <div
            class:list={['e5-banner-slide', slide.laydown && 'is-split']}
            data-slide={index}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            {slide.viz ? (
              <div class="e5-banner-viz" data-viz-cycle>
                {vizFrames.map((frame, fi) => {
                  const framePic = bannerPicture(frame.stem);
                  const first = fi === 0;
                  return (
                    <picture
                      class:list={['e5-banner-viz-frame', first && 'is-active']}
                      data-viz-frame={fi}
                      data-combo={frame.caption}
                    >
                      {framePic.avif && (
                        <source
                          type="image/avif"
                          srcset={first ? framePic.avif : undefined}
                          data-srcset={first ? undefined : framePic.avif}
                          sizes={framePic.sizes}
                        />
                      )}
                      {framePic.webp && (
                        <source
                          type="image/webp"
                          srcset={first ? framePic.webp : undefined}
                          data-srcset={first ? undefined : framePic.webp}
                          sizes={framePic.sizes}
                        />
                      )}
                      <img
                        src={first ? framePic.src : `/assets/images/banner/${frame.stem}-800.webp`}
                        data-src={first ? undefined : framePic.src}
                        alt={frame.alt}
                        width="1280"
                        height="720"
                        decoding="async"
                        fetchpriority="low"
                        loading="lazy"
                      />
                    </picture>
                  );
                })}
              </div>
            ) : (
              <picture class="e5-banner-picture">
                {pic.avif && <source type="image/avif" srcset={pic.avif} sizes={pic.sizes} />}
                {pic.webp && <source type="image/webp" srcset={pic.webp} sizes={pic.sizes} />}
                <img
                  src={pic.src}
                  alt={slide.alt}
                  width="1280"
                  height="720"
                  decoding="async"
                  fetchpriority={eager ? 'high' : 'low'}
                  loading={eager ? 'eager' : 'lazy'}
                />
              </picture>
            )}
            {slide.laydown && gt03Laydown && (
              <div class="e5-banner-laydown">
                <picture>
                  {gt03Laydown.avif && <source type="image/avif" srcset={gt03Laydown.avif} sizes={gt03Laydown.sizes} />}
                  {gt03Laydown.webp && <source type="image/webp" srcset={gt03Laydown.webp} sizes={gt03Laydown.sizes} />}
                  <img
                    src={gt03Laydown.src}
                    alt="GT.03 Brushed Aluminum wheel, product laydown"
                    width="1500"
                    height="1500"
                    decoding="async"
                    fetchpriority="low"
                    loading="lazy"
                  />
                </picture>
              </div>
            )}
            <div class="e5-banner-overlay"></div>
            <div class="e5-banner-copy">
              <div class:list={['e5-banner-copy-inner', slide.laydown && 'is-card']}>
                {slide.kicker && <p class="e5-banner-kicker">{slide.kicker}</p>}
                <h2 class="e5-banner-title">{slide.title}</h2>
                {slide.code && (
                  <p class="e5-banner-code" aria-label={`Promo code ${slide.code}`}>
                    {slide.code}
                  </p>
                )}
                {slide.body && (
                  <p class:list={['e5-banner-body', slide.emphasize && 'is-emphasis']}>{slide.body}</p>
                )}
                <div class="e5-banner-cta">
                  <CtaLink
                    primary
                    href={slide.href}
                    data-gtm-event="home_banner"
                    data-gtm-label={slide.gtm}
                  >
                    {slide.cta}
                  </CtaLink>
                </div>
                {slide.viz && (
                  <p class="e5-banner-combo" data-viz-caption>
                    {vizFrames[0].caption}
                  </p>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <button type="button" class="e5-banner-arrow e5-banner-arrow--prev" data-prev aria-label="Previous slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M11.5 3.5 6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="e5-banner-arrow e5-banner-arrow--next" data-next aria-label="Next slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M6.5 3.5 12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="e5-banner-dots" role="tablist" aria-label="Choose slide">
    {slides.map((slide, index) => (
      <button
        type="button"
        class:list={['e5-banner-dot', index === 0 && 'is-active']}
        data-dot={index}
        aria-label={`Go to slide ${index + 1}: ${slide.title}`}
        aria-current={index === 0 ? 'true' : 'false'}
      />
    ))}
  </div>
  <p class="sr-only" data-live aria-live="polite">Slide 1 of {slides.length}</p>
</section>

<div
  id="e5-film-modal"
  class="e5-film-modal"
  hidden
  data-film-modal
  data-film-id={FILM_VIDEO_ID}
  role="dialog"
  aria-modal="true"
  aria-labelledby="e5-film-title"
>
  <button type="button" class="e5-film-backdrop" data-film-close aria-label="Close film"></button>
  <div class="e5-film-dialog">
    <p id="e5-film-title" class="sr-only">E5 Wheels film</p>
    <button type="button" class="e5-film-x" data-film-close aria-label="Close film">
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="e5-film-frame" data-film-frame></div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('e5-banner');
    if (!root) return;
    var track = root.querySelector('.e5-banner-track');
    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-dot]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var live = root.querySelector('[data-live]');
    if (!track || !slides.length) return;
    var n = slides.length;
    var i = 0;
    var timer = null;
    var paused = false;
    var filmOpen = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var vizRoot = root.querySelector('[data-viz-cycle]');
    var vizFrames = vizRoot ? vizRoot.querySelectorAll('[data-viz-frame]') : [];
    var vizCaption = root.querySelector('[data-viz-caption]');
    var vizTimer = null;
    var vizI = 0;
    var vizLoaded = false;
    var vizHoldMs = 3000;

    function loadViz() {
      if (vizLoaded || !vizFrames.length) return;
      vizLoaded = true;
      for (var f = 0; f < vizFrames.length; f++) {
        var sources = vizFrames[f].querySelectorAll('source[data-srcset]');
        for (var s = 0; s < sources.length; s++) {
          if (!sources[s].getAttribute('srcset')) {
            sources[s].setAttribute('srcset', sources[s].getAttribute('data-srcset'));
          }
        }
        var img = vizFrames[f].querySelector('img');
        if (img && img.getAttribute('data-src') && !img.getAttribute('src')) {
          img.setAttribute('src', img.getAttribute('data-src'));
        }
      }
    }

    function paintViz() {
      for (var f = 0; f < vizFrames.length; f++) {
        vizFrames[f].classList.toggle('is-active', f === vizI);
      }
      if (vizCaption && vizFrames[vizI]) {
        vizCaption.textContent = vizFrames[vizI].getAttribute('data-combo') || '';
      }
    }

    function stopViz() {
      if (vizTimer) {
        clearInterval(vizTimer);
        vizTimer = null;
      }
    }

    function startViz() {
      if (reduce || i !== 1 || !vizFrames.length) return;
      loadViz();
      if (vizTimer) return;
      vizTimer = setInterval(function () {
        vizI = (vizI + 1) % vizFrames.length;
        paintViz();
      }, vizHoldMs);
    }

    function paint(idx) {
      i = ((idx % n) + n) % n;
      track.style.transform = 'translate3d(' + (-i * 100) + '%,0,0)';
      for (var s = 0; s < n; s++) {
        var hidden = s !== i;
        slides[s].setAttribute('aria-hidden', hidden ? 'true' : 'false');
        if (hidden) slides[s].setAttribute('inert', '');
        else slides[s].removeAttribute('inert');
        dots[s].setAttribute('aria-current', s === i ? 'true' : 'false');
        dots[s].classList.toggle('is-active', s === i);
      }
      if (live) live.textContent = 'Slide ' + (i + 1) + ' of ' + n;
      if (i === 1) startViz();
      else stopViz();
    }

    function go(idx, fromUser) {
      paint(idx);
      if (fromUser && !paused) restart();
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      if (reduce || paused || filmOpen) return;
      stop();
      timer = setInterval(function () { go(i + 1, false); }, 6000);
      startViz();
    }

    function restart() {
      stop();
      start();
    }

    function pause() {
      paused = true;
      stop();
    }

    function resume() {
      if (filmOpen) return;
      paused = false;
      start();
    }

    prev.addEventListener('click', function () { go(i - 1, true); });
    next.addEventListener('click', function () { go(i + 1, true); });
    for (var d = 0; d < dots.length; d++) {
      (function (idx) {
        dots[idx].addEventListener('click', function () { go(idx, true); });
      })(d);
    }

    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', function (e) {
      if (!root.contains(e.relatedTarget)) resume();
    });
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1, true); }
    });

    var startX = 0;
    var dx = 0;
    var swiping = false;
    root.addEventListener('pointerdown', function (e) {
      if (e.target.closest('a, button')) return;
      swiping = true;
      startX = e.clientX;
      dx = 0;
    });
    root.addEventListener('pointermove', function (e) {
      if (!swiping) return;
      dx = e.clientX - startX;
    });
    function endSwipe() {
      if (!swiping) return;
      swiping = false;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1), true);
    }
    root.addEventListener('pointerup', endSwipe);
    root.addEventListener('pointercancel', endSwipe);

    var modal = document.getElementById('e5-film-modal');
    var filmFrame = modal ? modal.querySelector('[data-film-frame]') : null;
    var filmId = modal ? modal.getAttribute('data-film-id') || '' : '';
    var lastFocus = null;

    function openFilm() {
      if (!modal || !filmFrame || !filmId) return;
      lastFocus = document.activeElement;
      filmOpen = true;
      pause();
      if (!filmFrame.querySelector('iframe')) {
        var iframe = document.createElement('iframe');
        iframe.setAttribute(
          'src',
          'https://www.youtube-nocookie.com/embed/' + filmId + '?rel=0&modestbranding=1'
        );
        iframe.setAttribute('title', 'E5 Wheels film');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute(
          'allow',
          'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
        );
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        filmFrame.appendChild(iframe);
      }
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('.e5-film-x');
      if (closeBtn) closeBtn.focus();
    }

    function closeFilm() {
      if (!modal || !filmOpen) return;
      filmOpen = false;
      modal.hidden = true;
      if (filmFrame) filmFrame.innerHTML = '';
      document.documentElement.style.overflow = '';
      if (!root.matches(':hover') && !root.contains(document.activeElement)) {
        resume();
      }
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    var openers = root.querySelectorAll('[data-film-open]');
    for (var o = 0; o < openers.length; o++) {
      openers[o].addEventListener('click', function (e) {
        e.preventDefault();
        openFilm();
      });
    }
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target && e.target.closest('[data-film-close]')) closeFilm();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && filmOpen) {
        e.preventDefault();
        closeFilm();
      }
    });

    paint(0);
    start();
  })();
</script>

<style>
  .e5-banner {
    position: relative;
    width: 100%;
    margin-top: 107px;
    height: 754px;
    min-height: 420px;
    max-height: calc(100svh - 107px);
    overflow: hidden;
    background: #111;
    color: #fff;
    outline: none;
  }
  .e5-banner:focus-visible {
    box-shadow: inset 0 0 0 3px #d31d25;
  }
  .e5-banner-viewport,
  .e5-banner-track,
  .e5-banner-slide {
    width: 100%;
    height: 100%;
  }
  .e5-banner-viewport {
    overflow: hidden;
  }
  .e5-banner-track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }
  .e5-banner-slide {
    position: relative;
    flex: 0 0 100%;
    overflow: hidden;
  }
  .e5-banner-picture,
  .e5-banner-picture img,
  .e5-banner-viz,
  .e5-banner-viz-frame,
  .e5-banner-viz-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .e5-banner-picture img,
  .e5-banner-viz-frame img {
    object-fit: cover;
    object-position: 22% center;
    pointer-events: none;
  }
  .e5-banner-slide.is-split .e5-banner-picture img {
    object-position: 72% center;
  }
  .e5-banner-viz-frame {
    opacity: 0;
    transition: opacity 0.9s ease;
    z-index: 0;
  }
  .e5-banner-viz-frame.is-active {
    opacity: 1;
    z-index: 1;
  }
  .e5-banner-laydown {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: transparent;
    pointer-events: none;
  }
  .e5-banner-laydown picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .e5-banner-laydown img {
    position: absolute;
    left: -16%;
    top: 50%;
    transform: translateY(-50%);
    width: 62%;
    height: auto;
    max-width: none;
    max-height: none;
    object-fit: contain;
    object-position: center;
    pointer-events: none;
    filter: drop-shadow(16px 8px 28px rgba(0, 0, 0, 0.38));
  }
  .e5-banner-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(270deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.52) 38%, rgba(0, 0, 0, 0.16) 68%, rgba(0, 0, 0, 0.28) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.22) 0%, transparent 34%, rgba(0, 0, 0, 0.5) 100%);
  }
  .e5-banner-slide.is-split .e5-banner-overlay {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.1) 26%, transparent 48%),
      linear-gradient(270deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.18) 30%, transparent 58%);
  }
  .e5-banner-copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    margin-left: auto;
    height: 100%;
    max-width: 760px;
    padding: 32px 80px 72px 40px;
    text-align: right;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }
  .e5-banner-slide.is-split .e5-banner-copy {
    justify-content: flex-start;
    padding-top: 48px;
  }
  .e5-banner-copy-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .e5-banner-copy-inner.is-card {
    background: rgba(8, 8, 8, 0.5);
    padding: 22px 24px 24px;
