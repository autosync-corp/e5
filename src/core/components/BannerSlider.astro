---
import CtaLink from '@/core/components/CtaLink.astro';
import { bannerPicture } from '@/core/utils/responsiveSrc';
import {
  SHOP_ROUTE,
  INTERACTIVE_GALLERY_ROUTE,
  WHEELS_GT_03_ROUTE,
} from '@/core/constants/Routes.ts';

const slides = [
  {
    stem: 'bf-sale' as const,
    // Real gallery photo: 2025 C8 Stingray Blue on Sebring Gloss Black
    // (public/assets/images/gallery/corvette/2025-c8-stingray-blue-sebring-gloss-black/0.webp)
    alt: 'Blue C8 Corvette Stingray fitted with E5 Sebring Gloss Black wheels',
    kicker: 'LIMITED TIME',
    title: 'BLACK FRIDAY SALE',
    code: '15%OFF@E5',
    body: 'Use this code at checkout for 15% off complete E5 wheel sets.',
    cta: 'SHOP WHEELS',
    href: SHOP_ROUTE,
    gtm: 'Black Friday Shop Wheels',
  },
  {
    stem: 'immersive-gallery' as const,
    // Live capture of https://www.e5wheels.com/e5-visualizer
    alt: 'E5 Immersive Gallery visualizer showing E5 wheels on a Corvette',
    kicker: 'NOW LIVE',
    title: 'E5 IMMERSIVE GALLERY',
    code: '',
    body: 'See E5 wheels on your Corvette — the new Immersive Gallery is live.',
    cta: 'OPEN GALLERY',
    href: INTERACTIVE_GALLERY_ROUTE,
    gtm: 'Open Immersive Gallery',
  },
  {
    stem: 'gt03-black' as const,
    // Real GT.03 on a black C8 Z06: gallery 2025-c8-z06-black/1.webp
    // Part numbers E5GT032010E25520AB / E5GT032113E20520AB.
    alt: 'Black C8 Corvette Z06 fitted with in-stock E5 GT.03 wheels',
    kicker: 'GT FORGED',
    title: 'GT.03',
    code: '',
    body: 'IN-STOCK & READY-2-SHIP',
    emphasize: true,
    cta: 'EXPLORE GT.03',
    href: WHEELS_GT_03_ROUTE,
    gtm: 'Explore GT.03',
  },
];
---

<section
  id="e5-banner"
  class="e5-banner"
  aria-roledescription="carousel"
  aria-label="Featured promotions"
  tabindex="0"
>
  <div class="e5-banner-viewport">
    <div class="e5-banner-track">
      {slides.map((slide, index) => {
        const pic = bannerPicture(slide.stem);
        const eager = index === 0;
        return (
          <div
            class="e5-banner-slide"
            data-slide={index}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            <picture class="e5-banner-picture">
              {pic.avif && <source type="image/avif" srcset={pic.avif} sizes={pic.sizes} />}
              {pic.webp && <source type="image/webp" srcset={pic.webp} sizes={pic.sizes} />}
              <img
                src={pic.src}
                alt={slide.alt}
                width="1280"
                height="720"
                decoding="async"
                fetchpriority={eager ? 'high' : 'low'}
                loading={eager ? 'eager' : 'lazy'}
              />
            </picture>
            <div class="e5-banner-overlay"></div>
            <div class="e5-banner-copy">
              {slide.kicker && <p class="e5-banner-kicker">{slide.kicker}</p>}
              <h2 class="e5-banner-title">{slide.title}</h2>
              {slide.code && (
                <p class="e5-banner-code" aria-label={`Promo code ${slide.code}`}>
                  {slide.code}
                </p>
              )}
              {slide.body && (
                <p class:list={['e5-banner-body', slide.emphasize && 'is-emphasis']}>{slide.body}</p>
              )}
              <div class="e5-banner-cta">
                <CtaLink
                  primary
                  href={slide.href}
                  data-gtm-event="home_banner"
                  data-gtm-label={slide.gtm}
                >
                  {slide.cta}
                </CtaLink>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <button type="button" class="e5-banner-arrow e5-banner-arrow--prev" data-prev aria-label="Previous slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M11.5 3.5 6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="e5-banner-arrow e5-banner-arrow--next" data-next aria-label="Next slide">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M6.5 3.5 12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="e5-banner-dots" role="tablist" aria-label="Choose slide">
    {slides.map((slide, index) => (
      <button
        type="button"
        class:list={['e5-banner-dot', index === 0 && 'is-active']}
        data-dot={index}
        aria-label={`Go to slide ${index + 1}: ${slide.title}`}
        aria-current={index === 0 ? 'true' : 'false'}
      />
    ))}
  </div>
  <p class="sr-only" data-live aria-live="polite">Slide 1 of {slides.length}</p>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById('e5-banner');
    if (!root) return;
    var track = root.querySelector('.e5-banner-track');
    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-dot]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var live = root.querySelector('[data-live]');
    if (!track || !slides.length) return;
    var n = slides.length;
    var i = 0;
    var timer = null;
    var paused = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function paint(idx) {
      i = ((idx % n) + n) % n;
      track.style.transform = 'translate3d(' + (-i * 100) + '%,0,0)';
      for (var s = 0; s < n; s++) {
        var hidden = s !== i;
        slides[s].setAttribute('aria-hidden', hidden ? 'true' : 'false');
        if (hidden) slides[s].setAttribute('inert', '');
        else slides[s].removeAttribute('inert');
        dots[s].setAttribute('aria-current', s === i ? 'true' : 'false');
        dots[s].classList.toggle('is-active', s === i);
      }
      if (live) live.textContent = 'Slide ' + (i + 1) + ' of ' + n;
    }

    function go(idx, fromUser) {
      paint(idx);
      if (fromUser) restart();
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      if (reduce || paused) return;
      stop();
      timer = setInterval(function () { go(i + 1, false); }, 6000);
    }

    function restart() {
      stop();
      start();
    }

    function pause() {
      paused = true;
      stop();
    }

    function resume() {
      paused = false;
      start();
    }

    prev.addEventListener('click', function () { go(i - 1, true); });
    next.addEventListener('click', function () { go(i + 1, true); });
    for (var d = 0; d < dots.length; d++) {
      (function (idx) {
        dots[idx].addEventListener('click', function () { go(idx, true); });
      })(d);
    }

    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', function (e) {
      if (!root.contains(e.relatedTarget)) resume();
    });
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1, true); }
    });

    var startX = 0;
    var dx = 0;
    var swiping = false;
    root.addEventListener('pointerdown', function (e) {
      if (e.target.closest('a, button')) return;
      swiping = true;
      startX = e.clientX;
      dx = 0;
    });
    root.addEventListener('pointermove', function (e) {
      if (!swiping) return;
      dx = e.clientX - startX;
    });
    function endSwipe() {
      if (!swiping) return;
      swiping = false;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1), true);
    }
    root.addEventListener('pointerup', endSwipe);
    root.addEventListener('pointercancel', endSwipe);

    paint(0);
    start();
  })();
</script>

<style>
  .e5-banner {
    position: relative;
    width: 100%;
    margin-top: 107px;
    height: 754px;
    min-height: 420px;
    max-height: calc(100svh - 107px);
    overflow: hidden;
    background: #111;
    color: #fff;
    outline: none;
  }
  .e5-banner:focus-visible {
    box-shadow: inset 0 0 0 3px #d31d25;
  }
  .e5-banner-viewport,
  .e5-banner-track,
  .e5-banner-slide {
    width: 100%;
    height: 100%;
  }
  .e5-banner-viewport {
    overflow: hidden;
  }
  .e5-banner-track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }
  .e5-banner-slide {
    position: relative;
    flex: 0 0 100%;
  }
  .e5-banner-picture,
  .e5-banner-picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .e5-banner-picture img {
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  .e5-banner-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.5) 36%, rgba(0, 0, 0, 0.18) 68%, rgba(0, 0, 0, 0.42) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, transparent 34%, rgba(0, 0, 0, 0.55) 100%);
  }
  .e5-banner-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
    max-width: 760px;
    padding: 32px 88px 72px 80px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }
  .e5-banner-kicker {
    margin: 0 0 10px;
    font-family: 'Franklin Gothic Demi', sans-serif;
    font-size: 13px;
    letter-spacing: 4.2px;
    color: #fff;
  }
  .e5-banner-title {
    margin: 0;
    font-family: 'Franklin Gothic Heavy', sans-serif;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 0.95;
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
  }
  .e5-banner-code {
    margin: 18px 0 0;
    display: inline-block;
    padding: 10px 16px;
    border: 2px solid #d31d25;
    background: rgba(211, 29, 37, 0.92);
    color: #fff;
    font-family: 'Franklin Gothic Heavy', sans-serif;
    font-size: clamp(22px, 3.4vw, 36px);
    letter-spacing: 2px;
    line-height: 1;
    text-shadow: none;
  }
  .e5-banner-body {
    margin: 16px 0 0;
    max-width: 34rem;
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.35;
    color: #fff;
  }
  .e5-banner-body.is-emphasis {
    font-family: 'Franklin Gothic Heavy', sans-serif;
    font-size: clamp(18px, 2.4vw, 28px);
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .e5-banner-cta {
    margin-top: 28px;
  }
  .e5-banner-arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .e5-banner-arrow:hover,
  .e5-banner-arrow:focus-visible {
    background: #d31d25;
  }
  .e5-banner-arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .e5-banner-arrow--prev { left: 12px; }
  .e5-banner-arrow--next { right: 12px; }
  .e5-banner-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .e5-banner-dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
  }
  .e5-banner-dot.is-active {
    background: #d31d25;
    transform: scale(1.15);
  }
  .e5-banner-dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .e5-banner-copy {
      justify-content: flex-end;
      padding: 20px 56px 64px 20px;
    }
    .e5-banner-overlay {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.35) 40%, rgba(0, 0, 0, 0.82) 100%);
    }
    .e5-banner-cta {
      margin-top: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .e5-banner-track {
      transition: none;
    }
  }
</style>
