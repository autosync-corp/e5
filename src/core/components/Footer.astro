---
import {
  E5_LOGO_BLACK_PNG,
  PHONE_BLACK_ICON,
  PIN_BLACK_ICON,
} from '@/core/constants/App.ts';
import { loadSiteNav, navFingerprint, visibleFooter } from '@/core/portal/nav.ts';
import { LOGO_SRCSET, SOCIAL_SRC } from '@/core/utils/responsiveSrc';

const year = new Date().getFullYear();
const { nav } = await loadSiteNav();
const footer = visibleFooter(nav.footer);
const fingerprint = navFingerprint(nav);
const colCount = footer.columns.length + (footer.contact ? 1 : 0);
const pinIcon = PIN_BLACK_ICON;
const phoneIcon = PHONE_BLACK_ICON;
---
<footer
  class="site-footer"
  data-site-nav
  data-fp={fingerprint}
  data-nav-api="/api/site-nav"
  data-pin={pinIcon}
  data-phone={phoneIcon}
>
  <div class="ft">
    <div class="vossen-top">
      <div class="ft-socials" data-ft-socials>
        {footer.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="ft-social">
            <img src={SOCIAL_SRC[s.src] || s.src} alt={s.alt} width="48" height="48" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
      <img src={E5_LOGO_BLACK_PNG} srcset={LOGO_SRCSET[E5_LOGO_BLACK_PNG]} sizes="(max-width: 767px) 283px, 330px" alt="E5 Wheels" class="ft-logo" width="1191" height="101" loading="lazy" decoding="async" />
      {footer.cta ? (
        <a href={footer.cta.href} class="ft-cta" data-ft-cta>{footer.cta.label}</a>
      ) : (
        <span class="ft-cta is-empty" data-ft-cta hidden></span>
      )}
    </div>

    <nav class="col-grid" aria-label="Footer" data-ft-cols style={`grid-template-columns: repeat(${Math.max(colCount, 1)}, minmax(0, 1fr))`}>
      {footer.columns.map((col) => (
        <div class="col">
          <p class="ft-label">{col.heading}</p>
          {col.links.map((link) => <a href={link.href} class="ft-link">{link.label}</a>)}
        </div>
      ))}
      {footer.contact && (
        <div class="col" data-ft-contact>
          <p class="ft-label">Contact</p>
          <a href={footer.contact.addressHref} target="_blank" rel="noopener noreferrer" class="ft-contact">
            <img src={PIN_BLACK_ICON} alt="" class="ft-icon ft-pin" width="22" height="22" loading="lazy" decoding="async" />
            <span set:html={footer.contact.addressLines.map((line) => line.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />')} />
          </a>
          <a href={footer.contact.phoneHref} class="ft-link ft-icon-link">
            <img src={PHONE_BLACK_ICON} alt="" class="ft-icon" width="22" height="22" loading="lazy" decoding="async" />
            {footer.contact.phoneLabel}
          </a>
          <a href={footer.contact.emailHref} class="ft-link">{footer.contact.emailLabel}</a>
        </div>
      )}
    </nav>

    <nav class="acc-nav" aria-label="Footer" data-footer-acc>
      {footer.columns.map((col) => (
        <details class="acc">
          <summary class="ft-label">{col.heading}</summary>
          {col.links.map((link) => <a href={link.href} class="ft-link">{link.label}</a>)}
        </details>
      ))}
      {footer.contact && (
        <details class="acc" data-contact>
          <summary class="ft-label">Contact</summary>
          <div class="acc-contact">
            <a href={footer.contact.addressHref} target="_blank" rel="noopener noreferrer" class="ft-contact">
              <img src={PIN_BLACK_ICON} alt="" class="ft-icon ft-pin" width="22" height="22" loading="lazy" decoding="async" />
              <span set:html={footer.contact.addressLines.map((line) => line.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />')} />
            </a>
            <a href={footer.contact.phoneHref} class="ft-link ft-icon-link">
              <img src={PHONE_BLACK_ICON} alt="" class="ft-icon" width="22" height="22" loading="lazy" decoding="async" />
              {footer.contact.phoneLabel}
            </a>
            <a href={footer.contact.emailHref} class="ft-link">{footer.contact.emailLabel}</a>
          </div>
        </details>
      )}
    </nav>

    <div class="legal">
      <span data-ft-legal>
        {footer.legal.map((link, i) => (
          <span>
            {i > 0 && <span aria-hidden="true">|</span>}
            <a href={link.href} class="ft-legal">{link.label}</a>
          </span>
        ))}
      </span>
      <span class="ft-copy">&copy; {year} COPYRIGHT E5 WHEELS, LLC</span>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-site-nav]');
    if (!root) return;
    var api = root.getAttribute('data-nav-api') || '/api/site-nav';
    var fp = root.getAttribute('data-fp') || '';
    var pin = root.getAttribute('data-pin') || '';
    var phone = root.getAttribute('data-phone') || '';

    function esc(value) {
      return String(value || '').replace(/[&<>"']/g, function (ch) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
      });
    }

    function contactHtml(contact, accordion) {
      if (!contact) return '';
      var lines = (contact.addressLines || []).map(esc).join('<br />');
      var inner =
        '<a href="' + esc(contact.addressHref) + '" target="_blank" rel="noopener noreferrer" class="ft-contact">' +
        '<img src="' + esc(pin) + '" alt="" class="ft-icon ft-pin" width="22" height="22" loading="lazy" decoding="async" />' +
        '<span>' + lines + '</span></a>' +
        '<a href="' + esc(contact.phoneHref) + '" class="ft-link ft-icon-link">' +
        '<img src="' + esc(phone) + '" alt="" class="ft-icon" width="22" height="22" loading="lazy" decoding="async" />' +
        esc(contact.phoneLabel) + '</a>' +
        '<a href="' + esc(contact.emailHref) + '" class="ft-link">' + esc(contact.emailLabel) + '</a>';
      if (accordion) {
        return '<details class="acc" data-contact><summary class="ft-label">Contact</summary><div class="acc-contact">' + inner + '</div></details>';
      }
      return '<div class="col" data-ft-contact><p class="ft-label">Contact</p>' + inner + '</div>';
    }

    fetch(api)
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (!data || data.fingerprint === fp || !data.footer) return;
        var footer = data.footer;
        var socials = root.querySelector('[data-ft-socials]');
        if (socials) {
          socials.innerHTML = (footer.socials || []).map(function (s) {
            return '<a href="' + esc(s.href) + '" target="_blank" rel="noopener" aria-label="' + esc(s.label) + '" class="ft-social">' +
              '<img src="' + esc(s.src) + '" alt="' + esc(s.alt) + '" width="48" height="48" loading="lazy" decoding="async" /></a>';
          }).join('');
        }
        var cta = root.querySelector('[data-ft-cta]');
        if (cta) {
          if (footer.cta) {
            cta.hidden = false;
            cta.classList.remove('is-empty');
            cta.setAttribute('href', footer.cta.href);
            cta.textContent = footer.cta.label;
          } else {
            cta.hidden = true;
            cta.textContent = '';
          }
        }
        var cols = root.querySelector('[data-ft-cols]');
        if (cols) {
          var n = (footer.columns || []).length + (footer.contact ? 1 : 0);
          cols.style.gridTemplateColumns = 'repeat(' + Math.max(n, 1) + ', minmax(0, 1fr))';
          cols.innerHTML = (footer.columns || []).map(function (col) {
            return '<div class="col"><p class="ft-label">' + esc(col.heading) + '</p>' +
              (col.links || []).map(function (link) {
                return '<a href="' + esc(link.href) + '" class="ft-link">' + esc(link.label) + '</a>';
              }).join('') + '</div>';
          }).join('') + contactHtml(footer.contact, false);
        }
        var acc = root.querySelector('[data-footer-acc]');
        if (acc) {
          acc.innerHTML = (footer.columns || []).map(function (col) {
            return '<details class="acc"><summary class="ft-label">' + esc(col.heading) + '</summary>' +
              (col.links || []).map(function (link) {
                return '<a href="' + esc(link.href) + '" class="ft-link">' + esc(link.label) + '</a>';
              }).join('') + '</details>';
          }).join('') + contactHtml(footer.contact, true);
        }
        var legal = root.querySelector('[data-ft-legal]');
        if (legal) {
          legal.innerHTML = (footer.legal || []).map(function (link, i) {
            return (i ? '<span aria-hidden="true">|</span>' : '') +
              '<a href="' + esc(link.href) + '" class="ft-legal">' + esc(link.label) + '</a>';
          }).join('');
        }
      })
      .catch(function () {});
  })();
</script>

<style>
.site-footer {
  background-color: #ffffff;
  color: #141414;
  width: 100%;
  border-top: 1px solid #e6e6e6;
  font-family: Oswald, 'Franklin Gothic Demi', sans-serif;
  font-weight: 500;
  color-scheme: only light;
}

.ft {
  max-width: 1280px;
  margin: 0 auto;
  padding: 40px 32px 20px;
}

.ft-logo {
  display: block;
  height: 28px;
  width: calc(28px * 1191 / 101);
  max-width: 100%;
  min-width: 0;
  aspect-ratio: 1191 / 101;
  object-fit: contain;
  object-position: center;
  flex: 0 0 auto;
}

.ft-link,
.ft-legal,
.ft-contact {
  color: #141414;
  text-decoration: none;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.ft-link {
  display: flex;
  align-items: center;
  min-height: 30px;
  font-size: 13px;
  line-height: 1.25;
}

.ft-link:hover,
.ft-link:focus-visible,
.ft-legal:hover,
.ft-legal:focus-visible,
.ft-contact:hover,
.ft-contact:focus-visible {
  color: var(--color-e5-red);
}

.ft-legal {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: 12px;
}

.ft-contact {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-height: 44px;
  font-size: 13px;
  line-height: 1.4;
  margin: 4px 0 8px;
}

.ft-icon {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  flex: 0 0 auto;
}

.ft-pin {
  transform: rotate(180deg) scaleY(-1);
}

.ft-icon-link {
  gap: 10px;
}

.ft-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 20px;
  background: transparent;
  color: #141414;
  border: 1px solid #141414;
  font-size: 13px;
  letter-spacing: 0.14em;
  text-decoration: none;
  text-transform: uppercase;
  width: fit-content;
  justify-self: end;
}

.ft-cta:hover,
.ft-cta:focus-visible {
  background: var(--color-e5-red);
  border-color: var(--color-e5-red);
  color: #ffffff;
}

.ft-socials {
  display: flex;
  align-items: center;
  gap: 4px;
}

.ft-social {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}

.ft-social img {
  width: 28px;
  height: 28px;
}

.ft-copy {
  font-size: 12px;
  letter-spacing: 0.08em;
  color: #333333;
}

.ft-label {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #4a4a4a;
  min-height: 28px;
  display: flex;
  align-items: center;
  margin: 0 0 8px;
}

.col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.col-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px 40px;
}

.acc-nav {
  display: none;
}

.vossen-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 16px;
  padding-bottom: 22px;
  margin-bottom: 8px;
  border-bottom: 1px solid #e6e6e6;
}

.legal {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8px 14px;
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid #e6e6e6;
}

/* Mobile only. Tablet 768–1023 keeps the desktop C layout. */
@media (max-width: 767px) {
  .ft {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 16px 8px;
  }

  .col-grid {
    display: none;
  }

  .vossen-top {
    display: contents;
  }

  .ft-logo {
    order: 1;
    height: 24px;
    width: calc(24px * 1191 / 101);
    margin: 4px 0 8px;
  }

  .ft-cta {
    order: 2;
    margin: 0 0 8px;
    justify-self: center;
  }

  .acc-nav {
    display: block;
    order: 3;
    width: 100%;
    border-top: 1px solid #e6e6e6;
  }

  .legal {
    order: 4;
    width: 100%;
    gap: 0 10px;
    margin-top: 12px;
    padding-top: 0;
    border-top: 0;
  }

  .ft-socials {
    order: 5;
    margin-top: 8px;
  }

  .ft-label {
    margin: 0;
  }

  .acc {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid #e6e6e6;
  }

  .acc .ft-label {
    list-style: none;
    height: 44px;
    min-height: 44px;
    padding: 0;
    margin: 0;
    cursor: pointer;
    box-sizing: border-box;
  }

  .acc .ft-label::-webkit-details-marker {
    display: none;
  }

  .acc .ft-link {
    min-height: 44px;
    padding: 0 2px;
  }

  .acc-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 2px 8px;
  }

  .acc-contact .ft-contact,
  .acc-contact .ft-link {
    position: relative;
    margin: 0;
    min-height: 0;
    padding: 2px 0;
  }

  .acc-contact .ft-contact {
    line-height: 1.25;
    gap: 8px;
  }

  .acc-contact .ft-contact::after,
  .acc-contact .ft-link::after {
    content: '';
    position: absolute;
    left: -8px;
    right: -8px;
    top: 50%;
    height: 44px;
    transform: translateY(-50%);
  }

  .legal .ft-legal {
    min-height: 44px;
  }

  .ft-copy {
    flex-basis: 100%;
    text-align: center;
    padding: 4px 0 0;
  }
}
</style>
