---
interface Props {
  title: string;
  years?: string;
  class?: string;
}

const { title, years, class: className } = Astro.props;

const eyebrowClass =
  "block whitespace-nowrap text-[13px] md:text-[15px] lg:text-[16px] tracking-[2.8px] md:tracking-[3.4px] lg:tracking-[4px] leading-[18px] md:leading-[20px] text-black uppercase mb-3 md:mb-4 font-['Franklin_Gothic_Heavy']";
---

<h1 class:list={[className, 'flex flex-col items-center']}>
  {years && <span class={eyebrowClass}>{years}</span>}
  <span class="block">{title}</span>
</h1>
