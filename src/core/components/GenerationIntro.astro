---
import {
  DAYTONA_TITANIUM_BRUSHED_TINT,
  SEBRING_TITANIUM_BRUSHED,
  SPEEDWAY_TITANIUM_BRUSHED,
  TALLADEGA_BRUSHED_ALUMINUM,
  SONOMA_BRUSHED_ALUMINUM,
  SEBRING_2P_TITANIUM_BRUSHED,
} from '@/pages/wheels/constants/Wheels.ts';

export interface HeadingPart {
  label: string;
  href?: string;
}

export interface FitmentGroup {
  heading: string;
  headingHref?: string;
  headingParts?: HeadingPart[];
  front: string;
  rear: string;
  note?: string;
}

export interface StyleLink {
  href: string;
  label: string;
}

interface StyleCardImage {
  src: string;
  alt: string;
}

interface Props {
  lead: string;
  groups: FitmentGroup[];
  styles: StyleLink[];
  finishes: string;
  linkClass?: string;
  bodyClass: string;
  wrapperClass?: string;
  application?: string;
}

const STYLE_IMAGES: Record<string, StyleCardImage> = {
  Daytona: {
    src: DAYTONA_TITANIUM_BRUSHED_TINT,
    alt: 'Daytona Titanium Brushed Tint',
  },
  Sebring: {
    src: SEBRING_TITANIUM_BRUSHED,
    alt: 'Sebring Titanium Brushed Tint',
  },
  Speedway: {
    src: SPEEDWAY_TITANIUM_BRUSHED,
    alt: 'Speedway Titanium Brushed Tint',
  },
  Talladega: {
    src: TALLADEGA_BRUSHED_ALUMINUM,
    alt: 'Talladega Brushed Aluminum',
  },
  Sonoma: {
    src: SONOMA_BRUSHED_ALUMINUM,
    alt: 'Sonoma Brushed Aluminum',
  },
  'Sebring 2P': {
    src: SEBRING_2P_TITANIUM_BRUSHED,
    alt: 'Sebring 2P Titanium Brushed',
  },
};

const {
  lead,
  groups,
  styles,
  finishes,
  linkClass = 'text-e5-red hover:opacity-80 transition-opacity',
  bodyClass,
  wrapperClass = 'max-w-[1536px] mx-auto px-4 mb-8',
  application,
} = Astro.props;

const cardGridClass =
  styles.length >= 5
    ? 'grid grid-cols-3 sm:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-5'
    : styles.length === 1
      ? 'grid grid-cols-1 max-w-[175px] mx-auto'
      : styles.length === 2
        ? 'grid grid-cols-2 max-w-[400px] mx-auto gap-3 md:gap-5'
        : 'grid grid-cols-3 max-w-[525px] md:max-w-[650px] mx-auto gap-3 md:gap-5';

const groupGridClass =
  groups.length >= 3
    ? 'grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8 mb-6 md:mb-8'
    : groups.length === 2
      ? 'grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-6 md:mb-8'
      : 'grid grid-cols-1 gap-6 mb-6 md:mb-8';

const headingClass =
  "text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[22px] text-black uppercase mb-3 font-['Franklin_Gothic_Heavy']";

const styleNameClass = `font-['Franklin_Gothic_Heavy'] ${linkClass}`;

function styleSeparator(index: number, length: number): string {
  if (index === 0) return '';
  if (index === length - 1) return length > 2 ? ', and ' : ' and ';
  return ', ';
}

function splitFitment(line: string): { label: string; value: string } {
  const match = line.match(/^(Front|Rear)\s+(.+)$/);
  if (!match) return { label: '', value: line };
  return { label: match[1], value: match[2] };
}
---

<div class:list={[bodyClass, wrapperClass, 'text-center']}>
  <p class="mb-6 md:mb-8">{lead}</p>

  <div class={groupGridClass}>
    {groups.map((group) => (
      <section class="min-w-0">
        <h2 class={headingClass}>{group.headingParts && group.headingParts.length > 0
          ? group.headingParts.map((part) => part.href ? <a href={part.href} class={linkClass}>{part.label}</a> : <span>{part.label}</span>)
          : group.headingHref
            ? <a href={group.headingHref} class={linkClass}>{group.heading}</a>
            : group.heading}</h2>
        <dl class="space-y-1">
          {[group.front, group.rear].map((line) => {
            const { label, value } = splitFitment(line);
            return (
              <div>
                <dt class={label ? "inline font-['Franklin_Gothic_Heavy']" : 'sr-only'}>{label || 'Size'}</dt>
                <dd class:list={[label && 'inline', "font-['Franklin_Gothic_Heavy']"]}>
                  {label ? ` ${value}` : value}
                </dd>
              </div>
            );
          })}
        </dl>
        {group.note && (
          <p class="mt-2 text-[15px] md:text-[17px] lg:text-[19px] tracking-[0px] leading-[22px] md:leading-[26px] text-black/50">
            {group.note}
          </p>
        )}
      </section>
    ))}
  </div>

  <p class="mb-3 md:mb-4">
    <span class="font-['Franklin_Gothic_Demi']">Styles:</span>{' '}{styles.map((style, index) => (
      <Fragment>{styleSeparator(index, styles.length)}<a href={style.href} class={styleNameClass}>{style.label}</a></Fragment>
    ))}
  </p>
  <p class="mb-3 md:mb-4">{finishes}</p>
  <p class="mb-6 md:mb-8">
    <slot name="see" />
  </p>
  {application && (
    <ul class:list={[cardGridClass, 'mt-2']}>
      {styles.map((style) => (
        <li>
          <a href={style.href} class="flex flex-col items-center hover:opacity-80 transition-opacity">
            {STYLE_IMAGES[style.label] && (
              <div class="w-full max-w-[120px] md:max-w-[160px] aspect-square mb-2">
                <img src={STYLE_IMAGES[style.label].src} alt={STYLE_IMAGES[style.label].alt} class="w-full h-full object-contain" width="160" height="160" />
              </div>
            )}
            <p class="text-[14px] md:text-[16px] tracking-[1.4px] md:tracking-[2px] leading-[18px] md:leading-[20px] text-black uppercase mb-1 font-['Franklin_Gothic_Heavy']">{style.label}</p>
            <p class="text-[13px] md:text-[15px] tracking-[0.3px] leading-[17px] md:leading-[19px] text-black/50 mb-1">{application}</p>
            <p class="text-[12px] md:text-[14px] tracking-[0.6px] md:tracking-[1.4px] leading-[16px] md:leading-[18px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] whitespace-nowrap">Free Shipping</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
