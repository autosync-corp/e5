---
import {
  DAYTONA_BRONZE_BRUSHED_TINT,
  SEBRING_BRONZE,
  SPEEDWAY_BRONZE,
  TALLADEGA_PODIUM_BRONZE,
  SONOMA_BRUSHED_ALUMINUM,
  SEBRING_2P_DARK_BRONZE,
} from '@/pages/wheels/constants/Wheels.ts';

export interface HeadingPart {
  label: string;
  href?: string;
}

export interface FitmentGroup {
  heading: string;
  headingHref?: string;
  headingParts?: HeadingPart[];
  front: string;
  rear: string;
  note?: string;
}

export interface StyleLink {
  href: string;
  label: string;
}

interface StyleCardImage {
  src: string;
  alt: string;
}

interface Props {
  lead: string;
  groups: FitmentGroup[];
  styles: StyleLink[];
  finishes: string;
  linkClass?: string;
  bodyClass: string;
  wrapperClass?: string;
  application?: string;
}

const STYLE_IMAGES: Record<string, StyleCardImage> = {
  Daytona: {
    src: DAYTONA_BRONZE_BRUSHED_TINT,
    alt: 'Daytona Bronze Brushed Tint',
  },
  Sebring: {
    src: SEBRING_BRONZE,
    alt: 'Sebring Bronze Brushed Tint',
  },
  Speedway: {
    src: SPEEDWAY_BRONZE,
    alt: 'Speedway Dark Bronze',
  },
  Talladega: {
    src: TALLADEGA_PODIUM_BRONZE,
    alt: 'Talladega Podium Bronze',
  },
  Sonoma: {
    src: SONOMA_BRUSHED_ALUMINUM,
    alt: 'Sonoma Brushed Aluminum',
  },
  'Sebring 2P': {
    src: SEBRING_2P_DARK_BRONZE,
    alt: 'Sebring 2P Dark Bronze',
  },
};

const {
  lead,
  groups,
  styles,
  finishes,
  linkClass = 'text-e5-red hover:opacity-80 transition-opacity',
  application,
} = Astro.props;

const groupGridClass =
  groups.length >= 3
    ? 'grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-5 lg:gap-8'
    : groups.length === 2
      ? 'grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 lg:gap-16'
      : 'grid grid-cols-1 gap-6 max-w-[420px] mx-auto';

const headingClass =
  "text-[12px] md:text-[13px] lg:text-[14px] tracking-[2.2px] md:tracking-[2.6px] lg:tracking-[3px] leading-[18px] text-black uppercase mb-2 md:mb-3 font-['Franklin_Gothic_Heavy']";

const sizeClass =
  "text-[16px] md:text-[18px] lg:text-[21px] tracking-[0px] leading-[22px] md:leading-[24px] lg:leading-[28px] text-black font-['Franklin_Gothic_Heavy']";
---

<div class="max-w-[1000px] mx-auto mb-8 md:mb-10 text-center text-black/70">
  <p class="mb-8 md:mb-10 text-[16px] md:text-[18px] lg:text-[20px] font-normal tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px]">
    {lead}
  </p>

  <div class:list={[groupGridClass, 'mb-8 md:mb-10 lg:mb-12']}>
    {groups.map((group) => (
      <section class="min-w-0">
        <h2 class={headingClass}>{group.headingParts && group.headingParts.length > 0
          ? group.headingParts.map((part) => part.href ? <a href={part.href} class={linkClass}>{part.label}</a> : <span>{part.label}</span>)
          : group.headingHref
            ? <a href={group.headingHref} class={linkClass}>{group.heading}</a>
            : group.heading}</h2>
        <dl class="space-y-0.5">
          <div>
            <dt class="sr-only">Front</dt>
            <dd class={sizeClass}>{group.front}</dd>
          </div>
          <div>
            <dt class="sr-only">Rear</dt>
            <dd class={sizeClass}>{group.rear}</dd>
          </div>
        </dl>
        {group.note && (
          <p class="mt-1.5 text-[13px] md:text-[14px] leading-[18px] text-black/50">
            {group.note}
          </p>
        )}
      </section>
    ))}
  </div>

  {application && (
    <ul class="flex flex-wrap justify-center gap-x-2 gap-y-8 md:gap-x-12 md:gap-y-10 lg:gap-x-24 lg:gap-y-12 mb-8 md:mb-10 lg:mb-12">
      {styles.map((style) => (
        <li class="w-[calc((100%-0.5rem*2)/3)] md:w-[190px] min-w-0">
          <a href={style.href} class="flex flex-col items-center hover:opacity-80 transition-opacity">
            {STYLE_IMAGES[style.label] && (
              <div class="w-full aspect-square mb-3 md:mb-4">
                <img src={STYLE_IMAGES[style.label].src} alt={STYLE_IMAGES[style.label].alt} class="w-full h-full object-contain" width="190" height="190" />
              </div>
            )}
            <p class="text-[11px] md:text-[14px] lg:text-[15px] tracking-[1.2px] md:tracking-[2.4px] lg:tracking-[2.8px] leading-[14px] md:leading-[18px] text-black uppercase mb-1 font-['Franklin_Gothic_Heavy']">{style.label}</p>
            <p class="text-[10px] md:text-[13px] lg:text-[14px] tracking-[0.1px] leading-[13px] md:leading-[18px] text-black/50 mb-1 md:whitespace-nowrap">{application}</p>
            <p class="text-[10px] md:text-[12px] lg:text-[13px] tracking-[1.2px] md:tracking-[2.4px] leading-[14px] md:leading-[16px] text-e5-red uppercase font-['Franklin_Gothic_Heavy'] whitespace-nowrap">Free Shipping</p>
          </a>
        </li>
      ))}
    </ul>
  )}

  <p class="mb-8 md:mb-10 text-[16px] md:text-[18px] lg:text-[20px] font-normal tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] lg:whitespace-nowrap">
    {finishes}
  </p>
  <p class="text-[16px] md:text-[18px] lg:text-[20px] font-normal tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] [&_a]:underline [&_a]:underline-offset-[6px] [&_a]:decoration-black/30">
    <slot name="see" />
  </p>
</div>
