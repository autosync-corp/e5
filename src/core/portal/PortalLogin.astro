---
import '@/assets/fonts/fonts.css';
import { E5_LOGO_BLACK_PNG } from '@/core/constants/App.ts';

interface Props {
  error?: string;
  action: string;
  disabled?: boolean;
}

const { error = '', action, disabled = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light only" />
    <title>E5 Client Portal</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        min-height: 100vh;
        background: #fff;
        color: #141414;
        font-family: 'Franklin Gothic Book', Arial, sans-serif;
      }
      .wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .box { width: 100%; max-width: 380px; }
      img { height: 28px; width: auto; display: block; margin: 0 auto 10px; }
      .kicker {
        text-align: center;
        font-family: 'Franklin Gothic Heavy', sans-serif;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-size: 12px;
        color: #333;
        margin-bottom: 28px;
      }
      label { display: block; font-size: 13px; color: #333; margin-bottom: 6px; }
      input {
        width: 100%;
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        padding: 12px 14px;
        font-size: 16px;
        margin-bottom: 16px;
        font-family: inherit;
      }
      input:focus { outline: 2px solid #141414; outline-offset: 1px; }
      input:disabled { background: #f5f5f5; }
      button {
        width: 100%;
        background: #d31d25;
        color: #fff;
        border: none;
        padding: 12px;
        border-radius: 4px;
        font-size: 14px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-family: 'Franklin Gothic Demi', sans-serif;
        cursor: pointer;
      }
      button:hover { background: #b3181f; }
      button:disabled { background: #aaa; cursor: not-allowed; }
      .err { color: #d31d25; font-size: 13px; margin-bottom: 12px; min-height: 1.2em; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="box">
        <img src={E5_LOGO_BLACK_PNG} alt="E5 Wheels" width="140" height="28" />
        <p class="kicker">Client Portal</p>
        <form method="POST" action={action}>
          <label for="password">Password</label>
          <input id="password" type="password" name="password" autocomplete="current-password" autofocus disabled={disabled} />
          {error ? <p class="err">{error}</p> : null}
          <button type="submit" disabled={disabled}>Log in</button>
        </form>
      </div>
    </div>
  </body>
</html>
