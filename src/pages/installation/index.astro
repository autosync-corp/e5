---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="E5 Wheels - Installation Instructions">
  <div class="w-full bg-white">
    <!-- Hero Section with Background Image -->
    <section class="w-full relative min-h-[600px] bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/images/installation/0bff205390134dea2d6ae15265d1cb4fc9a10a4e.png');">
      <!-- Dark overlay for text visibility -->
      <div class="absolute inset-0 bg-black/40"></div>

      <!-- Content -->
      <div class="relative z-10 max-w-[1536px] mx-auto px-24 py-32 text-center">
        <h1 class="text-[72px] font-franklin-heavy tracking-[7.2px] uppercase mb-6 leading-[1.2] text-white drop-shadow-lg">
          E5 WHEELS INSTALLATION GUIDE
        </h1>
        <p class="text-[32px] font-excon text-white/90 leading-[40px] drop-shadow-md">
          Corvette Specific Installation Instructions (C5 - C8)
        </p>
      </div>
    </section>

    <!-- Important Safety Notice -->
    <section class="w-full bg-[#FFC107] py-8">
      <div class="max-w-[1300px] mx-auto px-6 text-center">
        <h2 class="text-[28px] font-franklin-demi tracking-[5.6px] uppercase text-black mb-4 leading-tight">
          IMPORTANT SAFETY NOTICE
        </h2>
        <p class="text-[20px] font-franklin-book text-black/80 leading-[28px] max-w-[1100px] mx-auto">
          Professional Installation is highly recommended. Improper installation can result in wheel damage, loss of control, or serious injury. Always follow torque specifications and safety procedures.
        </p>
      </div>
    </section>

    <!-- Corvette Wheel Specifications -->
    <section class="py-20">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red text-center mb-16 tracking-[8px] uppercase leading-tight">
          CORVETTE WHEEL SPECIFICATIONS
        </h2>

        <div class="overflow-x-auto">
          <!-- Table -->
          <div class="min-w-[1200px]">
            <!-- Header Row -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6 flex items-center justify-center">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[54px]">SPECIFICATION</p>
              </div>
              <div class="bg-[#d31d25]/55 p-6 text-center">
                <p class="text-[32px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">C5</p>
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">(1997 - 2004)</p>
              </div>
              <div class="bg-black/25 p-6 text-center">
                <p class="text-[32px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">C6</p>
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">(2005 - 2013)</p>
              </div>
              <div class="bg-black/25 p-6 text-center">
                <p class="text-[32px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">C7</p>
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">(2014 - 2019)</p>
              </div>
              <div class="bg-black/25 p-6 text-center">
                <p class="text-[32px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">C8</p>
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.6px] leading-[30px]">(2020+)</p>
              </div>
            </div>

            <!-- Lug Nut Thread Size -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">LUG NUT<br/>THREAD SIZE</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">M12 x 1.5</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">M12 x 1.5</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">M12 x 1.5</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">M14 x 1.5</p>
              </div>
            </div>

            <!-- Lug Nut Seat Type -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">LUG NUT<br/>SEAT TYPE</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">CONICAL (60°)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">CONICAL (60°)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">CONICAL (60°)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">CONICAL (60°)</p>
              </div>
            </div>

            <!-- Socket Size -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">SOCKET SIZE</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">19mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">19mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">19mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">21mm</p>
              </div>
            </div>

            <!-- Number of Lugs -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">NUMBER OF LUGS</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">5 BOLT<br/>(5x120.7mm)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">5 BOLT<br/>(5x120.7mm)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">5 BOLT<br/>(5x120.65mm)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">5 BOLT<br/>(5x120.65mm)</p>
              </div>
            </div>

            <!-- Rec. Torque -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">REC.<br/>TORQUE</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">100 ft-lbs</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">100 ft-lbs</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">100 ft-lbs</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">129 ft-lbs</p>
              </div>
            </div>

            <!-- Hub Bore -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">HUB<br/>BORE</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">70.3mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">70.3mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">70.3mm</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[54px]">70.3mm</p>
              </div>
            </div>

            <!-- TPMS -->
            <div class="grid grid-cols-5 gap-0">
              <div class="bg-[#d9d9d9]/25 p-6">
                <p class="text-[27px] font-['Franklin_Gothic_Demi'] tracking-[1.35px] opacity-70 leading-[30px]">TPMS</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">NOT FACTORY<br/>OPTION</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">STANDARD<br/>(315MHz)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">STANDARD<br/>(315MHz)</p>
              </div>
              <div class="bg-black/10 p-6 text-center">
                <p class="text-[27px] font-['Franklin_Gothic_Book'] tracking-[1.35px] leading-[30px]">STANDARD<br/>(315MHz)</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Required Tools & Materials -->
    <section class="w-full bg-e5-black py-16">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red mb-10 tracking-[8px] uppercase leading-tight">REQUIRED TOOLS & MATERIALS</h2>
        <div class="space-y-3">
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• TORQUE WRENCH - Calibrated to 100ft-lbs (C5-C7), 129ft-lbs (C8).</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• LUG SOCKET - 19mm Socket for (C5-C7), 21mm for (C8).</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• JACK & STANDS - Recommended hydraulic jacks & jack stands.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• ANTI-SEIZE - Recommended anti-seize compound for lug studs.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• WIRE BRUSH - Recommended wire brush for cleaning hub surface.</p>
        </div>
      </div>
    </section>

    <!-- Installation Instructions -->
    <section class="py-20">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red text-center mb-16 tracking-[8px] uppercase leading-tight">
          INSTALLATION INSTRUCTIONS
        </h2>

        <div class="max-w-[1200px] mx-auto">
          <!-- Pre-Installation Checklist -->
          <div class="mb-16">
            <h3 class="text-[28px] font-franklin-demi text-black/70 tracking-[5.6px] uppercase mb-8 leading-tight">PRE-INSTALLATION CHECKLIST</h3>

            <div class="space-y-6">
              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 1 : VERIFY FITMENT</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Confirm wheel size, bolt pattern (5x120.7mm for C5/C6, 5x120.65mm for C7/C8), offset, and 70.3mm center bore match your Corvette specifications.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 2 : INSPECT WHEELS</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Check for any shipping damage, cracks, or defects before installation.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 3 : GATHER HARDWARE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Use M12 x 1.5 conical seat lug nuts with 19mm socket (C5/C6/C7) or M14 x 1.5 conical seat lug nuts with 21mm socket (C8).</p>
              </div>
            </div>
          </div>

          <!-- Step-by-Step Installation -->
          <div class="mb-16">
            <h3 class="text-[28px] font-franklin-demi text-black/70 tracking-[5.6px] uppercase mb-8 leading-tight">STEP-BY-STEP INSTALLATION</h3>

            <div class="space-y-6">
              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 1 : PREPARE VEHICLE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Park on level ground, engage parking brake, and loosen lug nuts slightly before lifting vehicle.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 2 : LIFT & SECURE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Use proper jack points to lift vehicle. Always use jack stands- never work under a vehicle supported only by a jack.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 3 : REMOVE OLD WHEEL</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Remove lug nuts completely and carefully remove the old wheel.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 4 : CLEAN HUB SURFACE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Use wire brush to clean hub face and mounting surface. Remove all rust, dirt, and debris for proper wheel seating.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 5 : APPLY ANTI-SEIZE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Apply a thin coat of anti-seize compound to lug studs (not the nut face). This prevents seizing and ensures accurate torque readings.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 6 : MOUNT E5 WHEEL</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Align wheel with lug studs and slide onto hub. Ensure the wheel sits flush against the hub surface.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 7 : HAND-TIGHTEN LUGS</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Thread lug nuts by hand in a star/cross pattern to precent cross-threading.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 8 : INITIAL TORQUE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Lower vehicle so tire touches ground. Torque lug nuts to 50% of final spec in star pattern.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 9 : FINAL TORQUE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Torque to specification in star pattern: 100ft-lbs for C5/C6/C7, and 129ft-lbs for C8.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 10 : LOWER VEHICLE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Lower vehicle completely to ground and remove jack stands and jack.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 11 : RE-TORQUE</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">After 50-100mi, re-check and re-torque all lug nuts to specification.</p>
              </div>
            </div>
          </div>

          <!-- Center Cap Installation -->
          <div class="mb-16">
            <h3 class="text-[28px] font-franklin-demi text-black/70 tracking-[5.6px] uppercase mb-8 leading-tight">CENTER CAP INSTALLATION</h3>

            <div class="space-y-6">
              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 1 : CLEAN WHEEL CENTER</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Ensure the center bore area of the wheel is clean and free of debris.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 2 : ALIGN CAP</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Align the E5 Center Cap with the wheel center, ensuring any logos or markings are properly oriented.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 3: PRESS FIRMLY</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Press the center cap firmly into place until you hear or feel it click/snap into position.</p>
              </div>

              <div>
                <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 4: VERIFY SECURITY</p>
                <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Gently tug on the cap to ensure its securely fastened. It should not come loose with light pressure.</p>
              </div>
            </div>
          </div>

          <!-- Pro Tip -->
          <div class="text-center py-8">
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-4 leading-tight uppercase">PRO TIP</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px] max-w-[1100px] mx-auto">Some center caps may have retention clips or screws. If your caps include these, follow the specific instructions provided with your wheel set. Avoid using excessive force that could crack the lip.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Transferring TPMS Sensors -->
    <section class="py-20">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red text-center mb-12 tracking-[8px] uppercase leading-tight">
          TRANSFERRING TPMS SENSORS
        </h2>

        <p class="text-[20px] font-franklin-book text-center text-black/70 max-w-[1100px] mx-auto mb-16 tracking-[1px] leading-[32px]">
          E5 Wheels are compatible with factory Corvette TPMS sensors. You can transfer your existing sensors from your old wheels to your new E5 Wheels.
        </p>

        <div class="max-w-[1200px] mx-auto space-y-6">
          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 1: SENSOR REMOVAL</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Have a qualified tire technician remove TPMS sensors from your old wheels during tire dismounting. Sensors are delicate - improper removal can lead to damaging them.</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 2: INSPECT SENSORS</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Check sensors for damage. Replace valve stems, cores, and sealing components with new TPMS service kit.</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 3: INSTALL IN E5 WHEELS</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Have TPMS sensors properly installed in your new E5 Wheels during tire mounting. Torque valve nut to specification. (Typically 35-60 in-lbs.)</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">STEP 4: RELEARN PROCEDURE</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px] mb-4">After installation, perform a TPMS relearn:</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">• C6: Use Tech 2 scan tool or drive vehicle at 20+ mph for 10 minutes.</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">• C7: Use scan tool or go to Settings > Tire Pressure > Relearn in Driver Information Center.</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">• C8: Use scan tool or go to Settings > Tire Pressure > Relearn in vehicle menu.</p>
          </div>
        </div>

        <!-- Important Notice -->
        <div class="text-center py-12">
          <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-4 leading-tight uppercase">IMPORTANT</p>
          <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px] max-w-[1100px] mx-auto">TPMS Sensors have batteries with limited lifespan (typically 7-10 years). C6 sensors from early years may need replacement. C7 sensors from 2014-2016 should be tested. C8 sensors are newer and typically don't require replacement yet. Always replace rubber components (valve stems, seals, cores) during transfer. Corvette TPMS sensors use 315 MHz frequency - ensure any replacement sensors match this specification.</p>
        </div>
      </div>
    </section>

    <!-- TPMS Service Kit Components -->
    <section class="w-full bg-e5-black py-16">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red mb-10 tracking-[8px] uppercase leading-tight">TPMS SERVICE KIT COMPONENTS</h2>
        <div class="space-y-3">
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• VALVE STEM - Rubber or metal.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• VALVE CORE - Standard or nickel plated.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• VALVE CAP - Protective Cap.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• GROMMET - Prevents air leaks.</p>
          <p class="text-[22px] font-franklin-book text-white/70 tracking-[1.1px] leading-[36px]">• VALVE NUT - Secures sensor.</p>
        </div>
      </div>
    </section>

    <!-- Maintenance & Care -->
    <section class="py-20">
      <div class="max-w-[1300px] mx-auto px-6">
        <h2 class="text-[40px] font-franklin-book text-e5-red text-center mb-16 tracking-[8px] uppercase leading-tight">
          MAINTENANCE & CARE
        </h2>

        <div class="max-w-[1200px] mx-auto space-y-6">
          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">CHECK TORQUE REGULARLY</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Re-torque lug nuts after the first 50-100mi, then check every 5,000mi or during tire rotation.</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">CLEAN WHEELS</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Use pH-neutral wheel cleaner. Avoid harsh chemicals or abrasive materials that can damage the finish.</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">INSPECT FOR DAMAGE</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Regularly check for cracks, bends, or other damage, especially after hitting potholes or curbs.</p>
          </div>

          <div>
            <p class="text-[24px] font-franklin-demi text-e5-red tracking-[2.4px] mb-2 leading-tight uppercase">CHECK TIRE PRESSURE</p>
            <p class="text-[20px] font-franklin-book text-black/70 tracking-[1px] leading-[32px]">Maintain proper tire pressure as specified by your vehicle manufacturer. Check monthly and before long trips.</p>
          </div>
        </div>
      </div>
    </section>

