---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    FORM_FORGED_STUDIO_IMAGES,
    FORM_FORGED_LOGO_BLACK,
    SHOP_FINISHES,
    SEBRING_LOGO,
    DAYTONA_LOGO,
    SPEEDWAY_LOGO,
    SEBRING_TITANIUM_BRUSHED,
    SEBRING_BRAND_NAME, DAYTONA_BRAND_NAME, DAYTONA_TITANIUM_BRUSHED_TINT_FACE,
    SPEEDWAY_TITANIUM_BRUSHED_TINT_BEAUTY_LEFT, SPEEDWAY_BRAND_NAME, PROCESS_DIAGRAM_1,
    PROCESS_DIAGRAM_2, PROCESS_DIAGRAM_3, PROCESS_DIAGRAM_4,
} from "@/pages/wheels/constants/Wheels.ts";
import Button from "@/core/components/Button.vue";
import ImageWithLegend from "@/core/components/ImageWithLegend.vue";
import {WHEELS_DAYTONA_ROUTE, WHEELS_SEBRING_ROUTE, WHEELS_SPEEDWAY_ROUTE, WHEELS_ROUTE} from "@/core/constants/Routes.ts";
const finishingImages = FORM_FORGED_STUDIO_IMAGES.slice(0, 4);
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://www.e5wheels.com';
const description = 'E5 Form Forged wheels &mdash; engineered with forged DNA and crafted through flow forming. Precision-fitted for Corvette C6, C7, and C8. Available in Sebring, Daytona, and Speedway.';
const canonicalUrl = `${baseUrl}/wheels/form-forged`;
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Wheels", "item": `${baseUrl}/wheels` },
    { "@type": "ListItem", "position": 3, "name": "Form Forged", "item": canonicalUrl }
  ]
});
---

<MainLayout title="Form Forged Wheels | E5 Wheels" description={description} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>

    <!-- Hero Banner -->
    <section class="relative w-full h-[400px] md:h-[550px] lg:h-[700px] overflow-hidden bg-e5-black">
        <img
            src={FORM_FORGED_STUDIO_IMAGES[0]}
            alt="E5 Form Forged Wheels"
            class="absolute inset-0 w-full h-full object-cover opacity-90"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
            <img src={FORM_FORGED_LOGO_BLACK} alt="Form Forged Series" class="invert h-[36px] md:h-[48px] lg:h-[60px] w-auto mb-6 md:mb-8" />
            <h1 class="font-['Franklin_Gothic_Heavy'] text-[28px] md:text-[44px] lg:text-[60px] leading-[32px] md:leading-[48px] lg:leading-[64px] tracking-[2px] md:tracking-[3px] lg:tracking-[4px] text-white uppercase mb-4 md:mb-6 max-w-[1100px]">
                Form Forged Wheels
            </h1>
            <p class="text-[14px] md:text-[18px] lg:text-[22px] tracking-[2px] md:tracking-[3px] lg:tracking-[4px] leading-[20px] md:leading-[26px] text-white/85 uppercase max-w-[800px]">
                Forged DNA. Flow-formed precision. Built for Corvette.
            </p>
        </div>
    </section>

    <!-- Intro Section -->
    <section class="container-e5 text-center py-12 md:py-16 lg:py-20">
        <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[32px] text-black/70 max-w-[900px] mx-auto">
            Engineered with forged DNA and crafted through flow forming, our Form Forged Series balances strength, agility, and everyday drivability. Precision-fitted exclusively for Corvette C6, C7, and C8 platforms.
        </p>
    </section>

    <section class="py-12 bg-gray-50">
        <div class="container-e5 grid grid-cols-1 md:grid-cols-3">
            <ImageWithLegend
                    alt={SEBRING_BRAND_NAME}
                    image={SEBRING_TITANIUM_BRUSHED}
            >
                <div class="flex flex-col items-center text-center">
                    <img class="w-2/4 mb-4" src={SEBRING_LOGO} alt={SEBRING_BRAND_NAME}/>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">TITANIUM BRUSHED TINT</span>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">EXCLUSIVELY FORGED FOR C6_C7_C8</span>
                    <span class="text-center tracking-[3px] text-[14px] text-black">3 PREMIUM FINISHES</span>
                    <span class="text-center tracking-[3px] text-[14px] text-e5-red mt-4">IN STOCK</span>

                    <div class="mt-6 uppercase">
                        <Button client:visible primary link={WHEELS_SEBRING_ROUTE}>EXPLORE {SEBRING_BRAND_NAME}</Button>
                    </div>
                </div>
            </ImageWithLegend>
            <ImageWithLegend
                    alt={DAYTONA_BRAND_NAME}
                    image={DAYTONA_TITANIUM_BRUSHED_TINT_FACE}
            >
                <div class="flex flex-col items-center text-center">
                    <img class="w-2/4 mb-4" src={DAYTONA_LOGO} alt={DAYTONA_BRAND_NAME}/>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">TITANIUM BRUSHED TINT</span>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">EXCLUSIVELY FORGED FOR C6_C7_C8</span>
                    <span class="text-center tracking-[3px] text-[14px] text-black">3 PREMIUM FINISHES</span>
                    <span class="text-center tracking-[3px] text-[14px] text-e5-red mt-4">IN STOCK</span>

                    <div class="mt-6 uppercase">
                        <Button client:visible primary link={WHEELS_DAYTONA_ROUTE}>EXPLORE {DAYTONA_BRAND_NAME}</Button>
                    </div>
                </div>
            </ImageWithLegend>
            <ImageWithLegend
                    alt={SPEEDWAY_BRAND_NAME}
                    image={SPEEDWAY_TITANIUM_BRUSHED_TINT_BEAUTY_LEFT}
            >
                <div class="flex flex-col items-center text-center">
                    <img class="w-2/4 mb-4" src={SPEEDWAY_LOGO} alt={SPEEDWAY_BRAND_NAME}/>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">TITANIUM BRUSHED TINT</span>
                    <span class="text-center tracking-[3px] text-[14px] opacity-50">EXCLUSIVELY FORGED FOR C6_C7_C8</span>
                    <span class="text-center tracking-[3px] text-[14px] text-black">3 PREMIUM FINISHES</span>
                    <span class="text-center tracking-[3px] text-[14px] text-e5-red mt-4">IN STOCK</span>

                    <div class="mt-6 uppercase">
                        <Button client:visible primary link={WHEELS_SPEEDWAY_ROUTE}>EXPLORE {SPEEDWAY_BRAND_NAME}</Button>
                    </div>
                </div>
            </ImageWithLegend>
        </div>
    </section>

    <!-- Our Process Section -->
    <section class="container-e5 text-center">
        <h2 class="text-[48px] tracking-[9.6px] leading-[48px] text-e5-red uppercase mb-6 mt-16">
            OUR PROCESS
        </h2>
        <p class="text-[18px] tracking-[4.8px] leading-[18px] text-black/50 uppercase max-w-[1485px] mx-auto my-12">
            Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility&mdash;without compromising daily drivability.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-16 mb-16">
            <div>
                <div class="relative flex items-center justify-center mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[16px] tracking-[3px] font-bold uppercase">STEP 1</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_1} alt="Step 1">
                    <b>CAST PREFORM & DESIGN</b>
                    Initial cast preform with design.
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[16px] tracking-[3px] font-bold uppercase">STEP 2</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_2} alt="Step 2">
                    <b>HEATING & SPINNING</b>
                    Heated workpiece rotated on mandrel.
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[16px] tracking-[3px] font-bold uppercase">STEP 3</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_3} alt="Step 3">
                    <b>FLOW FORMING STRETCH</b>
                    Rollers stretch and widen the barrel
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[16px] tracking-[3px] font-bold uppercase">STEP 4</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_4} alt="Step 4">
                    <b>FINAL PROFILE</b>
                    Finished barrel is significantly stronger and lighter.
                </ImageWithLegend>
            </div>
        </div>
    </section>

    <section class="container-e5 py-20">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl lg:text-5xl tracking-[5.6px] text-e5-red mb-4">
                FINISHING
            </h2>
            <p class="text-lg mx-auto opacity-60 uppercase tracking-[3px]">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint,
                AND DARK BRONZE&mdash; finishes that embody the essence of timeless, modern, and bold design.
                Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all
                <span class="text-e5-red">backed by our 5-year finishing warranty.</span>
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {finishingImages.map((image, index) => (
                <div>
                    <img
                            src={image}
                            alt={`Finishing ${index + 1}`}
                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    />
                </div>
            ))}
        </div>
    </section>

    <section class="container-e5">
        <div class="mt-20 mb-12">
            <h2 class="text-3xl md:text-4xl lg:text-5xl tracking-[5.6px] text-e5-red mb-4">
                EXPLORE FORM FORGED GALLERY
            </h2>
            <p class="text-lg mx-auto opacity-60 uppercase tracking-[3px]">
                OUR FORM FORGED SERIES IN ACTION.
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-[1fr_2px_1fr] gap-6">
            <img
                    src={FORM_FORGED_STUDIO_IMAGES[4]}
                    alt="Gallery TITANIUM"
                    class="w-full h-full object-cover cursor-pointer aspect-square py-4"
            />
            <div class="w-0.5 h-full bg-gray-300 lg:block"></div>
            <img
                    src={FORM_FORGED_STUDIO_IMAGES[5]}
                    alt="Gallery C7"
                    class="w-full h-full object-cover cursor-pointer aspect-square py-4"
            />
        </div>
    </section>

    <section class="container-e5">
        <h2 class="text-center text-lg mx-auto font-medium opacity-40 uppercase tracking-[3px] mt-20">
            EXCLUSIVELY ENGINEERED FOR CORVETTES
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-8 mb-20">
            {SHOP_FINISHES.map((finish) => (
                <ImageWithLegend
                        alt={finish.finish}
                        image={finish.image}
                >
                    <div class="flex flex-col items-center text-center">
                        <span class="text-center tracking-[3px] text-[14px] opacity-50">{finish.finish}</span>
                        <span class="text-center tracking-[3px] text-[14px] opacity-50">{finish.availability}</span>
                        <span class="text-center tracking-[3px] text-[14px] text-black">{finish.price}</span>
                        <span class="text-center tracking-[3px] text-[14px] text-e5-red mt-4">{finish.stock}</span>

                        <div class="mt-6 uppercase">
                            <Button client:visible primary link={WHEELS_ROUTE}>LEARN MORE</Button>
                        </div>
                    </div>
                </ImageWithLegend>
            ))}
        </div>
    </section>
</MainLayout>