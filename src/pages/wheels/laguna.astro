---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    LAGUNA_LOGO,
    LAGUNA_BRAND_NAME,
    LAGUNA_HERO,
    LAGUNA_WHEEL_RENDER,
    LAGUNA_SATIN_BLACK,
    LAGUNA_POLISHED_ALUMINUM,
    LAGUNA_GLOSS_BLACK,
    LAGUNA_SHOT_1,
    LAGUNA_FINISHING_BG,
    LAGUNA_SHOT_2,
    LAGUNA_SHOT_3,
    LAGUNA_VETTE_GALLERY,
    LAGUNA_WHEEL_GALLERY_BANNER,
    TALLADEGA_LOGO,
    TALLADEGA_BRAND_NAME,
    SONOMA_LOGO,
    SONOMA_BRAND_NAME
} from "@/pages/wheels/constants/Wheels.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import ImageWithLegend from "@/core/components/ImageWithLegend.vue";
import { HOME_ROUTE, PROCESS_FORGED_ROUTE, GALLERY_WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE } from "@/core/constants/Routes.ts";

// Build product URLs
const brushedAluminumUrl = buildWheelUrl(LAGUNA_BRAND_NAME, 'Brushed Aluminum');
const satinBlackUrl = buildWheelUrl(LAGUNA_BRAND_NAME, 'Satin Black');
const polishedAluminumUrl = buildWheelUrl(LAGUNA_BRAND_NAME, 'Polished');
const glossBlackUrl = buildWheelUrl(LAGUNA_BRAND_NAME, 'Gloss Black');
const talladegaBrushedAluminumUrl = buildWheelUrl(TALLADEGA_BRAND_NAME, 'Brushed Aluminum');
const sonomaBrushedAluminumUrl = buildWheelUrl(SONOMA_BRAND_NAME, 'Brushed Aluminum');

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Laguna - E5 Forged Corvette Wheels | E5 Wheels';
const description = 'The Laguna is a fully forged wheel featuring a bold multi-spoke design. Exclusively forged in the USA for the C8 Corvette platform. 4 premium finishes available.';
const canonicalUrl = `${baseUrl}/wheels/laguna`;
const ogImage = `${baseUrl}${LAGUNA_HERO}`;
// No "offers" block: every Laguna entry in the AutoSync catalog still has Price: null.
// Publishing a placeholder price (e.g. "0") in Product schema risks Google flagging it as
// invalid, or literally displaying "$0" in search results — add "offers" back once real
// pricing is confirmed.
const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "E5 Laguna Forged Corvette Wheel",
  "brand": { "@type": "Brand", "name": "E5 Wheels" },
  "description": description,
  "url": canonicalUrl,
  "image": ogImage
});
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Wheels", "item": `${baseUrl}/wheels` },
    { "@type": "ListItem", "position": 3, "name": "Laguna", "item": canonicalUrl }
  ]
});
---

<MainLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage} ogType="product">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={productSchema}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>

    <!-- Hero Section -->
    <section class="w-full bg-white">
        <!-- Full Width Hero Image -->
        <div class="w-full h-[350px] sm:h-[450px] md:h-[550px] lg:h-[600px]">
            <img src={LAGUNA_HERO} alt="C8 Corvette fitted with E5 Laguna forged wheels" class="w-full h-full object-cover object-center" />
        </div>

        <!-- Content Below Image -->
        <div class="max-w-[1400px] mx-auto px-6 py-8 md:py-12">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-6">
                <!-- Left: Laguna Logo -->
                <div class="flex-1">
                    <img src={LAGUNA_LOGO} alt="LAGUNA" class="w-full max-w-[550px]" />
                </div>

                <!-- Right: E5 FORGED Badge -->
                <div class="flex-shrink-0">
                    <img src="/assets/images/e5-forged-logo.webp" alt="E5 FORGED" class="h-[22px] md:h-[28px]" />
                </div>
            </div>

            <!-- Page Title -->
            <h1 class="text-[16px] md:text-[20px] lg:text-[24px] font-sans tracking-[6px] md:tracking-[9px] lg:tracking-[12.8px] text-black mb-8">
                LAGUNA E5 FORGED WHEELS
            </h1>

            <!-- Description Text -->
            <p class="text-[14px] md:text-[17px] leading-[20px] md:leading-[24px] text-black/70 mb-4 max-w-[700px]">
                The Laguna sharpens the E5 Forged Series with a bold multi-spoke design and an aggressive, motorsport-inspired stance. Still fully forged and made in the USA, its strategically placed weight cutouts keep it strong and lightweight while delivering a sharper edge to the lineup.
            </p>

            <!-- Exclusively Forged For -->
            <p class="text-[12px] md:text-[14px] tracking-[1.5px] uppercase text-black/50 text-center mt-8 md:mt-12">
                EXCLUSIVELY FORGED FOR C8 Z06, ZR1 / X, E-RAY, GRAND SPORT / X
            </p>
        </div>

        <!-- Wheel Image with Specs Section -->
        <div class="max-w-[1400px] mx-auto px-6 py-8 md:py-12">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
                <!-- Left: Wheel Image -->
                <div class="w-full md:w-[40%]">
                    <img src={LAGUNA_WHEEL_RENDER} alt="E5 Laguna forged wheel in Brushed Aluminum finish" class="w-full h-auto" />
                </div>

                <!-- Right: Specs and Buttons -->
                <div class="w-full md:w-[60%]">
                    <!-- Sizes -->
                    <div class="mb-6">
                        <h3 class="text-[14px] md:text-[16px] font-bold tracking-[1.5px] uppercase mb-3">SIZES</h3>
                        <ul class="list-disc list-inside text-[13px] md:text-[15px] leading-[20px] md:leading-[22px] space-y-1">
                            <li>Front: 20x10 / Offset +25mm</li>
                            <li>Rear: 21x13 / Offset +20mm</li>
                            <li>Bolt Pattern: 5x120, 5x130 (ZR1)</li>
                        </ul>
                    </div>

                    <!-- Finish -->
                    <div class="mb-6">
                        <h3 class="text-[14px] md:text-[16px] font-bold tracking-[1.5px] uppercase mb-3">FINISH</h3>
                        <p class="text-[13px] md:text-[15px] leading-[20px] md:leading-[22px]">
                            Brushed Aluminum
                        </p>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href={brushedAluminumUrl} class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors text-center" data-gtm-event="shop_fitment" data-gtm-label="Shop Laguna">
                            SHOP LAGUNA
                        </a>
                        <a href={PROCESS_FORGED_ROUTE} class="bg-white text-black border border-black px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-black/5 transition-colors text-center" data-gtm-event="explore_wheel" data-gtm-label="Explore E5 Forged">
                            EXPLORE E5 FORGED
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Available Finishes -->
    <section class="bg-white py-8 md:py-12 border-t border-gray-200">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12">
                <a href={satinBlackUrl} class="block hover:opacity-80 transition-opacity">
                    <ImageWithLegend image={LAGUNA_SATIN_BLACK} alt="Laguna Satin Black">
                        <p class="text-[13px] tracking-[2px] text-black/50 uppercase text-center">SATIN BLACK</p>
                    </ImageWithLegend>
                </a>
                <a href={polishedAluminumUrl} class="block hover:opacity-80 transition-opacity">
                    <ImageWithLegend image={LAGUNA_POLISHED_ALUMINUM} alt="Laguna Polished Aluminum">
                        <p class="text-[13px] tracking-[2px] text-black/50 uppercase text-center">POLISHED ALUMINUM</p>
                    </ImageWithLegend>
                </a>
                <a href={glossBlackUrl} class="block hover:opacity-80 transition-opacity">
                    <ImageWithLegend image={LAGUNA_GLOSS_BLACK} alt="Laguna Gloss Black">
                        <p class="text-[13px] tracking-[2px] text-black/50 uppercase text-center">GLOSS BLACK</p>
                    </ImageWithLegend>
                </a>
            </div>
        </div>
    </section>

    <!-- The Forging Process -->
    <section class="bg-white py-8 md:py-12 border-t border-gray-200">
        <div class="max-w-[1400px] mx-auto px-6">
            <h2 class="text-e5-red text-[24px] md:text-[28px] font-bold tracking-[2px] uppercase mb-2 text-center">
                THE FORGING PROCESS
            </h2>
            <p class="text-[13px] md:text-[15px] tracking-[1.5px] uppercase mb-1 text-center text-black/70">
                FORGED IN THE USA. ENGINEERED WITHOUT COMPROMISE. <img src="/assets/images/process/forged/74e97b24bbd8f0fa93b10ef755682a46c52738c9.webp" alt="USA Flag" class="inline-block h-[13px] w-[24px] ml-1" />
            </p>
            <p class="text-[13px] md:text-[15px] leading-[19px] md:leading-[21px] max-w-[800px] mx-auto mb-8 text-center text-black/70">
                Every E5 Forged wheel begins with purpose. Designed exclusively for Corvette platforms, our forged wheels are engineered and manufactured in the United States to meet the extreme demands of performance, precision, and strength. From aerospace-grade material selection to final finishing, each step is executed with intention&mdash;eliminating excess, reinforcing structure, and delivering uncompromising performance for the C8 Z06, ZR1, and E-Ray.
            </p>

            <!-- 5 Process Steps -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
                <div class="text-center">
                    <img src="/assets/images/process/forged/f0f3e57be69ac17bdf5d0b88a9acbb4dd11c959e.webp" alt="Material" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">MATERIAL</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        6061 AEROSPACE-GRADE ALUMINUM BILLET SELECTED FOR STRENGTH AND CONSISTENCY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/809caca77164233a698d905f1d587df976aea6e3.webp" alt="Forging" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">FORGING</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        HIGH-PRESSURE FORGING REFINES GRAIN STRUCTURE FOR INCREASED DENSITY AND DURABILITY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/797d5893d4a0bae48a4ccb031cafc436db1200ca.webp" alt="Machine" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">MACHINE</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        5-AXIS CNC MACHINING IN CALIFORNIA REMOVES MATERIAL WITH PRECISION AND PURPOSE.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/b9590fdbbe1a9e6203dbf8fe826d0dafe9f7baba.webp" alt="Refine" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">REFINE</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        HAND-FINISHED DETAILS ENSURE SYMMETRY, SHARP DEFINITION, AND VISUAL CLARITY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/bb6950e1bfd656ac155d1f7e1c229877ded3a542.webp" alt="Finish" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">FINISH</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        PREMIUM FINISHES APPLIED AND INSPECTED FOR PERFORMANCE AND LONGEVITY.
                    </p>
                </div>
            </div>

            <div class="text-center">
                <a href={PROCESS_FORGED_ROUTE} class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors inline-block">
                    LEARN MORE
                </a>
            </div>
        </div>
    </section>

    <!-- Finishing Section - Dark -->
    <section class="relative bg-black py-12 md:py-16">
        <div class="absolute inset-0 opacity-30">
            <img src={LAGUNA_FINISHING_BG} alt="E5 Laguna wheel finish close-up" class="w-full h-full object-cover" />
        </div>

        <div class="max-w-[1400px] mx-auto px-6 relative z-10">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
                <!-- Left: FINISHING Title -->
                <div class="w-full md:w-1/3">
                    <h2 class="text-white text-[40px] md:text-[58px] font-bold tracking-[4px] md:tracking-[6px] uppercase">
                        FINISHING
                    </h2>
                </div>

                <!-- Right: Description -->
                <div class="w-full md:w-2/3">
                    <p class="text-white text-[13px] md:text-[16px] leading-[19px] md:leading-[22px]">
                        Every wheel in the E5 Forged Collection is a statement beyond performance. Available in premium finishes like gloss black, brushed aluminum, and polished&mdash;with custom options upon request&mdash;each design highlights the precision of its forged construction. Every finish is executed with uncompromising attention to detail for a look that lasts.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Detail Images Grid -->
    <section class="bg-white py-8 md:py-12">
        <div class="w-full">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <img src={LAGUNA_SHOT_2} alt="E5 Laguna wheel spoke detail" class="w-full h-auto" />
                <img src={LAGUNA_SHOT_3} alt="E5 Laguna wheel barrel detail" class="w-full h-auto" />
            </div>
            <div class="w-full">
                <img src={LAGUNA_SHOT_1} alt="Corvette fitted with E5 Laguna wheels, close-up" class="w-full h-[300px] sm:h-[400px] md:h-[500px] lg:h-[600px] object-cover object-center" />
            </div>
        </div>
    </section>

    <!-- Gallery Banners -->
    <section class="w-full py-8 md:py-12">
        <!-- Vette Gallery Banner -->
        <div class="relative h-[250px] sm:h-[300px] md:h-[350px] lg:h-[400px] overflow-hidden mb-8 md:mb-12">
            <img src={LAGUNA_VETTE_GALLERY} alt="Corvette builds fitted with E5 Laguna wheels" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute inset-0 flex items-end justify-start pb-12 md:pb-16 pl-8 md:pl-16">
                <article class="text-white">
                    <h2 class="text-[40px] md:text-[58px] font-bold uppercase mb-3 md:mb-4 tracking-[2px] leading-[1]">
                        VETTE GALLERY
                    </h2>
                    <p class="text-[15px] md:text-[18px] leading-[1.4] mb-4 md:mb-6">
                        A collection of builds fitted with our wheels.
                    </p>
                    <a href={GALLERY_VEHICLES_ROUTE} class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                        VIEW GALLERY
                    </a>
                </article>
            </div>
        </div>

        <!-- Wheel Gallery Banner -->
        <div class="relative h-[250px] sm:h-[300px] md:h-[350px] lg:h-[400px] overflow-hidden">
            <img src={LAGUNA_WHEEL_GALLERY_BANNER} alt="E5 Laguna wheel detail gallery" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute inset-0 flex items-end justify-end pb-12 md:pb-16 pr-8 md:pr-16">
                <article class="text-white text-right">
                    <h2 class="text-[40px] md:text-[58px] font-bold uppercase mb-3 md:mb-4 tracking-[2px] leading-[1]">
                        WHEEL GALLERY
                    </h2>
                    <p class="text-[15px] md:text-[18px] leading-[1.4] mb-4 md:mb-6">
                        Our wheels, up close & personal.
                    </p>
                    <a href={GALLERY_WHEELS_ROUTE} class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                        VIEW GALLERY
                    </a>
                </article>
            </div>
        </div>
    </section>

    <!-- Related Wheels - Talladega + Sonoma (same E5 Forged family) -->
    <section class="bg-white py-8 md:py-12">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Talladega -->
                <a href={talladegaBrushedAluminumUrl} class="block hover:opacity-80 transition-opacity">
                    <div class="text-center w-full md:w-[70%] mx-auto">
                        <img src="/assets/images/generations/c8/zr1-figma/taladaga-c8wheel.webp" alt="Talladega" class="w-full h-auto mb-4" />
                        <img src={TALLADEGA_LOGO} alt="TALLADEGA" class="mx-auto h-[34px] md:h-[38px] mb-4" />
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">BRUSHED ALUMINUM</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY.</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-3">CUSTOM FINISHES</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-5">MADE IN USA</p>
                        <div class="bg-e5-red text-white px-10 py-3 text-[12px] md:text-[13px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                            SHOP FITMENT
                        </div>
                    </div>
                </a>

                <!-- Sonoma -->
                <a href={sonomaBrushedAluminumUrl} class="block hover:opacity-80 transition-opacity">
                    <div class="text-center w-full md:w-[70%] mx-auto">
                        <img src="/assets/images/generations/c8/zr1-figma/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-auto mb-4" />
                        <img src={SONOMA_LOGO} alt="SONOMA" class="mx-auto h-[42px] md:h-[46px] mb-4" />
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">BRUSHED ALUMINUM</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY.</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-3">CUSTOM FINISHES</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-5">MADE IN USA</p>
                        <div class="bg-e5-red text-white px-10 py-3 text-[12px] md:text-[13px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                            SHOP FITMENT
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Footer Red Section -->
    <section class="bg-e5-red text-white py-6">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="text-center">
                <a href={HOME_ROUTE}>
                    <img src="/assets/images/e5-wheels-logo-white.webp" alt="E5 Wheels" class="h-[34px] md:h-[40px] mx-auto" />
                </a>
            </div>
        </div>
    </section>

</MainLayout>
