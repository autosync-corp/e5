---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    WHEELS_DAYTONA_ROUTE,
    GALLERY_WHEELS_ROUTE,
    GALLERY_VEHICLES_ROUTE,
    WHEELS_SEBRING_ROUTE,
    WHEELS_SPEEDWAY_ROUTE,
    WHEELS_TALLADEGA_ROUTE,
    WHEELS_SONOMA_ROUTE,
    WHEELS_LAGUNA_ROUTE,
    WHEELS_GT_01_ROUTE,
    WHEELS_GT_02_ROUTE,
    WHEELS_GT_03_ROUTE,
    WHEELS_GT_04_ROUTE,
    WHEELS_SEBRING_2P_ROUTE,
} from "@/core/constants/Routes.ts";
import {
    LAGUNA_LOGO,
    LAGUNA_WHEEL_RENDER,
    GT_FORGED_LOGO,
    FORM_FORGED_WORDMARK,
    TWO_P_FORGED_LOGO,
    SEBRING_2P_LOGO,
    SEBRING_2P_GLOSS_BLACK,
    DAYTONA_TITANIUM_BRUSHED_STUDIO,
    SEBRING_TITANIUM_BRUSHED_STUDIO,
    SPEEDWAY_TITANIUM_BRUSHED_TINT_STUDIO,
    GT01_BRUSHED_ALUMINUM,
    GT02_BRUSHED_ALUMINUM,
    GT03_BRUSHED_ALUMINUM,
    GT04_BRUSHED_ALUMINUM,
    GT01_WORDMARK,
    GT02_WORDMARK,
    GT03_WORDMARK,
    GT04_WORDMARK,
} from "@/pages/wheels/constants/Wheels.ts";
import { SITE_URL } from '@/core/constants/Site.ts';

const baseUrl = SITE_URL;
const title = 'Corvette Wheels Collection | E5 Wheels';
const description = 'Browse our complete collection of Form Forged, 2P Forged, E5 Forged, and GT Forged Corvette wheels, engineered for every Corvette generation.';
const canonicalUrl = `${baseUrl}/wheels`;

const gtCards = [
    { name: 'GT.01', image: GT01_BRUSHED_ALUMINUM, wordmark: GT01_WORDMARK, href: WHEELS_GT_01_ROUTE, cta: 'EXPLORE GT.01' },
    { name: 'GT.02', image: GT02_BRUSHED_ALUMINUM, wordmark: GT02_WORDMARK, href: WHEELS_GT_02_ROUTE, cta: 'EXPLORE GT.02' },
    { name: 'GT.03', image: GT03_BRUSHED_ALUMINUM, wordmark: GT03_WORDMARK, href: WHEELS_GT_03_ROUTE, cta: 'EXPLORE GT.03' },
    { name: 'GT.04', image: GT04_BRUSHED_ALUMINUM, wordmark: GT04_WORDMARK, href: WHEELS_GT_04_ROUTE, cta: 'EXPLORE GT.04' },
];
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <!-- Page Title -->
    <div class="max-w-[1583px] mx-auto px-6 md:px-12 pt-12 md:pt-16">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-franklin-heavy text-black text-center mb-4">
            CORVETTE WHEELS COLLECTION
        </h1>
        <p class="text-base md:text-lg text-black/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
            Explore our complete lineup of forged and form forged wheels, exclusively engineered for every Corvette generation.
        </p>
    </div>

    <!-- Form Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12 series-lockup-scope">
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row md:flex-wrap items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src={FORM_FORGED_WORDMARK}
                            alt="Form Forged"
                            class="series-logo-form"
                        />
                    </div>
                    <div class="flex-1 min-w-[min(100%,16rem)]">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility&mdash;without compromising daily drivability. <a href="/process/form-forged" class="text-e5-red underline">Read more about our Form Forged series</a>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="wheel-finish-grid mb-8 md:mb-12">
                <!-- Daytona -->
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src={DAYTONA_TITANIUM_BRUSHED_STUDIO}
                            alt="Daytona"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src="/assets/images/wheels-new/bf617359a30df6e52e23d25ba89f15964c216df1.webp"
                            alt="Daytona"
                            class="h-[22px] md:h-[27px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">TITANIUM BRUSHED</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                            <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                        </div>
                        <a
                            href={WHEELS_DAYTONA_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE DAYTONA
                        </a>
                    </div>
                </div>

                <!-- Sebring -->
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src={SEBRING_TITANIUM_BRUSHED_STUDIO}
                            alt="Sebring"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src="/assets/images/wheels-new/90f6c4d4b52eb6c3ec25ae4927cf62a98d647c4d.webp"
                            alt="Sebring"
                            class="h-[24px] md:h-[29px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">TITANIUM BRUSHED</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                            <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                        </div>
                        <a
                            href={WHEELS_SEBRING_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE SEBRING
                        </a>
                    </div>
                </div>

                <!-- Speedway -->
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src={SPEEDWAY_TITANIUM_BRUSHED_TINT_STUDIO}
                            alt="Speedway"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src="/assets/images/wheels-new/5a059fba9b6f32612b072a121dc09766ef507b86.webp"
                            alt="Speedway"
                            class="h-[23px] md:h-[28px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">TITANIUM BRUSHED TINT</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                            <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                        </div>
                        <a
                            href={WHEELS_SPEEDWAY_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE SPEEDWAY
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2P Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12 series-lockup-scope">
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row md:flex-wrap items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src={TWO_P_FORGED_LOGO}
                            alt="2P Forged"
                            class="series-logo-2p"
                        />
                    </div>
                    <div class="flex-1 min-w-[min(100%,16rem)]">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            Sebring 2P is a two-piece Corvette-only C8 fitment&mdash;19x9 +35mm / 20x11 +45mm on Stingray, and 20x10 +25mm / 21x13 +20mm on Z06 and E-Ray.
                        </p>
                    </div>
                </div>
            </div>

            <div class="wheel-finish-grid wheels-2p-grid mb-8 md:mb-12">
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src={SEBRING_2P_GLOSS_BLACK}
                            alt="Sebring 2P"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src={SEBRING_2P_LOGO}
                            alt="Sebring 2P"
                            class="h-[24px] md:h-[29px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">GLOSS BLACK</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                            <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                        </div>
                        <a
                            href={WHEELS_SEBRING_2P_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE SEBRING 2P
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- E5 Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12 series-lockup-scope">
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row md:flex-wrap items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src="/assets/images/wheels-new/02d80e5501d4b44b3e61daf67192b4fe23242b09.webp"
                            alt="E5 Forged"
                            class="series-logo-e5"
                        />
                    </div>
                    <div class="flex-1 min-w-[min(100%,16rem)]">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            Exclusively Forged in the USA for C8 Z06, ZR1, and E_Ray. Engineered for extreme performance, reduced weight, and maximum strength. <a href="/process/forged" class="text-e5-red underline">LEARN MORE ABOUT E5 FORGED.</a>
                        </p>
                    </div>
                </div>
            </div>

            <div class="wheel-finish-grid mb-8 md:mb-12">
                <!-- Talladega -->
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src="/assets/images/wheels-new/taladaga-c8wheel.webp"
                            alt="Talladega"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src="/assets/images/wheels-new/3a0f898a970a7108262be2cdc91dcdde57744bd4.webp"
                            alt="Talladega"
                            class="h-[24px] md:h-[29px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                            <p class="wheels-card-fitment text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8 Z06, ZR1, E_RAY</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">5 PREMIUM FINISHES</p>
                            <p class="wheels-card-leadtime text-[12px] md:text-[16px] text-e5-red font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">MADE TO ORDER &middot; 4 WEEK LEAD TIME</p>
                        </div>
                        <a
                            href={WHEELS_TALLADEGA_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE TALLADEGA
                        </a>
                    </div>
                </div>

                <!-- Sonoma -->
                <div class="wheels-card">
                    <div class="wheels-card-image">
                        <img
                            src="/assets/images/wheels-new/sonoma-wheel-c8.webp"
                            alt="Sonoma"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src="/assets/images/wheels-new/85b233dbe3893890d7939ec5aea2b7b17a0287c2.webp"
                            alt="Sonoma"
                            class="h-[38px] md:h-[46px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                            <p class="wheels-card-fitment text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8 Z06, ZR1, E_RAY</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                            <p class="wheels-card-leadtime text-[12px] md:text-[16px] text-e5-red font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">MADE TO ORDER &middot; 4 WEEK LEAD TIME</p>
                        </div>
                        <a
                            href={WHEELS_SONOMA_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE SONOMA
                        </a>
                    </div>
                </div>

                <!-- Laguna -->
                <div class="wheels-card">
                    <div class="wheels-card-image wheels-card-image--laguna">
                        <img
                            src={LAGUNA_WHEEL_RENDER}
                            alt="Laguna"
                        />
                    </div>
                    <div class="wheels-card-name">
                        <img
                            src={LAGUNA_LOGO}
                            alt="Laguna"
                            class="h-[24px] md:h-[29px]"
                        />
                    </div>
                    <div class="wheels-card-body">
                        <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                            <p class="wheels-card-fitment text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8 Z06, ZR1, E_RAY, GRAND SPORT</p>
                            <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">4 PREMIUM FINISHES</p>
                            <p class="wheels-card-leadtime text-[12px] md:text-[16px] text-e5-red font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">MADE TO ORDER &middot; 6 WEEK LEAD TIME</p>
                        </div>
                        <a
                            href={WHEELS_LAGUNA_ROUTE}
                            class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                        >
                            EXPLORE LAGUNA
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- GT Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12 series-lockup-scope">
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row md:flex-wrap items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src={GT_FORGED_LOGO}
                            alt="GT Forged"
                            class="series-logo-gt"
                        />
                    </div>
                    <div class="flex-1 min-w-[min(100%,16rem)]">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            GT.01, GT.02, GT.03, and GT.04&mdash;made to order in Brushed Aluminum, Gloss Black, and Satin Black. Catalog sizes 19x9 +35mm through 21x13 +20mm.
                        </p>
                    </div>
                </div>
            </div>

            <div class="wheel-finish-grid wheels-gt-grid mb-8 md:mb-12">
                {gtCards.map((card) => (
                    <div class="wheels-card">
                        <div class="wheels-card-image">
                            <img src={card.image} alt={card.name} />
                        </div>
                        <div class="wheels-card-name">
                            <img
                                src={card.wordmark}
                                alt={card.name}
                                class="wheels-gt-wordmark"
                            />
                        </div>
                        <div class="wheels-card-body">
                            <div class="space-y-1 md:space-y-2 mb-4 md:mb-6 wheels-card-meta">
                                <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                                <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">19X9 +35 THROUGH 21X13 +20</p>
                                <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                                <p class="text-[12px] md:text-[16px] text-e5-red font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">MADE TO ORDER &middot; 6 WEEK LEAD TIME</p>
                            </div>
                            <a
                                href={card.href}
                                class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                            >
                                {card.cta}
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Vette Gallery Banner -->
    <section class="relative h-[280px] md:h-[380px] w-full">
        <img
            src="/assets/images/wheels-new/195456d72b224f9b92ca6b410ac88f61fad3db24.webp"
            alt="Vette Gallery"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-start">
            <div class="max-w-[1583px] mx-auto px-6 md:px-12 w-full">
                <div class="text-white">
                    <h2 class="text-[32px] md:text-[48px] font-franklin-heavy tracking-[-0.64px] md:tracking-[-0.96px] uppercase leading-[28px] md:leading-[37px] mb-2 md:mb-3">
                        VETTE GALLERY
                    </h2>
                    <p class="text-[16px] md:text-[20px] tracking-[-0.32px] md:tracking-[-0.48px] leading-[18px] md:leading-[23px] mb-4 md:mb-6">
                        Corvettes in their element.
                    </p>
                    <a
                        href={GALLERY_VEHICLES_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        VIEW GALLERY
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Wheel Gallery Banner -->
    <section class="relative h-[280px] md:h-[380px] w-full">
        <img
            src="/assets/images/wheels-new/38f473e1f45f9c800e13c02c7283b158fad81634.webp"
            alt="Wheel Gallery"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-start md:justify-end">
