---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    DAYTONA_BRAND_NAME,
    TALLADEGA_WHEELS,
    TALLADEGA_LOGO,
    TALLADEGA_BRAND_NAME,
    DAYTONA_LOGO,
    SPEEDWAY_LOGO,
    SPEEDWAY_WHEELS,
    SPEEDWAY_BRAND_NAME,
    DAYTONA_WHEELS,
    FORM_FORGED_LOGO,
    SEBRING_BRAND_NAME,
    SEBRING_LOGO,
    SEBRING_WHEELS,
    E5_FORGED_LOGO,
    SONOMA_BRAND_NAME,
    SONOMA_LOGO,
    SONOMA_WHEELS,
} from "@/pages/wheels/constants/Wheels.ts";
import {
    WHEELS_DAYTONA_ROUTE,
    GALLERY_WHEELS_ROUTE,
    GALLERY_VEHICLES_ROUTE,
    WHEELS_SEBRING_ROUTE,
    WHEELS_SPEEDWAY_ROUTE,
    WHEELS_TALLADEGA_ROUTE,
    WHEELS_SONOMA_ROUTE
} from "@/core/constants/Routes.ts";
---

<MainLayout title="E5 Wheels - Wheel Gallery">
    <!-- Hero Banner -->
    <section class="w-full h-[150px] bg-[#d9d9d9]">
    </section>

    <!-- E5 Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12">
            <!-- Header Container -->
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src="/assets/images/wheels-new/02d80e5501d4b44b3e61daf67192b4fe23242b09.png"
                            alt="E5 Forged"
                            class="h-[40px] md:h-[54px]"
                        />
                    </div>
                    <div class="flex-1">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            Exclusively Forged in the USA for C8 Z06, ZR1, and E_Ray. Engineered for extreme performance, reduced weight, and maximum strength. <a href="#" class="text-e5-red underline">LEARN MORE ABOUT E5 FORGED.</a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Two Wheels Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 mb-8 md:mb-12">
                <!-- Talladega -->
                <div class="text-center">
                    <div class="mb-4 md:mb-6">
                        <img
                            src="/assets/images/wheels-new/taladaga-c8wheel.webp"
                            alt="Talladega"
                            class="w-full max-w-[300px] md:max-w-[400px] mx-auto"
                        />
                    </div>
                    <img
                        src="/assets/images/wheels-new/3a0f898a970a7108262be2cdc91dcdde57744bd4.png"
                        alt="Talladega"
                        class="h-[24px] md:h-[29px] mx-auto mb-4 md:mb-6"
                    />
                    <div class="space-y-1 md:space-y-2 mb-4 md:mb-6">
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8 Z06, ZR1, E_RAY</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">5 PREMIUM FINISHES</p>
                        <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                    </div>
                    <a
                        href={WHEELS_TALLADEGA_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        EXPLORE TALLADEGA
                    </a>
                </div>

                <!-- Sonoma -->
                <div class="text-center">
                    <div class="mb-4 md:mb-6">
                        <img
                            src="/assets/images/wheels-new/sonoma-wheel-c8.webp"
                            alt="Sonoma"
                            class="w-full max-w-[300px] md:max-w-[400px] mx-auto"
                        />
                    </div>
                    <img
                        src="/assets/images/wheels-new/85b233dbe3893890d7939ec5aea2b7b17a0287c2.png"
                        alt="Sonoma"
                        class="h-[38px] md:h-[46px] mx-auto mb-4 md:mb-6"
                    />
                    <div class="space-y-1 md:space-y-2 mb-4 md:mb-6">
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">BRUSHED ALUMINUM</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C8 Z06, ZR1, E_RAY</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                        <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                    </div>
                    <a
                        href={WHEELS_SONOMA_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        EXPLORE SONOMA
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Form Forged Series Section -->
    <section class="py-12 md:py-20 bg-white">
        <div class="max-w-[1583px] mx-auto px-6 md:px-12">
            <!-- Header -->
            <div class="mb-8 md:mb-16">
                <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-8">
                    <div class="flex-shrink-0 pb-4 md:pb-0 md:pr-8 border-b-[3px] md:border-b-0 md:border-r-[3px] border-e5-red w-full md:w-auto">
                        <img
                            src="/assets/images/wheels-new/48b34752d7bd939ae556a6e8de9fa0837077ec48.png"
                            alt="Form Forged Series"
                            class="h-[100px] md:h-[140px]"
                        />
                    </div>
                    <div class="flex-1">
                        <p class="text-[14px] md:text-[16px] text-black leading-[20px] md:leading-[24px]">
                            Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility—without compromising daily drivability. <a href="#" class="text-e5-red underline">Click about read more about our Form Forged series</a>.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Three Wheels Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-8 md:mb-12">
                <!-- Sebring -->
                <div class="text-center">
                    <div class="mb-4 md:mb-6">
                        <img
                            src="/assets/images/wheels-new/6633a5fa3fbf86ab9e4ebada3acfa83d7ae98d30.png"
                            alt="Sebring"
                            class="w-full max-w-[250px] md:max-w-[300px] mx-auto"
                        />
                    </div>
                    <img
                        src="/assets/images/wheels-new/90f6c4d4b52eb6c3ec25ae4927cf62a98d647c4d.png"
                        alt="Sebring"
                        class="h-[24px] md:h-[29px] mx-auto mb-4 md:mb-6"
                    />
                    <div class="space-y-1 md:space-y-2 mb-4 md:mb-6">
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">GLOSS BLACK</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                        <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                    </div>
                    <a
                        href={WHEELS_SEBRING_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        EXPLORE SEBRING
                    </a>
                </div>

                <!-- Daytona -->
                <div class="text-center">
                    <div class="mb-4 md:mb-6">
                        <img
                            src="/assets/images/wheels-new/80cf38509a5d16588f6e494cb2d89f353487504c.png"
                            alt="Daytona"
                            class="w-full max-w-[250px] md:max-w-[300px] mx-auto"
                        />
                    </div>
                    <img
                        src="/assets/images/wheels-new/bf617359a30df6e52e23d25ba89f15964c216df1.png"
                        alt="Daytona"
                        class="h-[22px] md:h-[27px] mx-auto mb-4 md:mb-6"
                    />
                    <div class="space-y-1 md:space-y-2 mb-4 md:mb-6">
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">GLOSS BLACK</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                        <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                    </div>
                    <a
                        href={WHEELS_DAYTONA_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        EXPLORE DAYTONA
                    </a>
                </div>

                <!-- Speedway -->
                <div class="text-center">
                    <div class="mb-4 md:mb-6">
                        <img
                            src="/assets/images/wheels-new/2cb17a45657fa348958b15419df6f796aa26a518.png"
                            alt="Speedway"
                            class="w-full max-w-[250px] md:max-w-[300px] mx-auto"
                        />
                    </div>
                    <img
                        src="/assets/images/wheels-new/5a059fba9b6f32612b072a121dc09766ef507b86.png"
                        alt="Speedway"
                        class="h-[23px] md:h-[28px] mx-auto mb-4 md:mb-6"
                    />
                    <div class="space-y-1 md:space-y-2 mb-4 md:mb-6">
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">TITANIUM BRUSHED TINT</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">EXCLUSIVELY FOR C6_C7_C8</p>
                        <p class="text-[12px] md:text-[16px] text-black tracking-[2.4px] md:tracking-[3.2px] uppercase">3 PREMIUM FINISHES</p>
                        <p class="text-[12px] md:text-[16px] text-black font-bold tracking-[2.4px] md:tracking-[3.2px] uppercase">IN STOCK</p>
                    </div>
                    <a
                        href={WHEELS_SPEEDWAY_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        EXPLORE SPEEDWAY
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Vette Gallery Banner -->
    <section class="relative h-[280px] md:h-[380px] w-full">
        <img
            src="/assets/images/wheels-new/195456d72b224f9b92ca6b410ac88f61fad3db24.png"
            alt="Vette Gallery"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-start">
            <div class="max-w-[1583px] mx-auto px-6 md:px-12 w-full">
                <div class="text-white">
                    <h2 class="text-[32px] md:text-[48px] font-franklin-heavy tracking-[-0.64px] md:tracking-[-0.96px] uppercase leading-[28px] md:leading-[37px] mb-2 md:mb-3">
                        VETTE GALLERY
                    </h2>
                    <p class="text-[16px] md:text-[20px] tracking-[-0.32px] md:tracking-[-0.48px] leading-[18px] md:leading-[23px] mb-4 md:mb-6">
                        Corvettes in their element.
                    </p>
                    <a
                        href={GALLERY_VEHICLES_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        VIEW GALLERY
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Wheel Gallery Banner -->
    <section class="relative h-[280px] md:h-[380px] w-full">
        <img
            src="/assets/images/wheels-new/38f473e1f45f9c800e13c02c7283b158fad81634.png"
            alt="Wheel Gallery"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-start md:justify-end">
            <div class="max-w-[1583px] mx-auto px-6 md:px-12 w-full">
                <div class="text-white text-left md:text-right ml-0 md:ml-auto max-w-full md:max-w-[400px]">
                    <h2 class="text-[32px] md:text-[48px] font-franklin-heavy tracking-[-0.64px] md:tracking-[-0.96px] uppercase leading-[28px] md:leading-[37px] mb-2 md:mb-3">
                        WHEEL GALLERY
                    </h2>
                    <p class="text-[16px] md:text-[20px] tracking-[-0.32px] md:tracking-[-0.48px] leading-[18px] md:leading-[23px] mb-4 md:mb-6">
                        Our wheels, up close & personal.
                    </p>
                    <a
                        href={GALLERY_WHEELS_ROUTE}
                        class="inline-block bg-e5-red text-white px-6 md:px-8 py-3 md:py-4 text-[14px] md:text-[16px] font-franklin-demi tracking-[2px] md:tracking-[2.4px] uppercase hover:bg-e5-red/90 transition-colors"
                    >
                        VIEW GALLERY
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
