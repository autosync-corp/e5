---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    DAYTONA_BRAND_NAME,
    DAYTONA_BRONZE_BRUSHED_TINT,
    DAYTONA_DETAIL_1,
    DAYTONA_DETAIL_2,
    DAYTONA_DETAIL_3,
    DAYTONA_DETAIL_4,
    DAYTONA_DETAILS_BANNER,
    DAYTONA_GALLERY_BANNER_1,
    DAYTONA_GALLERY_BANNER_2,
    DAYTONA_GLOSS_BLACK,
    DAYTONA_HERO_IMAGE,
    DAYTONA_LIGHTWEIGHT_DESIGN_BANNER,
    DAYTONA_LOGO,
    DAYTONA_MOTORSPORT_STYLING_BANNER,
    DAYTONA_PRECISION_FITMENT_BANNER,
    DAYTONA_STILLS_BANNER,
    DAYTONA_TITANIUM_BRUSHED_TINT,
    FORM_FORGED_LOGO_BLACK,
    PROCESS_DIAGRAM_1,
    PROCESS_DIAGRAM_2,
    PROCESS_DIAGRAM_3, PROCESS_DIAGRAM_4,
    SEBRING_BRAND_NAME,
    SEBRING_GLOSS_BLACK,
    SEBRING_LOGO,
    SPEEDWAY_BRAND_NAME,
    SPEEDWAY_LOGO,
    SPEEDWAY_TITANIUM_BRUSHED_TINT_BEAUTY_LEFT,
} from "@/pages/wheels/constants/Wheels.ts";
import Button from "@/core/components/Button.vue";
import BannerFullWidthWithLegend from "@/core/components/BannerFullWidthWithLegend.vue";
import {Orientations} from "@/core/types/App.ts";
import ImageWithLegend from "@/core/components/ImageWithLegend.vue";
import {GALLERY_WHEELS_ROUTE, SHOP_ROUTE, WHEELS_SEBRING_ROUTE, WHEELS_SPEEDWAY_ROUTE, PROCESS_FORM_FORGED_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";

// Build product URLs
const glossBlackUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black');
const titaniumBrushedUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed');
const bronzeBrushedUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed');
const shopDaytonaUrl = `${SHOP_ROUTE}?series=${DAYTONA_BRAND_NAME}`;

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Daytona - Form Forged Corvette Wheels | E5 Wheels';
const description = 'Lightest wheel in our Form Forged Series. 10-spoke design with bold deep profile, exclusively engineered for Corvette C5, C6, C7, and C8.';
const canonicalUrl = `${baseUrl}/wheels/daytona`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <BannerFullWidthWithLegend class="h-[300px] sm:h-[400px] md:h-[500px] lg:h-[636px] xl:h-[750px]" image={DAYTONA_HERO_IMAGE} alt={DAYTONA_BRAND_NAME} orientation={Orientations.CENTER} />

    <!-- Logo and Description -->
    <section class="container-e5 py-12 md:py-20 px-6 md:px-12">
        <div class="flex flex-col lg:flex-row justify-between items-start mb-8 md:mb-12">
            <img src={DAYTONA_LOGO} alt="Daytona Logo" class="w-full max-w-[400px] md:max-w-[684px] h-auto" />
            <img src={FORM_FORGED_LOGO_BLACK} alt="Form Forged" class="w-[140px] md:w-[195px] h-auto mt-6 md:mt-8 lg:mt-0" />
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-franklin-heavy text-black text-center mb-8">
            DAYTONA FORM FORGED WHEELS
        </h1>

        <p class="text-[16px] md:text-[24px] leading-[22px] md:leading-[30px] text-black/50 mb-12 md:mb-16 max-w-[1024px]">
            The Daytona is the lightest wheel in our Form Forged Series — a 10-spoke design with a bold deep profile and precision engineering. Built exclusively  for Corvette fitments, it delivers uncompromising strength, reduced weight, and aggressive styling that's equally at home on the street or track.
        </p>

        <h2 class="text-center text-[14px] md:text-[20px] tracking-[2.8px] md:tracking-[4px] text-black/45 uppercase mb-8 md:mb-12">
            EXCLUSIVELY ENGINEERED FOR CORVETTES
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <a href={glossBlackUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_GLOSS_BLACK}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    </div>
                </ImageWithLegend>
            </a>

            <a href={titaniumBrushedUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_TITANIUM_BRUSHED_TINT}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    </div>
                </ImageWithLegend>
            </a>

            <a href={bronzeBrushedUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_BRONZE_BRUSHED_TINT}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">BRONZE BRUSHED TINT</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    </div>
                </ImageWithLegend>
            </a>
        </div>

        <div class="text-center mt-8 md:mt-12">
            <Button client:visible primary class="px-12 md:px-16 text-[14px] md:text-[16px]" link={shopDaytonaUrl}>
              <span>
                SHOP {DAYTONA_BRAND_NAME}
              </span>
            </Button>
        </div>
    </section>

    <!-- Precision Fitment Banner -->
    <BannerFullWidthWithLegend
            alt={`${DAYTONA_BRAND_NAME} Precision Fitment`}
            image={DAYTONA_PRECISION_FITMENT_BANNER}
            orientation={Orientations.LEFT}
            class="h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px] relative"
    >
        <article class="absolute top-0 left-0 max-w-[90%] md:max-w-[1024px] px-6 md:px-8 lg:px-20 h-full bg-white/95 md:bg-white lg:bg-transparent py-8 md:py-12">
            <h2 class="text-[28px] md:text-[48px] uppercase tracking-[5.6px] md:tracking-[9.6px]">
                <span class="text-e5-red">Precision Fitment</span>
            </h2>
            <p class="text-[14px] md:text-[20px] text-black/60 uppercase tracking-[2.8px] md:tracking-[4.8px] leading-[20px] md:leading-[30px]">
                Exclusively engineered for Corvettes, the Daytona locks in perfect stance, hub-centric balance, and uncompromising stability.
            </p>

            <div class="mt-12 md:mt-28">
                <Button client:visible secondary class="px-12 md:px-28 text-[14px] md:text-[16px]" link={PROCESS_FORM_FORGED_ROUTE}>
                    <span class="text-[16px] md:text-[20px] font-black tracking-[1.5px]">LEARN ABOUT<br/>OUR PROCESS</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Lightweight Design Banner -->
    <BannerFullWidthWithLegend
            alt={`${DAYTONA_BRAND_NAME} Lightweight Design`}
            image={DAYTONA_LIGHTWEIGHT_DESIGN_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px]"
            bgColor="bg-black/20 lg:bg-transparent"
    >
        <article class="max-w-[90%] md:max-w-[720px] mb-12 md:mb-80 px-6 md:px-0">
            <h2 class="text-[28px] md:text-[48px] uppercase tracking-[5.6px] md:tracking-[9.6px] leading-[32px] md:leading-[48px] mb-4 md:mb-6">
                <span class="text-e5-red">LIGHTWEIGHT DESIGN</span>
            </h2>
            <p class="text-[14px] md:text-[20px] text-gray-100 lg:text-black/60 uppercase tracking-[2.8px] md:tracking-[4.8px] leading-[20px] md:leading-[30px]">
                We carve away excess material with purpose. Every cut reduces weight, sharpens response, and delivers rotational performance you can feel.
            </p>
        </article>
    </BannerFullWidthWithLegend>

    <BannerFullWidthWithLegend
            alt={`${DAYTONA_BRAND_NAME} Motorsport Styling`}
            image={DAYTONA_MOTORSPORT_STYLING_BANNER}
            orientation={Orientations.LEFT}
            class="h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px] border-t-2 border-b-2 border-e5-red"
            bgColor="bg-black/20 lg:bg-transparent"
    >
        <article class="max-w-[90%] md:max-w-[720px] h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px] flex flex-col justify-end mb-12 md:mb-24 px-6 md:px-0">
            <h2 class="text-[28px] md:text-[48px] uppercase tracking-[5.6px] md:tracking-[9.6px]">
                <span class="text-e5-red">MOTORSPORT STYLING</span>
            </h2>
            <p class="text-[14px] md:text-[20px] text-gray-100 lg:text-black/60 uppercase tracking-[2.8px] md:tracking-[4.8px]">
                A deep concave profile and aggressive spoke geometry bring race-bred character to the street without sacrificing refinement.
            </p>
        </article>
    </BannerFullWidthWithLegend>

    <BannerFullWidthWithLegend
            alt={`${DAYTONA_BRAND_NAME} Motorsport Styling`}
            image={DAYTONA_DETAILS_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px] border-t-2 border-b-2 border-e5-red"
            bgColor="bg-black/20 lg:bg-transparent"
    >
        <article class="max-w-[90%] md:max-w-[720px] h-[350px] sm:h-[450px] md:h-[600px] lg:h-[750px] xl:h-[874px] flex flex-col justify-end mb-12 md:mb-24 text-start md:text-end px-6 md:px-0">
            <h2 class="text-[28px] md:text-[48px] uppercase tracking-[5.6px] md:tracking-[9.6px]">
                <span class="text-e5-red">DETAILS MATTER</span>
            </h2>
            <p class="text-[14px] md:text-[20px] text-gray-100 lg:text-black/60 uppercase tracking-[2.8px] md:tracking-[4.8px]">
                A CLOSER LOOK INTO E5 ENGINEERING.
            </p>

            <div class="my-8 md:my-12 flex justify-start md:justify-end">
                <Button client:visible secondary class="px-12 md:px-16 text-[14px] md:text-[16px]" link={GALLERY_WHEELS_ROUTE}>
                    <span class="text-[16px] md:text-[20px] font-black tracking-[1.5px]">VIEW<br/>WHEEL GALLERY</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Stills Banner -->
    <section class="w-full h-[300px] sm:h-[400px] md:h-[500px] lg:h-[600px] xl:h-[716px] relative overflow-hidden">
        <img src={DAYTONA_STILLS_BANNER} alt="Daytona Details" class="w-full h-full object-cover" />
    </section>

    <!-- Our Process Section -->
    <section class="container-e5 py-12 md:py-20 text-center px-6 md:px-12">
        <h2 class="text-[28px] md:text-[48px] tracking-[5.6px] md:tracking-[9.6px] leading-[32px] md:leading-[48px] text-e5-red uppercase mb-4 md:mb-6">
            OUR PROCESS
        </h2>
        <p class="text-[14px] md:text-[18px] tracking-[2.8px] md:tracking-[4.8px] leading-[18px] text-black/50 uppercase max-w-[1485px] mx-auto my-8 md:my-12">
            Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility—without compromising daily drivability.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 md:gap-16">
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[14px] md:text-[16px] tracking-[3px] font-bold uppercase">STEP 1</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_1} alt="Step 1">
                    <b class="text-[14px] md:text-[16px]">CAST PREFORM & DESIGN</b>
                    <span class="text-[12px] md:text-[14px]">Initial cast preform with design.</span>
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[14px] md:text-[16px] tracking-[3px] font-bold uppercase">STEP 2</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_2} alt="Step 2">
                    <b class="text-[14px] md:text-[16px]">HEATING & SPINNING</b>
                    <span class="text-[12px] md:text-[14px]">Heated workpiece rotated on mandrel.</span>
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[14px] md:text-[16px] tracking-[3px] font-bold uppercase">STEP 3</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_3} alt="Step 3">
                    <b class="text-[14px] md:text-[16px]">FLOW FORMING STRETCH</b>
                    <span class="text-[12px] md:text-[14px]">Rollers stretch and widen the barrel</span>
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-4 text-e5-red text-[14px] md:text-[16px] tracking-[3px] font-bold uppercase">STEP 4</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_4} alt="Step 4">
                    <b class="text-[14px] md:text-[16px]">FINAL PROFILE</b>
                    <span class="text-[12px] md:text-[14px]">Finished barrel is significantly stronger and lighter.</span>
                </ImageWithLegend>
            </div>
        </div>
    </section>

    <!-- Finishing Section -->
    <section class="container-e5 pb-8 md:pb-12 text-center px-6 md:px-12">
        <h2 class="text-[28px] md:text-[48px] tracking-[5.6px] md:tracking-[9.6px] leading-[32px] md:leading-[48px] text-e5-red uppercase mb-4 md:mb-6">
            FINISHING
        </h2>
        <p class="text-[14px] md:text-[18px] tracking-[2.8px] md:tracking-[4.8px] leading-[18px] text-black/50 uppercase max-w-[1485px] mx-auto my-8 md:my-16">
            Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all <span class="text-[#d31d25]/65">backed by our 5-year finishing warranty</span>.
        </p>
    </section>

    <!-- Detail Images Grid -->
    <section class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2">
            <img src={DAYTONA_DETAIL_1} alt="Detail 1" class="w-full h-auto" />
            <img src={DAYTONA_DETAIL_3} alt="Detail 3" class="w-full h-auto" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2">
            <img src={DAYTONA_DETAIL_2} alt="Detail 2" class="w-full h-auto" />
            <img src={DAYTONA_DETAIL_4} alt="Detail 4" class="w-full h-auto" />
        </div>
    </section>

    <!-- Gallery Banner 1 -->
    <section class="w-full h-[300px] sm:h-[400px] md:h-[500px] lg:h-[600px] xl:h-[716px] relative overflow-hidden border-t-2 border-b-2 border-e5-red">
        <img src={DAYTONA_GALLERY_BANNER_1} alt="Daytona Gallery" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/5"></div>
    </section>

    <!-- Shop Section with Three Wheels -->
    <section class="container-e5 py-12 md:py-16 px-6 md:px-12">
        <h2 class="text-center text-[14px] md:text-[20px] tracking-[2.8px] md:tracking-[4px] text-black/45 uppercase mb-8 md:mb-12">
            EXCLUSIVELY ENGINEERED FOR CORVETTES
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <a href={glossBlackUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_GLOSS_BLACK}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                        <Button client:visible primary class="mt-6 md:mt-8 text-[14px] md:text-[16px]" link={glossBlackUrl}>
                            SHOP NOW
                        </Button>
                    </div>
                </ImageWithLegend>
            </a>

            <a href={titaniumBrushedUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_TITANIUM_BRUSHED_TINT}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                        <Button client:visible primary class="mt-6 md:mt-8 text-[14px] md:text-[16px]" link={titaniumBrushedUrl}>
                            SHOP NOW
                        </Button>
                    </div>
                </ImageWithLegend>
            </a>

            <a href={bronzeBrushedUrl} class="block hover:opacity-80 transition-opacity">
                <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_BRONZE_BRUSHED_TINT}>
                    <div class="text-center">
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">BRONZE BRUSHED TINT</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C5_C6_C7_C8</p>
                        <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                        <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                        <Button client:visible primary class="mt-6 md:mt-8 text-[14px] md:text-[16px]" link={bronzeBrushedUrl}>
                            SHOP NOW
                        </Button>
                    </div>
                </ImageWithLegend>
            </a>
        </div>
    </section>

    <BannerFullWidthWithLegend
            alt={`${DAYTONA_BRAND_NAME} GALLERY`}
            image={DAYTONA_GALLERY_BANNER_2}
            orientation={Orientations.RIGHT}
            class="h-[300px] sm:h-[400px] md:h-[500px] lg:h-[600px] xl:h-[716px] border-t-2 border-b-2 border-e5-red"
    >
        <article class="max-w-[90%] md:max-w-[720px] h-[300px] sm:h-[400px] md:h-[500px] lg:h-[600px] xl:h-[716px] pl-6 md:pl-24 md:text-end pt-8 md:pt-12 px-6 md:px-0">
            <h2 class="text-[28px] md:text-[48px] uppercase tracking-[5.6px] md:tracking-[9.6px]">
                <span class="text-e5-red">DAYTONA GALLERY</span>
            </h2>
            <p class="text-[14px] md:text-[20px] text-white uppercase tracking-[2.8px] md:tracking-[4.8px]">
                A CLOSER LOOK INTO E5 ENGINEERING.
            </p>

            <div class="my-8 md:my-12">
                <Button client:visible secondary class="px-12 md:px-16 border-e5-red text-e5-red text-[14px] md:text-[16px]" link={GALLERY_WHEELS_ROUTE}>
                    <span class="text-[16px] md:text-[20px] font-black tracking-[1.5px]">VIEW DAYTONA<br/>GALLERY</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Discover More Form Forged Series Wheels -->
    <section class="container-e5 pt-12 md:pt-16 px-6 md:px-12">
        <h2 class="text-center text-[14px] md:text-[20px] tracking-[2.8px] md:tracking-[4px] text-black/50 uppercase mb-8 md:mb-12">
            DISCOVER MORE FORM FORGED SERIES WHEELS
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 mb-8 md:mb-12">
            <ImageWithLegend alt={SEBRING_BRAND_NAME} image={SEBRING_GLOSS_BLACK}>
                <div class="text-center">
                    <img src={SEBRING_LOGO} alt={SEBRING_BRAND_NAME} class="mx-auto mb-3 md:mb-4 h-[24px] md:h-[28px]" />
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">EXCLUSIVELY FOR C6_C7_C8</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">AVAILABLE IN OTHER FINISHES</p>
