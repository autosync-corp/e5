---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    SONOMA_BRAND_NAME,
    SONOMA_BRONZE_BRUSHED_TINT,
    SONOMA_DETAIL_1,
    SONOMA_DETAIL_2,
    SONOMA_DETAIL_3,
    SONOMA_DETAIL_4,
    SONOMA_VETTE_GALLERY_BANNER,
    SONOMA_FORGED_GALLERY_BANNER,
    SONOMA_GLOSS_BLACK,
    SONOMA_HERO_IMAGE,
    SONOMA_LIGHTWEIGHT_DESIGN_BANNER,
    SONOMA_LOGO,
    SONOMA_MOTORSPORT_STYLING_BANNER,
    SONOMA_PRECISION_FITMENT_BANNER,
    SONOMA_TITANIUM_BRUSHED_TINT,
    E5_FORGED_LOGO,
    PROCESS_DIAGRAM_1,
    PROCESS_DIAGRAM_2,
    PROCESS_DIAGRAM_3,
    PROCESS_DIAGRAM_4,
    DAYTONA_BRAND_NAME,
    DAYTONA_GLOSS_BLACK,
    DAYTONA_LOGO,
    SPEEDWAY_BRAND_NAME,
    SPEEDWAY_LOGO,
    SPEEDWAY_TITANIUM_BRUSHED_TINT_BEAUTY_LEFT,
} from "@/pages/wheels/constants/Wheels.ts";
import Button from "@/core/components/Button.vue";
import BannerFullWidthWithLegend from "@/core/components/BannerFullWidthWithLegend.vue";
import {Orientations} from "@/core/types/App.ts";
import ImageWithLegend from "@/core/components/ImageWithLegend.vue";
import {GALLERY_WHEELS_ROUTE, WHEELS_ROUTE, SHOP_ROUTE} from "@/core/constants/Routes.ts";
---

<MainLayout title="Sonoma - E5 Wheels">
    <BannerFullWidthWithLegend class="h-[400px] md:h-[500px] lg:h-[636px]" image={SONOMA_HERO_IMAGE} alt={SONOMA_BRAND_NAME} orientation={Orientations.CENTER} />

    <!-- Logo and Description -->
    <section class="container-e5 py-12 md:py-16 lg:py-20">
        <div class="flex flex-col lg:flex-row justify-between items-start mb-8 md:mb-12">
            <img src={SONOMA_LOGO} alt="Sonoma Logo" class="w-full max-w-[500px] lg:max-w-[684px] h-auto mx-auto lg:mx-0" />
            <img src={E5_FORGED_LOGO} alt="E5 Forged" class="w-[150px] md:w-[195px] h-auto mt-6 md:mt-8 lg:mt-0 mx-auto lg:mx-0" />
        </div>

        <p class="text-[18px] md:text-[20px] lg:text-[24px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/50 mb-12 md:mb-16 max-w-[1024px]">
            The Sonoma expands our E5 Forged Series with a refined, performance-focused mesh profile that's fully forged, weight-optimized, and Made in the USA. Designed with precision-cut pocketing and a clean, elevated aesthetic, it brings both visual clarity and driving precision.
        </p>

        <h2 class="text-center text-[16px] md:text-[18px] lg:text-[20px] tracking-[3px] md:tracking-[4px] text-black/45 uppercase mb-8">
            EXCLUSIVELY ENGINEERED FOR C8 Z06, ZR1, E-RAY
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_GLOSS_BLACK}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                </div>
            </ImageWithLegend>

            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_TITANIUM_BRUSHED_TINT}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                </div>
            </ImageWithLegend>

            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_BRONZE_BRUSHED_TINT}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">DARK BRONZE</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                </div>
            </ImageWithLegend>
        </div>

        <div class="text-center mt-8 md:mt-12">
            <Button client:visible primary class="px-12 md:px-16" link={`${SHOP_ROUTE}?series=${SONOMA_BRAND_NAME}`}>
              <span>
                SHOP {SONOMA_BRAND_NAME}
              </span>
            </Button>
        </div>
    </section>

    <!-- Our Process Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
        <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[42px] lg:leading-[48px] text-e5-red uppercase mb-4 md:mb-6">
            OUR PROCESS
        </h2>
        <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] leading-[16px] md:leading-[17px] lg:leading-[18px] text-black/50 uppercase max-w-[1485px] mx-auto my-8 md:my-10 lg:my-12 px-4">
            Through advanced flow forming, we transform aerospace-grade aluminum into wheels that are lighter, stronger, and precision-balanced. This process refines the barrel's grain structure, delivering forged-level performance without compromise.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 md:gap-12 lg:gap-16">
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-3 md:px-4 text-e5-red text-[14px] md:text-[16px] tracking-[2px] md:tracking-[3px] font-bold uppercase">STEP 1</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_1} alt="Step 1">
                    <b>CAST PREFORM & DESIGN</b>
                    Initial cast preform with design.
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-3 md:px-4 text-e5-red text-[14px] md:text-[16px] tracking-[2px] md:tracking-[3px] font-bold uppercase">STEP 2</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_2} alt="Step 2">
                    <b>HEATING & SPINNING</b>
                    Heated workpiece rotated on mandrel.
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-3 md:px-4 text-e5-red text-[14px] md:text-[16px] tracking-[2px] md:tracking-[3px] font-bold uppercase">STEP 3</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_3} alt="Step 3">
                    <b>FLOW FORMING STRETCH</b>
                    Rollers stretch and widen the barrel
                </ImageWithLegend>
            </div>
            <div>
                <div class="relative flex items-center justify-center mb-6 md:mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-e5-red"></div>
                    </div>
                    <span class="relative bg-white px-3 md:px-4 text-e5-red text-[14px] md:text-[16px] tracking-[2px] md:tracking-[3px] font-bold uppercase">STEP 4</span>
                </div>
                <ImageWithLegend image={PROCESS_DIAGRAM_4} alt="Step 4">
                    <b>FINAL PROFILE</b>
                    Finished barrel is significantly stronger and lighter.
                </ImageWithLegend>
            </div>
        </div>
    </section>

    <!-- Finishing Section -->
    <section class="container-e5 pb-6 md:pb-8 text-center px-4">
        <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[42px] lg:leading-[48px] text-e5-red uppercase mb-4 md:mb-6">
            FINISHING
        </h2>
        <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] leading-[16px] md:leading-[17px] lg:leading-[18px] text-black/50 uppercase max-w-[1485px] mx-auto my-8 md:my-12 lg:my-16">
            Our E5 Forged Series is available in Gloss Black, Titanium Brushed Tint, AND Dark Bronze— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all <span class="text-[#d31d25]/65">backed by our 5-year finishing warranty</span>.
        </p>
    </section>

    <!-- Detail Images Grid -->
    <section class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2">
            <img src={SONOMA_DETAIL_1} alt="Detail 1" class="w-full h-auto" />
            <img src={SONOMA_DETAIL_3} alt="Detail 3" class="w-full h-auto" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2">
            <img src={SONOMA_DETAIL_2} alt="Detail 2" class="w-full h-auto" />
            <img src={SONOMA_DETAIL_4} alt="Detail 4" class="w-full h-auto" />
        </div>
    </section>

    <!-- Shop Section with Three Wheels -->
    <section class="container-e5 py-12 md:py-16">
        <h2 class="text-center text-[16px] md:text-[18px] lg:text-[20px] tracking-[3px] md:tracking-[4px] text-black/45 uppercase mb-8">
            EXCLUSIVELY ENGINEERED FOR C8 Z06, ZR1, E-RAY
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_GLOSS_BLACK}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    <Button client:visible primary class="mt-6 md:mt-8" link={`${SHOP_ROUTE}?series=${SONOMA_BRAND_NAME}`}>
                        SHOP NOW
                    </Button>
                </div>
            </ImageWithLegend>

            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_TITANIUM_BRUSHED_TINT}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    <Button client:visible primary class="mt-6 md:mt-8" link={`${SHOP_ROUTE}?series=${SONOMA_BRAND_NAME}`}>
                        SHOP NOW
                    </Button>
                </div>
            </ImageWithLegend>

            <ImageWithLegend alt={SONOMA_BRAND_NAME} image={SONOMA_BRONZE_BRUSHED_TINT}>
                <div class="text-center">
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">DARK BRONZE</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">AVAILABLE FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">STARTING AT $600 PER WHEEL</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    <Button client:visible primary class="mt-6 md:mt-8" link={`${SHOP_ROUTE}?series=${SONOMA_BRAND_NAME}`}>
                        SHOP NOW
                    </Button>
                </div>
            </ImageWithLegend>
        </div>
    </section>

    <!-- Discover More E5 Forged Series Wheels -->
    <section class="container-e5 pt-8 md:pt-12 px-4">
        <h2 class="text-center text-[16px] md:text-[18px] lg:text-[20px] tracking-[3px] md:tracking-[4px] text-black/50 uppercase mb-8">
            DISCOVER MORE E5 FORGED SERIES WHEELS
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 lg:gap-16 mb-8 md:mb-12">
            <ImageWithLegend alt={DAYTONA_BRAND_NAME} image={DAYTONA_GLOSS_BLACK}>
                <div class="text-center">
                    <img src={DAYTONA_LOGO} alt={DAYTONA_BRAND_NAME} class="mx-auto mb-4 h-[24px] md:h-[28px]" />
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">EXCLUSIVELY FOR C5_C6_C7_C8</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">AVAILABLE IN OTHER FINISHES</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    <Button client:visible primary class="mt-6 md:mt-8" link={`${WHEELS_ROUTE}/${DAYTONA_BRAND_NAME.toLowerCase()}`}> EXPLORE {DAYTONA_BRAND_NAME} </Button>
                </div>
            </ImageWithLegend>

            <ImageWithLegend alt={SPEEDWAY_BRAND_NAME} image={SPEEDWAY_TITANIUM_BRUSHED_TINT_BEAUTY_LEFT}>
                <div class="text-center">
                    <img src={SPEEDWAY_LOGO} alt={SPEEDWAY_BRAND_NAME} class="mx-auto mb-4 h-[24px] md:h-[28px]" />
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/40 uppercase mb-2">EXCLUSIVELY FOR C6_C7_C8</p>
                    <p class="text-[14px] md:text-[16px] tracking-[1.5px] text-black/60 uppercase mb-2">AVAILABLE IN OTHER FINISHES</p>
                    <p class="text-[14px] md:text-[16px] text-e5-red uppercase mt-4 font-medium">IN STOCK</p>
                    <Button client:visible primary class="mt-6 md:mt-8" link={`${WHEELS_ROUTE}/${SPEEDWAY_BRAND_NAME.toLowerCase()}`}> EXPLORE {SPEEDWAY_BRAND_NAME} </Button>
                </div>
            </ImageWithLegend>
        </div>
    </section>

    <!-- Cut to Perform Banner -->
    <BannerFullWidthWithLegend
            alt={`${SONOMA_BRAND_NAME} Cut to Perform`}
            image={SONOMA_PRECISION_FITMENT_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[500px] md:h-[700px] lg:h-[874px] relative"
    >
        <article class="max-w-full md:max-w-[720px] px-6 md:px-8 lg:px-0 mb-12 md:mb-24 lg:mb-80 text-center md:text-right">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] uppercase tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[42px] lg:leading-[48px] mb-4 md:mb-6">
                <span>CUT TO </span><span class="text-e5-red">PERFORM</span>
            </h2>
            <p class="text-[16px] md:text-[18px] lg:text-[20px] text-white uppercase tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] leading-[24px] md:leading-[28px] lg:leading-[30px]">
                We carve away excess to optimize strength-to-weight, reduce inertia, and turn every ounce into performance.
            </p>

            <div class="mt-12 md:mt-20 lg:mt-28 flex justify-center md:justify-end">
                <Button client:visible secondary class="px-12 md:px-20 lg:px-28 border-e5-red text-e5-red" link="/process">
                    <span class="text-[16px] md:text-[18px] lg:text-[20px] font-black tracking-[1.5px]">LEARN ABOUT<br/>OUR PROCESS</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Engineered Depth Banner -->
    <BannerFullWidthWithLegend
            alt={`${SONOMA_BRAND_NAME} Engineered Depth`}
            image={SONOMA_LIGHTWEIGHT_DESIGN_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[500px] md:h-[700px] lg:h-[874px]"
    >
        <article class="max-w-full md:max-w-[720px] px-6 md:px-8 lg:px-0 mb-12 md:mb-24 lg:mb-80 text-center md:text-right">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] uppercase tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[42px] lg:leading-[48px] mb-4 md:mb-6">
                <span>ENGINEERED </span><span class="text-e5-red">DEPTH</span>
            </h2>
            <p class="text-[16px] md:text-[18px] lg:text-[20px] text-white uppercase tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] leading-[24px] md:leading-[28px] lg:leading-[30px]">
                Engineered for performance. Wider tire setups, greater grip, sharper handling, and improved brake clearance.
            </p>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Our Foundation Your Vision Banner -->
    <BannerFullWidthWithLegend
            alt={`${SONOMA_BRAND_NAME} Our Foundation Your Vision`}
            image={SONOMA_MOTORSPORT_STYLING_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[500px] md:h-[700px] lg:h-[874px] border-t-2 border-b-2 border-e5-red [&_img]:scale-[2] [&_img]:origin-right [&_img]:object-cover"
    >
        <article class="max-w-full md:max-w-[720px] px-6 md:px-8 lg:px-0 h-full flex flex-col justify-end pb-12 md:pb-20 lg:pb-24 text-center md:text-right">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] uppercase tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[42px] lg:leading-[48px] mb-4 md:mb-6">
                <span>OUR FOUNDATION, YOUR </span><span class="text-e5-red">VISION</span>
            </h2>
            <p class="text-[16px] md:text-[18px] lg:text-[20px] text-white uppercase tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] leading-[24px] md:leading-[28px] lg:leading-[30px]">
                Every E5 Forged wheel begins as a foundation of strength and precision. Finishing is yours to define.
            </p>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Vette Gallery Banner -->
    <BannerFullWidthWithLegend
            alt={`${SONOMA_BRAND_NAME} Vette Gallery`}
            image={SONOMA_VETTE_GALLERY_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[500px] md:h-[600px] lg:h-[716px] border-t-2 border-b-2 border-e5-red"
    >
        <article class="max-w-full md:max-w-[720px] px-6 md:px-8 lg:px-0 h-full flex flex-col justify-center md:justify-start pt-8 md:pt-12 text-center md:text-right">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] uppercase tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] mb-3 md:mb-4">
                <span class="text-e5-red">VETTE GALLERY</span>
            </h2>
            <p class="text-[16px] md:text-[18px] lg:text-[24px] text-white uppercase tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] mb-6 md:mb-8 lg:mb-12">
                THE SONOMA IN THE WILD.
            </p>

            <div class="flex justify-center md:justify-end">
                <Button client:visible secondary class="px-12 md:px-16 border-e5-red text-e5-red" link={GALLERY_WHEELS_ROUTE}>
                    <span class="text-[16px] md:text-[18px] lg:text-[20px] font-black tracking-[1.5px]">VIEW SONOMA<br/>GALLERY</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <!-- Forged Gallery Banner -->
    <BannerFullWidthWithLegend
            alt={`${SONOMA_BRAND_NAME} Forged Gallery`}
            image={SONOMA_FORGED_GALLERY_BANNER}
            orientation={Orientations.RIGHT}
            class="h-[500px] md:h-[600px] lg:h-[716px] border-t-2 border-b-2 border-e5-red"
    >
        <article class="max-w-full md:max-w-[720px] px-6 md:px-8 lg:pl-24 lg:pr-0 h-full flex flex-col justify-center md:justify-start pt-8 md:pt-12 text-center md:text-right">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] uppercase tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] mb-3 md:mb-4">
                <span class="text-e5-red">FORGED GALLERY</span>
            </h2>
            <p class="text-[16px] md:text-[18px] lg:text-[24px] text-white uppercase tracking-[3px] md:tracking-[4px] lg:tracking-[4.8px] mb-6 md:mb-8 lg:mb-12">
                UP CLOSE AND PERSONAL.
            </p>

            <div class="flex justify-center md:justify-end">
                <Button client:visible secondary class="px-12 md:px-16 border-e5-red text-e5-red" link={GALLERY_WHEELS_ROUTE}>
                    <span class="text-[16px] md:text-[18px] lg:text-[20px] font-black tracking-[1.5px]">VIEW FORGED<br/>WHEEL GALLERY</span>
                </Button>
            </div>
        </article>
    </BannerFullWidthWithLegend>

    <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
        BACK TO TOP
    </div>
</MainLayout>
