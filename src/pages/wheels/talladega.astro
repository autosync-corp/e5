---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    TALLADEGA_LOGO,
    TALLADEGA_BRAND_NAME,
    WHEEL_GALLERY_STUDIO_BANNER,
    TALLADEGA_SHOT_2,
    TALLADEGA_SHOT_1,
    TALLADEGA_SHOT_3,
    TALLADEGA_HERO,
    SONOMA_LOGO,
    SONOMA_BRAND_NAME
} from "@/pages/wheels/constants/Wheels.ts";
import {VETTE_GALLERY_IMAGE_1} from "@/pages/gallery/constants/Images.ts";
import {SINGLE_PRODUCT_ROUTE} from "@/core/constants/Routes.ts";
---

<MainLayout title="Talladega - E5 Wheels">

    <!-- Hero Section -->
    <section class="w-full bg-white">
        <!-- Full Width Hero Image -->
        <div class="w-full h-[600px]">
            <img src={TALLADEGA_HERO} alt="Talladega Wheel" class="w-full h-full object-cover object-center" />
        </div>

        <!-- Content Below Image -->
        <div class="max-w-[1100px] mx-auto px-6 py-8 md:py-12">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-6">
                <!-- Left: Talladega Logo -->
                <div class="flex-1">
                    <img src={TALLADEGA_LOGO} alt="TALLADEGA" class="w-full max-w-[400px]" />
                </div>

                <!-- Right: E5 FORGED Badge -->
                <div class="flex-shrink-0">
                    <img src="/assets/images/e5-forged-logo.png" alt="E5 FORGED" class="h-[38px] md:h-[46px]" />
                </div>
            </div>

            <!-- Description Text -->
            <p class="text-[14px] md:text-[17px] leading-[20px] md:leading-[24px] text-black/70 mb-4 max-w-[700px]">
                The Talladega marks the foundation of the E5 Forged Series—a fully forged, performance-driven design that set the standard for everything that followed. Featuring a bold split Y-spoke, precision weight reduction, and a clean motorsport aesthetic, it delivers strength, balance, and driving confidence with unmistakable presence.
            </p>

            <!-- Exclusively Forged For -->
            <p class="text-[12px] md:text-[14px] tracking-[1.5px] uppercase text-black/50">
                EXCLUSIVELY FORGED FOR C8 Z06, ZR1, E-RAY.
            </p>
        </div>

        <!-- Wheel Image with Specs Section -->
        <div class="max-w-[1100px] mx-auto px-6 py-8 md:py-12">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
                <!-- Left: Wheel Image -->
                <div class="w-full md:w-1/2">
                    <img src="/assets/images/generations/c8/c8-z06-new/taladaga-c8wheel.webp" alt="Talladega Wheel" class="w-full h-auto" />
                </div>

                <!-- Right: Specs and Buttons -->
                <div class="w-full md:w-1/2">
                    <!-- Sizes -->
                    <div class="mb-6">
                        <h3 class="text-[14px] md:text-[16px] font-bold tracking-[1.5px] uppercase mb-3">SIZES</h3>
                        <ul class="text-[13px] md:text-[15px] leading-[20px] md:leading-[22px] space-y-1">
                            <li>• Front: 20x11 / Offset +25mm</li>
                            <li>• Rear: 21x13 / Offset +20mm</li>
                            <li>• Bolt Pattern: 5x130</li>
                        </ul>
                    </div>

                    <!-- Finish -->
                    <div class="mb-6">
                        <h3 class="text-[14px] md:text-[16px] font-bold tracking-[1.5px] uppercase mb-3">FINISH</h3>
                        <p class="text-[13px] md:text-[15px] leading-[20px] md:leading-[22px]">
                            • Brushed Aluminum
                        </p>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href={`${SINGLE_PRODUCT_ROUTE}?series=${TALLADEGA_BRAND_NAME}&finish=Brushed Silver`} class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors text-center">
                            SHOP TALLADEGA
                        </a>
                        <button class="bg-white text-black border border-black px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-black/5 transition-colors">
                            EXPLORE E5 FORGED
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The Forging Process -->
    <section class="bg-white py-8 md:py-12 border-t border-gray-200">
        <div class="max-w-[1100px] mx-auto px-6">
            <h2 class="text-e5-red text-[24px] md:text-[28px] font-bold tracking-[2px] uppercase mb-2 text-center">
                THE FORGING PROCESS
            </h2>
            <p class="text-[13px] md:text-[15px] tracking-[1.5px] uppercase mb-1 text-center text-black/70">
                FORGED IN THE USA. ENGINEERED WITHOUT COMPROMISE. <img src="/assets/images/process/forged/74e97b24bbd8f0fa93b10ef755682a46c52738c9.png" alt="USA Flag" class="inline-block h-[13px] w-[24px] ml-1" />
            </p>
            <p class="text-[13px] md:text-[15px] leading-[19px] md:leading-[21px] max-w-[800px] mx-auto mb-8 text-center text-black/70">
                Every E5 Forged wheel begins with purpose. Designed exclusively for Corvette platforms, our forged wheels are engineered and manufactured in the United States to meet the extreme demands of performance, precision, and strength. From aerospace-grade material selection to final finishing, each step is executed with intention—eliminating excess, reinforcing structure, and delivering uncompromising performance for the C8 Z06, ZR1, and E-Ray.
            </p>

            <!-- 5 Process Steps -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
                <div class="text-center">
                    <img src="/assets/images/process/forged/f0f3e57be69ac17bdf5d0b88a9acbb4dd11c959e.png" alt="Material" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">MATERIAL</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        6061 AEROSPACE-GRADE ALUMINUM BILLET SELECTED FOR STRENGTH AND CONSISTENCY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/809caca77164233a698d905f1d587df976aea6e3.png" alt="Forging" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">FORGING</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        HIGH-PRESSURE FORGING REFINES GRAIN STRUCTURE FOR INCREASED DENSITY AND DURABILITY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/797d5893d4a0bae48a4ccb031cafc436db1200ca.png" alt="Machine" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">MACHINE</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        5-AXIS CNC MACHINING IN CALIFORNIA REMOVES MATERIAL WITH PRECISION AND PURPOSE.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/b9590fdbbe1a9e6203dbf8fe826d0dafe9f7baba.png" alt="Refine" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">REFINE</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        HAND-FINISHED DETAILS ENSURE SYMMETRY, SHARP DEFINITION, AND VISUAL CLARITY.
                    </p>
                </div>

                <div class="text-center">
                    <img src="/assets/images/process/forged/bb6950e1bfd656ac155d1f7e1c229877ded3a542.png" alt="Finish" class="w-full h-auto mb-2" />
                    <h3 class="text-[12px] md:text-[13px] font-bold tracking-[1px] mb-1 uppercase">FINISH</h3>
                    <p class="text-[10px] md:text-[11px] leading-[13px] md:leading-[14px] text-black/70 uppercase">
                        PREMIUM FINISHES APPLIED AND INSPECTED FOR PERFORMANCE AND LONGEVITY.
                    </p>
                </div>
            </div>

            <div class="text-center">
                <button class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors">
                    LEARN MORE
                </button>
            </div>
        </div>
    </section>

    <!-- Finishing Section - Dark -->
    <section class="relative bg-black py-12 md:py-16">
        <div class="absolute inset-0 opacity-30">
            <img src={TALLADEGA_SHOT_1} alt="Finishing Background" class="w-full h-full object-cover" />
        </div>

        <div class="max-w-[1100px] mx-auto px-6 relative z-10">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
                <!-- Left: FINISHING Title -->
                <div class="w-full md:w-1/3">
                    <h2 class="text-white text-[40px] md:text-[58px] font-bold tracking-[4px] md:tracking-[6px] uppercase">
                        FINISHING
                    </h2>
                </div>

                <!-- Right: Description -->
                <div class="w-full md:w-2/3">
                    <p class="text-white text-[13px] md:text-[16px] leading-[19px] md:leading-[22px]">
                        Every wheel in the E5 Forged Collection is a statement beyond performance. Available in premium finishes like gloss black, brushed aluminum, and polished—with custom options upon request—each design highlights the precision of its forged construction. Every finish is executed with uncompromising attention to detail for a look that lasts.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Detail Images Grid -->
    <section class="bg-white py-8 md:py-12">
        <div class="w-full">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <img src={TALLADEGA_SHOT_2} alt="Talladega Detail 1" class="w-full h-auto" />
                <img src={TALLADEGA_SHOT_3} alt="Talladega Detail 2" class="w-full h-auto" />
            </div>
            <div class="w-full">
                <img src={TALLADEGA_SHOT_1} alt="Talladega Detail 3" class="w-full h-auto" />
            </div>
        </div>
    </section>

    <!-- Gallery Banners -->
    <section class="w-full py-8 md:py-12">
        <!-- Vette Gallery Banner -->
        <div class="relative h-[350px] md:h-[400px] overflow-hidden mb-8 md:mb-12">
            <img src={VETTE_GALLERY_IMAGE_1} alt="Vette Gallery" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute inset-0 flex items-end justify-start pb-12 md:pb-16 pl-8 md:pl-16">
                <article class="text-white">
                    <h2 class="text-[40px] md:text-[58px] font-bold uppercase mb-3 md:mb-4 tracking-[2px] leading-[1]">
                        VETTE GALLERY
                    </h2>
                    <p class="text-[15px] md:text-[18px] leading-[1.4]">
                        A collection of builds fitted with our wheels.
                    </p>
                </article>
            </div>
        </div>

        <!-- Wheel Gallery Banner -->
        <div class="relative h-[350px] md:h-[400px] overflow-hidden">
            <img src={WHEEL_GALLERY_STUDIO_BANNER} alt="Wheel Gallery" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute inset-0 flex items-end justify-end pb-12 md:pb-16 pr-8 md:pr-16">
                <article class="text-white text-right">
                    <h2 class="text-[40px] md:text-[58px] font-bold uppercase mb-3 md:mb-4 tracking-[2px] leading-[1]">
                        WHEEL GALLERY
                    </h2>
                    <p class="text-[15px] md:text-[18px] leading-[1.4] mb-4 md:mb-6">
                        Our wheels, up close & personal.
                    </p>
                    <button class="bg-e5-red text-white px-8 py-3 text-[13px] md:text-[14px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase">
                        VIEW GALLERY
                    </button>
                </article>
            </div>
        </div>
    </section>

    <!-- Related Wheels - Talladega + Sonoma -->
    <section class="bg-white py-8 md:py-12">
        <div class="max-w-[1000px] mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
                <!-- Talladega -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${TALLADEGA_BRAND_NAME}&finish=Brushed Silver`} class="block hover:opacity-80 transition-opacity">
                    <div class="text-center">
                        <img src="/assets/images/generations/c8/zr1-figma/taladaga-c8wheel.webp" alt="Talladega" class="w-full h-auto mb-4" />
                        <img src={TALLADEGA_LOGO} alt="TALLADEGA" class="mx-auto h-[34px] md:h-[38px] mb-4" />
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">BRUSHED ALUMINUM</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY.</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-3">CUSTOM FINISHES</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-5">MADE IN USA</p>
                        <div class="bg-e5-red text-white px-10 py-3 text-[12px] md:text-[13px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                            SHOP TALLADEGA
                        </div>
                    </div>
                </a>

                <!-- Sonoma -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SONOMA_BRAND_NAME}&finish=Brushed Silver`} class="block hover:opacity-80 transition-opacity">
                    <div class="text-center">
                        <img src="/assets/images/generations/c8/zr1-figma/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-auto mb-4" />
                        <img src={SONOMA_LOGO} alt="SONOMA" class="mx-auto h-[42px] md:h-[46px] mb-4" />
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">BRUSHED ALUMINUM</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY.</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-3">CUSTOM FINISHES</p>
                        <p class="text-[11px] md:text-[12px] tracking-[1.2px] uppercase text-black/70 mb-5">MADE IN USA</p>
                        <div class="bg-e5-red text-white px-10 py-3 text-[12px] md:text-[13px] tracking-[2px] font-bold hover:bg-e5-red/90 transition-colors uppercase inline-block">
                            SHOP SONOMA
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Footer Red Section -->
    <section class="bg-e5-red text-white py-6">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="text-center">
                <img src="/assets/images/e5-wheels-logo-white.png" alt="E5 Wheels" class="h-[34px] md:h-[40px] mx-auto" />
            </div>
        </div>
    </section>

</MainLayout>
