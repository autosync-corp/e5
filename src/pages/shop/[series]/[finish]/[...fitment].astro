---
import MainLayout from '@/layouts/MainLayout.astro';
import SingleProductPage from '@/pages/shop/components/_SingleProductPage.vue';
import { parseWheelUrl, fromSlug, seriesFromSlug } from '@/core/utils/wheelUrl';
import { isMadeToOrderSeries } from '@/core/constants/SeriesLeadTimes';
import {
  DAYTONA_GLOSS_BLACK, DAYTONA_TITANIUM_BRUSHED_TINT, DAYTONA_BRONZE_BRUSHED_TINT, DAYTONA_HERO_IMAGE,
  SEBRING_GLOSS_BLACK, SEBRING_TITANIUM_BRUSHED, SEBRING_BRONZE, SEBRING_HERO_IMAGE,
  SPEEDWAY_GLOSS_BLACK, SPEEDWAY_TITANIUM_BRUSHED, SPEEDWAY_BRONZE, SPEEDWAY_HERO_IMAGE,
  TALLADEGA_GLOSS_BLACK, TALLADEGA_PODIUM_GOLD, TALLADEGA_PODIUM_BRONZE, TALLADEGA_SATIN_GREY, TALLADEGA_SMOKED_POLISHED, TALLADEGA_HERO,
  SONOMA_GLOSS_BLACK, SONOMA_TITANIUM_BRUSHED_TINT, SONOMA_BRONZE_BRUSHED_TINT, SONOMA_HERO_IMAGE,
  GT01_BRUSHED_ALUMINUM, GT01_GLOSS_BLACK, GT01_SATIN_BLACK,
  GT02_BRUSHED_ALUMINUM, GT02_GLOSS_BLACK, GT02_SATIN_BLACK,
  GT03_BRUSHED_ALUMINUM, GT03_GLOSS_BLACK, GT03_SATIN_BLACK,
  GT04_BRUSHED_ALUMINUM, GT04_GLOSS_BLACK, GT04_SATIN_BLACK,
} from "@/pages/wheels/constants/Wheels.ts";

// Get URL parameters from path
const { series, finish } = Astro.params;

// Parse the full URL to extract all components
const fullPath = Astro.url.pathname;
const parsedUrl = parseWheelUrl(fullPath);

// Build dynamic title from series, finish, and optional fitment details
const seriesTitle = seriesFromSlug(series);
const finishTitle = fromSlug(finish);

// Build title based on available URL parameters (keep under 60 chars for SEO)
let pageTitle = `${seriesTitle} ${finishTitle}`;

// Add vehicle generation and trim if present
if (parsedUrl.generation || parsedUrl.trim) {
  const vehicleParts = [];
  if (parsedUrl.generation) vehicleParts.push(parsedUrl.generation);
  if (parsedUrl.trim) vehicleParts.push(parsedUrl.trim);
  pageTitle += ` | ${vehicleParts.join(' ')}`;
}

pageTitle += ' - E5 Wheels';

// Build dynamic meta description
let description = `Shop ${seriesTitle} ${finishTitle} wheels`;
if (parsedUrl.generation || parsedUrl.trim) {
  const vehicleParts = [];
  if (parsedUrl.generation) vehicleParts.push(parsedUrl.generation);
  if (parsedUrl.trim) vehicleParts.push(parsedUrl.trim);
  description += ` for ${vehicleParts.join(' ')} Corvette`;
} else {
  description += ' for Corvette';
}
description += '. Precision-engineered fitment, hub-centric design. Available in multiple sizes and finishes. Made in USA.';

// Build canonical URL - always points to base product page
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const canonicalUrl = `${baseUrl}/shop/${series}/${finish}`;

// Pass parameters to component as props
const urlParams = {
  series: parsedUrl.series,
  finish: parsedUrl.finish,
  generation: parsedUrl.generation,
  trim: parsedUrl.trim,
  frontSize: parsedUrl.frontSize,
  rearSize: parsedUrl.rearSize,
};

const seriesKey = (series || '').toLowerCase();
const finishKey = (finish || '').toLowerCase();
// Lead times live in SeriesLeadTimes.ts, shared with the shop listing and product page
const isMadeToOrder = isMadeToOrderSeries(series);

// Starting price per finish (floor price for AggregateOffer)
const finishLowPrice: Record<string, string> = {
  // Daytona
  'daytona/gloss-black': '550',
  'daytona/titanium-gray-brushed': '550',
  'daytona/titanium-brushed': '550',
  'daytona/titanium-brushed-tint': '550',
  'daytona/bronze-brushed-tint': '550',
  'daytona/chrome': '950',
  // Sebring
  'sebring/gloss-black': '600',
  'sebring/titanium-brushed': '600',
  'sebring/titanium-gray-brushed': '600',
  'sebring/titanium-brushed-tint': '600',
  'sebring/bronze-brushed-tint': '600',
  'sebring/chrome': '950',
  // Sebring 2P
  'sebring-2p/gloss-black': '770',
  'sebring-2p/gloss-black-polished-lip': '770',
  'sebring-2p/dark-bronze': '900',
  'sebring-2p/bronze-black-lip': '900',
  'sebring-2p/bronze-polished-lip': '900',
  'sebring-2p/titanium-brushed': '900',
  'sebring-2p/gray-black-lip': '900',
  'sebring-2p/gray-polished-lip': '900',
  'sebring-2p/black': '900',
  'sebring-2p/titanium-black-lip': '900',
  'sebring-2p/titanium-polished-lip': '900',
  // Speedway
  'speedway/gloss-black': '600',
  'speedway/dark-bronze': '600',
  'speedway/titanium-brushed': '600',
  'speedway/titanium-brushed-tint': '600',
  'speedway/chrome': '950',
  // Talladega
  'talladega/brushed-aluminum': '2900',
  'talladega/gloss-black': '2900',
  'talladega/podium-gold-brushed': '2900',
  'talladega/podium-bronze': '2900',
  'talladega/satin-grey': '2900',
  'talladega/smoked-titanium-brushed': '2900',
  // Sonoma
  'sonoma/brushed-aluminum': '2900',
  'sonoma/gloss-black': '2900',
  'sonoma/titanium-brushed-tint': '2900',
  'sonoma/bronze-brushed-tint': '2900',
};
const finishHighPrice: Record<string, string> = {
  // Daytona
  'daytona/gloss-black': '850',
  'daytona/titanium-gray-brushed': '850',
  'daytona/titanium-brushed': '850',
  'daytona/titanium-brushed-tint': '850',
  'daytona/bronze-brushed-tint': '850',
  'daytona/chrome': '1200',
  // Sebring
  'sebring/gloss-black': '850',
  'sebring/titanium-brushed': '850',
  'sebring/titanium-gray-brushed': '1050',
  'sebring/titanium-brushed-tint': '850',
  'sebring/bronze-brushed-tint': '850',
  'sebring/chrome': '1200',
  // Sebring 2P
  'sebring-2p/gloss-black': '1300',
  'sebring-2p/gloss-black-polished-lip': '1300',
  'sebring-2p/dark-bronze': '1300',
  'sebring-2p/bronze-black-lip': '1300',
  'sebring-2p/bronze-polished-lip': '1300',
  'sebring-2p/titanium-brushed': '1300',
  'sebring-2p/gray-black-lip': '1300',
  'sebring-2p/gray-polished-lip': '1300',
  'sebring-2p/black': '1300',
  'sebring-2p/titanium-black-lip': '1300',
  'sebring-2p/titanium-polished-lip': '1300',
  // Speedway
  'speedway/gloss-black': '850',
  'speedway/dark-bronze': '850',
  'speedway/titanium-brushed': '850',
  'speedway/titanium-brushed-tint': '850',
  'speedway/chrome': '1100',
  // Talladega
  'talladega/brushed-aluminum': '3100',
  'talladega/gloss-black': '3100',
  'talladega/podium-gold-brushed': '3100',
  'talladega/podium-bronze': '3100',
  'talladega/satin-grey': '3100',
  'talladega/smoked-titanium-brushed': '3100',
  // Sonoma
  'sonoma/brushed-aluminum': '3100',
  'sonoma/gloss-black': '3100',
  'sonoma/titanium-brushed-tint': '3100',
  'sonoma/bronze-brushed-tint': '3100',
};
// Only publish a price when one actually exists for this series/finish. The old
// `|| '600'` / `|| '1200'` defaults silently invented a range for any wheel missing
// from the tables above - GT has no pricing in the AutoSync catalog yet (every variant
// returns Price: null), so it would have shipped a made-up $600-$1200 in structured data.
// TODO: add GT.01-GT.04 prices to the tables above once they're confirmed.
const lowPrice = finishLowPrice[`${seriesKey}/${finishKey}`];
const highPrice = finishHighPrice[`${seriesKey}/${finishKey}`];
const hasKnownPrice = Boolean(lowPrice && highPrice);

// Product image &mdash; series + finish specific, falls back to series hero
const productImageMap: Record<string, string> = {
  // Daytona
  'daytona/gloss-black': DAYTONA_GLOSS_BLACK,
  'daytona/titanium-brushed': DAYTONA_TITANIUM_BRUSHED_TINT,
  'daytona/titanium-brushed-tint': DAYTONA_TITANIUM_BRUSHED_TINT,
  'daytona/bronze-brushed-tint': DAYTONA_BRONZE_BRUSHED_TINT,
  // Sebring
  'sebring/gloss-black': SEBRING_GLOSS_BLACK,
  'sebring/titanium-brushed': SEBRING_TITANIUM_BRUSHED,
  'sebring/titanium-brushed-tint': SEBRING_TITANIUM_BRUSHED,
  'sebring/bronze-brushed-tint': SEBRING_BRONZE,
  // Speedway
  'speedway/gloss-black': SPEEDWAY_GLOSS_BLACK,
  'speedway/titanium-brushed': SPEEDWAY_TITANIUM_BRUSHED,
  'speedway/titanium-brushed-tint': SPEEDWAY_TITANIUM_BRUSHED,
  'speedway/dark-bronze': SPEEDWAY_BRONZE,
  // Talladega
  'talladega/gloss-black': TALLADEGA_GLOSS_BLACK,
  'talladega/podium-gold-brushed': TALLADEGA_PODIUM_GOLD,
  'talladega/podium-bronze': TALLADEGA_PODIUM_BRONZE,
  'talladega/satin-grey': TALLADEGA_SATIN_GREY,
  'talladega/smoked-titanium-brushed': TALLADEGA_SMOKED_POLISHED,
  'talladega/brushed-aluminum': TALLADEGA_HERO,
  // Sonoma
  'sonoma/gloss-black': SONOMA_GLOSS_BLACK,
  'sonoma/titanium-brushed-tint': SONOMA_TITANIUM_BRUSHED_TINT,
  'sonoma/bronze-brushed-tint': SONOMA_BRONZE_BRUSHED_TINT,
  'sonoma/brushed-aluminum': SONOMA_HERO_IMAGE,
  // GT - catalog render urls (absolute CDN paths, see note below)
  'gt01/brushed-aluminum': GT01_BRUSHED_ALUMINUM,
  'gt01/gloss-black': GT01_GLOSS_BLACK,
  'gt01/satin-black': GT01_SATIN_BLACK,
  'gt02/brushed-aluminum': GT02_BRUSHED_ALUMINUM,
  'gt02/gloss-black': GT02_GLOSS_BLACK,
  'gt02/satin-black': GT02_SATIN_BLACK,
  'gt03/brushed-aluminum': GT03_BRUSHED_ALUMINUM,
  'gt03/gloss-black': GT03_GLOSS_BLACK,
  'gt03/satin-black': GT03_SATIN_BLACK,
  'gt04/brushed-aluminum': GT04_BRUSHED_ALUMINUM,
  'gt04/gloss-black': GT04_GLOSS_BLACK,
  'gt04/satin-black': GT04_SATIN_BLACK,
};
const seriesFallbackImage: Record<string, string> = {
  'daytona': DAYTONA_HERO_IMAGE,
  'sebring': SEBRING_HERO_IMAGE,
  'speedway': SPEEDWAY_HERO_IMAGE,
  'talladega': TALLADEGA_HERO,
  'sonoma': SONOMA_HERO_IMAGE,
  'gt01': GT01_BRUSHED_ALUMINUM,
  'gt02': GT02_BRUSHED_ALUMINUM,
  'gt03': GT03_BRUSHED_ALUMINUM,
  'gt04': GT04_BRUSHED_ALUMINUM,
};
const productImagePath = productImageMap[`${seriesKey}/${finishKey}`]
  || seriesFallbackImage[seriesKey]
  || '/assets/images/vette-black-on-river.webp';

// GT renders are absolute CDN urls; the local ones still need the site origin prefixed
const productImageUrl = productImagePath.startsWith('http')
  ? productImagePath
  : `${baseUrl}${productImagePath}`;

// Product schema &mdash; base data known at server time
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${seriesTitle} ${finishTitle} Wheels`,
  "description": description,
  "brand": {
    "@type": "Brand",
    "name": "E5 Wheels"
  },
  "url": canonicalUrl,
  "image": productImageUrl,
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    ...(hasKnownPrice ? { lowPrice, highPrice } : {}),
    "availability": isMadeToOrder ? "https://schema.org/MadeToOrder" : "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "E5 Wheels"
    }
  }
};
---

<MainLayout title={pageTitle} description={description} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <SingleProductPage
    client:only="vue"
    seriesParam={urlParams.series}
    finishParam={urlParams.finish}
    generationParam={urlParams.generation}
    trimParam={urlParams.trim}
    frontSizeParam={urlParams.frontSize}
    rearSizeParam={urlParams.rearSize}
  />
</MainLayout>
