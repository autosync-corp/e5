---
import MainLayout from '@/layouts/MainLayout.astro';
import ShopPage from './components/_ShopPage.vue';

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Shop Corvette Wheels - E5 Forged & Form Forged | E5 Wheels';
const description = 'Shop precision-engineered wheels for your Corvette. E5 Forged for C8 Z06/ZR1/E-Ray and Form Forged for C5, C6, C7, C8. Filter by generation, model, and size.';
const canonicalUrl = `${baseUrl}/shop`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <ShopPage client:load />
</MainLayout>
