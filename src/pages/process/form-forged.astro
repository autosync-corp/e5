---
import MainLayout from '@/layouts/MainLayout.astro';
import { WHEELS_SEBRING_ROUTE, WHEELS_DAYTONA_ROUTE, WHEELS_SPEEDWAY_ROUTE } from '@/core/constants/Routes';
---

<MainLayout title="E5 Wheels - Form Forged Process">
  <div class="w-full bg-white">
    <!-- Hero Video Section 1 -->
    <section class="w-full h-[799px] relative overflow-hidden">
      <img
        src="/assets/images/d58a7e9630e8b54bac2641294335708365a28d50.png"
        alt="Factory Process Video"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Form Forged Series Process Section -->
    <section class="py-20">
      <div class="max-w-[1640px] mx-auto px-6">
        <!-- Title -->
        <h1 class="text-e5-red text-[64px] font-franklin-book tracking-[12.8px] uppercase mb-4 px-12">
          FORM FORGED SERIES PROCESS
        </h1>

        <!-- Subtitle -->
        <p class="text-[31px] font-franklin-book text-black mb-12 px-12">
          Forged DNA. Flow-Formed Precision. EXCLUSIVELY FOR CORVETTES.
        </p>

        <!-- Description -->
        <p class="text-black/70 text-[24px] leading-[30px] max-w-[1538px] mb-16 px-12">
          Every Form Forged Series wheel begins with intention. Engineered with forged DNA and refined through advanced flow-forming technology, our Form Forged wheels are designed exclusively for Corvette platforms to deliver strength, reduced weight, and everyday drivability. By reinforcing the barrel through controlled heat and pressure, we create a forged-like structure that enhances durability, load capacity, and impact resistance—without unnecessary mass.
        </p>

        <!-- 4-Step Process Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Step 1: Mount & Heat -->
          <div class="text-center">
            <div class="mb-6 h-[266px] flex items-center justify-center">
              <img
                src="/assets/images/64bb97db938e3fdaa9d10414be63d66a1365e361.png"
                alt="Mount & Heat"
                class="max-w-full max-h-full object-contain"
              />
            </div>
            <h3 class="text-[70px] font-franklin-heavy text-e5-red leading-[70px] mb-4">
              MOUNT & HEAT
            </h3>
            <p class="text-[24px] text-black/70 leading-[30px]">
              Mounted to the forming drum, the wheel blank is carefully heated to prepare the aluminum for controlled shaping and enhanced strength.
            </p>
          </div>

          <!-- Step 2: Roll Forming -->
          <div class="text-center">
            <div class="mb-6 h-[266px] flex items-center justify-center">
              <img
                src="/assets/images/ecda52251e8fccbaea01c9a3d3a82156fabcfa56.png"
                alt="Roll Forming"
                class="max-w-full max-h-full object-contain"
              />
            </div>
            <h3 class="text-[76px] font-franklin-heavy text-e5-red leading-[76px] mb-4">
              ROLL FORMING
            </h3>
            <p class="text-[24px] text-black/70 leading-[30px]">
              Hydraulic rollers apply calculated pressure to the rotating barrel, gradually shaping and extending the aluminum to form the rim profile.
            </p>
          </div>

          <!-- Step 3: Compression & Stretch -->
          <div class="text-center">
            <div class="mb-6 h-[272px] flex items-center justify-center">
              <img
                src="/assets/images/a05053599e50883ef39a7e50dfc6b06adcb1fbff.png"
                alt="Compression & Stretch"
                class="max-w-full max-h-full object-contain"
              />
            </div>
            <h3 class="text-[75px] font-franklin-heavy text-e5-red leading-[75px] mb-4">
              COMPRESSION & STRETCH
            </h3>
            <p class="text-[24px] text-black/70 leading-[30px]">
              The barrel is compressed and stretched to achieve precise width and thickness, aligning the grain structure for increased strength and reduced weight.
            </p>
          </div>

          <!-- Step 4: Finalized Barrel -->
          <div class="text-center">
            <div class="mb-6 h-[273px] flex items-center justify-center">
              <img
                src="/assets/images/d278abedab1224b2577b0d9b64f9eff9792bc199.png"
                alt="Finalized Barrel"
                class="max-w-full max-h-full object-contain"
              />
            </div>
            <h3 class="text-[76px] font-franklin-heavy text-e5-red leading-[76px] mb-4">
              FINALIZED BARREL
            </h3>
            <p class="text-[24px] text-black/70 leading-[30px]">
              The result is a thinner, lighter, and stronger barrel with forged-like strength, improving durability, load capacity, and impact resistance.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero Video Section 2 -->
    <section class="w-full h-[799px] relative overflow-hidden">
      <img
        src="/assets/images/d58a7e9630e8b54bac2641294335708365a28d50.png"
        alt="More Factory Process Video"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Finishing Section -->
    <section class="py-20">
      <div class="max-w-[1640px] mx-auto px-6">
        <!-- Title -->
        <h2 class="text-e5-red text-[64px] font-franklin-book tracking-[12.8px] uppercase mb-12 px-12">
          FINISHING
        </h2>

        <!-- Description -->
        <p class="text-black/70 text-[24px] leading-[30px] max-w-[1538px] mb-16 px-12">
          Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
        </p>

        <!-- 4 Finish Examples -->
        <div class="space-y-20">
          <!-- Gloss Black -->
          <div class="flex gap-12 items-center px-12 py-8">
            <div class="w-1/2">
              <img
                src="/assets/images/1ecfa74c543565c408b902e4ab933c004a8496a4.png"
                alt="Gloss Black Finish"
                class="w-full h-[471px] object-cover"
              />
            </div>
            <div class="w-1/2 px-12">
              <h3 class="text-[24px] font-bold text-e5-red mb-4 uppercase">
                Gloss Black
              </h3>
              <p class="text-[24px] text-black leading-[30px]">
                Shown on our Speedway, part of our Form Forged Series. (Also available in Titanium Brushed Tint, and Dark Bronze).
              </p>
            </div>
          </div>

          <!-- Titanium Brushed Tint -->
          <div class="flex gap-12 items-center px-12 py-8">
            <div class="w-1/2">
              <img
                src="/assets/images/9a733adf9a26ce056cf523600d07452d013743c3.png"
                alt="Titanium Brushed Tint Finish"
                class="w-full h-[471px] object-cover"
              />
            </div>
            <div class="w-1/2 px-12">
              <h3 class="text-[24px] font-bold text-e5-red mb-4 uppercase">
                Titanium Brushed Tint
              </h3>
              <p class="text-[24px] text-black leading-[30px]">
                Shown on our Sebring, part of our Form Forged Series. (Also available in Gloss Black, and Bronze Brushed Tint).
              </p>
            </div>
          </div>

          <!-- Bronze Brushed Tint -->
          <div class="flex gap-12 items-center px-12 py-8">
            <div class="w-1/2">
              <img
                src="/assets/images/cf4918ec695ac87e338eba6c522616117d49d1ff.png"
                alt="Bronze Brushed Tint Finish"
                class="w-full h-[471px] object-cover"
              />
            </div>
            <div class="w-1/2 px-12">
              <h3 class="text-[24px] font-bold text-e5-red mb-4 uppercase">
                Bronze Brushed Tint
              </h3>
              <p class="text-[24px] text-black leading-[30px]">
                Shown on our Daytona, part of our Form Forged Series. (Also available in Gloss Black, and Titanium Brushed Tint).
              </p>
            </div>
          </div>

          <!-- Dark Bronze -->
          <div class="flex gap-12 items-center px-12 py-8">
            <div class="w-1/2">
              <img
                src="/assets/images/31554c4e3204e6bdcbafa9aab122da40adfc49bc.png"
                alt="Dark Bronze Finish"
                class="w-full h-[471px] object-cover"
              />
            </div>
            <div class="w-1/2 px-12">
              <h3 class="text-[24px] font-bold text-e5-red mb-4 uppercase">
                Dark Bronze (Speedway Exclusive)
              </h3>
              <p class="text-[24px] text-black leading-[30px]">
                Shown on our Speedway, part of our Form Forged Series. (Also available in Gloss Black, and Titanium Brushed Tint).
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form Forged Gallery Section -->
    <section class="py-20">
      <div class="max-w-[1660px] mx-auto px-6">
        <!-- Title and Description -->
        <h2 class="text-[64px] font-franklin-book text-e5-red tracking-[12.8px] uppercase mb-4 px-12">
          FORM FORGED GALLERY
        </h2>
        <p class="text-[24px] text-black/70 leading-[30px] max-w-[1276px] mb-12 px-12">
          Explore our gallery highlighting the craftsmanship and processes behind our Form Forged Series and E5 Forged lineup.
        </p>

        <!-- 3 Gallery Images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <div class="aspect-square">
            <img
              src="/assets/images/776758bd5bea0e4f363bbaf50598ef8759e98cbf.png"
              alt="Gallery Image 1"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="aspect-square">
            <img
              src="/assets/images/ebc51d2211b31759f5c397f3b38a78c41cf6dae4.png"
              alt="Gallery Image 2"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="aspect-square">
            <img
              src="/assets/images/73ced6e7d3c4e6558443faafb317b5861649dec0.png"
              alt="Gallery Image 3"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- View Gallery Button -->
        <div class="flex justify-center">
          <button class="bg-e5-red text-white px-12 py-6 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors">
            VIEW GALLERY
          </button>
        </div>
      </div>
    </section>

    <!-- Wheel Showcase Section -->
    <section class="py-20">
      <div class="max-w-[1583px] mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <!-- Sebring -->
          <div class="text-center">
            <div class="aspect-square mb-6">
              <img
                src="/assets/images/57612e656f7cb177dd66a7b9e8dbaf32845675c7.png"
                alt="Sebring"
                class="w-full h-full object-contain"
              />
            </div>
            <img
              src="/assets/images/90f6c4d4b52eb6c3ec25ae4927cf62a98d647c4d.png"
              alt="Sebring Logo"
              class="mx-auto mb-6 h-[29px]"
            />
            <div class="space-y-2 mb-6">
              <p class="text-[26px] text-black">GLOSS BLACK</p>
              <p class="text-[26px] text-black">EXCLUSIVELY FOR C6_C7_C8</p>
              <p class="text-[26px] text-black">3 PREMIUM FINISHES</p>
              <p class="text-[26px] text-black font-bold">IN STOCK</p>
            </div>
            <a href={WHEELS_SEBRING_ROUTE} class="block w-full bg-e5-red text-white px-8 py-4 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors text-center">
              EXPLORE
            </a>
          </div>

          <!-- Daytona -->
          <div class="text-center">
            <div class="aspect-square mb-6">
              <img
                src="/assets/images/wheels/d4565cf05e3fa3637a06eedfd917c1499967f34b.png"
                alt="Daytona"
                class="w-full h-full object-contain"
              />
            </div>
            <img
              src="/assets/images/bf617359a30df6e52e23d25ba89f15964c216df1.png"
              alt="Daytona Logo"
              class="mx-auto mb-6 h-[27px]"
            />
            <div class="space-y-2 mb-6">
              <p class="text-[26px] text-black">BRONZE BRUSHED TINT</p>
              <p class="text-[26px] text-black">EXCLUSIVELY FOR C6_C7_C8</p>
              <p class="text-[26px] text-black">3 PREMIUM FINISHES</p>
              <p class="text-[26px] text-black font-bold">IN STOCK</p>
            </div>
            <a href={WHEELS_DAYTONA_ROUTE} class="block w-full bg-e5-red text-white px-8 py-4 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors text-center">
              EXPLORE
            </a>
          </div>

          <!-- Speedway -->
          <div class="text-center">
            <div class="aspect-square mb-6">
              <img
                src="/assets/images/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.png"
                alt="Speedway"
                class="w-full h-full object-contain"
              />
            </div>
            <img
              src="/assets/images/5a059fba9b6f32612b072a121dc09766ef507b86.png"
              alt="Speedway Logo"
              class="mx-auto mb-6 h-[28px]"
            />
            <div class="space-y-2 mb-6">
              <p class="text-[26px] text-black">TITANIUM BRUSHED TINT</p>
              <p class="text-[26px] text-black">EXCLUSIVELY FOR C6_C7_C8</p>
              <p class="text-[26px] text-black">3 PREMIUM FINISHES</p>
              <p class="text-[26px] text-black font-bold">IN STOCK</p>
            </div>
            <a href={WHEELS_SPEEDWAY_ROUTE} class="block w-full bg-e5-red text-white px-8 py-4 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors text-center">
              EXPLORE
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
