---
export const prerender = false;

import PortalLayout from '@/layouts/PortalLayout.astro';
import { readSession } from '@/core/portal/auth.ts';
import { isPortalHost, portalHref } from '@/core/portal/host.ts';
import { loadPortalGalleries } from '@/core/portal/galleries.ts';

const loginHref = portalHref(Astro.request, '/login');
const user = readSession(Astro.cookies);
if (!user) {
  return Astro.redirect(loginHref);
}

const { items, source } = await loadPortalGalleries();
const apiBase = isPortalHost(Astro.request) ? '/api/portal' : '/portal/api';

const GENERATION_ORDER = ['C8', 'C7', 'C6', 'C5'];

function uniqueValues(values: string[], order?: string[]): string[] {
  const seen = new Set<string>();
  const out: string[] = [];
  for (const raw of values) {
    const value = (raw || '').trim();
    if (!value || seen.has(value)) continue;
    seen.add(value);
    out.push(value);
  }
  out.sort((a, b) => {
    if (order) {
      const ia = order.indexOf(a);
      const ib = order.indexOf(b);
      if (ia !== -1 || ib !== -1) {
        if (ia === -1) return 1;
        if (ib === -1) return -1;
        return ia - ib;
      }
    }
    return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
  });
  return out;
}

const generations = uniqueValues(items.map((item) => item.generation), GENERATION_ORDER);
const trims = uniqueValues(items.map((item) => item.trim));
const years = uniqueValues(items.map((item) => item.year)).sort((a, b) => Number(b) - Number(a) || b.localeCompare(a));
const styles = uniqueValues(items.map((item) => item.wheelStyle));
const hasUnspecifiedStyle = items.some((item) => !item.wheelStyle);
---

<PortalLayout title="Galleries — E5 Client Portal" userName={user.username}>
  {loginHref && null}
  <h1>Galleries</h1>
  <p class="lead">
    Choose which vehicle galleries appear on e5wheels.com and in what order. Photos stay on AutoSync — this page does not upload or edit them. Saved changes appear on the live gallery within about a minute.
  </p>

  <div class="toolbar">
    <button type="button" class="btn primary" data-save>Save changes</button>
    <span class="status" data-status></span>
  </div>
  <p class="meta">
    {source === 'redis'
      ? 'Showing the live saved order. New AutoSync galleries appear at the bottom until you move them.'
      : 'Showing the current public gallery order. Nothing changes on the public site until you save.'}
  </p>

  {items.length === 0 ? (
    <p class="empty">No galleries loaded right now. Try again in a few minutes.</p>
  ) : (
    <>
      <div class="filters" data-filters>
        <fieldset class="filter-group">
          <legend>Vehicle</legend>
          <label>
            Generation
            <select data-filter="generation">
              <option value="">Any</option>
              {generations.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </label>
          <label>
            Trim
            <select data-filter="trim">
              <option value="">Any</option>
              {trims.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </label>
          <label>
            Year
            <select data-filter="year">
              <option value="">Any</option>
              {years.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </label>
        </fieldset>
        <fieldset class="filter-group">
          <legend>Wheel style</legend>
          <label>
            Style
            <select data-filter="style">
              <option value="">Any</option>
              {hasUnspecifiedStyle && <option value="__none__">Not set</option>}
              {styles.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </label>
        </fieldset>
        <div class="filter-actions">
          <p class="count" data-count>Showing {items.length} of {items.length}</p>
          <button type="button" class="btn ghost" data-clear>Clear</button>
        </div>
        <p class="filter-note" data-filter-note hidden>
          Reorder is paused while a filter is on. Clear the filter to move galleries. Hide still works, and Save still writes the full list in the current order.
        </p>
      </div>
      <p class="empty" data-empty-filter hidden>No galleries match these filters.</p>
      <ol class="list" data-list>
        {items.map((item) => (
          <li
            class:list={['card', item.hidden && 'is-hidden']}
            data-card
            data-id={item.id}
            data-generation={item.generation}
            data-trim={item.trim}
            data-year={item.year}
            data-style={item.wheelStyle}
          >
            <div class="thumb">
              {item.image ? <img src={item.image} alt="" /> : <div class="placeholder" />}
              <span class="badge">{item.source === 'autosync' ? 'AutoSync' : 'Site'}</span>
            </div>
            <div class="fields">
              <div class="row head">
                <strong>{item.title}</strong>
                <label class="check">
                  <input type="checkbox" data-field="hidden" checked={item.hidden} />
                  Hidden
                </label>
              </div>
              <p class="note">
                {[item.year, item.generation, item.trim, item.wheelStyle || 'Style not set'].filter(Boolean).join(' · ')}
                {' · '}
                /gallery/{item.id}
              </p>
              <div class="actions">
                <button type="button" class="btn ghost" data-up>Move up</button>
                <button type="button" class="btn ghost" data-down>Move down</button>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </>
  )}
</PortalLayout>

<script is:inline define:vars={{ apiBase }}>
  (function () {
    var list = document.querySelector('[data-list]');
    var saveBtn = document.querySelector('[data-save]');
    var statusEl = document.querySelector('[data-status]');
    var filtersEl = document.querySelector('[data-filters]');
    var generationSelect = document.querySelector('[data-filter="generation"]');
    var trimSelect = document.querySelector('[data-filter="trim"]');
    var yearSelect = document.querySelector('[data-filter="year"]');
    var styleSelect = document.querySelector('[data-filter="style"]');
    var countEl = document.querySelector('[data-count]');
    var noteEl = document.querySelector('[data-filter-note]');
    var emptyEl = document.querySelector('[data-empty-filter]');
    var clearBtn = document.querySelector('[data-clear]');

    function setStatus(text, ok) {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.classList.toggle('is-error', ok === false);
    }

    function cards() {
      return list ? Array.prototype.slice.call(list.querySelectorAll('[data-card]')) : [];
    }

    function attr(card, name) {
      return (card.getAttribute(name) || '').trim();
    }

    function selected(select) {
      return select ? select.value : '';
    }

    function filtersOn() {
      return !!(selected(generationSelect) || selected(trimSelect) || selected(yearSelect) || selected(styleSelect));
    }

    function cardMatches(card) {
      var generation = selected(generationSelect);
      var trim = selected(trimSelect);
      var year = selected(yearSelect);
      var style = selected(styleSelect);
      if (generation && attr(card, 'data-generation') !== generation) return false;
      if (trim && attr(card, 'data-trim') !== trim) return false;
      if (year && attr(card, 'data-year') !== year) return false;
      if (style === '__none__') return !attr(card, 'data-style');
      if (style && attr(card, 'data-style') !== style) return false;
      return true;
    }

    function refreshHidden() {
      cards().forEach(function (card) {
        var hidden = card.querySelector('[data-field="hidden"]');
        card.classList.toggle('is-hidden', hidden && hidden.checked);
      });
    }

    function refreshOptions() {
      var generation = selected(generationSelect);
      var trim = selected(trimSelect);
      if (trimSelect) {
        Array.prototype.forEach.call(trimSelect.options, function (option) {
          if (!option.value) return;
          var show = cards().some(function (card) {
            if (generation && attr(card, 'data-generation') !== generation) return false;
            return attr(card, 'data-trim') === option.value;
          });
          option.hidden = !show;
          option.disabled = !show;
        });
        if (trim && trimSelect.selectedOptions[0] && trimSelect.selectedOptions[0].hidden) {
          trimSelect.value = '';
        }
      }
      trim = selected(trimSelect);
      if (yearSelect) {
        Array.prototype.forEach.call(yearSelect.options, function (option) {
          if (!option.value) return;
          var show = cards().some(function (card) {
            if (generation && attr(card, 'data-generation') !== generation) return false;
            if (trim && attr(card, 'data-trim') !== trim) return false;
            return attr(card, 'data-year') === option.value;
          });
          option.hidden = !show;
          option.disabled = !show;
        });
        if (yearSelect.value && yearSelect.selectedOptions[0] && yearSelect.selectedOptions[0].hidden) {
          yearSelect.value = '';
        }
      }
    }

    function applyFilters() {
      refreshOptions();
      var all = cards();
      var shown = 0;
      all.forEach(function (card) {
        var match = cardMatches(card);
        card.classList.toggle('is-filtered-out', !match);
        if (match) shown += 1;
      });
      var filtered = filtersOn();
      if (countEl) {
        countEl.textContent = 'Showing ' + shown + ' of ' + all.length;
      }
      if (noteEl) noteEl.hidden = !filtered;
      if (emptyEl) emptyEl.hidden = shown !== 0;
      if (list) list.classList.toggle('is-filtered', filtered);
      all.forEach(function (card) {
        var up = card.querySelector('[data-up]');
        var down = card.querySelector('[data-down]');
        if (up) up.disabled = filtered;
        if (down) down.disabled = filtered;
      });
    }

    function move(card, direction) {
      if (!list || filtersOn()) return;
      if (direction < 0 && card.previousElementSibling) {
        list.insertBefore(card, card.previousElementSibling);
      } else if (direction > 0 && card.nextElementSibling) {
        list.insertBefore(card.nextElementSibling, card);
      }
    }

    if (list) {
      list.addEventListener('change', function (event) {
        var target = event.target;
        if (target && target.getAttribute('data-field') === 'hidden') refreshHidden();
      });
      list.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        var card = target.closest('[data-card]');
        if (!card) return;
        if (target.closest('[data-up]')) move(card, -1);
        if (target.closest('[data-down]')) move(card, 1);
      });
    }

    if (filtersEl) {
      filtersEl.addEventListener('change', applyFilters);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (generationSelect) generationSelect.value = '';
        if (trimSelect) trimSelect.value = '';
        if (yearSelect) yearSelect.value = '';
        if (styleSelect) styleSelect.value = '';
        applyFilters();
      });
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', async function () {
        var payload = cards().map(function (card) {
          var hidden = card.querySelector('[data-field="hidden"]');
          return { id: card.getAttribute('data-id'), hidden: !!(hidden && hidden.checked) };
        });
        setStatus('Saving…');
        try {
          var res = await fetch(apiBase + '/galleries', {
            method: 'PUT',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: payload }),
          });
          var data = await res.json();
          if (!res.ok) {
            setStatus(data.error || 'Save failed.', false);
            return;
          }
          setStatus('Saved. The live gallery updates within about a minute.');
        } catch (err) {
          setStatus('Save failed.', false);
        }
      });
    }

    applyFilters();
  })();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .meta { color: #666; font-size: 13px; margin-bottom: 20px; }
  .empty { color: #666; }
  .status { font-size: 13px; color: #333; }
  .status.is-error { color: #d31d25; }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) auto;
    gap: 16px 20px;
    align-items: start;
    max-width: 920px;
    margin-bottom: 20px;
    padding: 16px;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    background: #fafafa;
  }
  .filter-group {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .filter-group:last-of-type { grid-template-columns: minmax(0, 1fr); }
  .filter-group legend {
    font-family: 'Franklin Gothic Demi', sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    color: #333;
    margin-bottom: 8px;
    padding: 0;
  }
  .filter-group label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    color: #666;
    min-width: 0;
  }
  .filter-group select {
    width: 100%;
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 14px;
    color: #141414;
    border: 1px solid #d9d9d9;
    background: #fff;
    padding: 8px 10px;
    border-radius: 4px;
  }
  .filter-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-top: 22px;
  }
  .count {
    font-size: 13px;
    color: #333;
    margin: 0;
  }
  .filter-note {
    grid-column: 1 / -1;
    font-size: 13px;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }
  .btn {
    font-family: 'Franklin Gothic Demi', sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    border: 1px solid #141414;
    background: #fff;
    color: #141414;
    padding: 10px 14px;
    cursor: pointer;
  }
  .btn.primary { background: #d31d25; border-color: #d31d25; color: #fff; }
  .btn.ghost:hover { background: #141414; color: #fff; }
  .btn:disabled,
  .btn:disabled:hover {
    opacity: 0.45;
    cursor: not-allowed;
    background: #fff;
    color: #141414;
  }
  .list { list-style: none; display: flex; flex-direction: column; gap: 16px; max-width: 920px; padding: 0; margin: 0; }
  .card {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 18px;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    padding: 16px;
    background: #fff;
  }
  .card.is-hidden { opacity: 0.55; }
  .card.is-filtered-out { display: none; }
  .thumb { position: relative; background: #111; height: 148px; overflow: hidden; }
  .thumb img, .placeholder { width: 100%; height: 148px; object-fit: cover; display: block; }
  .placeholder { background: #222; }
  .badge {
    position: absolute;
    left: 8px;
    bottom: 8px;
    background: #141414;
    color: #fff;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 6px;
  }
  .fields { display: flex; flex-direction: column; gap: 10px; }
  .row.head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .check {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #666;
  }
  .note { font-size: 13px; color: #333; line-height: 1.4; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 800px) {
    .filters { grid-template-columns: 1fr; padding: 14px; }
    .filter-group { grid-template-columns: 1fr; }
    .filter-actions { padding-top: 0; }
    .card { grid-template-columns: 1fr; }
  }
</style>
