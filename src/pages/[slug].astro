---
import { getEntry, render } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';

const { slug } = Astro.params;

const post = slug ? await getEntry('blog', slug) : null;

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isoDate = new Date(post.data.date).toISOString();
const siteUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const canonical = `${siteUrl}/${slug}`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "datePublished": isoDate,
  "publisher": {
    "@type": "Organization",
    "name": "E5 Wheels",
    "url": siteUrl
  },
  "url": canonical,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
});
---

<MainLayout
  title={`${post.data.title} | E5 Wheels`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={post.data.image}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate} />
    <meta property="article:author" content={post.data.author} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-e5-black pt-16 pb-14 px-4">
    <div class="max-w-[1000px] mx-auto text-center">
      <nav class="text-[11px] font-['Franklin_Gothic_Book'] text-white/40 tracking-[2.5px] uppercase mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        <span class="mx-2 text-white/20" aria-hidden="true">/</span>
        <a href="/category/blog" class="hover:text-white/70 transition-colors">Blog</a>
        <span class="mx-2 text-white/20" aria-hidden="true">/</span>
        <span class="text-white/55">{post.data.title}</span>
      </nav>
      <p class="text-e5-red font-['Franklin_Gothic_Book'] text-[11px] tracking-[3px] uppercase mb-5">
        <time datetime={isoDate}>{formattedDate}</time>
      </p>
      <h1 class="font-['Franklin_Gothic_Heavy'] text-white text-[26px] md:text-[36px] lg:text-[44px] uppercase tracking-[2px] leading-tight mb-4">
        {post.data.title}
      </h1>
      <p class="text-white/40 font-['Franklin_Gothic_Book'] text-[11px] tracking-[3px] uppercase">
        By {post.data.author}
      </p>
    </div>
  </section>

  <!-- Article -->
  <article class="bg-white">

    <!-- Body -->
    <div class="max-w-[960px] mx-auto px-5 md:px-10 py-12 blog-content">
      <Content />
    </div>

    <!-- Shop CTA -->
    <div class="bg-e5-red py-16 px-4 text-center">
      <h2 class="font-['Franklin_Gothic_Heavy'] text-white text-[26px] md:text-[34px] uppercase tracking-[4px] mb-4">
        Upgrade Your Corvette Today
      </h2>
      <p class="font-['Libre_Franklin'] text-white/85 text-[15px] leading-[1.7] mb-8 max-w-[480px] mx-auto">
        Engineered exclusively for Corvettes. Built to perform, designed to impress.
      </p>
      <a
        href="/shop"
        class="inline-block bg-white text-e5-red font-['Franklin_Gothic_Demi'] text-[12px] tracking-[3px] uppercase px-14 py-4 hover:bg-white/90 transition-colors"
      >
        Shop E5 Wheels
      </a>
    </div>

    <!-- Back to Blog -->
    <div class="bg-[#f5f5f5] py-8 px-4 text-center">
      <a
        href="/category/blog"
        class="font-['Franklin_Gothic_Book'] text-black/50 text-[12px] tracking-[2.5px] uppercase hover:text-black/80 transition-colors"
      >
        &larr; Back to All Posts
      </a>
    </div>
  </article>
</MainLayout>

<style>
  .blog-content :global(h2) {
    font-family: 'Franklin Gothic Demi', sans-serif;
    color: var(--color-e5-red);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 18px;
    margin-top: 52px;
    margin-bottom: 16px;
  }

  .blog-content :global(h3) {
    font-family: 'Franklin Gothic Demi', sans-serif;
    color: #111;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .blog-content :global(p) {
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.70);
    font-size: 16px;
    line-height: 1.85;
    margin-bottom: 22px;
  }

  .blog-content :global(img) {
    width: 100%;
    height: auto;
    margin-top: 36px;
    margin-bottom: 10px;
    display: block;
  }

  .blog-content :global(em) {
    display: block;
    text-align: center;
    font-style: normal;
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 11px;
    color: rgba(0, 0, 0, 0.38);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 36px;
  }

  .blog-content :global(strong) {
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 700;
    color: #111;
  }

  .blog-content :global(ul) {
    margin-bottom: 28px;
    padding-left: 4px;
  }

  .blog-content :global(ul li) {
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.70);
    font-size: 16px;
    line-height: 1.85;
    margin-bottom: 12px;
    padding-left: 22px;
    position: relative;
    list-style: none;
  }

  .blog-content :global(ul li::before) {
    content: '\2014';
    position: absolute;
    left: 0;
    color: var(--color-e5-red);
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 600;
  }

  /* Side-by-side image grid */
  .blog-content :global(.image-grid-2) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
    margin-bottom: 36px;
  }

  .blog-content :global(.image-grid-2 img) {
    width: 100%;
    height: auto;
    margin: 0 0 8px 0;
  }

  .blog-content :global(.img-caption) {
    text-align: center !important;
    font-family: 'Libre Franklin', sans-serif !important;
    font-weight: 400 !important;
    font-size: 11px !important;
    color: rgba(0, 0, 0, 0.38) !important;
    letter-spacing: 2px !important;
    text-transform: uppercase !important;
    margin: 0 !important;
  }

  .blog-content :global(.image-grid-2 a) {
    display: block;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blog-content :global(.image-grid-2 a:hover) {
    opacity: 0.82;
  }

  .blog-content :global(.image-grid-2 a:hover .img-caption) {
    color: var(--color-e5-red);
  }

  .blog-content :global(.cap-variant::before) {
    content: ' \2013 ';
  }

  @media (max-width: 600px) {
    .blog-content :global(h2) {
      font-size: 16px;
    }

    .blog-content :global(p),
    .blog-content :global(ul li) {
      font-size: 15px;
      line-height: 1.8;
    }

    .blog-content :global(.image-grid-2) {
      grid-template-columns: 1fr;
    }
  }
</style>
