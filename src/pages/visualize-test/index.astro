---
import MainLayout from '@/layouts/MainLayout.astro';
---

<style>
#autosync-visualizer {
    max-width: 100%;
    overflow-x: auto;
    min-height: 400px;
}

.autosync-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(196, 30, 58, 0.4);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
}

.autosync-loading-message {
    background: #fff;
    padding: 30px 40px;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    font-family: 'Franklin Gothic Book', Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #333;
    text-align: center;
    max-width: 400px;
    border: 2px solid #e0e0e0;
}

.autosync-success {
    background: #2d5a27;
    color: white;
    border-color: #4a7c59;
}

.autosync-error {
    background: #c41e3a;
    color: white;
    border-color: #d73502;
}

.autosync-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-left: 12px;
    border: 3px solid #ddd;
    border-top: 3px solid #c41e3a;
    border-radius: 50%;
    animation: autosync-spin 1s linear infinite;
    vertical-align: middle;
}

@keyframes autosync-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.countdown-timer {
    font-size: 18px;
    font-weight: bold;
    color: #FFD700;
    margin-top: 10px;
}

@media (max-width: 768px) {
    #autosync-visualizer {
        min-height: 350px;
    }

    .autosync-loading-message {
        padding: 20px 25px;
        font-size: 14px;
    }
}

@supports (-webkit-touch-callout: none) {
    #autosync-visualizer iframe {
        -webkit-overflow-scrolling: touch;
        overflow: auto;
        transform: translateZ(0);
    }
}
</style>

<MainLayout title="E5 Wheels - Configure (Test)">
    <div id="autosync-visualizer"></div>
    <script is:inline src="https://vvs.autosyncstudio.com/js/Autosync.js"></script>
    <script is:inline>
(function() {
    'use strict';

    if (window.e5AutosyncInitialized) {
        console.log('E5 Autosync already initialized');
        return;
    }

    let bodyScrollPosition = 0;

    function preventBodyScroll() {
        if (/(iPhone|iPad)/i.test(navigator.userAgent)) {
            bodyScrollPosition = window.pageYOffset;
            document.body.style.position = 'fixed';
            document.body.style.top = `-${bodyScrollPosition}px`;
            document.body.style.width = '100%';
        }
    }

    function restoreBodyScroll() {
        if (/(iPhone|iPad)/i.test(navigator.userAgent)) {
            document.body.style.position = '';
            document.body.style.top = '';
            document.body.style.width = '';
            window.scrollTo(0, bodyScrollPosition);
        }
    }

    function showMessage(message, type = 'loading', duration = 0) {
        const existingOverlay = document.querySelector('.autosync-loading-overlay');
        if (existingOverlay) {
            existingOverlay.remove();
        }

        preventBodyScroll();

        const overlay = document.createElement('div');
        overlay.className = 'autosync-loading-overlay';

        const messageDiv = document.createElement('div');
        messageDiv.className = `autosync-loading-message ${type === 'success' ? 'autosync-success' : type === 'error' ? 'autosync-error' : ''}`;

        if (type === 'loading') {
            message += '<span class="autosync-spinner"></span>';
        }

        messageDiv.innerHTML = message;
        overlay.appendChild(messageDiv);
        document.body.appendChild(overlay);

        if (duration > 0) {
            setTimeout(() => {
                if (overlay && overlay.parentNode) {
                    restoreBodyScroll();
                    overlay.remove();
                }
            }, duration);
        }

        return overlay;
    }

    function startCountdown(seconds = 2) {
        const countdownElement = document.getElementById('countdown-number');
        if (!countdownElement) return;

        let remaining = seconds;
        const timer = setInterval(() => {
            remaining--;
            countdownElement.textContent = remaining;

            if (remaining <= 0) {
                clearInterval(timer);
            }
        }, 1000);
    }

    function initAutosync() {
        try {
            const autosync = new Autosync({
                id: 'autosync-visualizer',
                key: 'MFCtst',
                scrollBar: false,
                productSegment: null,
                homeStyle: null,
                widget: false,
                startPage: 'vehicles',
                disableQuoteForm: true,
                onEvent: ({ event, data }) => {
                    console.log('Autosync Event:', event, data);

                    if (event === 'addToCart' ||
                        event === 'buyNow' ||
                        event === 'btnBuyClick' ||
                        event === 'cartAdd' ||
                        event === 'addCart' ||
                        event === 'buyButton' ||
                        event === 'purchase' ||
                        event.toLowerCase().includes('buy') ||
                        event.toLowerCase().includes('cart') ||
                        event.toLowerCase().includes('add')) {
                        console.log('Buy event detected:', event);
                        handleCartRedirect(data);
                        return;
                    }

                    if (event === 'submitQuote') {
                        console.log('Submit quote event:', event);
                        handleCartRedirect(data);
                    }
                }
            });

            function handleCartRedirect(data) {
                console.log('handleCartRedirect called with data:', data);

                const wheels = data.wheels || [];
                const tires = data.tires || [];
                const vehicle = data.vehicle || {};

                let wheelPartNumber = "";
                let wheelQuantity = 4;

                if (wheels.length > 0) {
                    const wheel = wheels[0];
                    wheelPartNumber = wheel.partNumber || "";
                    wheelQuantity = wheel.quantity || 4;
                    console.log('Wheel:', wheelPartNumber, 'Qty:', wheelQuantity);
                }

                if (!wheelPartNumber) {
                    showMessage('No wheel selected. Please select a wheel first.', 'error', 3000);
                    return;
                }

                if (navigator.vibrate) {
                    navigator.vibrate(50);
                }

                showMessage('Adding Items to Cart...');

                // Build redirect URL with query parameters
                let redirectUrl = `/visualizer-callback?wheelPartNumber=${encodeURIComponent(wheelPartNumber)}&wheelQuantity=${encodeURIComponent(wheelQuantity)}`;

                // Add vehicle data if available
                if (vehicle.year) redirectUrl += `&year=${encodeURIComponent(vehicle.year)}`;
                if (vehicle.make) redirectUrl += `&make=${encodeURIComponent(vehicle.make)}`;
                if (vehicle.model) redirectUrl += `&model=${encodeURIComponent(vehicle.model)}`;
                if (vehicle.trim) redirectUrl += `&trim=${encodeURIComponent(vehicle.trim)}`;
                if (vehicle.submodel) redirectUrl += `&submodel=${encodeURIComponent(vehicle.submodel)}`;

                console.log('Redirecting to:', redirectUrl);

                // Success vibration
                if (navigator.vibrate) {
                    navigator.vibrate([50, 100, 50]);
                }

                const successMessage = `
                    Success! Your items have been added to cart
                    <div class="countdown-timer">
                        Taking you to Cart in <span id="countdown-number">2</span>s
                    </div>
                `;
                showMessage(successMessage, 'success');

                startCountdown(2);

                setTimeout(() => {
                    window.location.href = redirectUrl;
                }, 2000);
            }

            window.e5AutosyncInitialized = true;
            console.log('E5 Autosync initialized successfully');

        } catch (error) {
            console.error('Failed to initialize E5 Autosync:', error);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAutosync);
    } else {
        initAutosync();
    }

})();
    </script>
</MainLayout>
