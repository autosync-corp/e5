---
import MainLayout from '@/layouts/MainLayout.astro';
---

<style>
#autosync-visualizer {
    max-width: 100%;
    overflow-x: auto;
    min-height: 400px;
}

.autosync-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(196, 30, 58, 0.4);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
}

.autosync-loading-message {
    background: #fff;
    padding: 30px 40px;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    font-family: 'Franklin Gothic Book', Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #333;
    text-align: center;
    max-width: 400px;
    border: 2px solid #e0e0e0;
}

.autosync-success {
    background: #2d5a27;
    color: white;
    border-color: #4a7c59;
}

.autosync-error {
    background: #c41e3a;
    color: white;
    border-color: #d73502;
}

.autosync-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-left: 12px;
    border: 3px solid #ddd;
    border-top: 3px solid #c41e3a;
    border-radius: 50%;
    animation: autosync-spin 1s linear infinite;
    vertical-align: middle;
}

@keyframes autosync-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.countdown-timer {
    font-size: 18px;
    font-weight: bold;
    color: #FFD700;
    margin-top: 10px;
}

@media (max-width: 768px) {
    #autosync-visualizer {
        min-height: 350px;
    }

    .autosync-loading-message {
        padding: 20px 25px;
        font-size: 14px;
    }
}

@supports (-webkit-touch-callout: none) {
    #autosync-visualizer iframe {
        -webkit-overflow-scrolling: touch;
        overflow: auto;
        transform: translateZ(0);
    }
}
</style>

<MainLayout title="E5 Wheels - Configure (Test)">
    <div id="autosync-visualizer"></div>
    <script is:inline src="https://vvs.autosyncstudio.com/js/Autosync.js"></script>
    <script>
        // @ts-nocheck
        import { CartManager } from '@/core/services/ProductService';

        const API_BASE_URL = 'https://api.autosyncstudio.com/wheels';
        const API_KEY = 'MFCtst';

        // Extend window type
        declare global {
            interface Window {
                e5AutosyncInitialized?: boolean;
                Autosync: any;
            }
        }

        if ((window as any).e5AutosyncInitialized) {
            console.log('E5 Autosync already initialized');
        } else {
            let bodyScrollPosition = 0;

            function preventBodyScroll() {
                if (/(iPhone|iPad)/i.test(navigator.userAgent)) {
                    bodyScrollPosition = window.pageYOffset;
                    document.body.style.position = 'fixed';
                    document.body.style.top = `-${bodyScrollPosition}px`;
                    document.body.style.width = '100%';
                }
            }

            function restoreBodyScroll() {
                if (/(iPhone|iPad)/i.test(navigator.userAgent)) {
                    document.body.style.position = '';
                    document.body.style.top = '';
                    document.body.style.width = '';
                    window.scrollTo(0, bodyScrollPosition);
                }
            }

            function showMessage(message: string, type: string = 'loading', duration: number = 0) {
                const existingOverlay = document.querySelector('.autosync-loading-overlay');
                if (existingOverlay) {
                    existingOverlay.remove();
                }

                preventBodyScroll();

                const overlay = document.createElement('div');
                overlay.className = 'autosync-loading-overlay';

                const messageDiv = document.createElement('div');
                messageDiv.className = `autosync-loading-message ${type === 'success' ? 'autosync-success' : type === 'error' ? 'autosync-error' : ''}`;

                if (type === 'loading') {
                    message += '<span class="autosync-spinner"></span>';
                }

                messageDiv.innerHTML = message;
                overlay.appendChild(messageDiv);
                document.body.appendChild(overlay);

                if (duration > 0) {
                    setTimeout(() => {
                        if (overlay && overlay.parentNode) {
                            restoreBodyScroll();
                            overlay.remove();
                        }
                    }, duration);
                }

                return overlay;
            }

            function startCountdown(seconds: number = 2) {
                const countdownElement = document.getElementById('countdown-number');
                if (!countdownElement) return;

                let remaining = seconds;
                const timer = setInterval(() => {
                    remaining--;
                    countdownElement.textContent = String(remaining);

                    if (remaining <= 0) {
                        clearInterval(timer);
                    }
                }, 1000);
            }

           async function handleCartRedirect(data: any) {
                console.log('handleCartRedirect called with data:', data);

                const wheels = data.wheels || [];
                const vehicle = data.vehicle || {};

                console.log('Wheels array:', wheels);
                console.log('Number of wheels:', wheels.length);

                if (wheels.length === 0) {
                    showMessage('No wheel selected. Please select a wheel first.', 'error', 3000);
                    return;
                }

                if (navigator.vibrate) {
                    navigator.vibrate(50);
                }

                showMessage('Fetching wheel data...');

                try {
                    // Fetch and add each wheel to cart directly
                    for (let i = 0; i < wheels.length; i++) {
                        const wheel = wheels[i];
                        const wheelPartNumber = wheel.partNumber || "";
                        const wheelQuantity = wheel.quantity || 2;

                        console.log(`Processing wheel ${i + 1}/${wheels.length}:`, wheelPartNumber, 'Qty:', wheelQuantity);

                        // Fetch wheels from API (autosyncstudio format)
                        const params = new URLSearchParams({
                            key: API_KEY,
                            'p-number': '1',
                            'p-size': '100',
                            'i-img0001': 'true',
                            'i-img0002': 'true',
                            'i-img0003': 'true',
                            'i-inStock': 'true',
                            'i-inventory': 'true',
                            'i-price': 'true',
                            'i-specs': 'true',
                            'i-tags': 'true',
                            'i-updatedAt': 'true',
                        });

                        const apiUrl = `${API_BASE_URL}?${params.toString()}`;
                        console.log('Fetching wheels from API:', apiUrl);

                        const response = await fetch(apiUrl);

                        if (!response.ok) {
                            console.error(`Failed to fetch wheels:`, response.status);
                            continue;
                        }

                        const apiData = await response.json();

                        if (!apiData.Wheels || apiData.Wheels.length === 0) {
                            console.error(`No wheels found in API response`);
                            continue;
                        }

                        // Find the wheel by part number
                        const product = apiData.Wheels.find((w: any) => w.Pn === wheelPartNumber);

                        if (!product) {
                            console.error(`No wheel found with part number: ${wheelPartNumber}`);
                            continue;
                        }

                        showMessage(`Adding wheel ${i + 1}/${wheels.length} to cart...`);

                        // Determine if this is front or rear based on index
                        const isFront = i === 0;
                        const isRear = i === 1;

                        // Construct proper vehicle display format (e.g., "C8 Stingray")
                        let vehicleDisplayName;
                        if (vehicle.year && vehicle.make && vehicle.model) {
                            const year = parseInt(vehicle.year);
                            let generation = '';
                            if (year >= 2020) generation = 'C8';
                            else if (year >= 2014) generation = 'C7';
                            else if (year >= 2005) generation = 'C6';
                            else if (year >= 1997) generation = 'C5';

                            const trim = vehicle.trim || vehicle.submodel || '';
                            vehicleDisplayName = generation && trim ? `${generation} ${trim}` : undefined;
                        }

                        CartManager.addItem({
                            product: product,
                            quantity: wheelQuantity,
                            frontWheels: isFront ? wheelQuantity : 0,
                            rearWheels: isRear ? wheelQuantity : 0,
                            vehicleModel: vehicleDisplayName,
                            imgUrlBase: apiData.ImgUrlBase || undefined
                        });

                        console.log(`✅ Added wheel ${i + 1} to cart: ${wheelPartNumber} (qty: ${wheelQuantity}, ${isFront ? 'front' : isRear ? 'rear' : 'unknown'})`);
                    }

                    // Save display format to localStorage for cart/checkout display
                    // (We don't save full vehicle data to avoid breaking shop fitment)
                    if (vehicle.year && vehicle.make && vehicle.model) {
                        const year = parseInt(vehicle.year);
                        let generation = '';
                        if (year >= 2020) generation = 'C8';
                        else if (year >= 2014) generation = 'C7';
                        else if (year >= 2005) generation = 'C6';
                        else if (year >= 1997) generation = 'C5';

                        const trim = vehicle.trim || vehicle.submodel || '';
                        if (generation && trim) {
                            localStorage.setItem('e5-selected-vehicle-display', `${generation} ${trim}`);
                            console.log('✅ Saved vehicle display format:', `${generation} ${trim}`);
                        }
                    }

                    // Success vibration
                    if (navigator.vibrate) {
                        navigator.vibrate([50, 100, 50]);
                    }

                    const successMessage = `
                        Success! Your items have been added to cart
                        <div class="countdown-timer">
                            Taking you to Cart in <span id="countdown-number">2</span>s
                        </div>
                    `;
                    showMessage(successMessage, 'success');

                    startCountdown(2);

                    setTimeout(() => {
                        window.location.href = '/checkout/cart';
                    }, 2000);

                } catch (error) {
                    console.error('Error adding to cart:', error);
                    showMessage('Error adding to cart. Please try again.', 'error', 3000);
                }
            }

            function initAutosync() {
                try {
                    const Autosync = (window as any).Autosync;
                    if (!Autosync) {
                        console.error('Autosync not loaded');
                        return;
                    }

                    new Autosync({
                        id: 'autosync-visualizer',
                        key: 'MFCtst',
                        scrollBar: false,
                        productSegment: null,
                        homeStyle: null,
                        widget: false,
                        startPage: 'vehicles',
                        disableQuoteForm: true,
                        onEvent: ({ event, data }: any) => {
                            console.log('Autosync Event:', event, data);

                            if (event === 'addToCart' ||
                                event === 'buyNow' ||
                                event === 'btnBuyClick' ||
                                event === 'cartAdd' ||
                                event === 'addCart' ||
                                event === 'buyButton' ||
                                event === 'purchase' ||
                                event.toLowerCase().includes('buy') ||
                                event.toLowerCase().includes('cart') ||
                                event.toLowerCase().includes('add')) {
                                console.log('Buy event detected:', event);
                                handleCartRedirect(data);
                                return;
                            }

                            if (event === 'submitQuote') {
                                console.log('Submit quote event:', event);
                                handleCartRedirect(data);
                            }
                        }
                    });

                    (window as any).e5AutosyncInitialized = true;
                    console.log('E5 Autosync initialized successfully');

                } catch (error) {
                    console.error('Failed to initialize E5 Autosync:', error);
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initAutosync);
            } else {
                initAutosync();
            }
        }
    </script>
</MainLayout>
