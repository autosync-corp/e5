---
import MainLayout from "@/layouts/MainLayout.astro";
import CheckoutOrder from "./components/CheckoutOrder.vue";
import AddressForm from "./components/AddressForm.vue";

// Get payment API keys from environment
const stripePublishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY;
const affirmPublicKey = import.meta.env.PUBLIC_AFFIRM_PUBLIC_KEY;
---

<MainLayout title="Checkout - E5 Wheels">
  <!-- Progress Bar -->
  <section class="e5CheckoutProgBar">
    <div class="e5CheckoutProgInner">
      <div class="e5CheckoutProgRow">
        <div class="e5CheckoutProgLine"></div>

        <!-- Step 1 -->
        <div class="e5CheckoutProgStepCart">
          <div class="e5CheckoutProgDotCart">
            <img
              class="e5CheckoutProgIconCart"
              src="/assets/images/cart/40eb342b73462b1f996cdb7f9c9a92e0d95a45fc.webp"
              alt="Cart"
            />
          </div>
          <p class="e5CheckoutProgLabelCart">CART</p>
        </div>

        <!-- Step 2 (Active) -->
        <div class="e5CheckoutProgStepCheckout">
          <div class="e5CheckoutProgDotCheckout">
            <img
              class="e5CheckoutProgIconCheckout"
              src="/assets/images/cart/556a6d30f7a2b7b09444155207ee5da1a4c1ae86.webp"
              alt="Checkout"
            />
          </div>
          <p class="e5CheckoutProgLabelCheckout">CHECKOUT</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Checkout Content -->
  <section class="e5CheckoutContent">
    <div class="e5CheckoutContainer">
      <!-- Left Column - Billing Details -->
      <AddressForm client:load />

      <!-- Right Column - Order Summary -->
      <CheckoutOrder client:load stripePublishableKey={stripePublishableKey} affirmPublicKey={affirmPublicKey} />
    </div>
  </section>
</MainLayout>

<style is:global>
  /* Progress Bar */
  .e5CheckoutProgBar {
    width: 100%;
    background: #0a0a0a;
  }

  .e5CheckoutProgInner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 32px;
  }

  .e5CheckoutProgRow {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 200px;
  }

  .e5CheckoutProgLine {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    top: 18px;
    height: 1px;
    background: #a33a3a;
    z-index: 0;
  }

  .e5CheckoutProgStepCart,
  .e5CheckoutProgStepCheckout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .e5CheckoutProgDotCart,
  .e5CheckoutProgDotCheckout {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: #c94343;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .e5CheckoutProgIconCart,
  .e5CheckoutProgIconCheckout {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .e5CheckoutProgLabelCart,
  .e5CheckoutProgLabelCheckout {
    margin-top: 12px;
    font-size: 11px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    font-weight: 600;
    color: #ffffff;
  }

  /* Checkout Content */
  .e5CheckoutContent {
    width: 100%;
    background: #f5f5f5;
    padding: 60px 32px 80px;
  }

  .e5CheckoutContainer {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  /* Billing Section */
  .e5CheckoutBillingWrapper {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px;
  }

  .e5CheckoutSectionTitle {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #0a0a0a;
    margin-bottom: 32px;
  }

  .e5CheckoutForm {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .e5CheckoutFormRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .e5CheckoutFormGroup {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .e5CheckoutLabel {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .e5CheckoutInput,
  .e5CheckoutSelect,
  .e5CheckoutTextarea {
    width: 100%;
    height: 44px;
    padding: 0 16px;
    border: 1px solid #d5d5d5;
    border-radius: 4px;
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 14px;
    color: #0a0a0a;
    background: #ffffff;
  }

  .e5CheckoutInput::placeholder,
  .e5CheckoutTextarea::placeholder {
    color: #999999;
  }

  .e5CheckoutInputSecondary {
    margin-top: 8px;
  }

  .e5CheckoutSelect {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23666666' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 40px;
  }

  .e5CheckoutTextarea {
    height: 100px;
    padding: 12px 16px;
    resize: vertical;
  }

  .e5CheckoutCheckboxGroup {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .e5CheckoutCheckbox {
    width: 18px;
    height: 18px;
    border: 1px solid #d5d5d5;
    border-radius: 3px;
    cursor: pointer;
  }

  .e5CheckoutCheckboxLabel {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 14px;
    color: #0a0a0a;
    cursor: pointer;
  }

  /* Order Summary */
  .e5CheckoutOrderWrapper {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px;
  }

  .e5CheckoutOrderTitle {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #0a0a0a;
    margin-bottom: 32px;
  }

  .e5CheckoutOrderSection {
    padding: 24px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .e5CheckoutOrderRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
  }

  .e5CheckoutOrderLabel {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 14px;
    color: #0a0a0a;
  }

  .e5CheckoutOrderValue {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #0a0a0a;
  }

  .e5CheckoutProductItem {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 0;
  }

  .e5CheckoutProductName {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #0a0a0a;
    margin-bottom: 8px;
  }

  .e5CheckoutProductDetail {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 12px;
    color: #666666;
    margin: 2px 0;
  }

  .e5CheckoutProductPrice {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #0a0a0a;
  }

  .e5CheckoutOrderTotal {
    border-top: 2px solid #0a0a0a;
    padding-top: 16px;
    margin-top: 8px;
  }

  .e5CheckoutOrderTotal .e5CheckoutOrderLabel,
  .e5CheckoutOrderTotal .e5CheckoutOrderValue {
    font-family: 'Franklin Gothic Demi', sans-serif;
    font-size: 18px;
    font-weight: 600;
  }

  /* Payment Section */
  .e5CheckoutPaymentSection {
    padding: 24px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .e5CheckoutPaymentOption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    cursor: pointer;
  }

  .e5CheckoutRadio {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .e5CheckoutPaymentLabel {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 14px;
    color: #0a0a0a;
    cursor: pointer;
  }

  .e5CheckoutCardIcons {
    display: flex;
    gap: 8px;
  }

  .e5CheckoutCardImage {
    height: 24px;
  }

  .e5CheckoutAffirmLogo,
  .e5CheckoutPaymentIcon {
    height: 24px;
  }

  .e5CheckoutCardForm {
    padding: 20px;
    background: #f9f9f9;
    border-radius: 8px;
    margin-top: -8px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Privacy Text */
  .e5CheckoutPrivacyText {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 11px;
    color: #666666;
    line-height: 1.6;
    margin-top: 24px;
  }

  .e5CheckoutPrivacyLink {
    color: #d31d25;
    text-decoration: underline;
  }

  /* Place Order Button */
  .e5CheckoutPlaceOrderBtn {
    width: 100%;
    background: #d31d25;
    color: #ffffff;
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 16px 32px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s;
    margin-top: 24px;
  }

  .e5CheckoutPlaceOrderBtn:hover {
    background: #a33a3a;
  }

  /* Empty State Styles */
  .e5CheckoutEmptyState {
    padding: 40px;
    text-align: center;
  }

  .e5CheckoutEmptyText {
    font-family: 'Franklin Gothic Book', sans-serif;
    font-size: 16px;
    color: #666666;
  }

  /* Shipping Address Section */
  .e5CheckoutShippingSection {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 2px solid #e5e5e5;
  }

  .e5CheckoutSubsectionTitle {
    font-family: 'Franklin Gothic Medium', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #0a0a0a;
    margin-bottom: 24px;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .e5CheckoutContainer {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .e5CheckoutFormRow {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .e5CheckoutContent {
      padding: 40px 16px 60px;
    }

    .e5CheckoutBillingWrapper,
    .e5CheckoutOrderWrapper {
      padding: 24px;
    }

    .e5CheckoutProgRow {
      gap: 100px;
    }

    .e5CheckoutProgLine {
      width: 100px;
    }
  }
</style>
