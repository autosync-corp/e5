---
import MainLayout from '@/layouts/MainLayout.astro';
import Hero from "@/core/components/Hero.vue";
import Button from "@/core/components/Button.vue";
import {
  E5_FORGED_SERIES_LOGO,
  FORM_FORGED_WORDMARK,
  TALLADEGA_EXO,
  TWO_P_FORGED_LOGO,
  GT_FORGED_LOGO,
  DAYTONA_TITANIUM_BRUSHED_CARD,
  SEBRING_TITANIUM_BRUSHED_CARD,
  SPEEDWAY_TITANIUM_BRUSHED_TINT_CARD,
  SEBRING_2P_GLOSS_BLACK_CARD,
  SEBRING_2P_DARK_BRONZE_CARD,
  SEBRING_2P_TITANIUM_BRUSHED_CARD,
  TALLADEGA_BRUSHED_ALUMINUM_CARD,
  SONOMA_BRUSHED_ALUMINUM_CARD,
  LAGUNA_WHEEL_CARD,
  GT01_BRUSHED_ALUMINUM_CARD,
  GT02_BRUSHED_ALUMINUM_CARD,
  GT03_BRUSHED_ALUMINUM_CARD,
} from "@/pages/wheels/constants/Wheels.ts";
import { VETTE_BLACK_ON_RIVER } from "@/pages/gallery/constants/VetteGallery.ts";
import { E5_BLACK_RED_DRAW, WHEEL_HOME_SHOT_1 } from "@/core/constants/App.ts";
import {
    GALLERY_VEHICLES_ROUTE, GALLERY_WHEELS_ROUTE,
    PROCESS_ROUTE,
    WHEELS_FORM_FORGED_ROUTE,
    WHEELS_TALLADEGA_ROUTE,
    WHEELS_SEBRING_2P_ROUTE,
    WHEELS_GT_01_ROUTE,
} from "@/core/constants/Routes.ts";
import { SITE_URL } from '@/core/constants/Site.ts';

const baseUrl = SITE_URL;
const title = 'E5 Wheels | Exclusively Engineered for Corvettes';
const description = 'E5 Wheels designs forged and flow-formed wheels exclusively for Corvette C5, C6, C7, and C8. Precision fitment, hub-centric, made in the USA.';
const canonicalUrl = `${baseUrl}/`;
const heroVideoId = '2zk8Sdi3Yh8';

const homeSeries = [
  {
    key: 'form',
    logo: FORM_FORGED_WORDMARK,
    logoClass: 'home-series-logo--form',
    alt: 'Form Forged',
    wheels: [
      { src: DAYTONA_TITANIUM_BRUSHED_CARD, alt: 'Daytona Titanium Brushed' },
      { src: SEBRING_TITANIUM_BRUSHED_CARD, alt: 'Sebring Titanium Brushed' },
      { src: SPEEDWAY_TITANIUM_BRUSHED_TINT_CARD, alt: 'Speedway Titanium Brushed Tint' },
    ],
    blurb: 'Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility&mdash;without compromising daily drivability.',
    cta: 'EXPLORE FORM FORGED',
    href: WHEELS_FORM_FORGED_ROUTE,
    gtm: 'Explore Form Forged',
  },
  {
    key: '2p',
    logo: TWO_P_FORGED_LOGO,
    logoClass: 'home-series-logo--2p',
    alt: '2P Forged',
    wheels: [
      { src: SEBRING_2P_GLOSS_BLACK_CARD, alt: 'Sebring 2P Gloss Black' },
      { src: SEBRING_2P_DARK_BRONZE_CARD, alt: 'Sebring 2P Dark Bronze' },
      { src: SEBRING_2P_TITANIUM_BRUSHED_CARD, alt: 'Sebring 2P Titanium Brushed' },
    ],
    blurb: 'Sebring 2P is a two-piece Corvette-only C8 fitment&mdash;19x9 +35mm / 20x11 +45mm on Stingray, and 20x10 +25mm / 21x13 +20mm on Z06 and E-Ray.',
    cta: 'EXPLORE 2P FORGED',
    href: WHEELS_SEBRING_2P_ROUTE,
    gtm: 'Explore 2P Forged',
  },
  {
    key: 'e5',
    logo: E5_FORGED_SERIES_LOGO,
    logoClass: 'home-series-logo--e5',
    alt: 'E5 Forged',
    wheels: [
      { src: TALLADEGA_BRUSHED_ALUMINUM_CARD, alt: 'Talladega Brushed Aluminum' },
      { src: SONOMA_BRUSHED_ALUMINUM_CARD, alt: 'Sonoma Brushed Aluminum' },
      { src: LAGUNA_WHEEL_CARD, alt: 'Laguna Brushed Aluminum' },
    ],
    blurb: 'Exclusively Forged in the USA for C8 Z06, ZR1, and E Ray. Engineered for extreme performance, reduced weight, and maximum strength.',
    cta: 'EXPLORE E5 FORGED',
    href: WHEELS_TALLADEGA_ROUTE,
    gtm: 'Explore E5 Forged',
  },
  {
    key: 'gt',
    logo: GT_FORGED_LOGO,
    logoClass: 'home-series-logo--gt',
    alt: 'GT Forged',
    wheels: [
      { src: GT01_BRUSHED_ALUMINUM_CARD, alt: 'GT.01 Brushed Aluminum' },
      { src: GT02_BRUSHED_ALUMINUM_CARD, alt: 'GT.02 Brushed Aluminum' },
      { src: GT03_BRUSHED_ALUMINUM_CARD, alt: 'GT.03 Brushed Aluminum' },
    ],
    blurb: 'GT.01, GT.02, GT.03, and GT.04&mdash;made to order in Brushed Aluminum, Gloss Black, and Satin Black. Catalog sizes 19x9 +35mm through 21x13 +20mm.',
    cta: 'EXPLORE GT FORGED',
    href: WHEELS_GT_01_ROUTE,
    gtm: 'Explore GT Forged',
  },
];
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/images/hero-video-poster-800.webp"
    type="image/webp"
    media="(max-width: 1023px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/images/hero-video-poster.webp"
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="w-full h-full">
    <Hero>
      <div
        id="e5-hero-video"
        data-youtube-id={heroVideoId}
        style={`position: relative; width: 100%; height: 94%; overflow: hidden; background: #000 url('/assets/images/hero-video-poster-800.webp') center / cover no-repeat;`}
      >
        <img
          src="/assets/images/hero-video-poster-800.webp"
          srcset="/assets/images/hero-video-poster-800.webp 800w, /assets/images/hero-video-poster.webp 1280w"
          sizes="100vw"
          alt="E5 Wheels Corvette hero"
          width="1280"
          height="720"
          fetchpriority="high"
          decoding="async"
          style="position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; transform: translate(-50%, -50%); object-fit: cover; pointer-events: none;"
        />
      </div>
    </Hero>
    <script is:inline>
      (function () {
        var host = document.getElementById('e5-hero-video');
        if (!host) return;
        var videoId = host.getAttribute('data-youtube-id');
        if (!videoId) return;
        function loadHeroVideo() {
          if (host.getAttribute('data-loaded')) return;
          host.setAttribute('data-loaded', '1');
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&mute=1&loop=1&playlist=' + videoId + '&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0&playsinline=1&enablejsapi=0&vq=hd720';
          iframe.setAttribute('allowtransparency', 'true');
          iframe.setAttribute('allow', 'autoplay; encrypted-media');
          iframe.setAttribute('title', 'E5 Wheels Hero Video');
          iframe.style.cssText = 'position: absolute; top: 47%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; transform: translate(-50%, -50%); border: 0; pointer-events: none;';
          host.appendChild(iframe);
        }
        // Mobile PageSpeed: keep the poster as LCP and do not inject YouTube
        // until the visitor interacts. Desktop still autoplays after idle.
        var desktop = window.matchMedia('(min-width: 1024px)').matches;
        if (desktop) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadHeroVideo, { timeout: 4000 });
          } else {
            window.addEventListener('load', loadHeroVideo);
          }
        } else {
          window.addEventListener('pointerdown', loadHeroVideo, { once: true, passive: true });
          window.addEventListener('touchstart', loadHeroVideo, { once: true, passive: true });
        }
      })();
    </script>

    <section class="container-e5 text-center mt-8 mb-20">
      <div>
        <h1 class="font-franklin-heavy text-4xl md:text-5xl lg:text-6xl text-black mb-6 font-black">
          EXCLUSIVELY ENGINEERED FOR CORVETTES
        </h1>
        <p class="font-sans font-bold text-lg md:text-xl lg:text-26 text-black/70 mx-auto">
          E5 Wheels are exclusively engineered for Corvettes&mdash;no universal fitments, no compromises.
          Every design is forged to align with the car's aggressive stance, meet its high-performance demands, and complement its unmistakable identity.
        </p>
      </div>
    </section>

    <section class="container-e5 mt-8 bg-gray-100 py-16 md:py-20">
      <div class="home-series-grid">
        {homeSeries.map((block) => (
          <article class="home-series-block">
            <div class="home-series-logo-row">
              <img src={block.logo} alt={block.alt} class={`home-series-logo ${block.logoClass}`} width="528" height="66" decoding="async" loading="lazy" />
            </div>
            <div class:list={['home-series-cluster', block.key === 'gt' && 'home-series-cluster--gt']}>
              {block.wheels.map((wheel) => (
                <img src={wheel.src} alt={wheel.alt} width="400" height="400" decoding="async" loading="lazy" />
              ))}
            </div>
            <p class="home-series-blurb" set:html={block.blurb} />
            <div class="home-series-cta">
              <Button client:visible primary link={block.href} data-gtm-event="explore_wheel" data-gtm-label={block.gtm}>{block.cta}</Button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container-e5 relative max-w-[1500px] lg:flex justify-between mx-auto py-32">
      <div class="grid grid-cols-1 auto-rows-min text-center lg:text-start">
        <img src={E5_BLACK_RED_DRAW} alt="E5 Wheels process" class="w-[264px] h-auto mx-auto lg:mx-0" width="264" height="80" decoding="async" loading="lazy" />
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-franklin-medium mt-12">OUR PROCESS</h2>
        <p class="lg:max-w-[700px] text-xl text-black/70 mt-6">
          At E5, we approach every wheel with a process rooted in precision engineering, model-specific fitment, and an uncompromising attention to detail. From concept design to final finish, we engineer each product to enhance performance, complement the car's design, and uphold the standards that define the Corvette platform.
        </p>
        <div class="mt-20">
          <Button client:visible primary link={PROCESS_ROUTE} data-gtm-event="cta_learn_more" data-gtm-label="Learn More">LEARN MORE<span class="sr-only"> about our process</span></Button>
        </div>
      </div>
      <div class="h-[438px] hidden lg:block">
        <img src={TALLADEGA_EXO} alt="Talladega Exo" class="w-full max-w-[438px] h-auto" width="438" height="438" decoding="async" loading="lazy" />
      </div>
    </section>

    <section class="py-20 bg-gray-100 text-center md:text-start">
      <div class="container-e5">
        <h2 class="text-3xl md:text-4xl lg:text-48 text-e5-red font-normal">GALLERIES</h2>
        <p class="text-base md:text-lg lg:text-24 text-black/60 uppercase mt-5 mb-20">
          From detailed finishes to full builds&mdash; experience E5 in our galleries.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_4px_1fr] gap-12">
          <div class="flex justify-center items-center">
            <div class="relative w-full max-w-[660px] h-auto aspect-square bg-cover bg-center" style={`background-image: url(${VETTE_BLACK_ON_RIVER})`}>
              <div class="absolute bottom-0 left-0 w-full cursor-pointer h-full hover:bg-black/30 flex justify-center items-end pb-10">
                <Button client:visible primary link={GALLERY_VEHICLES_ROUTE} data-gtm-event="view_gallery" data-gtm-label="Vette Gallery">
                    VETTE GALLERY
                </Button>
              </div>
            </div>
          </div>
          <div class="bg-e5-separator h-full min-h-[660px] hidden lg:block"></div>
          <div class="flex justify-center items-center">
            <div class="relative w-full max-w-[660px] h-auto aspect-square bg-cover bg-center" style={`background-image: url(${WHEEL_HOME_SHOT_1})`}>
              <div class="absolute bottom-0 left-0 w-full cursor-pointer h-full hover:bg-black/30 flex justify-center items-end pb-10">
                <Button client:visible primary link={GALLERY_WHEELS_ROUTE} data-gtm-event="view_gallery" data-gtm-label="Wheel Gallery">
                    WHEEL GALLERY
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
