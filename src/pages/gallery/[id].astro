---
import MainLayout from '@/layouts/MainLayout.astro';
import { corvetteGalleryData } from "@/pages/gallery/constants/CorvetteGalleryData.ts";
import type { CorvetteGalleryItem } from "@/pages/gallery/constants/CorvetteGalleryData.ts";
import VehicleCard from "@/pages/gallery/components/_VehicleCard.vue";
// @ts-expect-error - Vue component with script setup has implicit default export
import VehicleImagesGallery from "@/pages/gallery/components/_VehicleImagesGallery.vue";
import Button from "@/core/components/Button.vue";
import VehicleWheelDetails from "@/pages/gallery/components/_VehicleWheelDetails.vue";
import WheelGalleryImages from "@/pages/gallery/components/_WheelGalleryImages.vue";
import {GALLERY_DETAIL_ROUTE, GALLERY_VEHICLES_ROUTE, WHEELS_ROUTE} from "@/core/constants/Routes.ts";

export const prerender = true;

export function getStaticPaths() {
  return corvetteGalleryData.map((vehicle) => ({
    params: { id: vehicle.galleryId || '' },
    props: { vehicleData: vehicle },
  }));
}

const { vehicleData } = Astro.props as { vehicleData: CorvetteGalleryItem };

// Build unique page title
const buildPageTitle = () => {
  // If vehicleTitle exists and is not "N/A", use it
  if (vehicleData.vehicleTitle && vehicleData.vehicleTitle !== 'N/A') {
    return `${vehicleData.vehicleTitle} Gallery - E5 Wheels`;
  }

  // Otherwise, build from parts
  const parts = [];
  if (vehicleData.year && vehicleData.year !== 'N/A') parts.push(vehicleData.year);
  if (vehicleData.submodel && vehicleData.submodel !== 'N/A') parts.push(vehicleData.submodel);
  if (vehicleData.trim && vehicleData.trim !== 'N/A') parts.push(vehicleData.trim);

  if (parts.length > 0) {
    return `${parts.join(' ')} Corvette Gallery - E5 Wheels`;
  }

  // Fallback
  return `Corvette Gallery - E5 Wheels`;
};

const pageTitle = buildPageTitle();

// Build meta description
const buildDescription = () => {
  const parts = [];
  if (vehicleData.year && vehicleData.year !== 'N/A') parts.push(vehicleData.year);
  if (vehicleData.submodel && vehicleData.submodel !== 'N/A') parts.push(vehicleData.submodel);
  if (vehicleData.trim && vehicleData.trim !== 'N/A') parts.push(vehicleData.trim);

  const vehicleName = parts.length > 0 ? parts.join(' ') : 'Corvette';
  const wheelInfo = vehicleData.wheelStyle && vehicleData.wheelStyle !== 'N/A' ? `${vehicleData.wheelStyle}` : 'E5';

  return `View ${vehicleName} Corvette with ${wheelInfo} wheels. See detailed photos, wheel specifications, and fitment details from our customer gallery.`;
};

const description = buildDescription();

// Build canonical URL
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const canonicalUrl = `${baseUrl}/gallery/${vehicleData.galleryId}`;

// Helper function to get media items from the vehicle data
function getGalleryMedia(vehicle: CorvetteGalleryItem): any[] {
  const galleryPath = `/assets/images/gallery/corvette/${vehicle.galleryId}`;

  // If media array exists, use it (supports videos)
  if (vehicle.media && vehicle.media.length > 0) {
    return vehicle.media.map((item: any) => {
      if (item.type === 'video') {
        return {
          type: 'video',
          youtubeId: item.youtubeId,
          thumbnail: item.thumbnail ? `${galleryPath}/${item.thumbnail}` : null
        };
      }
      return {
        type: 'image',
        url: item.url ? `${galleryPath}/${item.url}` : ''
      };
    });
  }

  // Fallback to images array for backward compatibility
  if (vehicle.images && vehicle.images.length > 0) {
    return vehicle.images.map((file: string) => ({
      type: 'image',
      url: `${galleryPath}/${file}`
    }));
  }

  return [];
}

// Map CSV data to page format
const vehicle = {
  id: vehicleData.galleryId,
  galleryId: vehicleData.galleryId,
  year: vehicleData.year || 'N/A',
  model: vehicleData.submodel || 'N/A',
  trim: vehicleData.vehicleTitle || vehicleData.trim || 'N/A',
  title: vehicleData.vehicleTitle || vehicleData.trim || 'N/A',
  style: vehicleData.wheelStyle || 'N/A',
  finish: vehicleData.wheelFinish || 'N/A',
  image: `/assets/images/gallery/corvette/${vehicleData.galleryId}/0.webp`,
  galleryMedia: getGalleryMedia(vehicleData),
  wheelLogo: `/assets/images/logos/e5-${vehicleData.wheelStyle?.toLowerCase().replace(' ', '-')}.webp`,
  tires: vehicleData.tireModel || 'N/A',
};

// Build ImageObject schema for Google Image Search
const wheelDesc = vehicle.style !== 'N/A'
  ? `E5 ${vehicle.style}${vehicle.finish !== 'N/A' ? ` ${vehicle.finish}` : ''} wheels`
  : 'E5 custom wheels';

const imageSchemaItems = vehicle.galleryMedia
  .filter((m: any) => m.type === 'image')
  .map((m: any, i: number) => ({
    '@type': 'ImageObject',
    'contentUrl': `${baseUrl}${m.url}`,
    'name': `${vehicle.trim !== 'N/A' ? vehicle.trim : vehicle.year + ' ' + vehicle.model + ' Corvette'} &mdash; ${wheelDesc} &mdash; Photo ${i + 1}`,
    'description': `${vehicle.year !== 'N/A' ? vehicle.year + ' ' : ''}${vehicle.model !== 'N/A' ? vehicle.model + ' ' : ''}Corvette with ${wheelDesc}`,
  }));

const imageGallerySchema = imageSchemaItems.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  'name': `${vehicle.trim !== 'N/A' ? vehicle.trim : 'Corvette'} with ${wheelDesc}`,
  'description': description,
  'url': canonicalUrl,
  'image': `${baseUrl}${vehicle.image}`,
  'associatedMedia': imageSchemaItems,
}) : null;

const breadcrumbName = vehicle.trim !== 'N/A' ? vehicle.trim : `${vehicle.year} ${vehicle.model} Corvette`;
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${baseUrl}/` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Gallery', 'item': `${baseUrl}/gallery/vehicles` },
    { '@type': 'ListItem', 'position': 3, 'name': breadcrumbName, 'item': canonicalUrl }
  ]
});

// Get similar corvettes (same model)
const corvetteGalleryImages = corvetteGalleryData
  .filter(v => v.submodel === vehicleData.submodel && v.galleryId !== vehicleData.galleryId)
  .slice(0, 3)
  .map((item, index) => ({
    id: item.galleryId || `vehicle-${index}`,
    image: `/assets/images/gallery/corvette/${item.galleryId}/0.webp`,
    year: item.year || 'N/A',
    trim: item.vehicleTitle || item.trim || 'N/A',
    title: item.vehicleTitle || item.trim || 'N/A',
    wheelModel: item.wheelStyle || 'N/A',
    wheelFinish: item.wheelFinish || 'N/A',
  }));
---

<MainLayout title={pageTitle} description={description} canonical={canonicalUrl} ogImage={`${baseUrl}${vehicle.image}`}>
  <Fragment slot="head">
    {imageGallerySchema && <script is:inline type="application/ld+json" set:html={imageGallerySchema}></script>}
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
  <div class="w-full h-full">
    <div class="relative">
      <div class="absolute w-full bg-black/60 py-6">
        <div class="container-e5 flex items-center justify-end">
          <a
              href={GALLERY_VEHICLES_ROUTE}
              class="font-franklin-book text-xs text-white tracking-[3.2px] uppercase hover:text-white transition-colors"
          >
            BACK TO GALLERY
          </a>

          <!--<nav class="flex gap-8">-->
          <!--  <a href={PENDING_ROUTE} class="font-franklin-book text-xs text-white tracking-[3.2px] uppercase hover:text-e5-red transition-colors">SHOP</a>-->
          <!--  <a href={PENDING_ROUTE} class="font-franklin-book text-xs text-white tracking-[3.2px] uppercase hover:text-e5-red transition-colors">SIZES</a>-->
          <!--  <a href={PENDING_ROUTE} class="font-franklin-book text-xs text-white tracking-[3.2px] uppercase hover:text-e5-red transition-colors">FINISHES</a>-->
          <!--  <a href={PENDING_ROUTE} class="font-franklin-book text-xs text-white tracking-[3.2px] uppercase hover:text-e5-red transition-colors">WARRANTY</a>-->
          <!--</nav>-->
        </div>
      </div>

      <VehicleImagesGallery client:only="vue" trim={vehicle.trim} media={vehicle.galleryMedia} />
    </div>

    <!-- Vehicle & Wheel Details Section -->
    <section class="container-e5 pt-4">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-franklin-heavy uppercase tracking-[2px] text-black mb-6">
        {vehicle.trim !== 'N/A' ? vehicle.trim : `${vehicle.year} ${vehicle.model} Corvette`} with {wheelDesc}
      </h1>
      <div class="flex items-start justify-between mb-8">
        <div></div>
        <div class="text-right">
          <p class="text-lg text-black/50 opacity-70 tracking-wide leading-[30px]">
            VEHICLE MODEL
          </p>
          <p class="text-xl md:text-2xl font-bold text-black opacity-70 tracking-wide leading-[30px] mt-1"> {vehicle.trim} </p>
        </div>
      </div>

      <VehicleWheelDetails
        client:only="vue"
        partF={vehicleData.partF}
        wheelPartR={vehicleData.wheelPartR}
        vehicleWheelStyle={vehicle.style}
        vehicleWheelFinish={vehicle.finish}
        vehicleWheelSizeF={vehicleData.wheelSizeF}
        vehicleOffesetF={vehicleData.offesetF}
        vehicleWheelSizeRear={vehicleData.wheelSizeRear}
        vehicleOffsetR={vehicleData.offsetR}
        wheelStyleLogo={vehicle.wheelLogo}
        vehicleSubmodel={vehicleData.submodel}
        vehicleTitle={vehicleData.vehicleTitle}
        vehicleTrim={vehicleData.trim}
      />
    </section>

    <!-- C7 Corvette Gallery Section -->
    <section class="container-e5 pt-24">
      <h2 class="text-xl md:text-2xl text-black opacity-70 tracking-wide leading-[34px] mb-4">
        {vehicle.model} GALLERY
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {corvetteGalleryImages.map((item) => (
          <VehicleCard
            client:only="vue"
            image={item.image}
            year={item.year}
            title={item.title}
            style={item.wheelModel}
            finish={item.wheelFinish}
            link={`${GALLERY_DETAIL_ROUTE}/${item.id}`}
          />
        ))}
      </div>

      <div class="w-full flex justify-center mt-12">
        <Button client:only="vue" primary={true} secondary={false} disabled={false} link={GALLERY_VEHICLES_ROUTE}>
          VIEW FULL GALLERY
        </Button>
      </div>
    </section>

    <WheelGalleryImages
      client:only="vue"
      partF={vehicleData.partF}
      wheelPartR={vehicleData.wheelPartR}
      wheelStyle={vehicle.style}
      wheelFinish={vehicle.finish}
      wheelsRoute={WHEELS_ROUTE}
      vehicleSubmodel={vehicleData.submodel}
      vehicleTitle={vehicleData.vehicleTitle}
      vehicleTrim={vehicleData.trim}
    />
  </div>
</MainLayout>
