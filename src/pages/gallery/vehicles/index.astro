---
import GalleryVehiclesGrid from '@/pages/gallery/components/_GalleryVehiclesGrid.vue';
import MainLayout from '@/layouts/MainLayout.astro';
import { corvetteGalleryData, WHEELS_COMING_SOON } from '@/pages/gallery/constants/CorvetteGalleryData.ts';
import { sortGalleryItems } from '@/pages/gallery/utils/sortGallery.ts';
import { GALLERY_DETAIL_ROUTE } from '@/core/constants/Routes.ts';
import { SITE_URL } from '@/core/constants/Site.ts';

// Get URL parameters
const url = new URL(Astro.request.url);
const generation = url.searchParams.get('generation');
const trim = url.searchParams.get('trim');

// Build dynamic title
let pageTitle = 'Corvette Gallery';
if (generation) {
  pageTitle = `${generation} Corvette Gallery`;
  if (trim) {
    pageTitle = `${generation} ${trim} Corvette Gallery`;
  }
}
pageTitle += ' - E5 Wheels';

let pageHeading = 'Corvette Gallery';
if (generation) {
  pageHeading = `${generation}${trim ? ' ' + trim : ''} Corvette Gallery`;
}

// SEO metadata
const baseUrl = SITE_URL;
const description = generation
  ? `Browse our gallery of ${generation}${trim ? ' ' + trim : ''} Corvettes with E5 Wheels. See real customer builds and installations.`
  : 'Browse our complete Corvette gallery featuring C5, C6, C7, and C8 builds with E5 Wheels. Real customer installations and builds.';
const canonicalUrl = `${baseUrl}/gallery/vehicles`;

let listing = corvetteGalleryData;
if (generation) {
  listing = listing.filter((item) => item.submodel === generation.toUpperCase());
}
if (trim) {
  listing = listing.filter((item) => item.trim === trim);
}
listing = sortGalleryItems(listing);

const crawlableVehicles = listing
  .filter((item) => item.galleryId)
  .map((item) => ({
    id: item.galleryId as string,
    image: `/assets/images/gallery/corvette/${item.galleryId}/0.webp`,
    title: item.vehicleTitle || item.trim || 'Corvette',
    style: item.wheelStyle || WHEELS_COMING_SOON,
    finish: item.wheelFinish || '',
    link: `${GALLERY_DETAIL_ROUTE}/${item.galleryId}`,
  }));
---

<MainLayout title={pageTitle} description={description} canonical={canonicalUrl}>
  <div class="w-full h-full">
    <div id="gallery-ssr">
      <section class="w-full bg-white pt-16 pb-8">
        <div class="container-e5">
          <img
            src="/assets/images/gallery-logo.png"
            alt="Gallery"
            class="h-[50px] md:h-[60px] lg:h-[70px] mb-4 object-contain"
          />
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-franklin-heavy text-black mb-6">
            {pageHeading}
          </h1>
          <p class="text-[18px] md:text-[20px] font-excon-light text-black/70 leading-[30px] max-w-[800px]">
            Our builds are in the wild. See them for yourself, envision yours.
          </p>
        </div>
      </section>

      <section class="container-e5 pt-8 pb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {crawlableVehicles.map((vehicle) => (
            <a href={vehicle.link} class="flex flex-col hover:opacity-90 transition-opacity">
              <img
                src={vehicle.image}
                alt={vehicle.title}
                class="w-full h-[330px] object-cover bg-gray-50"
                width="400"
                height="330"
                loading="lazy"
              />
              <div class="bg-gray-100 px-4 py-3 text-center uppercase tracking-[1.5px] text-14">
                <p class="text-black/30">{vehicle.style}</p>
                <p class="font-franklin-medium text-lg text-black">{vehicle.title}</p>
                {vehicle.finish && (
                  <div class="text-black tracking-[0.8px]">{vehicle.style} {vehicle.finish}</div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
    <GalleryVehiclesGrid client:only="vue" />
  </div>
</MainLayout>
