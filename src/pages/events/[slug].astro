---
export const prerender = false;
import EventPage from '@/core/components/EventPage.astro';
import { getEventBySlug } from '@/core/services/EventsService';
import { FALLBACK_EVENT } from '@/core/constants/fallbackEvent';

const { slug } = Astro.params;

let event = slug ? await getEventBySlug(slug) : null;

// Preserve the original fallback event's own URL so it's still reachable pre-seed
if (!event && slug === FALLBACK_EVENT.slug) {
  event = FALLBACK_EVENT;
}

if (!event) {
  return Astro.redirect('/events');
}
---

<EventPage event={event} canonicalPath={`/events/${event.slug}`} />
