---
export const prerender = false;
import '@/assets/main.css';
import '@/assets/fonts/fonts.css';
import Footer from '@/core/components/Footer.vue';
import EventNavHeader from '@/core/components/EventNavHeader.astro';
import EventPage from '@/core/components/EventPage.astro';
import { getActiveEvent } from '@/core/services/EventsService';

const siteUrl = import.meta.env.PUBLIC_BASE_URL || 'https://www.e5wheels.com';
const event = await getActiveEvent();
---

{event ? (
  <EventPage event={event} canonicalPath="/events/upcoming" />
) : (
  <html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>No Upcoming Events — E5 Wheels</title>
    <meta name="description" content="No upcoming E5 Wheels events right now — check back soon." />
    <link rel="canonical" href={`${siteUrl}/events/upcoming`} />
    <style>
      html, body { width: 100%; margin: 0; padding: 0; }
      .no-events-page { width: 100%; background: #fff; color: #111; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
      .no-events-content { max-width: 700px; margin: 0 auto; padding: 120px 32px; text-align: center; }
      .no-events-content h1 { font-family: 'Franklin Gothic Heavy', sans-serif; font-size: clamp(28px, 5vw, 42px); text-transform: uppercase; color: #000; margin-bottom: 16px; }
      .no-events-content p { font-size: 16px; color: #666; line-height: 1.7; margin-bottom: 24px; }
      .no-events-content a { color: #d31d25; text-decoration: none; font-weight: 600; }
      .no-events-content a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
  <div class="no-events-page">
    <EventNavHeader />
    <div class="no-events-content">
      <h1>No Upcoming Events</h1>
      <p>There's nothing scheduled right now — check back soon, or view <a href="/events">past events</a>.</p>
    </div>
  </div>
  <Footer client:only="vue" />
  </body>
  </html>
)}
