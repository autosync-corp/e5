---
import MainLayout from '@/layouts/MainLayout.astro';

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://www.e5wheels.com';
const description = 'Explore E5 Wheels in interactive 3D. Rotate, zoom, and inspect every detail of our form forged and forged wheel designs for Corvette C5, C6, C7, and C8.';
const canonicalUrl = `${baseUrl}/interact`;
---

<MainLayout title="Interactive 3D Models - E5 Wheels" description={description} canonical={canonicalUrl}>
  <div class="w-full bg-white pb-24">
    <!-- Hero Section -->
    <section class="container-e5 py-20">
      <div class="max-w-[1400px] mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
          <h1 class="text-[#d31d25] text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] font-['Franklin_Gothic_Book'] tracking-[5.6px] md:tracking-[7.2px] lg:tracking-[8.4px] xl:tracking-[9.6px] uppercase mb-6 leading-tight px-6 md:px-12">
            Interactive 3D Models
          </h1>
          <div class="w-full h-[2px] bg-[#d31d25] mb-8"></div>
          <p class="text-black/70 text-[14px] md:text-[16px] lg:text-[18px] xl:text-[20px] leading-[24px] md:leading-[28px] px-6 md:px-12">
            Explore our wheel designs in stunning 3D. Rotate, zoom, and inspect every detail.
          </p>
        </div>

        <!-- Sketchfab Embed -->
        <div class="px-6 md:px-12">
          <div class="sketchfab-embed-wrapper">
            <div class="sketchfab-embed-container">
              <iframe
                src="https://sketchfab.com/playlists/embed?collection=d0c6f933457b4e3497d5088f4cc1e02b&autostart=0"
                title="E5 Wheels - The Daytona"
                style="border: 0;"
                allowfullscreen
                allow="autoplay; fullscreen; xr-spatial-tracking"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .sketchfab-embed-wrapper {
    position: relative;
    padding-bottom: 75%; /* Adjust this value based on your desired aspect ratio */
    height: 0;
    overflow: hidden;
  }

  .sketchfab-embed-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .sketchfab-embed-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>
