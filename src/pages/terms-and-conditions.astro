          </h1>
          <div class="w-full h-[2px] bg-[#d31d25] mb-8"></div>
          <p class="text-black/70 text-[14px] md:text-[16px] font-['Franklin_Gothic_Book'] px-6 md:px-12">
            Last updated: June 5, 2023
          </p>
        </div>

        <!-- Introduction -->
        <div class="mb-12 space-y-6 text-black/70 text-[14px] md:text-[16px] lg:text-[18px] xl:text-[20px] leading-[24px] md:leading-[28px] px-6 md:px-12">
