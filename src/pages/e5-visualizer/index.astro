---
import MainLayout from '@/layouts/MainLayout.astro';

// E5's own custom-built visualizer (ported from the `testground` staging
// repo — see ai/VISUALIZER_MIGRATION_NOTES.md). Now embedded under the main
// site's own header/footer, so the tool's own internal nav bar was removed
// from public/visualizer-app/e5wheels-visualizer_9.html (it's redundant with
// the one MainLayout renders here).
//
// Still embedded via iframe rather than served directly at this URL: the
// ported app's internal paths (its nested iframe, css, images) are all
// relative to its own directory (public/visualizer-app/), and a redirect
// changes the address bar away from /e5-visualizer, which isn't wanted.
//
// Not linked from anywhere else on the site yet — direct-link access only.
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Wheel Visualizer | E5 Wheels';
const description = 'Visualize E5 Forged and Form Forged wheels on your Corvette.';
const canonicalUrl = `${baseUrl}/e5-visualizer`;
---

<style>
.e5-visualizer-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 650px;
    border: 0;
}
</style>

<MainLayout title={title} description={description} canonical={canonicalUrl} noindex={true}>
    <iframe
        class="e5-visualizer-frame"
        src="/visualizer-app/e5wheels-visualizer_9.html"
        title="E5 Wheels Visualizer"
    ></iframe>
</MainLayout>
