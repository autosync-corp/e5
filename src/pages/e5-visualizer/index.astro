---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE_URL } from '@/core/constants/Site.ts';

// E5's own custom-built visualizer (ported from the `testground` staging
// repo — see ai/VISUALIZER_MIGRATION_NOTES.md). Now embedded under the main
// site's own header/footer, so the tool's own internal nav bar was removed
// from public/visualizer-app/e5wheels-visualizer_9.html (it's redundant with
// the one MainLayout renders here).
//
// Still embedded via iframe rather than served directly at this URL: the
// ported app's internal paths (its nested iframe, css, images) are all
// relative to its own directory (public/visualizer-app/), and a redirect
// changes the address bar away from /e5-visualizer, which isn't wanted.
//
// Not linked from anywhere else on the site yet — direct-link access only.
const baseUrl = SITE_URL;
const title = 'E5 Immersive Gallery | Visualize E5 Wheels on Your Corvette';
const description = 'Open the E5 Immersive Gallery to see Daytona, Sebring, Speedway, Talladega, Sonoma, Laguna, and GT Forged wheels on C5, C6, C7, and C8 Corvettes.';
const canonicalUrl = `${baseUrl}/e5-visualizer`;
---

<style>
.e5-visualizer-intro {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 16px;
    text-align: center;
}
.e5-visualizer-intro h1 {
    font-family: 'Franklin Gothic Heavy', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 12px;
    color: #111;
}
.e5-visualizer-intro p {
    font-family: 'Franklin Gothic Book', sans-serif;
    color: rgba(0, 0, 0, 0.7);
    font-size: 16px;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 720px;
}
.e5-visualizer-frame {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 650px;
    border: 0;
}
</style>

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <section class="e5-visualizer-intro">
        <h1>E5 Immersive Gallery</h1>
        <p>
            Browse real E5 wheel and Corvette combinations in the Immersive Gallery.
            Pick a generation, style, and finish to see complete staggered sets on C5, C6, C7, and C8.
        </p>
    </section>
    <iframe
        class="e5-visualizer-frame"
        src="/visualizer-app/e5wheels-visualizer_9.html"
        title="E5 Immersive Gallery"
    ></iframe>
</MainLayout>
