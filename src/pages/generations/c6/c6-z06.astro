---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    GALLERY_VEHICLES_ROUTE,
    GENERATIONS_ROUTE,
} from "@/core/constants/Routes.ts";
import { SITE_URL } from '@/core/constants/Site.ts';
import GenerationIntro from '@/core/components/GenerationIntro.astro';
import GenerationHeading from '@/core/components/GenerationHeading.astro';
import GenerationSetups from '@/core/components/GenerationSetups.astro';
import {
    finishSummary,
    styleLinksFromSetups,
} from '@/core/utils/generationSetups';
import { loadGenerationSetups } from '@/core/utils/loadGenerationSetups';

const baseUrl = SITE_URL;
const title = 'C6 Z06 Wheels (2006–2013) | E5 Wheels';
const description = 'C6 Z06 wheels (2006–2013) with Corvette-only 19x10 +30mm / 20x12 +50mm Form Forged fitment. Daytona, Sebring, and Speedway in gloss black, bronze, and titanium.';
const canonicalUrl = `${baseUrl}/generations/c6/c6-z06`;
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Generations", "item": `${baseUrl}${GENERATIONS_ROUTE}` },
    { "@type": "ListItem", "position": 3, "name": "C6", "item": `${baseUrl}/generations/c6` },
    { "@type": "ListItem", "position": 4, "name": "Z06", "item": canonicalUrl }
  ]
});
const setups = await loadGenerationSetups('C6', ['Z06']);
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
    <div class="w-full bg-white -mt-107">
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden bg-[#ededed] flex items-center justify-center" data-missing="gallery-hero">
            <p class="text-center px-6 text-[14px] md:text-[16px] tracking-[3px] uppercase text-black/50 font-['Franklin_Gothic_Demi']">
                E5 gallery photo needed — C6 Z06
            </p>
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <GenerationHeading
                title="C6 Z06 Wheels"
                years="2006–2013"
                class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']"
            />
            <GenerationIntro
                lead="C6 Z06 wheels (2006–2013) are Form Forged for Corvette-only widebody hub-centric fitment."
                groups={[
                    { heading: 'Z06', front: 'Front 19" × 10" +30mm', rear: 'Rear 20" × 12" +50mm' },
                ]}
                styles={styleLinksFromSetups(setups)}
                finishes={finishSummary(setups) || "Available in gloss black, bronze brushed tint, and titanium brushed tint"}
                bodyClass="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[34px] lg:leading-[38px] text-black/70"
                wrapperClass="max-w-[1536px] mx-auto px-4 mb-8"
                application="C6 Corvette application"
            >
                <Fragment slot="see">
                    See customer cars in the <a href={`${GALLERY_VEHICLES_ROUTE}?generation=C6`} class="text-e5-red hover:opacity-80 transition-opacity">C6 gallery</a>.
                </Fragment>
            </GenerationIntro>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FITMENT FOR C6 CORVETTES
            </p>
        </section>

        <GenerationSetups setups={setups} />

        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                The C6 Z06's LS7 and wide fenders want a staggered 19/20 set with extra rear width. E5's catalog uses the same Form Forged 19x10 +30mm / 20x12 +50mm spec published for C6 Grand Sport&mdash;hub-centric, no spacers, and enough barrel for big brakes.
            </p>
        </section>

        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Form Forged C6 colors are Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, and Dark Bronze, each with E5's five-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/7b0eb2bf712356f129743563b9cab285a89c93ba.webp" alt="Bronze Brushed Tint" class="w-full h-full object-cover" />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">BRONZE BRUSHED TINT</p>
                </div>
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/8e5841a54069de69a6a01416054324b8d9753076.webp" alt="Titanium Brushed Tint" class="w-full h-full object-cover" />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">TITANIUM BRUSHED TINT</p>
                </div>
            </div>
            <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-4 md:mb-8">
                <img src="/assets/images/generations/c6/grand-sport-figma-new/3fc4a5a61713920ec596f2c3d1972913bf4e7a6b.webp" alt="Gloss Black" class="w-full h-full object-cover" />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">GLOSS BLACK</p>
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <div class="w-full md:w-auto flex-shrink-0">
                    <img src="/assets/images/logos/C6.png" alt="C6 Corvette Logo" class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0" />
                </div>
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">C6 (2005–2013)</h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I took everything the C5 started and refined it with surgical precision. Exposed headlamps, a stiffer chassis, and up to 638 horsepower in my Z06 and ZR1 trims &mdash; I wasn't chasing anyone. I was the benchmark they were all trying to catch."
                    </p>
                </div>
            </div>
        </section>

        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden bg-[#ededed] flex items-center justify-center" data-missing="gallery-banner">
            <p class="text-center px-6 text-[14px] md:text-[16px] tracking-[3px] uppercase text-black/50 font-['Franklin_Gothic_Demi']">E5 gallery photo needed — C6 Z06</p>
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] tracking-[3px] md:tracking-[5px] lg:tracking-[7px] xl:tracking-[9.6px] leading-[32px] md:leading-[40px] lg:leading-[46px] xl:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C6 Z06 CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                E5's published gallery does not yet include a C6 Z06. The C6 gallery currently shows Base and Grand Sport cars.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px] bg-[#ededed] flex items-center justify-center" data-missing="gallery-thumb"><p class="px-4 text-center text-[12px] tracking-[2px] uppercase text-black/40">Photo needed</p></div>
                <div class="w-full h-[530px] bg-[#ededed] flex items-center justify-center" data-missing="gallery-thumb"><p class="px-4 text-center text-[12px] tracking-[2px] uppercase text-black/40">Photo needed</p></div>
                <div class="w-full h-[530px] bg-[#ededed] flex items-center justify-center" data-missing="gallery-thumb"><p class="px-4 text-center text-[12px] tracking-[2px] uppercase text-black/40">Photo needed</p></div>
            </div>
            <div class="text-center">
                <a href={`${GALLERY_VEHICLES_ROUTE}?generation=C6`} class="inline-block bg-e5-red text-white px-12 py-6 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors">
                    VIEW GALLERY
                </a>
            </div>
        </section>

        <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            BACK TO TOP
        </div>
    </div>
</MainLayout>
