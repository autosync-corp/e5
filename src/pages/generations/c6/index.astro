---
import MainLayout from '@/layouts/MainLayout.astro';
import Button from "@/core/components/Button.vue";
import {
    GALLERY_VEHICLES_ROUTE,
    GENERATIONS_ROUTE,
    GENERATIONS_C6_GRAND_SPORT_ROUTE,
    GENERATIONS_C6_Z06_ROUTE,
    GENERATIONS_C6_ZR1_ROUTE,
} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";
import { SITE_URL } from '@/core/constants/Site.ts';
import GenerationIntro from '@/core/components/GenerationIntro.astro';
import GenerationHeading from '@/core/components/GenerationHeading.astro';
import GenerationSetups from '@/core/components/GenerationSetups.astro';
import {
    finishSummary,
    styleLinksFromSetups,
} from '@/core/utils/generationSetups';
import { loadGenerationSetups } from '@/core/utils/loadGenerationSetups';

// URL variables for different sections
// Daytona detail section (19" x 9.5" +53mm / 20" x 11" +76mm)
// Sebring detail section (19" x 10" +30mm / 20" x 12" +50mm)
// Also Available section - use Base sizes (Daytona finishes)
const daytonaGlossBlackAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');
const daytonaTitaniumBrushedAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');
const daytonaBronzeBrushedAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');

const baseUrl = SITE_URL;
const title = 'C6 Corvette Wheels (2005–2013) | E5 Wheels';
const description = 'E5 C6 Corvette wheels for 2005–2013 Base, Z06, ZR1, and Grand Sport. Hub-centric Daytona and Sebring fitment, 19"/20" sizes, and Corvette-only finishes.';
const canonicalUrl = `${baseUrl}/generations/c6`;
const c6GalleryUrl = `${GALLERY_VEHICLES_ROUTE}?generation=c6`;
const introLinkClass = 'underline decoration-black/30 underline-offset-[6px] hover:text-e5-red hover:decoration-e5-red transition-colors';
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Generations", "item": `${baseUrl}${GENERATIONS_ROUTE}` },
    { "@type": "ListItem", "position": 3, "name": "C6", "item": canonicalUrl }
  ]
});
const setups = await loadGenerationSetups('C6', ['Base']);
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c6/19e3d04f39bacd3cde7701e9583418f945235fb5.webp"
                    alt="C6 Corvette with E5 wheels"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <GenerationHeading
                title="C6 Corvette Wheels"
                years="2005–2013"
                class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']"
            />
            <GenerationIntro
                lead={'E5 C6 Corvette wheels are hub-centric and engineered only for Corvettes, covering 2005–2013 Base, Z06, ZR1, and Grand Sport in staggered 19"/20" sizes.'}
                groups={[
                    { heading: 'Base', front: 'Front 19" × 9.5" +53mm', rear: 'Rear 20" × 11" +76mm' },
                    {
                      heading: 'Grand Sport and Z06',
                      headingParts: [
                        { label: 'Grand Sport', href: GENERATIONS_C6_GRAND_SPORT_ROUTE },
                        { label: ' and ' },
                        { label: 'Z06', href: GENERATIONS_C6_Z06_ROUTE },
                      ],
                      front: 'Front 19" × 10" +30mm',
                      rear: 'Rear 20" × 12" +50mm',
                    },
                    {
                      heading: 'ZR1',
                      headingHref: GENERATIONS_C6_ZR1_ROUTE,
                      front: 'Front size unpublished',
                      rear: 'Rear size unpublished',
                      note: 'No E5 gallery car or curated catalog fitment for C6 ZR1 yet.',
                    },
                ]}
                styles={styleLinksFromSetups(setups)}
                finishes={finishSummary(setups) || "Available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint & Dark Bronze"}
                linkClass={introLinkClass}
                bodyClass="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[34px] lg:leading-[38px] text-black/70"
                wrapperClass="max-w-[1536px] mx-auto px-4 mb-8"
                application="C6 Corvette application"
            >
                <Fragment slot="see">
                    See customer cars in the <a href={c6GalleryUrl} class={introLinkClass}>C6 gallery</a> and on the <a href={GENERATIONS_C6_GRAND_SPORT_ROUTE} class={introLinkClass}>C6 Grand Sport</a>, <a href={GENERATIONS_C6_Z06_ROUTE} class={introLinkClass}>C6 Z06</a>, and <a href={GENERATIONS_C6_ZR1_ROUTE} class={introLinkClass}>C6 ZR1</a> pages.
                </Fragment>
            </GenerationIntro>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED FOR C6 CORVETTES
            </p>
        </section>

        <GenerationSetups setups={setups} />

        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <p class="text-[14px] md:text-[18px] lg:text-[22px] tracking-[3px] md:tracking-[4px] lg:tracking-[4.4px] leading-[22px] text-black/50 uppercase text-center mb-8 md:mb-12">
                Shop Wheels by C6 Model
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 lg:gap-10">
                <a href={GENERATIONS_C6_GRAND_SPORT_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
                    <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-e5-black">
                        <img
                            src="/assets/images/generations/c6/grand-sport-figma-new/ebd9666fb80be2e2e27be771428f3fc1ea0e0241.webp"
                            alt="C6 Corvette Grand Sport"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                    <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
                        C6 Grand Sport
                    </h2>
                    <p class="text-[14px] md:text-[16px] tracking-[2.8px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
                        Form Forged Series
                    </p>
                    <p class="text-[14px] md:text-[15px] leading-[20px] text-black/60 mb-3">
                        Catalog 19x10 +30mm / 20x12 +50mm staggered set, shared with C6 Z06.
                    </p>
                    <span class="text-[12px] md:text-[14px] tracking-[2.4px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
                        Explore C6 Grand Sport &rarr;
                    </span>
                </a>
                <a href={GENERATIONS_C6_Z06_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
                    <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-[#ededed] flex items-center justify-center" data-missing="gallery-thumb">
                        <p class="px-4 text-center text-[12px] tracking-[2px] uppercase text-black/40">E5 gallery photo needed</p>
                    </div>
                    <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
                        C6 Z06
                    </h2>
                    <p class="text-[14px] md:text-[16px] tracking-[2.8px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
                        Form Forged Series
                    </p>
                    <p class="text-[14px] md:text-[15px] leading-[20px] text-black/60 mb-3">
                        LS7 widebody, 2006–2013. Same published 19x10 / 20x12 staggered set as Grand Sport.
                    </p>
                    <span class="text-[12px] md:text-[14px] tracking-[2.4px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
                        Explore C6 Z06 &rarr;
                    </span>
                </a>
                <a href={GENERATIONS_C6_ZR1_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
                    <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-[#ededed] flex items-center justify-center" data-missing="gallery-thumb">
                        <p class="px-4 text-center text-[12px] tracking-[2px] uppercase text-black/40">E5 gallery photo needed</p>
                    </div>
                    <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
                        C6 ZR1
                    </h2>
                    <p class="text-[14px] md:text-[16px] tracking-[2.8px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
                        Form Forged Series
                    </p>
                    <p class="text-[14px] md:text-[15px] leading-[20px] text-black/60 mb-3">
                        LS9 flagship, 2009–2013. Fitment unpublished until a catalog row or gallery car is confirmed.
                    </p>
                    <span class="text-[12px] md:text-[14px] tracking-[2.4px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
                        Explore C6 ZR1 &rarr;
                    </span>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C6 Corvette, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance&mdash;delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="border-2 border-gray-400 p-4 md:p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                    <div class="w-full">
                        <img
                            src="/assets/images/generations/c6/625c360a181b1fdc1da3a474f72af58d0bcaa9d6.webp"
                            alt="E5 Wheel Detail"
                            class="w-full h-auto object-cover"
                        />
                    </div>
                    <div class="w-full">
                        <img
                            src="/assets/images/generations/c6/df7543f5024bf725601bb1f963d352f6d20807df.webp"
                            alt="E5 Wheel Detail"
                            class="w-full h-auto object-cover"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE&mdash; finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c6/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                            alt="Bronze Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        BRONZE BRUSHED TINT
                    </p>
                </div>
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c6/8e5841a54069de69a6a01416054324b8d9753076.webp"
                            alt="Titanium Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        TITANIUM BRUSHED TINT
                    </p>
                </div>
            </div>
            <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-4 md:mb-8">
                <img
                    src="/assets/images/generations/c6/3fc4a5a61713920ec596f2c3d1972913bf4e7a6b.webp"
                    alt="Gloss Black"
                    class="w-full h-full object-cover"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">
                GLOSS BLACK
            </p>
        </section>

        <!-- C6 Generation Quote Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <!-- Logo and Quote -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <!-- C6 Logo -->
                <div class="w-full md:w-auto flex-shrink-0">
                    <img
                        src="/assets/images/logos/C6.png"
                        alt="C6 Corvette Logo"
                        class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0"
                    />
                </div>

                <!-- Quote Content -->
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">
                        C6 (2005–2013)
                    </h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I took everything the C5 started and refined it with surgical precision. Exposed headlamps, a stiffer chassis, and up to 638 horsepower in my Z06 and ZR1 trims &mdash; I wasn't chasing anyone. I was the benchmark they were all trying to catch."
                    </p>
                </div>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/6ce8c3d28464c1fd0ab1c8cee39cb706a3c2b6f1.webp"
                alt="C6"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/45965a1f7b5d1621792495a8d5047e8de71e0caa.webp"
                alt="C6"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Daytona Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase text-center mb-12">
                ALSO AVAILABLE FOR C6 CORVETTES
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Gloss Black -->
                <a href={daytonaGlossBlackAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Titanium Brushed Tint -->
                <a href={daytonaTitaniumBrushedAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Bronze Brushed Tint -->
                <a href={daytonaBronzeBrushedAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="https://wheels.autosyncstudio.com/webp/E5/Daytona_BBT_Gloss_Bronze_Brushed-Face-Tinted-Clear_5-lug_0001.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>

            <div class="text-center">
                <Button client:visible primary link={daytonaGlossBlackAltUrl}>
                    <span>SHOP FITMENT</span>
                </Button>
            </div>
        </section>

        <!-- Gallery Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] tracking-[3px] md:tracking-[5px] lg:tracking-[7px] xl:tracking-[9.6px] leading-[32px] md:leading-[40px] lg:leading-[46px] xl:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C6 CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Explore our gallery of C6 Corvettes, showcasing a variety of styles and finishes on customer vehicles.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c6/3b74eb172b8dae322d2702ad3627c74ff388d9e1.webp"
                        alt="C6 Gallery 1"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c6/45965a1f7b5d1621792495a8d5047e8de71e0caa.webp"
                        alt="C6 Gallery 2"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c6/e21442d1d8316475411e59a4b7d71e5f75b67590.webp"
                        alt="C6 Gallery 3"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
            <div class="text-center">
