---
import MainLayout from '@/layouts/MainLayout.astro';
import Button from "@/core/components/Button.vue";
import {GALLERY_VEHICLES_ROUTE, WHEELS_DAYTONA_ROUTE, WHEELS_SEBRING_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
    SEBRING_LOGO,
    SEBRING_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

// URL variables for different sections
// Daytona detail section (19" x 9.5" +53mm / 20" x 11" +76mm)
const daytonaTitaniumBrushedUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed Tint', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');

// Sebring detail section (19" x 10" +30mm / 20" x 12" +50mm)
const sebringGlossBlackUrl = buildWheelUrl(SEBRING_BRAND_NAME, 'Gloss Black', 'C6', 'Base', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringBronzeBrushedUrl = buildWheelUrl(SEBRING_BRAND_NAME, 'Bronze Brushed Tint', 'C6', 'Base', '19" x 10" +30mm', '20" x 12" +50mm');

// Top 3 wheels - use Base sizes
const daytonaBronzeBrushedUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');
const daytonaGlossBlackUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');

// Also Available section - use Base sizes (Daytona finishes)
const daytonaGlossBlackAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');
const daytonaTitaniumBrushedAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed Tint', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');
const daytonaBronzeBrushedAltUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C6', 'Base', '19" x 9.5" +53mm', '20" x 11" +76mm');

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'C6 Corvette Wheels (2005-2013) - Form Forged Series | E5 Wheels';
const description = 'Shop Form Forged wheels for C6 Corvette (2005-2013). Engineered for Base, Z06, ZR1, and Grand Sport models. Hub-centric fitment, multiple finishes and sizes available.';
const canonicalUrl = `${baseUrl}/generations/c6`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c6/19e3d04f39bacd3cde7701e9583418f945235fb5.webp"
                    alt="C6 Corvette"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C6 CORVETTE Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4 mb-8">
                The passion for the C6 runs deep—and the support should match it. Built for the C6 base model, our Form Forged Series blends forged DNA with flow-formed construction to deliver strength, reduced weight, and everyday drivability. Exclusively engineered for Corvettes, each design complements the C6's proportions, performance character, and timeless identity.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED FOR C6 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Daytona - Bronze Brushed Tint -->
                <a href={daytonaBronzeBrushedUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="https://wheels.autosyncstudio.com/webp/E5/Daytona_BBT_Gloss_Bronze_Brushed-Face-Tinted-Clear_5-lug_0001.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Daytona - Gloss Black -->
                <a href={daytonaGlossBlackUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Sebring - Bronze Brushed Tint -->
                <a href={sebringBronzeBrushedUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/6633a5fa3fbf86ab9e4ebada3acfa83d7ae98d30.webp" alt="Sebring Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={SEBRING_LOGO} alt="Sebring" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C6 Corvette, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="border-2 border-gray-400 p-4 md:p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                    <div class="w-full">
                        <img
                            src="/assets/images/generations/c6/625c360a181b1fdc1da3a474f72af58d0bcaa9d6.webp"
                            alt="E5 Wheel Detail"
                            class="w-full h-auto object-cover"
                        />
                    </div>
                    <div class="w-full">
                        <img
                            src="/assets/images/generations/c6/df7543f5024bf725601bb1f963d352f6d20807df.webp"
                            alt="E5 Wheel Detail"
                            class="w-full h-auto object-cover"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c6/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                            alt="Bronze Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        BRONZE BRUSHED TINT
                    </p>
                </div>
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c6/8e5841a54069de69a6a01416054324b8d9753076.webp"
                            alt="Titanium Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        TITANIUM BRUSHED TINT
                    </p>
                </div>
            </div>
            <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-4 md:mb-8">
                <img
                    src="/assets/images/generations/c6/3fc4a5a61713920ec596f2c3d1972913bf4e7a6b.webp"
                    alt="Gloss Black"
                    class="w-full h-full object-cover"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">
                GLOSS BLACK
            </p>
        </section>

        <!-- C6 Generation Quote Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <!-- Logo and Quote -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <!-- C6 Logo -->
                <div class="w-full md:w-auto flex-shrink-0">
                    <img
                        src="/assets/images/logos/C6.png"
                        alt="C6 Corvette Logo"
                        class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0"
                    />
                </div>

                <!-- Quote Content -->
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">
                        C6 (2005–2013)
                    </h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I took everything the C5 started and refined it with surgical precision. Exposed headlamps, a stiffer chassis, and up to 638 horsepower in my Z06 and ZR1 trims — I wasn't chasing anyone. I was the benchmark they were all trying to catch."
                    </p>
                </div>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/6ce8c3d28464c1fd0ab1c8cee39cb706a3c2b6f1.webp"
                alt="C6"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 1: Titanium Brushed Tint -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c6/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 9.5" / Offset +53mm</li>
                                <li>Rear: 20" x 11" / Offset +76mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Titanium Brushed Tint</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 pt-8">
                            <Button client:visible primary link={daytonaTitaniumBrushedUrl}>
                                <span>SHOP FITMENT</span>
                            </Button>
                            <Button client:visible secondary link={WHEELS_DAYTONA_ROUTE}>
                                <span>EXPLORE DAYTONA</span>
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/45965a1f7b5d1621792495a8d5047e8de71e0caa.webp"
                alt="C6"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 2: Gloss Black (Sebring) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c6/57612e656f7cb177dd66a7b9e8dbaf32845675c7.webp" alt="Sebring Gloss Black" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SEBRING_LOGO} alt="Sebring" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 pt-8">
                            <Button client:visible primary link={sebringGlossBlackUrl}>
                                <span>SHOP FITMENT</span>
                            </Button>
                            <Button client:visible secondary link={WHEELS_SEBRING_ROUTE}>
                                <span>EXPLORE SEBRING</span>
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Daytona Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase text-center mb-12">
                ALSO AVAILABLE FOR C6 CORVETTES
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Gloss Black -->
                <a href={daytonaGlossBlackAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Titanium Brushed Tint -->
                <a href={daytonaTitaniumBrushedAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Bronze Brushed Tint -->
                <a href={daytonaBronzeBrushedAltUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="https://wheels.autosyncstudio.com/webp/E5/Daytona_BBT_Gloss_Bronze_Brushed-Face-Tinted-Clear_5-lug_0001.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
