---
import MainLayout from '@/layouts/MainLayout.astro';
import Button from "@/core/components/Button.vue";
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE, SHOP_ROUTE, WHEELS_DAYTONA_ROUTE, WHEELS_SEBRING_ROUTE, SINGLE_PRODUCT_ROUTE} from "@/core/constants/Routes.ts";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
    SEBRING_LOGO,
    SEBRING_BRAND_NAME,
    SPEEDWAY_LOGO,
    SPEEDWAY_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";
---

<MainLayout title="C6 Grand Sport Corvette Wheels - E5 Wheels">
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c6/grand-sport-figma-new/ebd9666fb80be2e2e27be771428f3fc1ea0e0241.webp"
                    alt="C6 Grand Sport Corvette"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C6 GRAND SPORT CORVETTE Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4 mb-8">
                Born from the bridge between street presence and track capability, the C6 Grand Sport demands more than a generic fitment. Our Form Forged Series is engineered around its wider stance and performance intent, using flow-formed construction rooted in forged DNA to deliver strength, reduced weight, and daily drivability. Exclusively designed for Corvettes, each wheel sharpens the Grand Sport's proportions, handling confidence, and unmistakable character.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED FOR C6 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Speedway Titanium Brushed Tint -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SPEEDWAY_BRAND_NAME}&finish=Titanium Brushed Tint&generation=C6&trim=Grand Sport`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.webp" alt="Speedway Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={SPEEDWAY_LOGO} alt="Speedway" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Daytona Gloss Black -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${DAYTONA_BRAND_NAME}&finish=Gloss Black&generation=C6&trim=Grand Sport`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Sebring Bronze Brushed Tint -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SEBRING_BRAND_NAME}&finish=Bronze Brushed Tint&generation=C6&trim=Grand Sport`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/6633a5fa3fbf86ab9e4ebada3acfa83d7ae98d30.webp" alt="Sebring Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={SEBRING_LOGO} alt="Sebring" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>

            <div class="text-center">
                <Button client:visible primary link={`${WHEELS_ROUTE}`}>
                    <span>SHOP FORM FORGED</span>
                </Button>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C6 Grand Sport, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <div class="w-full h-[434px]">
                    <img
                        src="/assets/images/generations/c6/grand-sport-figma-new/3ae3d924f20f4cb3f91caa52ba737cec2861fd34.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[435px]">
                    <img
                        src="/assets/images/generations/c6/grand-sport-figma-new/14d9cddaf6c883d25f65e4da7abe1e7379299063.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8">
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c6/grand-sport-figma-new/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                        alt="Bronze Brushed Tint"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c6/grand-sport-figma-new/8e5841a54069de69a6a01416054324b8d9753076.webp"
                        alt="Titanium Brushed Tint"
                        class="w-full h-full object-cover object-[0%_0%]"
                    />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-12">
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    BRONZE BRUSHED TINT
                </p>
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    TITANIUM BRUSHED TINT
                </p>
            </div>
            <div class="w-full h-[611px] mb-8">
                <img
                    src="/assets/images/generations/c6/grand-sport-figma-new/3fc4a5a61713920ec596f2c3d1972913bf4e7a6b.webp"
                    alt="Gloss Black"
                    class="w-full h-full object-cover object-[0%_53%]"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                GLOSS BLACK
            </p>
        </section>

        <!-- C6 Specifications Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[35px] md:leading-[40px] lg:leading-[43px] text-e5-red uppercase mb-8 md:mb-12 text-center font-['Franklin_Gothic_Book']">
                C6 WHEEL SPECIFICATIONS
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 text-center max-w-[1276px] mx-auto mb-12 md:mb-16">
                Here is what you need to know about your C6.
            </p>

            <!-- Specifications Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-center font-['Franklin_Gothic_Book'] text-[18px] md:text-[20px] lg:text-[24px] tracking-[1.2px]">
                    <thead>
                        <tr class="border-b border-black/20">
                            <th class="py-6 px-4 text-black/70 font-normal leading-[54px]">C6 VARIANT</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">BOLT<br/>PATTERN</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">CENTER<br/>BORE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT<br/>OFFSET</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR<br/>OFFSET</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">BASE<br/>MODEL</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">18" x 8.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+56 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 10"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+59 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">Grand Sport</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">18" x 9.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+56 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 12"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+59 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">Z06</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">18" x 9.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+54 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 12"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+58 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">ZR1</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 10"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+56 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 12"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+59 mm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/grand-sport-figma-new/336db2c4e39af603249bf7fc1e70d3337ca99a96.webp"
                alt="C6 Grand Sport"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 1: Daytona Titanium -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c6/grand-sport-figma-new/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6">
                            <a href={`${SINGLE_PRODUCT_ROUTE}?series=${DAYTONA_BRAND_NAME}&finish=Gloss Black&generation=C6&trim=Grand Sport`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                                SHOP FITMENT
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c6/grand-sport-figma-new/4c505df112dd477a57422eadbd4e65e222c074ca.webp"
                alt="C6 Grand Sport"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 2: Sebring Gloss Black -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c6/grand-sport-figma-new/57612e656f7cb177dd66a7b9e8dbaf32845675c7.webp" alt="Sebring Gloss Black" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SEBRING_LOGO} alt="Sebring" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6">
                            <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SEBRING_BRAND_NAME}&finish=Gloss Black&generation=C6&trim=Grand Sport`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                                SHOP FITMENT
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Speedway Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase text-center mb-12">
                ALSO AVAILABLE FOR C6 CORVETTES
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Speedway Gloss Black -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SPEEDWAY_BRAND_NAME}&finish=Gloss Black&generation=C6&trim=Grand Sport`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/cd19461c451031cb11b5e748b6774ae80b22a516.webp" alt="Speedway Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={SPEEDWAY_LOGO} alt="Speedway" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C6 CORVETTES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Speedway Titanium Brushed Tint -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SPEEDWAY_BRAND_NAME}&finish=Titanium Brushed Tint&generation=C6&trim=Grand Sport`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c6/grand-sport-figma-new/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.webp" alt="Speedway Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
