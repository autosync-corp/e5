---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    TALLADEGA_LOGO,
    TALLADEGA_BRAND_NAME,
    SONOMA_LOGO,
    SONOMA_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

const E5_FORGED_LOGO = "/assets/images/e5-forged-logo.webp";

// Shop URLs with proper sizes
const talladegaShopUrl = buildWheelUrl(TALLADEGA_BRAND_NAME, 'Brushed Aluminum', 'C8', 'Z06', '20" x 10" +25mm', '21" x 13" +20mm');
const sonomaShopUrl = buildWheelUrl(SONOMA_BRAND_NAME, 'Brushed Aluminum', 'C8', 'Z06', '20" x 10" +25mm', '21" x 13" +20mm');

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'C8 Z06 Wheels (2023+) - E5 Forged | E5 Wheels';
const description = 'E5 Forged wheels for C8 Z06 (2023+). Fully forged in USA for the flat-plane LT6 670hp platform. Maximum strength and weight savings. 5 premium finishes.';
const canonicalUrl = `${baseUrl}/generations/c8/c8-z06`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <div class="w-full bg-white -mt-107">

        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <img
                src="/assets/images/generations/c8/c8-z06-new/712eb0d1487009b3864cb1a30e308f725770b503.webp"
                alt="C8 Corvette Z06"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Main Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C8 CORVETTE Z06 Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4">
                Unlike universal fitments, every E5 Forged wheel for the C8 Z06 is engineered around its wider track, carbon-ceramic brake clearance, and race-bred body lines. The result is a fitment that's assertive yet composed—enhancing the Z06's aerodynamic stance without sacrificing ride quality or drivability. Whether carving canyon roads or pushing limits on track, these wheels are built to perform at the level the Z06 demands.
            </p>
        </section>

        <!-- E5 FORGED Logo Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8">
                <img src={E5_FORGED_LOGO} alt="E5 Forged" class="h-[54px] w-auto" />
                <div class="hidden md:block w-px h-[138px] bg-black/20"></div>
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[656px] text-center md:text-left">
                    Exclusively Forged in the USA for C8 Z06, ZR1, and E-Ray. Engineered for extreme performance, reduced weight, and maximum strength.
                </p>
            </div>
        </section>

        <!-- Two Wheel Options (Talladega & Sonoma) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 items-start">

                <!-- Talladega -->
                <a href={talladegaShopUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c8/c8-z06-new/taladaga-c8wheel.webp" alt="Talladega" class="w-full h-full object-contain" />
                    </div>
                    <img src={TALLADEGA_LOGO} alt="Talladega" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRUSHED ALUMINUM</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">CUSTOM FINISHES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase">MADE IN USA</p>
                </a>

                <!-- Sonoma -->
                <a href={sonomaShopUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c8/c8-z06-new/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-full object-contain" />
                    </div>
                    <img src={SONOMA_LOGO} alt="Sonoma" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRUSHED ALUMINUM</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">CUSTOM FINISHES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase">MADE IN USA</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Forged C8 Z06 wheel begins with a foundation of uncompromising strength and precision, crafted from premium 6061 aluminum. From there, we carve away excess material to optimize the strength-to-weight ratio, reduce inertia, and convert every ounce into performance. Engineered for maximum capability, our aftermarket C8 Z06 wheels unlock wider tire setups, greater grip, sharper handling, and improved brake clearance—delivering a decisive advantage on the street and the track.
            </p>
        </section>

        <!-- Two Car Images -->
        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img src="/assets/images/generations/c8/c8-z06-new/635c360776d4fed06014550fb174128129f3db5d.webp" alt="Dark Corvette" class="w-full h-auto object-cover" />
                </div>
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img src="/assets/images/generations/c8/c8-z06-new/2cab458dfcc2fd50ad398991665a70015b250025.webp" alt="Teal Corvette" class="w-full h-auto object-cover" />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every wheel in the E5 Forged Collection is more than performance—it's a statement of individuality. Available in premium finishes like gloss black, brushed aluminum, or polished, each design showcases the precision of its forged construction. For those seeking something truly unique, we also offer custom powder coats and bespoke finishes to match any vision. No matter the choice, every finish is executed with uncompromising attention to detail, delivering a look that lasts as long as the engineering behind it.
            </p>
        </section>

        <!-- Brushed Aluminum Section -->
        <section class="w-full">
            <!-- Two Brushed Aluminum Detail Images -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <img src="/assets/images/generations/c8/c8-z06-new/0f5ae0270cc82c41e485b74c2ffd241cd9722bfd.webp" alt="Brushed Aluminum Detail 1" class="w-full h-auto" />
                <img src="/assets/images/generations/c8/c8-z06-new/6d5577f249662e9409f99448a419c32c8fcbf8a5.webp" alt="Brushed Aluminum Detail 2" class="w-full h-auto" />
            </div>
        </section>

        <!-- Brushed Aluminum Label -->
        <section class="w-full bg-white py-8 mb-8">
            <p class="text-center text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red">
                BRUSHED ALUMINUM
            </p>
        </section>

        <!-- Gloss White Wheel Image -->
        <section class="w-full bg-black">
            <img src="/assets/images/generations/c8/c8-z06-new/7181d8beb31fddc40fec023baa619e384c6e542c.webp" alt="Gloss White Wheel" class="w-full h-auto" />
        </section>

        <!-- Gloss White Label -->
        <section class="w-full bg-white py-8">
            <p class="text-center text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red">
                GLOSS WHITE
            </p>
        </section>

        <!-- C8 Generation Quote Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <!-- Logo and Quote -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <!-- C8 Logo -->
                <div class="w-full md:w-auto flex-shrink-0">
                    <img
                        src="/assets/images/logos/c8.png"
                        alt="C8 Corvette Logo"
                        class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0"
                    />
                </div>

                <!-- Quote Content -->
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">
                        C8 (2020–Present)
                    </h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I rewrote the rules. Mid-engine, dual-clutch, supercar DNA — I'm what happens when seven decades of evolution finally break free from tradition. They said Corvette would never go mid-engine. I'm the answer to every doubter who ever lived."
                    </p>
                </div>
            </div>
        </section>

        <!-- Banner Image 1 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img src="/assets/images/generations/c8/c8-z06-new/middle-black-image.webp" alt="C8 Z06 Lifestyle" class="w-full h-full object-cover" />
        </section>

        <!-- Product Detail: Sonoma -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c8/c8-z06-new/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SONOMA_LOGO} alt="Sonoma" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 20" x 10" / Offset +25mm</li>
                                <li>Rear: 21" x 13" / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Brushed Aluminum</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 mt-6">
                            <a href={sonomaShopUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/sonoma`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE SONOMA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img src="/assets/images/generations/c8/c8-z06-new/3985c8d6c04f033ca897b497515ede3447f10730.webp" alt="C8 Z06 Blue" class="w-full h-full object-cover" />
        </section>

        <!-- Product Detail: Talladega -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c8/c8-z06-new/taladaga-c8wheel.webp" alt="Talladega" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={TALLADEGA_LOGO} alt="Talladega" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 20" x 10" / Offset +25mm</li>
                                <li>Rear: 21" x 13" / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Brushed Aluminum</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 mt-6">
                            <a href={talladegaShopUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/talladega`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE TALLADEGA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gallery Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] tracking-[3px] md:tracking-[5px] lg:tracking-[7px] xl:tracking-[9.6px] leading-[32px] md:leading-[40px] lg:leading-[46px] xl:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C8 Z06 CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Explore our gallery of C8 Z06 Corvettes, showcasing a variety of styles and finishes on customer vehicles.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/c8-z06-new/blue-corvette-bottom.webp" alt="Blue Corvette Gallery" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/c8-z06-new/black-corvette-bottom.webp" alt="Black Corvette Gallery" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/c8-z06-new/red-bottom.webp" alt="Red Corvette Gallery" class="w-full h-full object-cover" />
                </div>
            </div>
            <div class="text-center">
                <a href={`${GALLERY_VEHICLES_ROUTE}?generation=C8&trim=Z06`} class="inline-block bg-e5-red text-white px-10 md:px-12 lg:px-14 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors whitespace-nowrap">
                    VIEW GALLERY
                </a>
            </div>
        </section>

        <!-- Back to Top -->
        <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            BACK TO TOP
        </div>
    </div>
</MainLayout>
