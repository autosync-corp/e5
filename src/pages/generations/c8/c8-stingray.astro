---
import MainLayout from '@/layouts/MainLayout.astro';
import Button from "@/core/components/Button.vue";
import {WHEELS_ROUTE, GALLERY_WHEELS_ROUTE} from "@/core/constants/Routes.ts";
import {
    DAYTONA_BRAND_NAME,
    DAYTONA_GLOSS_BLACK,
    DAYTONA_BRONZE_BRUSHED_TINT,
    DAYTONA_TITANIUM_BRUSHED_TINT,
    DAYTONA_LOGO,
} from "@/pages/wheels/constants/Wheels.ts";
---

<MainLayout title="C8 Corvette Stingray Wheels - E5 Wheels">
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c8/ddf3b031aace1961a53533a1f783a84a67fb61b6.png"
                    alt="C8 Corvette Stingray"
                    class="w-full h-full object-cover object-[36%_38%]"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C8 CORVETTE STINGRAY Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto mb-8 md:mb-12 px-4">
                Unlike universal fitments, every E5 wheel is specifically designed around the C8 platform—its offsets, brake clearance, and body lines. The fitment is aggressive yet refined, amplifying the Stingray's naturally muscular stance while keeping comfort uncompromised. Whether it's your daily drive or a track-built setup, these wheels deliver performance that meets the legend they were made for.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED SERIES FOR C8 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12 md:mb-16">
                <!-- Chrome -->
                <div class="flex flex-col items-center">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src={DAYTONA_GLOSS_BLACK} alt="Daytona Chrome" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">CHROME</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C8</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </div>

                <!-- Titanium Brushed Tint -->
                <div class="flex flex-col items-center">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src={DAYTONA_TITANIUM_BRUSHED_TINT} alt="Daytona Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C8</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </div>

                <!-- Gloss Black -->
                <div class="flex flex-col items-center">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src={DAYTONA_BRONZE_BRUSHED_TINT} alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">18" / 19" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C8</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </div>
            </div>

            <div class="text-center">
                <Button client:visible primary>
                    <span>SHOP FORM FORGED</span>
                </Button>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C8 Stingray, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <div class="w-full h-[434px]">
                    <img
                        src="/assets/images/generations/c8/ed5a9fff49c73c30d27e3d5880a29ba1ded004f5.png"
                        alt="E5 Wheel Detail"
                        class="w-full h-full object-cover object-[0%_62%]"
                    />
                </div>
                <div class="w-full h-[434px]">
                    <img
                        src="/assets/images/generations/c8/fbf3e1f04876dc370bd4e2ec5b9496b54ae32fb3.png"
                        alt="E5 Wheel Detail"
                        class="w-full h-full object-cover object-[0%_71%]"
                    />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8">
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c8/7b0eb2bf712356f129743563b9cab285a89c93ba.png"
                        alt="Bronze Brushed Tint"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c8/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.png"
                        alt="Titanium Brushed Tint"
                        class="w-full h-full object-cover object-[0%_0%]"
                    />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-12">
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    BRONZE BRUSHED TINT
                </p>
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    TITANIUM BRUSHED TINT
                </p>
            </div>
            <div class="w-full h-[611px] mb-8">
                <img
                    src="/assets/images/generations/c8/fb6915b500baca326333e5804080e0087421c402.png"
                    alt="Gloss Black"
                    class="w-full h-full object-cover object-[0%_53%]"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                GLOSS BLACK
            </p>
        </section>

        <!-- C8 Specifications Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[35px] md:leading-[40px] lg:leading-[43px] text-e5-red uppercase mb-8 md:mb-12 text-center font-['Franklin_Gothic_Book']">
                C8 STINGRAY WHEEL SPECIFICATIONS
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 text-center max-w-[1276px] mx-auto mb-12 md:mb-16">
                Here is what you need to know about your C8 STINGRAY.
            </p>

            <!-- Specifications Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-center font-['Franklin_Gothic_Book'] text-[18px] md:text-[20px] lg:text-[24px] tracking-[1.2px]">
                    <thead>
                        <tr class="border-b border-black/20">
                            <th class="py-6 px-4 text-black/70 font-normal leading-[54px]">C8 VARIANT</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">BOLT<br/>PATTERN</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">CENTER<br/>BORE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT<br/>OFFSET</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR<br/>OFFSET</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">STINGRAY</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 8.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+38 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 11"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">Z51</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 8.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+38 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 11"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c8/7fa1c1ad958d106edf90c9fbe0d8e8e426b58bdd.png"
                alt="C8 Stingray"
                class="w-full h-full object-cover object-[0%_34%]"
            />
        </section>

        <!-- Wheel Detail 1: Titanium -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src={DAYTONA_TITANIUM_BRUSHED_TINT} alt="Daytona Titanium" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 18x10 / Offset +25mm</li>
                                <li>Rear: 19x11 / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Titanium Brushed Tint</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 pt-8">
                            <Button client:visible primary link={`${WHEELS_ROUTE}/${DAYTONA_BRAND_NAME.toLowerCase()}`}>
                                <span>SHOP DAYTONA</span>
                            </Button>
                            <Button client:visible secondary link={`${WHEELS_ROUTE}`}>
                                <span>EXPLORE FORM FORGED</span>
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c8/2eb163e4cd1c402fc02e705eae6845841c86c89c.png"
                alt="C8 Stingray"
                class="w-full h-full object-cover object-[0%_56%]"
            />
        </section>

        <!-- Wheel Detail 2: Bronze -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src={DAYTONA_BRONZE_BRUSHED_TINT} alt="Daytona Bronze" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 18x10 / Offset +25mm</li>
                                <li>Rear: 19x11 / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Bronze Brushed Tint</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 pt-8">
                            <Button client:visible primary link={`${WHEELS_ROUTE}/${DAYTONA_BRAND_NAME.toLowerCase()}`}>
                                <span>SHOP DAYTONA</span>
                            </Button>
                            <Button client:visible secondary link={`${WHEELS_ROUTE}`}>
                                <span>EXPLORE FORM FORGED</span>
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 3 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c8/339457e3ff138bf0744f20d8a7f19dfe1da3645a.png"
                alt="C8 Stingray"
                class="w-full h-full object-cover object-[0%_18%]"
            />
        </section>

        <!-- Wheel Detail 3: Gloss Black -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src={DAYTONA_GLOSS_BLACK} alt="Daytona Gloss Black" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 18x10 / Offset +25mm</li>
                                <li>Rear: 19x11 / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 pt-8">
                            <Button client:visible primary link={`${WHEELS_ROUTE}/${DAYTONA_BRAND_NAME.toLowerCase()}`}>
                                <span>SHOP DAYTONA</span>
                            </Button>
                            <Button client:visible secondary link={`${WHEELS_ROUTE}`}>
                                <span>EXPLORE FORM FORGED</span>
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gallery Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C8 CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Explore our gallery of C8 Corvettes, showcasing a variety of styles and finishes on customer vehicles.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c8/384a010f812a0db86f4ffb292d914721e9594838.png"
                        alt="C8 Gallery 1"
                        class="w-full h-full object-cover object-[0%_28%]"
                    />
                </div>
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c8/00fd7c9ac6c2ef01e4976fea6fb2012fe6a68913.png"
                        alt="C8 Gallery 2"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[530px]">
                    <img
                        src="/assets/images/generations/c8/46fe8afbb201f8ca7be0b931c5df37ace3563b2e.png"
                        alt="C8 Gallery 3"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
            <div class="text-center">
                <Button client:visible primary link={GALLERY_WHEELS_ROUTE}>
                    <span>VIEW GALLERY</span>
                </Button>
            </div>
        </section>

        <!-- Back to Top -->
        <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            BACK TO TOP
        </div>
    </div>
</MainLayout>
