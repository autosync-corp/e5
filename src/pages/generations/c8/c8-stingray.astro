---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_WHEELS_ROUTE} from "@/core/constants/Routes.ts";
import {
    DAYTONA_BRAND_NAME,
    DAYTONA_LOGO,
    SEBRING_BRAND_NAME,
    SEBRING_LOGO,
    SPEEDWAY_BRAND_NAME,
    SPEEDWAY_LOGO,
} from "@/pages/wheels/constants/Wheels.ts";
---

<MainLayout title="C8 Corvette Stingray Wheels - E5 Wheels">
  <div class="w-full bg-white -mt-107">
    <!-- Hero Banner -->
    <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/assets/images/generations/c8/stingray-figma-new/ddf3b031aace1961a53533a1f783a84a67fb61b6.webp"
          alt="C8 Corvette Stingray"
          class="w-full h-full object-cover"
        />
      </div>
    </section>

    <!-- Title and Description -->
    <section class="container-e5 py-8 md:py-12 lg:py-16 text-center">
      <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Heavy']">
        Custom C8 CORVETTE STINGRAY Wheels
      </h1>
      <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto mb-6 md:mb-8 px-4">
        Unlike universal fitments, every E5 wheel is specifically designed around the C8 platform—its offsets, brake clearance, and body lines. The fitment is aggressive yet refined, amplifying the Stingray's naturally muscular stance while keeping comfort uncompromised. Whether it's your daily drive or a track-built setup, these wheels deliver performance that meets the legend they were made for.
      </p>
      <p class="text-[16px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
        SHOP FORM FORGED SERIES FOR C7 CORVETTES
      </p>
    </section>

    <!-- Three Wheel Options -->
    <section class="w-full bg-white py-8 md:py-12 lg:py-16">
      <div class="container-e5">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 items-start">
          <!-- Speedway - Gloss Black -->
          <div class="flex flex-col items-center px-4">
            <div class="w-full max-w-[380px] md:max-w-[420px] lg:max-w-[464px] mb-6 md:mb-8">
              <img src="/assets/images/generations/c8/stingray-figma-new/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.webp" alt="Speedway Gloss Black" class="w-full h-auto" />
            </div>
            <img src={SPEEDWAY_LOGO} alt="Speedway" class="h-[24px] md:h-[28px] lg:h-[30px] w-auto mb-4 md:mb-6" />
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">CHROME</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2 text-center">ENJOY FREE SHIPPING</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">AVAILABLE FOR C8 STINGRAY</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase text-center">IN STOCK</p>
          </div>

          <!-- Daytona - Titanium Brushed Tint -->
          <div class="flex flex-col items-center px-4">
            <div class="w-full max-w-[380px] md:max-w-[420px] lg:max-w-[464px] mb-6 md:mb-8">
              <img src="/assets/images/generations/c8/stingray-figma-new/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-auto" />
            </div>
            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[24px] md:h-[28px] lg:h-[30px] w-auto mb-4 md:mb-6" />
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">TITANIUM BRUSHED TINT</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2 text-center">SET OF 4 STARTING AT $2,500</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">AVAILABLE FOR C8 STINGRAY</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase text-center">IN STOCK</p>
          </div>

          <!-- Sebring - Bronze Brushed Tint -->
          <div class="flex flex-col items-center px-4">
            <div class="w-full max-w-[380px] md:max-w-[420px] lg:max-w-[464px] mb-6 md:mb-8">
              <img src="/assets/images/generations/c8/stingray-figma-new/d442c91c12ba3d5e69ac89b01731b5399b849d1f.webp" alt="Sebring Bronze Brushed Tint" class="w-full h-auto" />
            </div>
            <img src={SEBRING_LOGO} alt="Sebring" class="h-[24px] md:h-[28px] lg:h-[30px] w-auto mb-4 md:mb-6" />
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">GLOSS BLACK</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2 text-center">19" / 20" & 20" / 21" SIZES</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2 text-center">AVAILABLE FOR C8 STINGRAY</p>
            <p class="text-[14px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase text-center">IN STOCK</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Shop Button -->
    <section class="w-full bg-white py-8 md:py-12 lg:py-16">
      <div class="container-e5 text-center">
        <a href={WHEELS_ROUTE} class="inline-block bg-e5-red text-white px-10 md:px-12 lg:px-14 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors">
          SHOP FORM FORGED
        </a>
      </div>
    </section>

    <!-- Overview Section -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
        OVERVIEW
      </h2>
      <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C8 Stingray, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        <div class="w-full h-[300px] md:h-[400px] lg:h-[434px]">
          <img
            src="/assets/images/generations/c8/stingray-figma-new/ed5a9fff49c73c30d27e3d5880a29ba1ded004f5.webp"
            alt="E5 Wheel Detail"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="w-full h-[300px] md:h-[400px] lg:h-[435px]">
          <img
            src="/assets/images/generations/c8/stingray-figma-new/fbf3e1f04876dc370bd4e2ec5b9496b54ae32fb3.webp"
            alt="E5 Wheel Detail"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Finishing Section -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
        FINISHING
      </h2>
      <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-6 md:mb-8">
        <div class="w-full h-[400px] md:h-[500px] lg:h-[575px]">
          <img
            src="/assets/images/generations/c8/stingray-figma-new/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
            alt="Bronze Brushed Tint"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="w-full h-[400px] md:h-[500px] lg:h-[575px]">
          <img
            src="/assets/images/generations/c8/stingray-figma-new/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.webp"
            alt="Titanium Brushed Tint"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 md:mb-12">
        <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center">
          BRONZE BRUSHED TINT
        </p>
        <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center">
          TITANIUM BRUSHED TINT
        </p>
      </div>
      <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-6 md:mb-8">
        <img
          src="/assets/images/generations/c8/stingray-figma-new/fb6915b500baca326333e5804080e0087421c402.webp"
          alt="Gloss Black"
          class="w-full h-full object-cover"
        />
      </div>
      <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">
        GLOSS BLACK
      </p>
    </section>

    <!-- C8 Specifications Section -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[35px] md:leading-[40px] lg:leading-[43px] text-e5-red uppercase mb-6 md:mb-8 text-center font-['Franklin_Gothic_Book']">
        C8 STINGRAY WHEEL SPECIFICATIONS
      </h2>
      <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 text-center max-w-[1276px] mx-auto mb-8 md:mb-12">
        Here is what you need to know about your C8 STINGRAY.
      </p>

      <!-- Specifications Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-center font-['Franklin_Gothic_Book'] text-[18px] md:text-[20px] lg:text-[24px] tracking-[1.2px]">
          <thead>
            <tr class="border-b border-black/20">
              <th class="py-6 px-4 text-black/70 font-normal leading-[54px]">C8 VARIANT</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">BOLT<br/>PATTERN</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">CENTER<br/>BORE</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT WHEEL<br/>SIZE</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT<br/>OFFSET</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR WHEEL<br/>SIZE</th>
              <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR<br/>OFFSET</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-black/20">
              <td class="py-6 px-4 text-black/70 leading-[30px]">STINGRAY</td>
              <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">19" x 8.5"</td>
              <td class="py-6 px-4 text-black leading-[54px]">+38 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">20" x 11"</td>
              <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
            </tr>
            <tr class="border-b border-black/20">
              <td class="py-6 px-4 text-black/70 leading-[30px]">Z51</td>
              <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">19" x 8.5"</td>
              <td class="py-6 px-4 text-black leading-[54px]">+38 mm</td>
              <td class="py-6 px-4 text-black leading-[54px]">20" x 11"</td>
              <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Banner Image 1 -->
    <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
      <img
        src="/assets/images/generations/c8/stingray-figma-new/7fa1c1ad958d106edf90c9fbe0d8e8e426b58bdd.webp"
        alt="C8 Stingray"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Wheel Detail 1: Daytona - Titanium Brushed Tint -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-start">
        <div class="w-full max-w-[500px] md:max-w-[550px] lg:max-w-[613px] mx-auto">
          <img src="/assets/images/generations/c8/stingray-figma-new/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium" class="w-full h-auto" />
        </div>
        <div class="flex flex-col px-4">
          <div class="space-y-4 md:space-y-6">
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2 md:mb-4">WHEEL MODEL</p>
              <img src={DAYTONA_LOGO} alt="Daytona" class="h-[40px] md:h-[46px] lg:h-[52px] w-auto mb-2" />
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Front: 18x10 / Offset +25mm</li>
                <li>Rear: 19x11 / Offset +20mm</li>
                <li>Bolt Pattern: 5x120</li>
              </ul>
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Titanium Brushed Tint</li>
              </ul>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 pt-4 md:pt-6">
              <a href={`${WHEELS_ROUTE}/${DAYTONA_BRAND_NAME.toLowerCase()}`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                SHOP DAYTONA
              </a>
              <a href={WHEELS_ROUTE} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center">
                EXPLORE FORM FORGED
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner Image 2 -->
    <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
      <img
        src="/assets/images/generations/c8/stingray-figma-new/2eb163e4cd1c402fc02e705eae6845841c86c89c.webp"
        alt="C8 Stingray"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Wheel Detail 2: Sebring - Bronze Brushed Tint -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-start">
        <div class="w-full max-w-[500px] md:max-w-[550px] lg:max-w-[613px] mx-auto">
          <img src="/assets/images/generations/c8/stingray-figma-new/d442c91c12ba3d5e69ac89b01731b5399b849d1f.webp" alt="Sebring Bronze" class="w-full h-auto" />
        </div>
        <div class="flex flex-col px-4">
          <div class="space-y-4 md:space-y-6">
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2 md:mb-4">WHEEL MODEL</p>
              <img src={SEBRING_LOGO} alt="Sebring" class="h-[40px] md:h-[46px] lg:h-[52px] w-auto mb-2" />
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Front: 18x10 / Offset +25mm</li>
                <li>Rear: 19x11 / Offset +20mm</li>
                <li>Bolt Pattern: 5x120</li>
              </ul>
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Titanium Brushed Tint</li>
              </ul>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 pt-4 md:pt-6">
              <a href={`${WHEELS_ROUTE}/${SEBRING_BRAND_NAME.toLowerCase()}`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                SHOP SEBRING
              </a>
              <a href={WHEELS_ROUTE} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center">
                EXPLORE FORM FORGED
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner Image 3 -->
    <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
      <img
        src="/assets/images/generations/c8/stingray-figma-new/339457e3ff138bf0744f20d8a7f19dfe1da3645a.webp"
        alt="C8 Stingray"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Wheel Detail 3: Speedway - Gloss Black -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-start">
        <div class="w-full max-w-[500px] md:max-w-[550px] lg:max-w-[613px] mx-auto">
          <img src="/assets/images/generations/c8/stingray-figma-new/55e2dad1e72a82c3b811737504db985db4ec5353.webp" alt="Speedway Gloss Black" class="w-full h-auto" />
        </div>
        <div class="flex flex-col px-4">
          <div class="space-y-4 md:space-y-6">
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2 md:mb-4">WHEEL MODEL</p>
              <img src={SPEEDWAY_LOGO} alt="Speedway" class="h-[40px] md:h-[46px] lg:h-[52px] w-auto mb-2" />
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Front: 18x10 / Offset +25mm</li>
                <li>Rear: 19x11 / Offset +20mm</li>
                <li>Bolt Pattern: 5x120</li>
              </ul>
            </div>
            <div>
              <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
              <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                <li>Titanium Brushed Tint</li>
              </ul>
