---
import MainLayout from '@/layouts/MainLayout.astro';
import {
  GALLERY_VEHICLES_ROUTE,
  GENERATIONS_C8_STINGRAY_ROUTE,
  GENERATIONS_C8_Z06_ROUTE,
  GENERATIONS_C8_ZR1_ROUTE,
  PROCESS_FORM_FORGED_ROUTE,
  PROCESS_FORGED_ROUTE,
} from "@/core/constants/Routes.ts";
import { FORM_FORGED_LOGO } from "@/pages/wheels/constants/Wheels.ts";

const E5_FORGED_LOGO = "/assets/images/e5-forged-logo.webp";

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://www.e5wheels.com';
const title = 'C8 Corvette Wheels (2020+) - E5 Forged & Form Forged | E5 Wheels';
const description = 'Shop wheels for C8 Corvette (2020+). Form Forged Series for Stingray and E5 Forged for Z06, ZR1, and E-Ray. Hub-centric fitment, forged in USA, multiple sizes and finishes.';
const canonicalUrl = `${baseUrl}/generations/c8`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <div class="w-full bg-white -mt-107">

    <!-- Hero Banner -->
    <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
      <img
        src="/assets/images/gallery/corvette/2026-c8-zr1-with-e5-talladega-brushed-silver-wheels-night-shot/0.webp"
        alt="2026 C8 Corvette ZR1 with E5 Talladega Brushed Aluminum Wheels"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Main Title and Description -->
    <section class="container-e5 py-8 md:py-12 lg:py-16 text-center">
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] tracking-[0px] leading-[40px] md:leading-[56px] lg:leading-[68px] text-black uppercase mb-4 md:mb-6 font-['Franklin_Gothic_Heavy']">
        Custom C8 Corvette Wheels
      </h1>
      <p class="text-[16px] md:text-[22px] lg:text-[28px] tracking-[0px] leading-[24px] md:leading-[30px] lg:leading-[36px] text-black/70 max-w-[1276px] mx-auto mb-4 md:mb-6 px-4">
        The mid-engine C8 Corvette (2020+) represents a generational leap in American performance. From the daily-driven Stingray to the track-bred Z06 and the supercar ZR1, every C8 platform has unique wheel requirements. E5 engineers wheels precisely for each one—aggressive offsets, hub-centric fitment, and forged construction made in the USA.
      </p>
      <p class="text-[14px] md:text-[18px] lg:text-[22px] tracking-[3px] md:tracking-[4px] lg:tracking-[4.4px] leading-[22px] text-black/50 uppercase">
        Shop Wheels by C8 Model
      </p>
    </section>

    <!-- C8 Model Selector Grid -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 lg:gap-10">

        <!-- C8 Stingray -->
        <a href={GENERATIONS_C8_STINGRAY_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
          <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-e5-black">
            <img
              src="/assets/images/generations/c8/stingray-figma-new/ddf3b031aace1961a53533a1f783a84a67fb61b6.webp"
              alt="C8 Corvette Stingray"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] md:tracking-[2.4px] lg:tracking-[3.2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
            C8 Stingray
          </h2>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
            Form Forged Series
          </p>
          <p class="text-[14px] md:text-[15px] lg:text-[16px] leading-[20px] md:leading-[22px] text-black/60 mb-3">
            Engineered for the 6.2L LT2 (490hp) base platform. Available in Daytona, Sebring, and Speedway designs across multiple finishes.
          </p>
          <span class="text-[12px] md:text-[14px] tracking-[2.4px] md:tracking-[2.8px] leading-[20px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
            Explore C8 Stingray &rarr;
          </span>
        </a>

        <!-- C8 Z06 -->
        <a href={GENERATIONS_C8_Z06_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
          <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-e5-black">
            <img
              src="/assets/images/generations/c8/c8-z06-new/712eb0d1487009b3864cb1a30e308f725770b503.webp"
              alt="C8 Corvette Z06"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] md:tracking-[2.4px] lg:tracking-[3.2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
            C8 Z06
          </h2>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
            E5 Forged Series
          </p>
          <p class="text-[14px] md:text-[15px] lg:text-[16px] leading-[20px] md:leading-[22px] text-black/60 mb-3">
            Engineered for the flat-plane LT6 (670hp) and E-Ray hybrid platforms. Talladega and Sonoma designs in multiple premium finishes.
          </p>
          <span class="text-[12px] md:text-[14px] tracking-[2.4px] md:tracking-[2.8px] leading-[20px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
            Explore C8 Z06 &rarr;
          </span>
        </a>

        <!-- C8 ZR1 -->
        <a href={GENERATIONS_C8_ZR1_ROUTE} class="group flex flex-col hover:opacity-90 transition-opacity">
          <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 md:mb-6 bg-e5-black">
            <img
              src="/assets/images/generations/c8/zr1-figma/eda905a44366020603e226a9f33a6ee123371b79.webp"
              alt="C8 Corvette ZR1"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <h2 class="text-[24px] md:text-[28px] lg:text-[32px] leading-[28px] md:leading-[32px] lg:leading-[36px] tracking-[2px] md:tracking-[2.4px] lg:tracking-[3.2px] text-black uppercase mb-2 font-['Franklin_Gothic_Heavy']">
            C8 ZR1
          </h2>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-e5-red uppercase mb-2 font-['Franklin_Gothic_Demi']">
            E5 Forged Series
          </p>
          <p class="text-[14px] md:text-[15px] lg:text-[16px] leading-[20px] md:leading-[22px] text-black/60 mb-3">
            Engineered for the twin-turbo LT7 (1064hp) flagship. Ultimate strength-to-weight ratio for the most extreme C8 platform.
          </p>
          <span class="text-[12px] md:text-[14px] tracking-[2.4px] md:tracking-[2.8px] leading-[20px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
            Explore C8 ZR1 &rarr;
          </span>
        </a>

      </div>
    </section>

    <!-- Two Series Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20 bg-[#f8f8f8]">
      <h2 class="font-['Franklin_Gothic_Book'] text-[28px] md:text-[40px] lg:text-[48px] leading-[32px] md:leading-[40px] lg:leading-[48px] text-e5-red tracking-[5.6px] md:tracking-[8px] lg:tracking-[9.6px] uppercase mb-8 md:mb-12 text-center">
        Two Series. One Platform.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 lg:gap-16">

        <!-- Form Forged -->
        <div class="flex flex-col items-center text-center px-4">
          <img src={FORM_FORGED_LOGO} alt="Form Forged" class="h-[40px] md:h-[50px] lg:h-[60px] w-auto mb-4 md:mb-6" />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-black/50 uppercase mb-4 font-['Franklin_Gothic_Demi']">
            For C8 Stingray
          </p>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] leading-[22px] md:leading-[24px] lg:leading-[28px] text-black/70 max-w-[480px] mb-6">
            Engineered with forged DNA and crafted through flow forming, our Form Forged Series balances strength and agility—without compromising daily drivability. Available in Daytona, Sebring, and Speedway designs.
          </p>
          <a href={PROCESS_FORM_FORGED_ROUTE} class="inline-block bg-e5-red text-white font-['Franklin_Gothic_Demi'] text-[14px] md:text-[16px] lg:text-[18px] tracking-[1.4px] md:tracking-[1.6px] lg:tracking-[1.8px] px-8 md:px-10 lg:px-12 py-4 md:py-5 lg:py-6 hover:bg-e5-red/90 transition-colors">
            Explore Form Forged
          </a>
        </div>

        <!-- E5 Forged -->
        <div class="flex flex-col items-center text-center px-4">
          <img src={E5_FORGED_LOGO} alt="E5 Forged" class="h-[40px] md:h-[50px] lg:h-[60px] w-auto mb-4 md:mb-6" />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-black/50 uppercase mb-4 font-['Franklin_Gothic_Demi']">
            For C8 Z06, ZR1, &amp; E-Ray
          </p>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] leading-[22px] md:leading-[24px] lg:leading-[28px] text-black/70 max-w-[480px] mb-6">
            Fully forged from premium 6061 aluminum. Carved to optimize the strength-to-weight ratio and unlock wider tire setups, greater grip, and improved brake clearance. Talladega and Sonoma designs.
          </p>
          <a href={PROCESS_FORGED_ROUTE} class="inline-block bg-e5-red text-white font-['Franklin_Gothic_Demi'] text-[14px] md:text-[16px] lg:text-[18px] tracking-[1.4px] md:tracking-[1.6px] lg:tracking-[1.8px] px-8 md:px-10 lg:px-12 py-4 md:py-5 lg:py-6 hover:bg-e5-red/90 transition-colors">
            Explore E5 Forged
          </a>
        </div>

      </div>
    </section>

    <!-- Finishing Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20">
      <h2 class="font-['Franklin_Gothic_Book'] text-[28px] md:text-[40px] lg:text-[48px] leading-[32px] md:leading-[40px] lg:leading-[48px] text-e5-red tracking-[5.6px] md:tracking-[8px] lg:tracking-[9.6px] uppercase mb-8 md:mb-12">
        Finishing
      </h2>

      <p class="text-[16px] md:text-[20px] lg:text-[24px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Every wheel in the E5 Collection is more than performance—it's a statement of individuality. Available in premium finishes like gloss black, silver, brushed, or polished, each design showcases the precision of its forged construction. Custom powder coats and bespoke finishes available on request.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-4 md:mb-6">
        <div>
          <img
            src="/assets/images/635c360776d4fed06014550fb174128129f3db5d.webp"
            alt="C8 Corvette with Gloss White wheels"
            class="w-full h-[200px] md:h-[240px] lg:h-[280px] object-cover"
          />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
            Gloss White
          </p>
        </div>
        <div>
          <img
            src="/assets/images/594596d32c2664b60ada31f941308aa49a446810.webp"
            alt="C8 Corvette with Brushed Aluminum wheels"
            class="w-full h-[200px] md:h-[240px] lg:h-[280px] object-cover"
          />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
            Brushed Aluminum
          </p>
        </div>
      </div>

      <div>
        <img
          src="/assets/images/ea5c4ce9fe1dff8253a015d8213129e6dfcc0fc2.webp"
          alt="C8 Corvette with Gloss Gold wheels"
          class="w-full h-[280px] md:h-[400px] lg:h-[527px] object-cover"
        />
        <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
          Gloss Gold
        </p>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20">
      <h2 class="font-['Franklin_Gothic_Book'] text-[28px] md:text-[40px] lg:text-[48px] leading-[32px] md:leading-[40px] lg:leading-[48px] text-e5-red tracking-[5.6px] md:tracking-[8px] lg:tracking-[9.6px] uppercase mb-6 md:mb-8">
        C8 Gallery
      </h2>

      <p class="text-[16px] md:text-[20px] lg:text-[24px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Explore our gallery of C8 Corvettes, showcasing a variety of styles and finishes on customer vehicles across all C8 trims.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 lg:gap-8 mb-8 md:mb-12">
        <img
          src="/assets/images/2aa980bafdc02ffb5bb841ba963f436f9cef7ece.webp"
          alt="C8 Corvette gallery example 1"
          class="w-full h-[260px] md:h-[320px] lg:h-[408px] object-cover"
        />
        <img
          src="/assets/images/ca9a9d5bbdcec445ae42fe0a4b5b4bbd7ac79e81.webp"
          alt="C8 Corvette gallery example 2"
          class="w-full h-[260px] md:h-[320px] lg:h-[408px] object-cover"
        />
        <img
          src="/assets/images/571e72291039231446ba08b58aa44f3358d4886a.webp"
          alt="C8 Corvette gallery example 3"
          class="w-full h-[260px] md:h-[320px] lg:h-[408px] object-cover"
        />
      </div>

      <div class="flex justify-center">
        <a href={GALLERY_VEHICLES_ROUTE} class="inline-block bg-e5-red text-white font-['Franklin_Gothic_Demi'] text-[14px] md:text-[16px] lg:text-[18px] tracking-[1.4px] md:tracking-[1.6px] lg:tracking-[1.8px] px-8 md:px-10 lg:px-12 py-4 md:py-5 lg:py-6 hover:bg-e5-red/90 transition-colors">
          View Full Gallery
        </a>
      </div>
    </section>

  </div>
</MainLayout>
