---
import MainLayout from '@/layouts/MainLayout.astro';
import {SINGLE_PRODUCT_ROUTE} from "@/core/constants/Routes.ts";
import {
    TALLADEGA_LOGO,
    TALLADEGA_BRAND_NAME,
    SONOMA_LOGO,
    SONOMA_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

const E5_FORGED_LOGO = "/assets/images/e5-forged-logo.webp";
---

<MainLayout title="C8 Corvette ZR1 Wheels - E5 Wheels">
    <div class="w-full bg-white -mt-107">

        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <img
                src="/assets/images/generations/c8/zr1-figma/eda905a44366020603e226a9f33a6ee123371b79.webp"
                alt="C8 Corvette ZR1"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Main Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C8 CORVETTE ZR1 Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4">
                The C8 ZR1 represents the pinnacle of American performance engineering—a street-legal supercar built to dominate both the track and the road. Every E5 Forged wheel for the ZR1 is precision-engineered to complement its extreme aerodynamics, carbon-ceramic braking system, and track-focused suspension geometry. Designed for those who demand the absolute best, these wheels deliver uncompromising strength, reduced unsprung weight, and fitment that enhances the ZR1's aggressive stance without sacrificing control or precision.
            </p>
        </section>

        <!-- E5 FORGED Logo Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8">
                <img src={E5_FORGED_LOGO} alt="E5 Forged" class="h-[54px] w-auto" />
                <div class="hidden md:block w-px h-[138px] bg-black/20"></div>
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[656px] text-center md:text-left">
                    Exclusively Forged in the USA for C8 Z06, ZR1, and E-Ray. Engineered for extreme performance, reduced weight, and maximum strength.
                </p>
            </div>
        </section>

        <!-- Two Wheel Options (Talladega & Sonoma) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 items-start">

                <!-- Talladega -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${TALLADEGA_BRAND_NAME}&finish=Brushed Silver&generation=C8&trim=ZR1`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c8/zr1-figma/taladaga-c8wheel.webp" alt="Talladega" class="w-full h-full object-contain" />
                    </div>
                    <img src={TALLADEGA_LOGO} alt="Talladega" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRUSHED ALUMINUM</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">CUSTOM FINISHES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase">MADE IN USA</p>
                </a>

                <!-- Sonoma -->
                <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SONOMA_BRAND_NAME}&finish=Brushed Silver&generation=C8&trim=ZR1`} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c8/zr1-figma/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-full object-contain" />
                    </div>
                    <img src={SONOMA_LOGO} alt="Sonoma" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRUSHED ALUMINUM</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">EXCLUSIVELY FOR C8 Z06, ZR1, E-RAY</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">CUSTOM FINISHES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-black/50 uppercase">MADE IN USA</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                The C8 ZR1 demands wheels that match its unrelenting pursuit of performance. Every E5 Forged ZR1 wheel is CNC-machined from premium 6061 aluminum, carefully engineered to shed excess weight while maximizing structural integrity. The result is a wheel that reduces rotational mass, improves acceleration and braking response, and enhances handling precision at the limit. Built to accommodate wider tires, larger brakes, and aggressive suspension setups, these wheels unlock the ZR1's full potential—on the street, on the track, or anywhere speed matters.
            </p>
        </section>

        <!-- Two Car Images -->
        <section class="w-full bg-black">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <img src="/assets/images/generations/c8/zr1-figma/car-mid2.webp" alt="Dark Corvette" class="w-full h-auto" />
                <img src="/assets/images/generations/c8/zr1-figma/car-mid1.webp" alt="White Corvette" class="w-full h-auto" />
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every wheel in the E5 Forged Collection is more than performance—it's a statement of individuality. Available in premium finishes like gloss black, brushed aluminum, or polished, each design showcases the precision of its forged construction. For those seeking something truly unique, we also offer custom powder coats and bespoke finishes to match any vision. No matter the choice, every finish is executed with uncompromising attention to detail, delivering a look that lasts as long as the engineering behind it.
            </p>
        </section>

        <!-- Brushed Aluminum Section -->
        <section class="w-full">
            <!-- Two Brushed Aluminum Detail Images -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <img src="/assets/images/generations/c8/zr1-figma/0d8866684e1944744d0228187ebc1aeca83b7743.webp" alt="Brushed Aluminum Detail 1" class="w-full h-auto" />
                <img src="/assets/images/generations/c8/zr1-figma/0d8866684e1944744d0228187ebc1aeca83b7743.webp" alt="Brushed Aluminum Detail 2" class="w-full h-auto" />
            </div>
        </section>

        <!-- Brushed Aluminum Label -->
        <section class="w-full bg-white py-8 mb-8">
            <p class="text-center text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red">
                BRUSHED ALUMINUM
            </p>
        </section>

        <!-- Gloss White Wheel Image -->
        <section class="w-full bg-black">
            <img src="/assets/images/generations/c8/zr1-figma/7181d8beb31fddc40fec023baa619e384c6e542c.webp" alt="Gloss White Wheel" class="w-full h-auto" />
        </section>

        <!-- Gloss White Label -->
        <section class="w-full bg-white py-8">
            <p class="text-center text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red">
                GLOSS WHITE
            </p>
        </section>

        <!-- Specifications Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[35px] md:leading-[40px] lg:leading-[43px] text-e5-red uppercase mb-8 md:mb-12 text-center font-['Franklin_Gothic_Book']">
                C8 ZR1 WHEEL SPECIFICATIONS
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 text-center max-w-[1276px] mx-auto mb-12 md:mb-16">
                Here is what you need to know about your C8 ZR1.
            </p>

            <!-- Specifications Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-center font-['Franklin_Gothic_Book'] text-[18px] md:text-[20px] lg:text-[24px] tracking-[1.2px]">
                    <thead>
                        <tr class="border-b border-black/20">
                            <th class="py-6 px-4 text-black/70 font-normal leading-[54px]">C8 VARIANT</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">BOLT<br/>PATTERN</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">CENTER<br/>BORE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">FRONT<br/>OFFSET</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR WHEEL<br/>SIZE</th>
                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR<br/>OFFSET</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">ZR1</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 10.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+28 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">21" x 13"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+50 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">Z06</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 10"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+30 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">21" x 13"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">E-RAY</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">66.9 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 9.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+38 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">21" x 12"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+52 mm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Banner Image 1 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img src="/assets/images/generations/c8/zr1-figma/e39c7a34e8b69874a0fe8e52fabf2243421baa7e.webp" alt="C8 ZR1 Lifestyle" class="w-full h-full object-cover" />
        </section>

        <!-- Product Detail: Sonoma -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c8/zr1-figma/sonoma-wheel-c8.webp" alt="Sonoma" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SONOMA_LOGO} alt="Sonoma" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 20" x 10.5" / Offset +25mm</li>
                                <li>Rear: 21" x 13" / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Brushed Aluminum</li>
                            </ul>
                        </div>
                        <div class="mt-6">
                            <a href={`${SINGLE_PRODUCT_ROUTE}?series=${SONOMA_BRAND_NAME}&finish=Brushed Silver&generation=C8&trim=ZR1`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                                SHOP FITMENT
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img src="/assets/images/generations/c8/zr1-figma/eda905a44366020603e226a9f33a6ee123371b79.webp" alt="C8 ZR1 Blue" class="w-full h-full object-cover" />
        </section>

        <!-- Product Detail: Talladega -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c8/zr1-figma/82a4246061714fe6bf2bb3deb1c153e56e715ad2.webp" alt="Talladega" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={TALLADEGA_LOGO} alt="Talladega" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 20" x 10.5" / Offset +25mm</li>
                                <li>Rear: 21" x 13" / Offset +20mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Brushed Aluminum</li>
                            </ul>
                        </div>
                        <div class="mt-6">
                            <a href={`${SINGLE_PRODUCT_ROUTE}?series=${TALLADEGA_BRAND_NAME}&finish=Brushed Silver&generation=C8&trim=ZR1`} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                                SHOP FITMENT
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gallery Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C8 ZR1 CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Explore our gallery of C8 ZR1 Corvettes, showcasing a variety of styles and finishes on customer vehicles.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/zr1-figma/e39c7a34e8b69874a0fe8e52fabf2243421baa7e.webp" alt="Blue Corvette Gallery" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/zr1-figma/907d9c4588d2ba6e645bd4c074b28096568282c9.webp" alt="Black Corvette Gallery" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src="/assets/images/generations/c8/zr1-figma/c23bd018713f82c64bfd45f4df7952db2e2436b4.webp" alt="Red Corvette Gallery" class="w-full h-full object-cover" />
                </div>
            </div>
        </section>

        <!-- Back to Top -->
        <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            BACK TO TOP
        </div>
    </div>
</MainLayout>
