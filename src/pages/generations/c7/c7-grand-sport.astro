---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE, SINGLE_PRODUCT_ROUTE} from "@/core/constants/Routes.ts";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
    SPEEDWAY_LOGO,
    SPEEDWAY_BRAND_NAME,
    SEBRING_LOGO,
    SEBRING_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

// Helper function to build shop URLs with proper encoding
function buildShopUrl(series: string, finish: string, generation: string, trim: string, frontSize: string, rearSize: string): string {
  const params = new URLSearchParams({
    series,
    finish,
    generation,
    trim,
    frontSize,
    rearSize
  });
  return `${SINGLE_PRODUCT_ROUTE}?${params.toString()}`;
}

// Shop URLs with proper sizes (Grand Sport uses same sizes across all wheels: 19x10 +30mm / 20x12 +50mm)
const speedwayTitaniumUrl = buildShopUrl(SPEEDWAY_BRAND_NAME, 'Titanium Brushed Tint', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');
const daytonaGlossBlackUrl = buildShopUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringBronzeUrl = buildShopUrl(SEBRING_BRAND_NAME, 'Bronze Brushed Tint', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');

// Detail section URLs
const speedwayGlossBlackUrl = buildShopUrl(SPEEDWAY_BRAND_NAME, 'Gloss Black', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');
const daytonaGlossBlackDetailUrl = buildShopUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringTitaniumUrl = buildShopUrl(SEBRING_BRAND_NAME, 'Titanium Brushed Tint', 'C7', 'Grand Sport', '19" x 10" +30mm', '20" x 12" +50mm');
---

<MainLayout title="C7 Corvette Grand Sport Wheels - E5 Wheels">
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c7/grand-sport/62297c70ab964e62c7fbaaabf1c1a5fe25065b86.webp"
                    alt="C7 Corvette Grand Sport"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C7 CORVETTE GRAND SPORT Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4 mb-8">
                Unlike universal fitments, every E5 wheel is specifically designed around the C7 platform—its offsets, brake clearance, and body lines. The fitment is aggressive yet refined, amplifying the Grand Sport's naturally muscular stance while keeping comfort uncompromised. Whether it's your daily drive or a track-built setup, these wheels deliver performance that meets the legend they were made for.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED SERIES FOR C7 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Speedway - Titanium Brushed Tint -->
                <a href={speedwayTitaniumUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/grand-sport/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.webp" alt="Speedway Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src="/assets/images/generations/c7/grand-sport/5a059fba9b6f32612b072a121dc09766ef507b86.webp" alt="Speedway" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 GRAND SPORT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Daytona - Gloss Black -->
                <a href={daytonaGlossBlackUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/grand-sport/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src="/assets/images/generations/c7/grand-sport/bf617359a30df6e52e23d25ba89f15964c216df1.webp" alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 GRAND SPORT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Sebring - Bronze Brushed Tint -->
                <a href={sebringBronzeUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/grand-sport/6633a5fa3fbf86ab9e4ebada3acfa83d7ae98d30.webp" alt="Sebring Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src="/assets/images/generations/c7/grand-sport/90f6c4d4b52eb6c3ec25ae4927cf62a98d647c4d.webp" alt="Sebring" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 GRAND SPORT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C7 Grand Sport, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c7/grand-sport/03b41c9e561f6a5e5f97745c8787773c5c8f399d.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c7/grand-sport/1bdb34f9c9002590831a56a7bd6db2b7c8faa50b.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8">
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c7/grand-sport/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                        alt="Bronze Brushed Tint"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="w-full h-[575px]">
                    <img
                        src="/assets/images/generations/c7/grand-sport/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.webp"
                        alt="Titanium Brushed Tint"
                        class="w-full h-full object-cover object-[0%_0%]"
                    />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-12">
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    BRONZE BRUSHED TINT
                </p>
                <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                    TITANIUM BRUSHED TINT
                </p>
            </div>
            <div class="w-full h-[611px] mb-8">
                <img
                    src="/assets/images/generations/c7/grand-sport/fb6915b500baca326333e5804080e0087421c402.webp"
                    alt="Gloss Black"
                    class="w-full h-full object-cover object-[0%_53%]"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red text-center">
                GLOSS BLACK
            </p>
        </section>

        <!-- C7 Generation Quote Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <!-- Logo and Quote -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <!-- C7 Logo -->
                <div class="w-full md:w-auto flex-shrink-0">
                    <img
                        src="/assets/images/logos/C7.png"
                        alt="C7 Corvette Logo"
                        class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0"
                    />
                </div>

                <!-- Quote Content -->
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">
                        C7 (2014–2019)
                    </h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I'm the last of the front-engine legends, and I made sure the world would never forget it. With angular aggression, a supercharged LT4 in my Z06, and technology that rivaled cars costing three times my price, I closed out an era with nothing left to prove."
                    </p>
                </div>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/grand-sport/999315a8e34bb245780a9e34b0b141c618ca689d.webp"
                alt="C7 Grand Sport"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 1: Gloss Black (Speedway) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/grand-sport/cd19461c451031cb11b5e748b6774ae80b22a516.webp" alt="Speedway Gloss Black" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src="/assets/images/generations/c7/grand-sport/5a059fba9b6f32612b072a121dc09766ef507b86.webp" alt="Speedway" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={speedwayGlossBlackUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/speedway`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE SPEEDWAY
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/grand-sport/1bdb34f9c9002590831a56a7bd6db2b7c8faa50b.webp"
                alt="C7 Grand Sport"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 2: Gloss Black (Daytona) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/grand-sport/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={daytonaGlossBlackDetailUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/daytona`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE DAYTONA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 3 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/grand-sport/8539460a4dbb9bfb469d78aaa75091312b4b49e7.webp"
                alt="C7 Grand Sport"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 3: Titanium Brushed Tint (Sebring) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/grand-sport/d442c91c12ba3d5e69ac89b01731b5399b849d1f.webp" alt="Sebring Titanium Brushed Tint" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src="/assets/images/generations/c7/grand-sport/90f6c4d4b52eb6c3ec25ae4927cf62a98d647c4d.webp" alt="Sebring" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Titanium Brushed Tint</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={sebringTitaniumUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
