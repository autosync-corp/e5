---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
    SPEEDWAY_LOGO,
    SPEEDWAY_BRAND_NAME,
    SEBRING_LOGO,
    SEBRING_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

// Shop URLs with proper sizes (Z06 uses: 19x10 +30mm / 20x12 +50mm)
const speedwayTitaniumUrl = buildWheelUrl(SPEEDWAY_BRAND_NAME, 'Titanium Brushed Tint', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');
const daytonaBronzeUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringGlossBlackUrl = buildWheelUrl(SEBRING_BRAND_NAME, 'Gloss Black', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');

// Detail section URLs (using +30mm / +50mm for detail sections based on spec table)
const daytonaGlossBlackUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringGlossBlackDetailUrl = buildWheelUrl(SEBRING_BRAND_NAME, 'Gloss Black', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');
const sebringTitaniumUrl = buildWheelUrl(SEBRING_BRAND_NAME, 'Titanium Brushed Tint', 'C7', 'Z06', '19" x 10" +30mm', '20" x 12" +50mm');
---

<MainLayout title="C7 Corvette Z06 Wheels - E5 Wheels">
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c7/c7-z06-new/7effa23c7267f19706f5c67892383b7061a6c091.webp"
                    alt="C7 Corvette Z06"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C7 CORVETTE Z06 Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4 mb-8">
                Unlike universal fitments, every E5 wheel is specifically designed around the C7 platform—its offsets, brake clearance, and body lines. The fitment is aggressive yet refined, amplifying the Z06's naturally muscular stance while keeping comfort uncompromised. Whether it's your daily drive or a track-built setup, these wheels deliver performance that meets the legend they were made for.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FORM FORGED SERIES FOR C7 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Speedway - Titanium Brushed Tint -->
                <a href={speedwayTitaniumUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/c7-z06-new/9b42939207b0a1af6d11b3b9a2835f0304c9cedb.webp" alt="Speedway Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={SPEEDWAY_LOGO} alt="Speedway" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 Z06</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">19" / 20" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Daytona - Bronze Brushed Tint -->
                <a href={daytonaBronzeUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/c7-z06-new/13015d50313f3d5f39cd2616f369d0fd2c044010.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <img src={DAYTONA_LOGO} alt="Daytona" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 Z06</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Sebring - Gloss Black -->
                <a href={sebringGlossBlackUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/c7-z06-new/57612e656f7cb177dd66a7b9e8dbaf32845675c7.webp" alt="Sebring Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <img src={SEBRING_LOGO} alt="Sebring" class="h-[30px] w-auto mb-4" />
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">AVAILABLE FOR C7 Z06</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Designed exclusively for the C7 Z06, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance—delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c7/c7-z06-new/07eaaf7c8e53eaff8a8517993c3a40ee1a3f475e.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c7/c7-z06-new/4d0e8d856722833f6f0035bbeaba47696df83faa.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, AND DARK BRONZE— finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c7/c7-z06-new/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                            alt="Bronze Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        BRONZE BRUSHED TINT
                    </p>
                </div>
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c7/c7-z06-new/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.webp"
                            alt="Titanium Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
                        TITANIUM BRUSHED TINT
                    </p>
                </div>
            </div>
            <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-4 md:mb-8">
                <img
                    src="/assets/images/generations/c7/c7-z06-new/fb6915b500baca326333e5804080e0087421c402.webp"
                    alt="Gloss Black"
                    class="w-full h-full object-cover"
                />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">
                GLOSS BLACK
            </p>
        </section>

        <!-- C7 Generation Quote Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <!-- Logo and Quote -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <!-- C7 Logo -->
                <div class="w-full md:w-auto flex-shrink-0">
                    <img
                        src="/assets/images/logos/C7.png"
                        alt="C7 Corvette Logo"
                        class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0"
                    />
                </div>

                <!-- Quote Content -->
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">
                        C7 (2014–2019)
                    </h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I'm the last of the front-engine legends, and I made sure the world would never forget it. With angular aggression, a supercharged LT4 in my Z06, and technology that rivaled cars costing three times my price, I closed out an era with nothing left to prove."
                    </p>
                </div>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/c7-z06-new/b568c0af41aee7508d85f24e73aeaeedf605ad68.webp"
                alt="C7 Z06"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 1: Daytona -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/c7-z06-new/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={DAYTONA_LOGO} alt="Daytona" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={daytonaGlossBlackUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/daytona`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE DAYTONA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/c7-z06-new/f65b00dc6483d52a7ae7128434ee886042a7c5eb.webp"
                alt="C7 Z06"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 2: Sebring -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/c7-z06-new/57612e656f7cb177dd66a7b9e8dbaf32845675c7.webp" alt="Sebring" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SEBRING_LOGO} alt="Sebring" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Gloss Black</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={sebringGlossBlackDetailUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center whitespace-nowrap">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/sebring`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[14px] md:text-[18px] lg:text-[20px] xl:text-[24px] tracking-[1.4px] md:tracking-[1.8px] lg:tracking-[2px] xl:tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center whitespace-nowrap">
                                EXPLORE SEBRING
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 3 -->
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/c7-z06-new/07aa26e10869fbf948cf9bc37372325f9fdc6b7e.webp"
                alt="C7 Z06"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 3: Sebring (Second Section) -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/c7-z06-new/d442c91c12ba3d5e69ac89b01731b5399b849d1f.webp" alt="Sebring" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">WHEEL MODEL</p>
                            <img src={SEBRING_LOGO} alt="Sebring" class="h-[52px] w-auto mb-4" />
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">SIZES</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Front: 19" x 10" / Offset +30mm</li>
                                <li>Rear: 20" x 12" / Offset +50mm</li>
                                <li>Bolt Pattern: 5x120</li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/50 mb-2">FINISH</p>
                            <ul class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 list-disc pl-9">
                                <li>Titanium Brushed Tint</li>
                            </ul>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-4">
                            <a href={sebringTitaniumUrl} class="inline-block bg-e5-red text-white px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/90 transition-colors text-center">
                                SHOP FITMENT
                            </a>
                            <a href={`${WHEELS_ROUTE}/sebring`} class="inline-block border border-e5-red text-e5-red px-8 md:px-10 lg:px-12 py-3 md:py-4 text-[16px] md:text-[20px] lg:text-[24px] tracking-[2.4px] leading-[20px] uppercase font-['Franklin_Gothic_Demi'] hover:bg-e5-red/10 transition-colors text-center">
                                EXPLORE SEBRING
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

