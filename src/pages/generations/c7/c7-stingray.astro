                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Sebring -->
                <a href={sebringShopUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c7/stingray/2890992da4691efe5a794ea8c4ce3130ac005db2.webp" alt="Sebring Chrome" class="w-full h-full object-contain" />
