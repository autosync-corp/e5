                                EXPLORE DAYTONA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Image 2 -->
        <section class="w-full h-[716px] overflow-hidden">
            <img
                src="/assets/images/generations/c7/stingray/9b395e66334dc4360bdcf069a64de86fae8d2d5b.webp"
                alt="C7 Stingray"
                class="w-full h-full object-cover"
            />
        </section>

        <!-- Wheel Detail 2: Bronze Brushed Tint -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
                <div class="w-full max-w-[613px] mx-auto">
                    <img src="/assets/images/generations/c7/stingray/13015d50313f3d5f39cd2616f369d0fd2c044010.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-auto" />
                </div>
                <div class="flex flex-col">
                    <div class="space-y-6">
