                            <th class="py-6 px-4 text-black font-normal leading-[30px]">REAR<br/>OFFSET</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">STINGRAY</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">18" x 8.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+56 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 10"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+79 mm</td>
                        </tr>
                        <tr class="border-b border-black/20">
                            <td class="py-6 px-4 text-black/70 leading-[30px]">Z51 PACKAGE</td>
                            <td class="py-6 px-4 text-black leading-[54px]">5x120 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">70.3 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">19" x 8.5"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+56 mm</td>
                            <td class="py-6 px-4 text-black leading-[54px]">20" x 10"</td>
                            <td class="py-6 px-4 text-black leading-[54px]">+79 mm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Banner Image -->
        <section class="w-full h-[716px] overflow-hidden">
