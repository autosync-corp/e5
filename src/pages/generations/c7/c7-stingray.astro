            <div class="text-center">
                <a href={WHEELS_ROUTE} class="inline-block bg-e5-red text-white px-12 py-6 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors">
                    SHOP FORM FORGED
