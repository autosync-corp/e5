---
import MainLayout from '@/layouts/MainLayout.astro';

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Find Wheels by Corvette Generation - E5 Wheels';
const description = 'Shop wheels by Corvette generation - C5, C6, C7, and C8 (Stingray, Z06, ZR1, E-Ray). Every wheel is precision-engineered for your specific Corvette model.';
const canonicalUrl = `${baseUrl}/generations`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <div class="w-full bg-white -mt-107">
    <!-- Page Title -->
    <div class="container-e5 py-12 md:py-16 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-franklin-heavy text-black mb-4">
        FIND WHEELS BY CORVETTE GENERATION
      </h1>
      <p class="text-base md:text-lg text-black/70 max-w-2xl mx-auto">
        Select your Corvette generation to explore wheels engineered specifically for your model.
      </p>
    </div>

    <!-- C8 Wheel Collection -->
    <section class="relative w-full h-[350px] md:h-[400px] lg:h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/gallery_c8.webp"
          alt="Corvette C8"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-4 py-4 md:px-8 md:py-5 lg:px-12 lg:py-6 inline-block">
            <h2 class="text-white text-[16px] md:text-[18px] lg:text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-3 md:mb-4">
              C8 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-2 md:gap-3 lg:gap-4">
              <a href="/generations/c8/c8-stingray" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Stingray
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c8/c8-z06" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Z06
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c8/c8-zr1" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                ZR1
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C7 Wheel Collection -->
    <section class="relative w-full h-[350px] md:h-[400px] lg:h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/dcc8afb858d26cd58cef64fa5550d84062748073.webp"
          alt="Corvette C7"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-4 py-4 md:px-8 md:py-5 lg:px-12 lg:py-6 inline-block">
            <h2 class="text-white text-[16px] md:text-[18px] lg:text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-3 md:mb-4">
              C7 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-2 md:gap-3 lg:gap-4">
              <a href="/generations/c7/c7-stingray" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Stingray
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c7/c7-grand-sport" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Grand Sport
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c7/c7-z06" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Z06
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C6 Wheel Collection -->
    <section class="relative w-full h-[350px] md:h-[400px] lg:h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/b54d60985beb894c74d2ab4424fef74f8ce724c4.webp"
          alt="Corvette C6"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-4 py-4 md:px-8 md:py-5 lg:px-12 lg:py-6 inline-block">
            <h2 class="text-white text-[16px] md:text-[18px] lg:text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-3 md:mb-4">
              C6 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-2 md:gap-3 lg:gap-4">
              <a href="/generations/c6" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Base Model
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c6/c6-grand-sport" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Grand Sport
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C5 Wheel Collection -->
    <section class="relative w-full h-[350px] md:h-[400px] lg:h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/generations/764bd0a8067c11c02fee4c817fa95a8d38b6e753.webp"
          alt="Corvette C5"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-4 py-4 md:px-8 md:py-5 lg:px-12 lg:py-6 inline-block">
            <h2 class="text-white text-[16px] md:text-[18px] lg:text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-3 md:mb-4">
              C5 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-2 md:gap-3 lg:gap-4">
              <a href="/generations/c5/c5-z06" class="text-white text-[13px] md:text-[15px] lg:text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Z06
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
