---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="E5 Wheels - Choose Your Corvette">
  <div class="w-full bg-white -mt-107">
    <!-- C8 Wheel Collection -->
    <section class="relative w-full h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/gallery_c8.png"
          alt="Corvette C8"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-12 py-6 inline-block">
            <h2 class="text-white text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-4">
              C8 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-4">
              <a href="/generations/c8/c8-stingray" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Stingray
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c8/c8-z06" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Z06
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C7 Wheel Collection -->
    <section class="relative w-full h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/dcc8afb858d26cd58cef64fa5550d84062748073.png"
          alt="Corvette C7"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-12 py-6 inline-block">
            <h2 class="text-white text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-4">
              C7 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-4">
              <a href="/generations/c7/c7-stingray" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Stingray
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c7/c7-grand-sport" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Grand Sport
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C6 Wheel Collection -->
    <section class="relative w-full h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/b54d60985beb894c74d2ab4424fef74f8ce724c4.png"
          alt="Corvette C6"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-12 py-6 inline-block">
            <h2 class="text-white text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-4">
              C6 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-4">
              <a href="/generations/c6" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Base Model
              </a>
              <span class="text-white/50">|</span>
              <a href="/generations/c6/c6-grand-sport" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Grand Sport
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- C5 Wheel Collection -->
    <section class="relative w-full h-[460px] overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/assets/images/generations/764bd0a8067c11c02fee4c817fa95a8d38b6e753.png"
          alt="Corvette C5"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="absolute inset-0 flex items-center">
        <div class="container-e5">
          <div class="bg-[#d31d25] px-12 py-6 inline-block">
            <h2 class="text-white text-[20px] font-['Franklin_Gothic_Demi'] tracking-[2px] uppercase leading-[20px] mb-4">
              C5 WHEEL COLLECTION
            </h2>
            <div class="flex flex-wrap gap-4">
              <a href="/generations/c5/c5-z06" class="text-white text-[16px] font-['Franklin_Gothic_Book'] tracking-[2px] uppercase hover:text-white/80 transition-colors">
                Z06
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
