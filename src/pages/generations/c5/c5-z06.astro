---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    DAYTONA_LOGO,
    DAYTONA_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

// Shop URLs with proper sizes (C5 Z06 uses first detail section sizes: 18" x 10" +25mm / 19" x 11" +20mm)
const daytonaGlossBlackUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C5', 'Z06', '18" x 10" +25mm', '19" x 11" +20mm');
const daytonaTitaniumUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed', 'C5', 'Z06', '18" x 10" +25mm', '19" x 11" +20mm');
const daytonaBronzeUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C5', 'Z06', '18" x 10" +25mm', '19" x 11" +20mm');

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'C5 Z06 Corvette Wheels (2001-2004) - Form Forged | E5 Wheels';
const description = 'Form Forged wheels engineered for C5 Z06 Corvette (2001-2004). Precision fitment for the 385hp LS6 platform. Multiple sizes, finishes, and styles available.';
const canonicalUrl = `${baseUrl}/generations/c5/c5-z06`;
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "C5 Corvette", "item": `${baseUrl}/generations/c5` },
    { "@type": "ListItem", "position": 3, "name": "C5 Z06", "item": canonicalUrl }
  ]
});
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
    <div class="w-full bg-white -mt-107">
        <!-- Hero Banner -->
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src="/assets/images/generations/c5/z06-updated/76e661b873c8acdfb076c02ad1ca15b4ba8974d5.webp"
                    alt="C5 Corvette Z06"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <!-- Title and Description -->
        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <h1 class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']">
                Custom C5 Corvette Z06 Wheels
            </h1>
            <p class="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[32px] lg:leading-[35px] text-black/70 max-w-[1536px] mx-auto px-4 mb-8">
                The passion for the C5 never faded &mdash; and neither should the support. Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility without compromise. Exclusively built for Corvettes, every design aligns with the car's stance, performance, and unmistakable identity.
            </p>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FITMENT FOR C5 CORVETTES
            </p>
        </section>

        <!-- Three Wheel Options -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 mb-12">
                <!-- Gloss Black -->
                <a href={daytonaGlossBlackUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c5/z06-updated/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp" alt="Daytona Gloss Black" class="w-full h-full object-contain" />
                    </div>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">GLOSS BLACK</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">ENJOY FREE SHIPPING</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C5</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Titanium Brushed Tint -->
                <a href={daytonaTitaniumUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c5/z06-updated/d4565cf05e3fa3637a06eedfd917c1499967f34b.webp" alt="Daytona Titanium Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">TITANIUM BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">SET OF 4 STARTING AT $2,500</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C5</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>

                <!-- Bronze Brushed Tint -->
                <a href={daytonaBronzeUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
                    <div class="w-full max-w-[464px] aspect-square mb-6 md:mb-8">
                        <img src="/assets/images/generations/c5/z06-updated/13015d50313f3d5f39cd2616f369d0fd2c044010.webp" alt="Daytona Bronze Brushed Tint" class="w-full h-full object-contain" />
                    </div>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">BRONZE BRUSHED TINT</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/60 uppercase mb-2">18" / 19" SIZES</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-black/50 uppercase mb-2">AVAILABLE NOW FOR C5</p>
                    <p class="text-[16px] md:text-[18px] lg:text-[20px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[4px] leading-[20px] text-e5-red uppercase">IN STOCK</p>
                </a>
            </div>
        </section>

        <!-- Overview Section -->
        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Every E5 Form Forged wheel begins with a foundation of strength and precision. Engineered with forged DNA and crafted through advanced flow forming, we strategically remove excess material to optimize the strength-to-weight ratio and reduce rotational mass. Now exclusively available for the C5 Corvette, our Form Forged wheels enable wider tire setups, improved grip, sharper handling, and increased brake clearance&mdash;delivering confident performance on the street without sacrificing daily drivability.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c5/z06-updated/f71df08b13112a4424320ccedc861514847ba72f.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img
                        src="/assets/images/generations/c5/z06-updated/3604cf7d8bfc6bcadb8918f0365808bb998c938c.webp"
                        alt="E5 Wheel Detail"
                        class="w-full h-auto object-cover"
                    />
                </div>
            </div>
        </section>

        <!-- Finishing Section -->
        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Our Form Forged Series is available in Gloss Black, Titanium Brushed Tint, Bronze Brushed Tint, and Dark Bronze&mdash; finishes that embody the essence of timeless, modern, and bold design. Each surface is crafted to elevate the wheel's form while enduring the demands of the road, all backed by our 5-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img
                            src="/assets/images/generations/c5/z06-updated/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
                            alt="Bronze Brushed Tint"
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">
