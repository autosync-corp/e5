---
import MainLayout from '@/layouts/MainLayout.astro';
import {WHEELS_ROUTE, GALLERY_VEHICLES_ROUTE} from "@/core/constants/Routes.ts";
import { buildWheelUrl } from "@/core/utils/wheelUrl";
import {
    DAYTONA_BRAND_NAME,
} from "@/pages/wheels/constants/Wheels.ts";

// Shop URLs with proper sizes (C5 Base uses: 17" x 8.5" +58mm / 18" x 9.5" +65mm)
const daytonaBronzeUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Bronze Brushed Tint', 'C5', 'Base', '17" x 8.5" +58mm', '18" x 9.5" +65mm');
const daytonaTitaniumUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Titanium Brushed Tint', 'C5', 'Base', '17" x 8.5" +58mm', '18" x 9.5" +65mm');
const daytonaGlossBlackUrl = buildWheelUrl(DAYTONA_BRAND_NAME, 'Gloss Black', 'C5', 'Base', '17" x 8.5" +58mm', '18" x 9.5" +65mm');

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'C5 Corvette Wheels (1997-2004) - Form Forged Series | E5 Wheels';
const description = 'Shop Form Forged wheels for C5 Corvette (1997-2004). Daytona, Sebring, and Speedway wheels precision-engineered for C5 Base and Z06. Hub-centric fitment, multiple finishes.';
const canonicalUrl = `${baseUrl}/generations/c5`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <div class="w-full bg-white">
    <!-- Hero Section with Background Image -->
    <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
      <img
        src="/assets/images/76e661b873c8acdfb076c02ad1ca15b4ba8974d5.webp"
        alt="C5 Corvette"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </section>

    <!-- Main Title and Description -->
    <section class="max-w-[1536px] mx-auto px-16 py-12">
      <h1 class="font-['Franklin_Gothic_Heavy'] text-[79px] leading-[60px] text-black text-center uppercase mb-12">
        Custom C5 CORVETTE Wheels
      </h1>

      <p class="font-['Excon_Variable'] text-[32px] leading-[35px] text-black/70 text-center max-w-[1536px] mx-auto mb-8">
        The passion for the C5 never faded — and neither should the support. Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers strength and agility without compromise. Exclusively built for Corvettes, every design aligns with the car's stance, performance, and unmistakable identity.
      </p>

      <p class="font-['Franklin_Gothic_Book'] text-[24px] leading-[20px] text-black/50 text-center tracking-[4.8px] mb-16">
        SHOP FITMENT FOR C5 CORVETTES
      </p>

      <!-- Wheel Selection Grid -->
      <div class="grid grid-cols-3 gap-8 mb-12">
        <!-- Wheel 1 - Bronze Brushed -->
        <a href={daytonaBronzeUrl} class="flex flex-col items-center hover:opacity-80 transition-opacity">
          <img
            src="/assets/images/77a1e54cf299ca527e8fc5695731f7a6680822fe.webp"
            alt="Daytona - Bronze Brushed Tint"
            class="w-full aspect-square object-contain mb-4"
          />
          <p class="font-['Franklin_Gothic_Book'] text-[20px] leading-[20px] text-e5-red tracking-[4px] mb-2">
            IN STOCK
          </p>
          <p class="font-['Franklin_Gothic_Book'] text-[20px] leading-[20px] text-black/50 tracking-[4px] mb-2 text-center">
            BRONZE BRUSHED TINT
          </p>
          <p class="font-['Franklin_Gothic_Book'] text-[20px] leading-[20px] text-black/50 tracking-[4px] mb-2 text-center">
            AVAILABLE NOW FOR C5
          </p>
          <p class="font-['Franklin_Gothic_Book'] text-[20px] leading-[20px] text-black/60 tracking-[4px] text-center">
            ENJOY FREE SHIPPING
