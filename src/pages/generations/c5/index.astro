---
import MainLayout from '@/layouts/MainLayout.astro';
import {
  GALLERY_VEHICLES_ROUTE,
  GENERATIONS_C5_Z06_ROUTE,
  WHEELS_FORM_FORGED_ROUTE,
} from "@/core/constants/Routes.ts";
import { FORM_FORGED_LOGO } from "@/pages/wheels/constants/Wheels.ts";

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://www.e5wheels.com';
const title = 'C5 Corvette Wheels (1997-2004) - Form Forged Series | E5 Wheels';
const description = 'Shop Form Forged wheels for C5 Corvette (1997-2004). Daytona, Sebring, and Speedway wheels precision-engineered for C5 Base and Z06. Hub-centric fitment, multiple finishes.';
const canonicalUrl = `${baseUrl}/generations/c5`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
  <div class="w-full bg-white -mt-107">

    <!-- Hero Banner -->
    <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
      <img
        src="/assets/images/generations/c5/z06-updated/76e661b873c8acdfb076c02ad1ca15b4ba8974d5.webp"
        alt="C5 Corvette with E5 Wheels"
        class="w-full h-full object-cover"
      />
    </section>

    <!-- Main Title and Description -->
    <section class="container-e5 py-8 md:py-12 lg:py-16 text-center">
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] tracking-[0px] leading-[40px] md:leading-[56px] lg:leading-[68px] text-black uppercase mb-4 md:mb-6 font-['Franklin_Gothic_Heavy']">
        Custom C5 Corvette Wheels
      </h1>
      <p class="text-[16px] md:text-[22px] lg:text-[28px] tracking-[0px] leading-[24px] md:leading-[30px] lg:leading-[36px] text-black/70 max-w-[1276px] mx-auto mb-4 md:mb-6 px-4">
        The C5 Corvette (1997-2004) defined a generation with the all-aluminum LS1 V8 and the hydroformed perimeter chassis that set the modern Corvette template. E5 Form Forged wheels are engineered around the C5's specific offsets, brake clearance, and stance—delivering aggressive fitment that respects the platform's character while modernizing its presence.
      </p>
      <p class="text-[14px] md:text-[18px] lg:text-[22px] tracking-[3px] md:tracking-[4px] lg:tracking-[4.4px] leading-[22px] text-black/50 uppercase">
        Featured C5 Model
      </p>
    </section>

    <!-- C5 Z06 Featured Card -->
    <section class="container-e5 py-8 md:py-12 lg:py-16">
      <a href={GENERATIONS_C5_Z06_ROUTE} class="group flex flex-col md:flex-row gap-6 md:gap-10 lg:gap-12 max-w-[1200px] mx-auto hover:opacity-90 transition-opacity">
        <div class="relative w-full md:w-1/2 aspect-[4/3] overflow-hidden bg-e5-black">
          <img
            src="/assets/images/generations/c5/z06-updated/76e661b873c8acdfb076c02ad1ca15b4ba8974d5.webp"
            alt="C5 Corvette Z06"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="w-full md:w-1/2 flex flex-col justify-center">
          <h2 class="text-[28px] md:text-[36px] lg:text-[42px] leading-[32px] md:leading-[40px] lg:leading-[46px] tracking-[2px] md:tracking-[2.8px] lg:tracking-[3.6px] text-black uppercase mb-3 font-['Franklin_Gothic_Heavy']">
            C5 Z06
          </h2>
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-e5-red uppercase mb-4 font-['Franklin_Gothic_Demi']">
            Form Forged Series
          </p>
          <p class="text-[15px] md:text-[16px] lg:text-[18px] leading-[22px] md:leading-[26px] lg:leading-[28px] text-black/60 mb-6">
            For the LS6 (385-405hp) hardtop platform with FE4 suspension. Wider fitment to match the Z06's track-tuned stance and brake clearance.
          </p>
          <span class="text-[13px] md:text-[14px] lg:text-[16px] tracking-[2.6px] md:tracking-[2.8px] lg:tracking-[3.2px] leading-[20px] text-e5-red uppercase font-['Franklin_Gothic_Demi'] border-b border-e5-red pb-[2px] self-start">
            Explore C5 Z06 &rarr;
          </span>
        </div>
      </a>
    </section>

    <!-- Form Forged Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20 bg-[#f8f8f8]">
      <div class="flex flex-col items-center text-center max-w-[900px] mx-auto px-4">
        <img src={FORM_FORGED_LOGO} alt="Form Forged" class="h-[40px] md:h-[50px] lg:h-[60px] w-auto mb-4 md:mb-6" />
        <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2.8px] md:tracking-[3.2px] lg:tracking-[3.6px] leading-[20px] text-black/50 uppercase mb-6 font-['Franklin_Gothic_Demi']">
          Exclusively for C5 Corvettes
        </p>
        <p class="text-[16px] md:text-[18px] lg:text-[20px] leading-[24px] md:leading-[28px] lg:leading-[32px] text-black/70 mb-8">
          Engineered with forged DNA and crafted through flow forming, our Form Forged Series delivers the right balance of strength and agility for the C5 platform—without compromising daily drivability. Available in Daytona, Sebring, and Speedway designs across premium finishes.
        </p>
        <a href={WHEELS_FORM_FORGED_ROUTE} class="inline-block bg-e5-red text-white font-['Franklin_Gothic_Demi'] text-[14px] md:text-[16px] lg:text-[18px] tracking-[1.4px] md:tracking-[1.6px] lg:tracking-[1.8px] px-8 md:px-10 lg:px-12 py-4 md:py-5 lg:py-6 hover:bg-e5-red/90 transition-colors">
          Explore Form Forged
        </a>
      </div>
    </section>

    <!-- Finishing Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20">
      <h2 class="font-['Franklin_Gothic_Book'] text-[28px] md:text-[40px] lg:text-[48px] leading-[32px] md:leading-[40px] lg:leading-[48px] text-e5-red tracking-[5.6px] md:tracking-[8px] lg:tracking-[9.6px] uppercase mb-8 md:mb-12">
        Finishing
      </h2>

      <p class="text-[16px] md:text-[20px] lg:text-[24px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Every wheel in the E5 Collection is more than performance—it's a statement of individuality. Available in premium finishes including gloss black, bronze brushed tint, and titanium brushed tint, each design showcases the precision of its forged construction. Custom powder coats and bespoke finishes available on request.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6">
        <div>
          <img
            src="/assets/images/7b0eb2bf712356f129743563b9cab285a89c93ba.webp"
            alt="C5 Corvette with Bronze Brushed Tint wheels"
            class="w-full h-[280px] md:h-[400px] lg:h-[480px] object-cover"
          />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
            Bronze Brushed Tint
          </p>
        </div>
        <div>
          <img
            src="/assets/images/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.webp"
            alt="C5 Corvette with Titanium Brushed Tint wheels"
            class="w-full h-[280px] md:h-[400px] lg:h-[480px] object-cover"
          />
          <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
            Titanium Brushed Tint
          </p>
        </div>
      </div>

      <div>
        <img
          src="/assets/images/fb6915b500baca326333e5804080e0087421c402.webp"
          alt="C5 Corvette with Gloss Black wheels"
          class="w-full h-[280px] md:h-[440px] lg:h-[560px] object-cover"
        />
        <p class="text-[14px] md:text-[16px] lg:text-[18px] tracking-[2px] leading-[24px] text-black/40 uppercase text-center mt-3 font-['Franklin_Gothic_Book']">
          Gloss Black
        </p>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="container-e5 py-12 md:py-16 lg:py-20">
      <h2 class="font-['Franklin_Gothic_Book'] text-[28px] md:text-[40px] lg:text-[48px] leading-[32px] md:leading-[40px] lg:leading-[48px] text-e5-red tracking-[5.6px] md:tracking-[8px] lg:tracking-[9.6px] uppercase mb-6 md:mb-8">
        C5 Corvette Gallery
      </h2>

      <p class="text-[16px] md:text-[20px] lg:text-[24px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
        Explore our gallery of C5 Corvettes, showcasing a variety of styles and finishes on customer vehicles across all C5 trims.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 lg:gap-8 mb-8 md:mb-12">
        <img
          src="/assets/images/ecc049b1378ca99b0cc62091deec494b065e7fc1.webp"
          alt="C5 Corvette gallery example 1"
          class="w-full h-[260px] md:h-[360px] lg:h-[530px] object-cover"
        />
        <img
          src="/assets/images/7bfa695d147f8e922fe017db87cf37027ac5729a.webp"
          alt="C5 Corvette gallery example 2"
          class="w-full h-[260px] md:h-[360px] lg:h-[530px] object-cover"
        />
        <img
          src="/assets/images/76e661b873c8acdfb076c02ad1ca15b4ba8974d5.webp"
          alt="C5 Corvette gallery example 3"
          class="w-full h-[260px] md:h-[360px] lg:h-[530px] object-cover"
        />
      </div>

      <div class="flex justify-center">
        <a href={GALLERY_VEHICLES_ROUTE} class="inline-block bg-e5-red text-white font-['Franklin_Gothic_Demi'] text-[14px] md:text-[16px] lg:text-[18px] tracking-[1.4px] md:tracking-[1.6px] lg:tracking-[1.8px] px-8 md:px-10 lg:px-12 py-4 md:py-5 lg:py-6 hover:bg-e5-red/90 transition-colors">
          View Full Gallery
        </a>
      </div>
    </section>

  </div>
</MainLayout>
