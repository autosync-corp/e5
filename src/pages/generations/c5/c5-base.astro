---
import MainLayout from '@/layouts/MainLayout.astro';
import {
    GALLERY_VEHICLES_ROUTE,
    GENERATIONS_ROUTE,
} from "@/core/constants/Routes.ts";
import { SITE_URL } from '@/core/constants/Site.ts';
import GenerationIntro from '@/core/components/GenerationIntro.astro';
import GenerationHeading from '@/core/components/GenerationHeading.astro';
import GenerationSetups from '@/core/components/GenerationSetups.astro';
import {
    finishSummary,
    styleLinksFromSetups,
} from '@/core/utils/generationSetups';
import { loadGenerationSetups } from '@/core/utils/loadGenerationSetups';

const GALLERY = '/assets/images/gallery/corvette/2003-c5-corvette';
const baseUrl = SITE_URL;
const title = 'C5 Base Wheels (1997–2004) | E5 Wheels';
const description = 'C5 Corvette base wheels (1997–2004) with Corvette-only 18x10 +58mm / 19x11 +59mm Form Forged fitment. Daytona in gloss black, bronze brushed tint, and titanium.';
const canonicalUrl = `${baseUrl}/generations/c5/c5-base`;
const ogImage = `${baseUrl}${GALLERY}/0.webp`;
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${baseUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Generations", "item": `${baseUrl}${GENERATIONS_ROUTE}` },
    { "@type": "ListItem", "position": 3, "name": "C5", "item": `${baseUrl}/generations/c5` },
    { "@type": "ListItem", "position": 4, "name": "Base", "item": canonicalUrl }
  ]
});
const setups = await loadGenerationSetups('C5', ['Base']);
---

<MainLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
    <div class="w-full bg-white -mt-107">
        <section class="relative w-full h-[400px] md:h-[600px] lg:h-[799px] overflow-hidden">
            <div class="absolute inset-0">
                <img
                    src={`${GALLERY}/0.webp`}
                    alt="2003 C5 Corvette Base with E5 Daytona Gloss Black wheels"
                    class="w-full h-full object-cover"
                />
            </div>
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20 text-center">
            <GenerationHeading
                title="C5 Base Wheels"
                years="1997–2004"
                class="text-[48px] md:text-[64px] lg:text-[79px] tracking-[0px] leading-[48px] md:leading-[56px] lg:leading-[60px] text-black uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Heavy']"
            />
            <GenerationIntro
                lead="C5 Base wheels (1997–2004) are Form Forged for Corvette-only hub-centric fitment on the LS1 coupe and convertible."
                groups={[
                    { heading: 'Base', front: 'Front 18" × 10" +58mm', rear: 'Rear 19" × 11" +59mm' },
                ]}
                styles={styleLinksFromSetups(setups)}
                finishes={finishSummary(setups) || "Available in gloss black, bronze brushed tint, and titanium brushed tint"}
                bodyClass="text-[20px] md:text-[28px] lg:text-[32px] tracking-[0px] leading-[28px] md:leading-[34px] lg:leading-[38px] text-black/70"
                wrapperClass="max-w-[1536px] mx-auto px-4 mb-8"
                application="C5 Corvette application"
            >
                <Fragment slot="see">
                    See customer cars in the <a href={`${GALLERY_VEHICLES_ROUTE}?generation=C5`} class="text-e5-red hover:opacity-80 transition-opacity">C5 gallery</a>.
                </Fragment>
            </GenerationIntro>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[4.8px] leading-[20px] text-black/50 uppercase">
                SHOP FITMENT FOR C5 CORVETTES
            </p>
        </section>

        <GenerationSetups setups={setups} />

        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[36px] md:leading-[44px] lg:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                OVERVIEW
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                Form Forged C5 Base wheels start from forged DNA, then flow-form the barrel so the rim is strong where it needs to be and light where it does not. The C5 coupe and convertible share the same hub-centric 18/19 staggered set as the Z06 in E5's catalog&mdash;wider rubber, more brake room, and a street-first ride that still feels planted.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img src={`${GALLERY}/7.webp`} alt="C5 Base Corvette with E5 Daytona wheels" class="w-full h-auto object-cover" />
                </div>
                <div class="border-2 border-gray-400 p-4 md:p-6">
                    <img src={`${GALLERY}/8.webp`} alt="C5 Base Corvette wheel close-up" class="w-full h-auto object-cover" />
                </div>
            </div>
        </section>

        <section class="container-e5 py-8 md:py-12 lg:py-16">
            <h2 class="text-[32px] md:text-[40px] lg:text-[48px] tracking-[6px] md:tracking-[8px] lg:tracking-[9.6px] leading-[20px] text-e5-red uppercase mb-6 md:mb-8 font-['Franklin_Gothic_Book']">
                FINISHING
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[24px] md:leading-[28px] lg:leading-[30px] text-black/70 max-w-[1276px] mb-8 md:mb-12">
                Form Forged C5 Base colors in the catalog are Gloss Black, Bronze Brushed Tint, and Titanium Brushed. Each coat is built for daily miles and covered by E5's five-year finishing warranty.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-8 md:mb-12">
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img src="/assets/images/generations/c5/z06-updated/7b0eb2bf712356f129743563b9cab285a89c93ba.webp" alt="Bronze Brushed Tint" class="w-full h-full object-cover" />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">BRONZE BRUSHED TINT</p>
                </div>
                <div>
                    <div class="w-full h-[400px] md:h-[500px] lg:h-[575px] mb-4 md:mb-8">
                        <img src="/assets/images/generations/c5/z06-updated/2dc258da3ef0fa3bafdc282a190b412e0a3f7aac.webp" alt="Titanium Brushed Tint" class="w-full h-full object-cover" />
                    </div>
                    <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8 md:mb-0">TITANIUM BRUSHED TINT</p>
                </div>
            </div>
            <div class="w-full h-[400px] md:h-[500px] lg:h-[611px] mb-4 md:mb-8">
                <img src="/assets/images/generations/c5/z06-updated/fb6915b500baca326333e5804080e0087421c402.webp" alt="Gloss Black" class="w-full h-full object-cover" />
            </div>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-e5-red/70 text-center mb-8">GLOSS BLACK</p>
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20 px-8 md:px-16 lg:px-[250px] border-t border-gray-300">
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 lg:gap-16">
                <div class="w-full md:w-auto flex-shrink-0">
                    <img src="/assets/images/logos/c5.png" alt="C5 Corvette Logo" class="w-[120px] md:w-[150px] lg:w-[180px] h-auto mx-auto md:mx-0" />
                </div>
                <div class="flex-1">
                    <h2 class="text-[32px] md:text-[40px] lg:text-[48px] font-bold mb-4 md:mb-6 text-black text-center md:text-left">C5 (1997–2004)</h2>
                    <p class="text-[18px] md:text-[22px] lg:text-[26px] leading-[1.6] text-black/80 italic text-center md:text-left">
                        "I'm the one that changed the game. I brought real performance to the masses &mdash; an LS1 under my hood, a hydroformed frame beneath me, and a price tag that made European exotics nervous. I didn't just level the playing field, I owned it."
                    </p>
                </div>
            </div>
        </section>

        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img src={`${GALLERY}/1.webp`} alt="2003 C5 Corvette Base" class="w-full h-full object-cover" />
        </section>
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img src={`${GALLERY}/2.webp`} alt="2003 C5 Corvette Base" class="w-full h-full object-cover" />
        </section>
        <section class="w-full h-[400px] md:h-[550px] lg:h-[716px] overflow-hidden">
            <img src={`${GALLERY}/3.webp`} alt="2003 C5 Corvette Base" class="w-full h-full object-cover" />
        </section>

        <section class="container-e5 py-12 md:py-16 lg:py-20">
            <h2 class="text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] tracking-[3px] md:tracking-[5px] lg:tracking-[7px] xl:tracking-[9.6px] leading-[32px] md:leading-[40px] lg:leading-[46px] xl:leading-[52px] text-e5-red uppercase mb-8 md:mb-12 font-['Franklin_Gothic_Book']">
                C5 BASE CORVETTE GALLERY
            </h2>
            <p class="text-[18px] md:text-[20px] lg:text-[24px] tracking-[0px] leading-[30px] text-black/70 max-w-[1276px] mb-12 md:mb-16">
                A C5 Base in the E5 gallery, wearing Daytona Gloss Black in the catalog 18x10 / 19x11 staggered set.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 md:mb-16">
                <div class="w-full h-[530px]">
                    <img src={`${GALLERY}/4.webp`} alt="C5 Base gallery 1" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src={`${GALLERY}/5.webp`} alt="C5 Base gallery 2" class="w-full h-full object-cover" />
                </div>
                <div class="w-full h-[530px]">
                    <img src={`${GALLERY}/6.webp`} alt="C5 Base gallery 3" class="w-full h-full object-cover" />
                </div>
            </div>
            <div class="text-center">
                <a href={`${GALLERY_VEHICLES_ROUTE}?generation=C5`} class="inline-block bg-e5-red text-white px-12 py-6 text-[16px] font-excon-light tracking-[5.12px] uppercase hover:bg-e5-red/90 transition-colors">
                    VIEW GALLERY
                </a>
            </div>
        </section>

        <div class="text-center hover:bg-black/5 transition-colors duration-300 py-4 md:py-6 text-[16px] md:text-[18px] lg:text-[20px] text-black/50 font-medium tracking-[2px] uppercase cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            BACK TO TOP
        </div>
    </div>
</MainLayout>
