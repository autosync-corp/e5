---
import MainLayout from '@/layouts/MainLayout.astro';

// Reached from the visualizers (/visualizer, /e5-visualizer) when the
// wheel/finish/vehicle combo someone is looking at doesn't have a real
// product yet - see task_shop_fitment_quote_flow.md. Pre-fills from query
// params so the sales team knows exactly what was being viewed.
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Request a Quote - E5 Wheels';
const description = 'Request a custom quote for E5 Wheels not yet available in our online shop.';
const canonicalUrl = `${baseUrl}/request-quote`;

const params = Astro.url.searchParams;
const series = params.get('series') || '';
const finish = params.get('finish') || '';
const generation = params.get('generation') || '';
const trim = params.get('trim') || '';
const label = params.get('label') || [generation, trim].filter(Boolean).join(' ');

const hasSelection = Boolean(series || finish || label);
const summaryParts = [series, finish, label].filter(Boolean);
const summaryLine = summaryParts.join(' — ');
---

<MainLayout title={title} description={description} canonical={canonicalUrl} noindex={true}>
  <div class="w-full bg-white pb-24">
    <section class="container-e5 py-20">
      <div class="max-w-[998px] mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-[#d31d25] text-[24px] md:text-[32px] lg:text-[40px] xl:text-[48px] font-['Franklin_Gothic_Book'] tracking-[6px] md:tracking-[9px] lg:tracking-[9.6px] uppercase mb-6 leading-tight px-6 md:px-12">
            REQUEST A QUOTE
          </h1>
          <div class="w-full h-[2px] bg-[#d31d25] mb-8"></div>
          {hasSelection ? (
            <p class="text-black/70 text-[14px] md:text-[16px] lg:text-[18px] xl:text-[20px] leading-[24px] md:leading-[28px] px-6 md:px-12">
              This fitment isn't in our online shop yet. Tell us a bit about yourself and we'll follow up with pricing and availability for:
            </p>
            <p class="text-black text-[16px] md:text-[20px] lg:text-[24px] font-['Franklin_Gothic_Demi'] uppercase tracking-[1px] mt-4">
              {summaryLine}
            </p>
          ) : (
            <p class="text-black/70 text-[14px] md:text-[16px] lg:text-[18px] xl:text-[20px] leading-[24px] md:leading-[28px] px-6 md:px-12">
              Looking for a wheel, finish, or fitment that isn't in our online shop yet? Leave your details below and we'll follow up with pricing and availability.
            </p>
          )}
        </div>

        <form class="space-y-6 mt-12">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative">
              <input type="text" name="firstName" placeholder="FIRST NAME*" required
                class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25]" />
            </div>
            <div class="relative">
              <input type="text" name="lastName" placeholder="LAST NAME*" required
                class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25]" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative">
              <input type="email" name="email" placeholder="EMAIL ADDRESS*" required
                class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25]" />
            </div>
            <div class="relative">
              <input type="tel" name="phone" placeholder="PHONE NUMBER"
                class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25]" />
            </div>
          </div>

          <div class="relative">
            <input type="text" name="vehicle" placeholder="YOUR CORVETTE (E.G. 2019 C7 STINGRAY)" value={label}
              class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25]" />
          </div>

          <div class="relative">
            <textarea name="message" placeholder="ANYTHING ELSE WE SHOULD KNOW?" rows="6"
              class="w-full px-4 py-3 border border-[#cccccc] rounded-[7px] text-[16px] text-black/70 placeholder:text-black/70 placeholder:opacity-80 focus:outline-none focus:border-[#d31d25] resize-none"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" name="smsConsent" id="smsConsent"
              class="mt-1.5 h-[19.5px] w-[17px] rounded-[6px] border-2 border-[#939393] bg-[#d9d9d9] text-[#d31d25] focus:ring-[#d31d25] cursor-pointer" />
            <label for="smsConsent" class="text-[14px] md:text-[16px] lg:text-[18px] xl:text-[20px] text-black/50 leading-[24px] md:leading-[28px] cursor-pointer">
              I agree to receive SMS messages from E5 wheels at the number provided.
              Msg &amp; data rates may apply. Reply STOP to unsubscribe.
            </label>
          </div>

          <div class="pt-4">
            <button type="submit"
              class="w-full bg-[#d31d25] text-white rounded-[7px] py-3 text-[16px] tracking-[5.12px] hover:bg-[#b11a21] transition-colors">
              REQUEST QUOTE
            </button>
          </div>
        </form>
      </div>
    </section>
  </div>
</MainLayout>

<script define:vars={{ series, finish, generation, trim, label, summaryLine, hasSelection }}>
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]');
      const originalText = submitButton.textContent || 'REQUEST QUOTE';

      try {
        submitButton.disabled = true;
        submitButton.textContent = 'SENDING...';

        const formData = new FormData(form);
        const vehicle = formData.get('vehicle') || label;
        const detailLines = [
          hasSelection ? `Wheel: ${series || 'N/A'}` : null,
          hasSelection ? `Finish: ${finish || 'N/A'}` : null,
          vehicle ? `Vehicle: ${vehicle}` : null,
        ].filter(Boolean);
        const userMessage = (formData.get('message') || '').toString().trim();
        const message = [detailLines.join(' | '), userMessage].filter(Boolean).join('\n\n');

        const data = {
          firstName: formData.get('firstName'),
          lastName: formData.get('lastName'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          message,
          smsConsent: formData.get('smsConsent') === 'on',
          formType: 'Wheel Quote Request',
          source: 'E5 Wheels Website - Visualizer Quote Request',
        };

        const response = await fetch('/api/send-contact-webhook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error('Failed to send quote request');

        alert('Thank you! We will follow up with pricing and availability within 1 business day.');
        form.reset();

      } catch (error) {
        console.error('Quote request submission error:', error);
        alert('Sorry, there was an error sending your request. Please try again or call us at (305) 964-7429.');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
      }
    });
  }
</script>
