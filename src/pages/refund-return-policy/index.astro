---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="E5 Wheels - Return Policy">
  <div class="w-full bg-white pb-24">
    <!-- Return Policy Section -->
    <section class="container-e5 py-20">
      <div class="max-w-[1300px] mx-auto px-6">
        <!-- Header -->
        <div class="mb-16 text-center">
          <h1 class="text-e5-red text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] font-franklin-book tracking-[5.6px] md:tracking-[7.2px] lg:tracking-[8.4px] xl:tracking-[9.6px] uppercase mb-8 leading-tight">
            RETURN POLICY
          </h1>

          <!-- Main Policy Text -->
          <div class="text-black/70 text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] font-excon leading-[22px] md:leading-[24px] lg:leading-[26px] xl:leading-[30px] space-y-6 mb-12">
            <p>
              If you find an error with your order or find you need to return or exchange an item, please call customer service at
              <a href="tel:+13059647429" class="text-e5-red hover:underline font-bold">(305) 964-7429</a>
              and we will help find a quick and easy resolution for you.
            </p>
            <p>
              Customer service will provide you with a return authorization number and answer any questions regarding the product return/exchange procedure.
            </p>
            <p>
              Please follow the return check list to ensure that no shipping damage will occur.
            </p>
          </div>

          <!-- Red Divider -->
          <div class="w-full h-[2px] bg-e5-red"></div>
        </div>

        <!-- Manufacturer's Warranties -->
        <div class="mb-16 text-center">
          <h2 class="text-e5-red text-[24px] md:text-[32px] lg:text-[40px] xl:text-[48px] font-franklin-book tracking-[4.8px] md:tracking-[6.4px] lg:tracking-[8px] xl:tracking-[9.6px] uppercase mb-8 leading-tight">
            MANUFACTURER'S WARRANTIES
          </h2>
          <div class="text-black/70 text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] font-excon leading-[22px] md:leading-[24px] lg:leading-[26px] xl:leading-[30px] mb-12">
            <p>
              E5 Wheels come with a <span class="text-e5-red">five-year warranty</span>. The warranty doesn't apply to racing wheels.
            </p>
          </div>

          <!-- Red Divider -->
          <div class="w-full h-[2px] bg-e5-red"></div>
        </div>

        <!-- Return for Refund or Exchange -->
        <div class="mb-16 text-center">
          <h2 class="text-e5-red text-[24px] md:text-[32px] lg:text-[40px] xl:text-[48px] font-franklin-book tracking-[4.8px] md:tracking-[6.4px] lg:tracking-[8px] xl:tracking-[9.6px] uppercase mb-8 leading-tight">
            RETURN FOR REFUND OR EXCHANGE
          </h2>
          <div class="text-black/70 text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] font-excon leading-[22px] md:leading-[24px] lg:leading-[26px] xl:leading-[30px] space-y-6 mb-12">
            <p>
              All returns are subject to inspection by E5 Wheels returns specialist and are accepted within 7 days of delivery. <span class="text-e5-red">Only unused wheels that have not been mounted with tires nor installed on a vehicle are eligible for return.</span>
            </p>
            <p>
              Orders that are picked up at our distribution centers are only eligible for immediate return or exchange on the same day they are picked up. After that time, orders must be reviewed by a return specialist before an exchange or credit is provided. Allow 2-3 business days to process the credit.
            </p>
            <p class="font-excon-bold">
              Credit amount will be calculated as follows:
            </p>
            <p>
              <strong class="font-excon-bold">WHEELS</strong>: Credit less all freight charges incurred. Wheels cannot have had tires mounted; please test fit wheels prior to mounting tires.
            </p>
            <p>
              <strong class="font-excon-bold">WHEEL & TIRE PACKAGE</strong>: Credit less $60 labor charge for dismount and less all freight charges incurred.
            </p>
            <p>
              <strong class="font-excon-bold">SPECIAL ORDER ITEMS</strong>: Special order items are not returnable.
            </p>
            <p>
              Orders shipped via Federal Express or UPS are charged freight both ways on refused shipments.
            </p>
            <p>
              Credits will be issued to the credit card used on the order. If payment received was cash or check, we will refund by check to the billing address.
            </p>
          </div>

          <!-- Red Divider -->
          <div class="w-full h-[2px] bg-e5-red"></div>
        </div>

        <!-- Shipping and Damage Claims -->
        <div class="mb-16 text-center">
          <h2 class="text-e5-red text-[24px] md:text-[32px] lg:text-[40px] xl:text-[48px] font-franklin-book tracking-[4.8px] md:tracking-[6.4px] lg:tracking-[8px] xl:tracking-[9.6px] uppercase mb-8 leading-tight">
            SHIPPING AND DAMAGE CLAIMS
          </h2>
          <div class="text-black/70 text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] font-excon leading-[22px] md:leading-[24px] lg:leading-[26px] xl:leading-[30px] space-y-6">
            <p>
              If your shipment has arrived with a damaged or incorrect item, please contact E5 Wheels customer service department at 305-964-7429.
            </p>
            <p>
              We will report the damage to the shipper and arrange for replacement or exchange. Damaged merchandise must be completely repackaged in the original packing, and we will arrange for the return.
            </p>
            <p>
              Call customer service at 305-964-7429 for a return authorization number and packaging instructions.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
