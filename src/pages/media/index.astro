---
import MainLayout from '@/layouts/MainLayout.astro';
import MediaDownload from "@/pages/media/components/_MediaDownload.vue"

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://e5wheels.com';
const title = 'Media & Downloads - Logos and High-Res Assets | E5 Wheels';
const description = 'Download official E5 wheel logos and high-resolution product images. Includes assets for Daytona, Sebring, Speedway, Talladega, and Sonoma wheels in various formats.';
const canonicalUrl = `${baseUrl}/media`;
---

<MainLayout title={title} description={description} canonical={canonicalUrl}>
    <section class="container-e5 py-20">
        <div class="max-w-[998px] mx-auto">
            <div class="text-center mb-12">
                <h1 class="text-e5-red text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] font-['Franklin_Gothic_Book'] tracking-[5.6px] md:tracking-[7.2px] lg:tracking-[8.4px] xl:tracking-[9.6px] uppercase mb-6 leading-tight">
                    MEDIA & DOWNLOADS
                </h1>
                <div class="w-full h-[2px] bg-e5-red mb-8"></div>
                <p class="text-black/70 text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] leading-[22px] md:leading-[24px] lg:leading-[26px] xl:leading-[30px]">
                    Download official E5 logos and high-res assets for all wheel styles: Daytona, Sebring, Speedway,
                    Talladega, and Sonoma. Perfect for marketing materials, product pages, and promotional use.
                </p>
            </div>
        </div>
    </section>

    <!-- Logos Section -->
    <section class="container-e5 pb-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                OFFICIAL E5 LOGOS
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="E5 Wheels Logo"
                               image="/assets/images/e5-wheels-logo-white.webp"
                               downloadLink="/media/logos/E5-Wheels-Logo.zip"/>
            </div>
        </div>
    </section>

    <!-- Wheel Styles Section -->
    <section class="container-e5 py-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                DAYTONA</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="Daytona Titanium Brushed"
                               image="https://wheels.autosyncstudio.com/webp/E5/Daytona_TIU_Titanium_Brushed_5-lug_0001.webp"
                               downloadLink="/media/daytona/DAYTONA-Titanium-Brushed.zip"/>
                <MediaDownload alt="Daytona Gloss Black"
                               image="https://wheels.autosyncstudio.com/webp/E5/Daytona_BK_Gloss_Black_5-lug_0001.webp"
                               downloadLink="/media/daytona/DAYTONA-Gloss-Black.zip"/>
                <MediaDownload alt="Daytona Bronze Brushed Tint"
                               image="https://wheels.autosyncstudio.com/webp/E5/Daytona_BBT_Gloss_Bronze_Brushed-Face-Tinted-Clear_5-lug_0001.webp"
                               downloadLink="/media/daytona/DAYTONA-Bronze-Brushed-Tint.zip"/>
                <MediaDownload alt="Daytona Chrome"
                               image="https://wheels.autosyncstudio.com/webp/E5/Daytona_CH_Chrome_Chrome_5-lug_0001.webp"
                               downloadLink="/media/daytona/Daytona_Chrome.zip"/>
            </div>
        </div>
    </section>

    <section class="container-e5 py-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                SEBRING</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="Sebring Titanium Brushed"
                               image="https://wheels.autosyncstudio.com/webp/E5/Sebring_TIU_Titanium_Brushed_5-lug_0001.webp"
                               downloadLink="/media/sebring/Sebring-Titanium-Brushed.zip"/>
                <MediaDownload alt="Sebring Gloss Black"
                               image="https://wheels.autosyncstudio.com/webp/E5/Sebring_BK_Gloss_Black_5-lug_0001.webp"
                               downloadLink="/media/sebring/Sebring-Gloss-Black.zip"/>
                <MediaDownload alt="Sebring Bronze"
                               image="https://wheels.autosyncstudio.com/webp/E5/Sebring_BBT_Gloss_Bronze_Brushed-Face-Tinted-Clear_5-lug_0001.webp"
                               downloadLink="/media/sebring/Sebring-Bronze.zip"/>
                <MediaDownload alt="Sebring Chrome"
                               image="https://wheels.autosyncstudio.com/webp/E5/Sebring_CH_Chrome_Chrome_5-lug_0001.webp"
                               downloadLink="/media/sebring/Sebring_Chrome.zip"/>
            </div>
        </div>
    </section>

    <section class="container-e5 py-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                SPEEDWAY</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="Speedway Titanium Brushed"
                               image="https://wheels.autosyncstudio.com/webp/E5/Speedway_TIU_Titanium_Brushed-Tint_5-lug_0001.webp"
                               downloadLink="/media/speedway/Speedway-Titanium-Brushed.zip"/>
                <MediaDownload alt="Speedway Gloss Black"
                               image="https://wheels.autosyncstudio.com/webp/E5/Speedway_BK_Gloss_Black_5-lug_0001.webp"
                               downloadLink="/media/speedway/Speedway-Gloss-Black.zip"/>
                <MediaDownload alt="Speedway Dark Bronze"
                               image="https://wheels.autosyncstudio.com/webp/E5/Speedway_DB_Dark-Bronze_5-lug_0001.webp"
                               downloadLink="/media/speedway/Speedway-Bronze-Brushed-Tint.zip"/>
                <MediaDownload alt="Speedway Chrome"
                               image="https://wheels.autosyncstudio.com/webp/E5/Speedway_CH_Chrome_Chrome_5-lug_0001.webp"
                               downloadLink="/media/speedway/Speedway_Chrome.zip"/>
            </div>
        </div>
    </section>

    <section class="container-e5 py-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                TALLADEGA</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="Talladega Brushed Aluminum"
                               image="https://wheels.autosyncstudio.com/webp/E5/Talladega_AB_Brushed_Aluminum_5-lug_0001.webp"
                               downloadLink="/media/talladega/E5_Talledega.zip"/>
            </div>
        </div>
    </section>

    <!-- Sonoma Section -->
    <section class="container-e5 py-12">
        <div class="mx-auto">
            <h2 class="text-e5-red text-[24px] md:text-[28px] lg:text-[32px] xl:text-[36px] font-['Franklin_Gothic_Book'] tracking-[4.8px] md:tracking-[5.6px] lg:tracking-[6.4px] xl:tracking-[7.2px] uppercase mb-8">
                SONOMA</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <MediaDownload alt="Sonoma Brushed Aluminum"
                               image="https://wheels.autosyncstudio.com/webp/E5/Sonoma_AB_Brushed_Aluminum_5-lug_0001.webp"
                               downloadLink="/media/sonoma/Sonoma_brushed.zip"/>
            </div>
        </div>
    </section>
</MainLayout>